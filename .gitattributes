# Byte-pinned goldens and generated-artifact sources. Without an explicit
# `eol=lf` these fall to `* text=auto` above, which converts LF to CRLF on
# checkout under the `core.autocrlf=true` that Windows CI runners default to.
# A byte comparison against a renderer that emits `\n` then fails on Windows
# only -- which is exactly how `proof_export::tests::the_rendered_lean_source_
# matches_the_pinned_golden` broke while passing everywhere else.
*.golden text eol=lf
*.lean text eol=lf
*.jsonl text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.wit text eol=lf
*.py text eol=lf
*.swift text eol=lf
*.java text eol=lf
platform-tests/component-runtime/** text eol=lf
docs/evidence/**/*.log text eol=lf whitespace=-blank-at-eof
# Frozen LAW16 process capsules retain exact bytes, including diagnostic whitespace.
benchmarks/bend2-law-v1/evidence/law16-unified-*/** -text -whitespace
benchmarks/bend2-law-v1/evidence/law16-guest-cache-*/** -text -whitespace
# CSV framing fixture intentionally mixes record CRLF with embedded CRLF bytes.
tests/project/standard_library/fixtures/csv-multiline.csv -text -whitespace

# Frozen #286 prior-model receipt retains exact diagnostic whitespace.
docs/evidence/prelude-forecast-286/historical-owning-selected-286.log -text -whitespace

# Frozen actual prelude pin producer logs retain original diagnostic whitespace.
docs/evidence/prelude-forecast-actual-pins-a184d-20261015/actual-capture/*.log -text -whitespace

# Preserve the actual failed source-guard receipt byte-for-byte.
docs/evidence/prelude-fixture-source-guard-4ec/historical-owning-selected-90.log -text -whitespace

# Preserve the actual old/current forecast comparison failure receipt.
docs/evidence/core-proof-prelude-forecast-correction-4ec/historical-owning-selected-167.log -text -whitespace

# Extensionless content-addressed source images retain their exact pinned bytes.
e/** -text
docs/evidence/w/** -text

# Byte-pinned evidence source images must survive Windows checkout unchanged.
# Their .before extension otherwise falls through to core.autocrlf conversion.
docs/evidence/**/*.before -text


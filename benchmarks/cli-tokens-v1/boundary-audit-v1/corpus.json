          "request": {
            "ip": "203.0.113.7",
            "path": "/𐀀",
            "hour": "09",
            "status": 404,
            "bytes": "1"
          }
        },
        {
          "request": {
            "ip": "203.0.113.7",
            "path": "/",
            "hour": "09",
            "status": 200,
            "bytes": "1"
          }
        }
      ]
    },

module bench.validation.app;
use function @id("bench.validation.validate") from bench.validation.candidate as validate;

@id("bench.validation.eq")
fn eq(actual: i64, expected: i64) -> i64
{
    if actual == expected { 1 } else { 0 }
}

@id("bench.validation.app.main")
fn main() -> i64
{
    let checks = eq(validate(6, 2, 0), 1) + eq(validate(7, 2, 0), 2) + eq(validate(7, 1, -1), 3) + eq(validate(7, 1, 65), 3) + eq(validate(7, 1, 64), 0) + eq(validate(7, 1, 1), 0);
    if checks == 6 { 0 } else { 1 }
}

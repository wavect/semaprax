#!/bin/sh
# Deterministic stand-in for `cargo test` output (libtest shape): 320 tests,
# one failure buried mid-run, repetitive compile notices on stderr. Builtins
# only, so it needs no PATH. $BENCH_COUNTER, when set, counts executions.
if [ -n "$BENCH_COUNTER" ]; then
  n=0
  [ -f "$BENCH_COUNTER" ] && read n < "$BENCH_COUNTER"
  echo $((n + 1)) > "$BENCH_COUNTER"
fi
j=0
while [ $j -lt 120 ]; do
  echo "   Compiling ledger-dep-$j v0.1.0" >&2
  j=$((j + 1))
done
echo "running 320 tests"
i=0
while [ $i -lt 320 ]; do
  if [ $i -eq 173 ]; then
    echo "test ledger_suite::case_173 ... FAILED"
  else
    printf 'test ledger_suite::case_%03d ... ok\n' $i
  fi
  i=$((i + 1))
done
echo
echo "failures:"
echo "---- ledger_suite::case_173 stdout ----"
echo "thread 'ledger_suite::case_173' panicked at src/lib.spx:6:5:"
echo "assertion failed: ledger.line_total(3, 4) == 12 (left: 7, right: 12)"
echo
echo "test result: FAILED. 319 passed; 1 failed; 0 ignored"
exit 101

/* The safe Rust scope proves this UTF-8 view lives through the entire call. */
uint32_t spx_borrowed_callback_invoke(const uint8_t *data, uint64_t length,
    int64_t argument, int64_t *out, uint32_t *status_class, uint32_t *status_code) {
    if (!data || !out || !status_class || !status_code) return UINT32_C(3);
    struct spx_context context = {0};
    struct spx_status_entry entries[8] = {{0}};
    if (!spx_context_init(&context, UINT64_C(366), entries, UINT32_C(8), NULL, NULL, NULL))
        return UINT32_C(3);
    spx_str_v1 view = { .data = data, .len = length };
    int64_t result = 0;
    spx_status_token token = ENTRY_SYMBOL(&context, view, argument, &result);
    if (token == SPX_STATUS_SUCCESS) { *out = result; return UINT32_C(0); }
    const struct spx_normalized_status *status = spx_status_resolve(&context, token);
    if (!status) return UINT32_C(3);
    *status_class = status->status_class;
    *status_code = status->code;
    return UINT32_C(1);
}

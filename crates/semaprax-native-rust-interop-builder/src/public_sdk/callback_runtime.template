fn spx_callback_error(error:NativeRustCallError)->SpxCallbackError {
    match error {
        NativeRustCallError::Semantic{domain_id,code,class,..}=>match class {
            NativeRustStatusClass::Contract=>SpxCallbackError::Contract(code.get()),
            NativeRustStatusClass::Semantic=>SpxCallbackError::Semantic(code.get()),
            NativeRustStatusClass::Import=>SpxCallbackError::Domain{domain:domain_id,code:code.get()},
            NativeRustStatusClass::Adapter=>SpxCallbackError::AdapterRejected,
        },
        NativeRustCallError::HostFailed=>SpxCallbackError::HostFailed,
        NativeRustCallError::HostPanicked=>SpxCallbackError::RustPanicked,
        NativeRustCallError::AdapterRejected=>SpxCallbackError::AdapterRejected,
    }
}

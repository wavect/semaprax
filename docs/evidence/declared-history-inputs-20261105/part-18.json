[{"source":"src/prelude.rs","provenance":"docs/evidence/prelude-forecast-286/exact-source-inverses.json","current_bytes":46722,"current_sha256":"07b73401aad6bfa3f0ad8b3d3d56b13d93d09f04b3de4366ac07a00dca0c2a3f","current_archive":"e/07b73401aad6bfa3f0ad8b3d3d56b13d93d09f04b3de4366ac07a00dca0c2a3f","before_bytes":46154,"before_sha256":"e7ad3dacb0541f2c4558a6826aaef49f05a3cbdec2ae358061f6e387017f6a51","before_archive":"e/e7ad3dacb0541f2c4558a6826aaef49f05a3cbdec2ae358061f6e387017f6a51","inverse":[[3048,"// Addressable byte arrays give every codegen unit the same backing storage.\n// A static &str only fixes the reference's address; its literal can be copied\n// when that reference is evaluated in a constant used by another codegen unit.\nstatic VEC_ID_STORAGE: [u8; 8] = *b\"core.vec\";\nstatic BOX_ID_STORAGE: [u8; 8] = *b\"core.box\";\npub(crate) const VEC_ID: &str = match std::str::from_utf8(&VEC_ID_STORAGE) {\n    Ok(text) => text,\n    Err(_) => panic!(\"compiler Vec identity must be UTF-8\"),\n};\npub(crate) const BOX_ID: &str = match std::str::from_utf8(&BOX_ID_STORAGE) {\n    Ok(text) => text,\n    Err(_) => panic!(\"compiler Box identity must be UTF-8\"),\n};\n","pub(crate) const VEC_ID: &str = \"core.vec\";\npub(crate) const BOX_ID: &str = \"core.box\";\n"]],"fixture_originals":[{"sha256":"acfbd839aee3ce120bb05677374efb0005e7c3f324cd0dbd4976c5a09942fd80","table_sha256":"9583da7f424d9e962b60023a62443e3239e5aaa7015e5f3026fdbabc46ef5610","provenance":"docs/evidence/prelude-forecast-286/exact-source-inverses.json"}]},{"source":"src/workspace_graph/expected_projection.rs","provenance":"docs/evidence/prelude-forecast-286/exact-source-inverses.json","current_bytes":62390,"current_sha256":"7d5db49018e54ece27f87d09e333be437904a8fbdf6bb72369775ade471cfbad","current_archive":"e/7d5db49018e54ece27f87d09e333be437904a8fbdf6bb72369775ade471cfbad","before_bytes":59451,"before_sha256":"974468e7035d1a7baa48b13078ce7ec7b0711c2c7610d64db7feea561b192f0c","before_archive":"e/974468e7035d1a7baa48b13078ce7ec7b0711c2c7610d64db7feea561b192f0c","inverse":[[1111,"#[path = \"expected_projection/call_carriers.rs\"]\nmod call_carriers;\n#[cfg(test)]\n#[path = \"expected_projection/call_carriers_original.rs\"]\n#[allow(dead_code, reason = \"complete independent pre-898 forecaster control\")]\nmod call_carriers_original;\n",""],[14657,"// Imported intrinsic wrappers are retained as templates by the synthetic\n// projection too. Each actual typed call constructs a full instance, just as\n// a call to an authored local template does; count its real provider body.\nfn generic_instance_source_cost_with_imports(\n    program: &Program,\n    authored: &BTreeMap<&str, AuthoredDeclaration<'_>>,\n    programs: &[Program],\n    include_imports: bool,\n) -> Result<GenericInstanceCost, Vec<Diagnostic>> {\n    let mut total = generic_instance_source_cost(program)?;\n    for module_use in program.module_uses.iter().filter(|_| include_imports) {\n        if module_use.kind != ModuleUseKind::Function {\n            continue;\n        }\n        let Some(target) = authored.get(module_use.persistent_id.as_str()) else {\n            continue;\n        };\n        let Some(function) = target.function.filter(|f| !f.type_parameters.is_empty()) else {\n            continue;\n        };\n        let Some(provider) = programs.iter().find(|p| p.module == target.module) else {\n            continue;\n        };\n        if crate::vec_ops::source_wrapper(provider, function).is_none()\n            && crate::box_ops::source_wrapper(provider, function).is_none()\n        {\n            continue;\n        }\n        let mut instances = 0usize;\n        for caller in program\n            .functions\n            .iter()\n            .filter(|f| f.type_parameters.is_empty())\n        {\n            for expression in caller\n                .requires\n                .iter()\n                .chain(std::iter::once(&caller.body))\n                .chain(&caller.ensures)\n            {\n                expression.visit_call_instances(&mut |name, arguments, _| {\n                    if name == module_use.alias && !arguments.is_empty() {\n                        instances = instances.saturating_add(1);\n                    }\n                });\n            }\n        }\n        if instances == 0 {\n            continue;\n        }\n        let mut cost = StructuralCost::new();\n        ast_function_cost(function, &mut cost)?;\n        let slots = ast_function_identity_slots(function)?;\n        for (sum, per_instance) in [\n            (&mut total.bytes, cost.total),\n            (&mut total.string_bytes, cost.string_bytes),\n            (&mut total.identity_slots, slots),\n            (&mut total.identity_carriers, cost.identity_carriers),\n        ] {\n            *sum = instances\n                .checked_mul(per_instance)\n                .and_then(|bytes| sum.checked_add(bytes))\n                .filter(|bytes| *bytes <= active_builder_limit())\n                .ok_or_else(|| vec![limit_error(\"builder_bytes\", active_builder_limit())])?;\n        }\n    }\n    Ok(total)\n}\n\n",""]],"fixture_originals":[{"sha256":"65533cf9ba31f97cbc6618222b5a99bbb6b89dda14c34b686e541a8b77ce3a4c","table_sha256":"9583da7f424d9e962b60023a62443e3239e5aaa7015e5f3026fdbabc46ef5610","provenance":"docs/evidence/prelude-forecast-286/exact-source-inverses.json"}]},{"source":"src/workspace_graph/expected_projection/held_projection.rs","provenance":"docs/evidence/prelude-forecast-286/exact-source-inverses.json","current_bytes":21987,"current_sha256":"9e9dce95e9ca4b7273319fe3171c88a3db6c6695d14ea8e8de327419fd2e65a8","current_archive":"e/9e9dce95e9ca4b7273319fe3171c88a3db6c6695d14ea8e8de327419fd2e65a8","before_bytes":21629,"before_sha256":"1530f578236abe624f92941698def06f8de44d9deba0003936fb60206afe74bd","before_archive":"e/1530f578236abe624f92941698def06f8de44d9deba0003936fb60206afe74bd","inverse":[[446,"    default_expr, generic_instance_source_cost_with_imports, graph_error
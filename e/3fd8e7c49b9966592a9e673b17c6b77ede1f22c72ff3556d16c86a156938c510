       }\n                None\n            }\n            _ => {\n                let result = child(self.expression, self.outer);\n                if result.is_some() {\n                    self.outer += 1;\n                }\n                result\n            }\n        }\n    }\n}\nimpl std::iter::FusedIterator for ChildCursor<'_> {}\n\n"

fn assert_merged_measured_host_history_before_current272388(name: &str, bytes: &[u8]) {
    if !cfg!(all(target_os = "macos", target_arch = "aarch64")) {
        assert_measured_host_history(name, bytes);
        return;
    }
    let names = ["public-graph.json", "context.json", "forward.json", "capability-context.json", "type-context.json", "impact.json", "custom-impact.json", "review.json", "capability-review.json"];
    let slot = names.iter().position(|candidate| *candidate == name).expect("exact nine merged KAT names");
    assert_eq!(document_digest(bytes), MERGED_MACOS_AARCH64_WIRES.expect("actual merged macOS KAT capture required")[slot]);
    let document: serde_json::Value = serde_json::from_str(MERGED_MACOS_FULL_INVERSES.expect("actual full merged payload inverses required")).unwrap();
    let rows = document.as_array().unwrap();
    assert_eq!(rows.len(), 9);
    let row = &rows[slot];
    assert_eq!(row["name"], name);
    assert_eq!(row["current_length"].as_u64().unwrap(), u64::try_from(bytes.len()).unwrap());
    let mut predecessor = None;
    for domain in ["ours", "incoming_f65"] {
        let leg = &row[domain];
        let mut restored = std::str::from_utf8(bytes).unwrap().to_owned();
        let mut next = restored.len();
        let edits = leg["inverse"].as_array().unwrap();
        assert!(edits.len() <= 512);
        for edit in edits.iter().rev() {
            let start = usize::try_from(edit[0].as_u64().unwrap()).unwrap();
            let end = usize::try_from(edit[1].as_u64().unwrap()).unwrap();
            let after = edit[2].as_str().unwrap();
            let before = edit[3].as_str().unwrap();
            assert!(start <= end && end <= next);
            assert_eq!(restored.get(start..end), Some(after));
            restored.replace_range(start..end, before);
            next = start;
        }
        assert_eq!(restored, leg["entire_target"].as_str().unwrap(), "entire historical KAT payload including unknown fields");
        assert_eq!(document_digest(restored.as_bytes()), leg["target_sha256"].as_str().unwrap());
        if domain == "ours" {
            assert_measured_host_history(name, restored.as_bytes());
            predecessor = Some(restored);
        } else {
            assert_eq!(restored, INCOMING_F65_MACOS_WHOLE[slot]);
            let stem = name.strip_suffix(".json").unwrap();
            let path = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join(format!("docs/evidence/public-wire-accounting-20261026/{stem}-current-macos.json"));
            assert_eq!(std::fs::metadata(&path).unwrap().len(), u64::try_from(restored.len()).unwrap());
            assert_eq!(std::fs::read_to_string(&path).unwrap(), restored);
        }
    }
    assert!(predecessor.is_some());
}


fn common_and_promotion_banks_cover_actual_roles_without_changing_layout_or_group_prices() {
    macro_rules! check {
        ($t:ty) => {{
            assert_eq!(
                size_of::<frontier::Incoming<$t>>(),
                size_of::<fused_before_frontier::Incoming<$t>>()
            );
            assert_eq!(
                size_of::<frontier::Insertions<$t>>(),

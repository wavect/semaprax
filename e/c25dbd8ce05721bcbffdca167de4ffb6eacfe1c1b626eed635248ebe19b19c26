            );
            assert_eq!(
                frontier::Insertions::<$t>::controls(),
                fused_before_frontier::Insertions::<$t>::controls()
            );
            let saving = common_saving::<$t>();
            let arm = promotion::<$t>();
            assert_eq!(
                arm,
                4 * size_of::<frontier::Incoming<$t>>() + 2 * size_of::<BTreeSet<Box<$t>>>()
            );
            let old = fused_before_frontier::Insertions::<$t>::observed_prices();
            let new = frontier::Insertions::<$t>::observed_prices();
            for i in 0..6 {
                assert_eq!(
                    new[i].checked_add(saving),
                    old[i].checked_add(if i == 2 || i == 3 { arm } else { 0 })
                );
            }
            assert_eq!(new[6], old[6]);
        }};
    }

// One authenticated full-current -> complete immediate-old leg, composed before
// every older inverse. Only the exact already-projected endpoint is idempotent.
pub(super) fn before_source(path: &str, supplied: String) -> String {
    let packet = include_bytes!("fused_before/inverse.json");
    assert_eq!(digest(packet), INVERSE_SHA);
    let rows: serde_json::Value = serde_json::from_slice(packet).unwrap();
    let Some(row) = rows
        .as_array()
        .unwrap()
        .iter()
        .find(|r| r["path"].as_str() == Some(path))
    else {
        return supplied;
    };
    let root = std::path::Path::new(env!("CARGO_MANIFEST_DIR"));
    let physical = std::fs::read(root.join(path)).unwrap();
    let compiled: &[u8] = match path {
        "src/cleanup_plan/replay/path_join.rs" => include_bytes!("../path_join.rs"),
        "src/cleanup_plan/replay/path_join/frontier.rs" => include_bytes!("frontier.rs"),
        "src/cleanup_plan/replay/path_join/contains_tests.rs" => {
            include_bytes!("contains_tests.rs")
        }
        "src/cleanup_plan/replay/path_join/shared_insertions_tests.rs" => {
            include_bytes!("shared_insertions_tests.rs")
        }
        "src/cleanup_plan/replay/path_join/compact_failure_tests.rs" => {
            include_bytes!("compact_failure_tests.rs")
        }
        "src/cleanup_plan/replay/path_join/direct_one_tests.rs" => {
            include_bytes!("direct_one_tests.rs")
        }
        "src/cleanup_plan/replay/path_join/frontier_tests.rs" => {
            include_bytes!("frontier_tests.rs")
        }
        "src/cleanup_plan/replay/path_join/fused_before.rs" => include_bytes!("fused_before.rs"),
        _ => panic!("unadmitted fused source"),
    };
    assert_eq!(physical, compiled);
    assert_eq!(physical.len() as u64, row["length"].as_u64().unwrap());
    assert_eq!(digest(&physical), row["sha256"].as_str().unwrap());
    let mut actual = physical.clone();
    for edit in row["edits"].as_array().unwrap() {
        let at = edit[0].as_u64().unwrap() as usize;
        let from = edit[1].as_str().unwrap().as_bytes();
        assert_eq!(&actual[at..at + from.len()], from);
        actual.splice(at..at + from.len(), edit[2].as_str().unwrap().bytes());
    }
    let before = std::fs::read(root.join(row["before"].as_str().unwrap())).unwrap();
    assert_eq!(before.len() as u64, row["before_length"].as_u64().unwrap());
    assert_eq!(digest(&before), row["before_sha256"].as_str().unwrap());
    assert_eq!(actual, before);
    assert!(
        supplied.as_bytes() == physical || supplied.as_bytes() == actual,
        "foreign fused acquisition"
    );
    assert_eq!(std::fs::read(root.join(path)).unwrap(), physical);
    assert_eq!(
        std::fs::read(root.join("src/cleanup_plan/replay/path_join/fused_before/inverse.json"))
            .unwrap(),
        packet
    );
    String::from_utf8(actual).unwrap()
}

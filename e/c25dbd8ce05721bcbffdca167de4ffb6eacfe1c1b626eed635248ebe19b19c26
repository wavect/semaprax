#[test]
fn complete_immediate_ordinary_driver_has_exact_bank_equation_through_drop_and_all_work_cuts() {
    for source in [TINY, SOURCE, LEXICAL, RENEWAL] {
        let program =
            crate::hir::resolve(&crate::check(source, "ordinary-frontier.spx").unwrap()).unwrap();
        for f in &program.functions {
            let original = f.cleanup_plan.clone();
            let observe = |old, limit| {
                with_limit_usage_refusal(limit, || {
                    measure(|| {
                        let mut b = ReplayBudget::new();
                        let result = ordinary_replay(&program, f, old, &mut b);
                        let ok = result.is_ok();
                        if let Err(e) = &result {
                            assert_eq!(e.code, "SPX-H006");
                        }
                        drop(result);
                        drop(b);
                        ok
                    })
                })
            };
            let old = observe(true, usize::MAX);
            contains_tests::reset_banks();
            let new = observe(false, usize::MAX);
            assert!(old.0 .0 && new.0 .0 && !old.1 && !new.1);
            let entry = contains_tests::paid_banks()
                .checked_mul(common_saving::<PathState>())
                .unwrap();
            let arms = promotions().checked_mul(promotion::<PathState>()).unwrap();
            assert_eq!(
                new.2.checked_add(entry).and_then(|n| n.checked_sub(arms)),
                Some(old.2)
            );
            assert!(
                new.2 < old.2,
                "strict whole immediate-old invoice: {}",
                f.id
            );
            assert_eq!(new.0 .1, old.0 .1);
            for o in [&old, &new] {
                let a = &o.0 .1;
                assert!(!a.invalid && a.live == 0);
                assert_eq!(a.allocated, a.freed);
                assert!(a.allocated <= o.2);
            }
            for prior in [false, true] {
                let exact = if prior { old.2 } else { new.2 };
                for limit in [0, exact - 1, exact] {
                    let r = observe(prior, limit);
                    assert_eq!(r.0 .0, limit == exact);
                    assert_eq!(r.1, limit != exact);
                }
            }
            assert_eq!(f.cleanup_plan, original);
        }
    }
    for source in [TINY, SOURCE, LEXICAL, RENEWAL] {
        let p =
            crate::hir::resolve(&crate::check(source, "ordinary-frontier.spx").unwrap()).unwrap();
        for f in &p.functions {
            let mut complete = ReplayBudget::unobserved();
            ordinary_replay(&p, f, true, &mut complete).unwrap();
            let work = MAX_REPLAY_WORK_UNITS - complete.remaining;
            for skeleton in [false, true] {
                for limit in [
                    0,
                    1,
                    2,
                    7,
                    work.saturating_sub(1),
                    work,
                    MAX_REPLAY_WORK_UNITS,
                ] {
                    let mut old = ReplayBudget::unobserved();
                    let mut now = ReplayBudget::unobserved();
                    if skeleton {
                        old.skeleton_remaining = limit;
                        now.skeleton_remaining = limit;
                    } else {
                        old.remaining = limit;
                        now.remaining = limit;
                    }
                    assert_eq!(
                        ordinary_replay(&p, f, false, &mut now),
                        ordinary_replay(&p, f, true, &mut old)
                    );
                    assert_eq!(
                        (now.remaining, now.skeleton_remaining),
                        (old.remaining, old.skeleton_remaining)
                    );
                }
            }
        }
    }
    let mut p =
        crate::hir::resolve(&crate::check(SOURCE, "ordinary-frontier.spx").unwrap()).unwrap();
    for arity in [0, 1, 3] {
        let mut changed = false;
        for f in &mut p.functions {
            if let Some(edges) = f.cleanup_plan.blocks.iter_mut().find_map(|block| {
                if let CleanupTerminator::Branch(edges) = &mut block.terminator {
                    Some(edges)
                } else {
                    None
                }
            }) {
                let original = edges.clone();
                *edges = (0..arity).map(|i| original[i % original.len()]).collect();
                changed = true;
                break;
            }
        }
        assert!(changed);
        for f in &p.functions {
            for limit in [0, 1, 2, 7, MAX_REPLAY_WORK_UNITS] {
                let mut old = ReplayBudget::unobserved();
                let mut now = ReplayBudget::unobserved();
                old.remaining = limit;
                now.remaining = limit;
                assert_eq!(
                    ordinary_replay(&p, f, false, &mut now),
                    ordinary_replay(&p, f, true, &mut old)
                );
                assert_eq!(
                    (now.remaining, now.skeleton_remaining),
                    (old.remaining, old.skeleton_remaining)
                );
            }
        }
        p = crate::hir::resolve(&crate::check(SOURCE, "ordinary-frontier.spx").unwrap()).unwrap();
    }
}
#[test]
fn actual_ordinary_and_group_entries_keep_authority_positive_zero_sticky_and_drop_order() {
    let f = function();
    let other = function();
    for grouped in [false, true] {
        for scenario in 0..6 {
            let observe = |old| {
                DROPS.with(|n| n.set(0));
                let (answer, refused, paid, first) = with_limit_usage_refusal(1 << 20, || {
                    let mut b = ReplayBudget::new();
                    let mut foreign = ReplayBudget::new();
                    macro_rules! run {
                        ($module:ident) => {{
                            let mut receiver = $module::Insertions::acquire(&f, &mut b).unwrap();
                            let mut incoming = $module::Incoming::default();
                            let mut group = BTreeSet::new();
                            let mut held = if grouped {
                                receiver.insert_owned(&f, &mut incoming, State([7; 50]), &mut b);
                                assert!(!receiver.failed);
                                Some(incoming.into_one().next().unwrap())
                            } else {
                                None
                            };
                            let mut incoming = $module::Incoming::default();
                            match scenario {
                                1 => {
                                    assert!(set_active_floor(active_remaining().unwrap()));
                                }
                                2 => {
                                    let remaining = active_remaining().unwrap();
                                    assert!(set_active_floor(remaining - 1));
                                }
                                5 => {
                                    let ((), child_refused, child_paid, child_first) =
                                        with_limit_usage_refusal(1, || {
                                            if grouped {
                                                receiver.insert_group_held(
                                                    &f,
                                                    &mut group,
                                                    held.take().unwrap(),
                                                    &mut b,
                                                );
                                            } else {
                                                receiver.insert_owned(
                                                    &f,
                                                    &mut incoming,
                                                    State([1; 50]),
                                                    &mut b,
                                                );
                                            }
                                        });
                                    assert!(
                                        !child_refused && child_paid == 0 && child_first.is_none()
                                    );
                                }
                                _ => {}
                            }
                            if scenario != 5 {
                                let function = if scenario == 3 { &other } else { &f };
                                let budget = if scenario == 4 { &mut foreign } else { &mut b };
                                if grouped {
                                    receiver.insert_group_held(
                                        function,
                                        &mut group,
                                        held.take().unwrap(),
                                        budget,
                                    );
                                } else {
                                    receiver.insert_owned(
                                        function,
                                        &mut incoming,
                                        State([1; 50]),
                                        budget,
                                    );
                                }
                            }
                            let error = if receiver.failed {
                                Some(receiver.failure())
                            } else {
                                None
                            };
                            if scenario == 0 {
                                assert!(error.is_none());
                                if grouped {
                                    receiver.insert_owned(
                                        &f,
                                        &mut incoming,
                                        State([7; 50]),
                                        &mut b,
                                    );
                                    receiver.insert_group_held(
                                        &f,
                                        &mut group,
                                        incoming.into_one().next().unwrap(),
                                        &mut b,
                                    );
                                    assert_eq!(group.len(), 1);
                                } else {
                                    for v in [2, 2, 3] {
                                        receiver.insert_owned(
                                            &f,
                                            &mut incoming,
                                            State([v; 50]),
                                            &mut b,
                                        );
                                    }
                                    assert_eq!(incoming.len(), 3);
                                    assert_eq!(incoming.iter().map(|v| v.0[0]).sum::<u64>(), 6);
                                    drop(incoming);
                                }
                                assert!(!receiver.failed);
                            } else {
                                assert!(error.is_some());
                                let at = active_remaining();
                                // An already-failed owner must neither query nor publish on retry.
                                let mut retry = $module::Incoming::default();
                                receiver.insert_owned(
                                    &other,
                                    &mut retry,
                                    State([99; 50]),
                                    &mut foreign,
                                );
                                assert!(retry.is_empty() && receiver.failed);
                                assert_eq!(active_remaining(), at);
                                drop(incoming);
                            }
                            assert_eq!(foreign.remaining, MAX_REPLAY_WORK_UNITS);
                            clear_active_floor();
                            drop(group);
                            drop(receiver);
                            (
                                error,
                                b.remaining,
                                b.skeleton_remaining,
                                DROPS.with(std::cell::Cell::get),
                            )
                        }};
                    }
                    if old {
                        run!(fused_before_frontier)
                    } else {
                        run!(frontier)
                    }
                });
                assert!(paid <= 1 << 20);
                (answer, refused, first)
            };
            // The physical first receipt is intentionally compared only where
            // requests are identical; owner-acquisition byte prices differ.
            let old = observe(true);
            let new = observe(false);
            assert_eq!(old.0, new.0, "group={grouped} scenario={scenario}");
            assert_eq!(old.1, new.1);
            assert_eq!(old.2.is_some(), new.2.is_some());
        }
    }
}
#[test]
fn both_promotion_orders_tree_splits_and_partial_promotion_unwind_preserve_owners() {
    let f = function();
    for reverse in [false, true] {
        let observe = |old| {
            with_limit_usage_refusal(1 << 24, || {
                measure(|| {
                    let mut b = ReplayBudget::new();
                    macro_rules! run {
                        ($module:ident) => {{
                            let mut r = $module::Insertions::<u64>::acquire(&f, &mut b).unwrap();
                            let mut target = $module::Incoming::default();
                            let first = if reverse { 31 } else { 0 };
                            r.insert_owned(&f, &mut target, first, &mut b);
                            assert!(!r.failed);
                            let original =
                                std::ptr::from_ref(target.iter().next().unwrap().as_ref());
                            for index in 1..32 {
                                let value = if reverse { 31 - index } else { index };
                                r.insert_owned(&f, &mut target, value, &mut b);
                                assert!(!r.failed);
                            }
                            for value in 0..32 {
                                r.insert_owned(&f, &mut target, value, &mut b);
                                assert!(!r.failed);
                            }
                            assert!(target.iter().map(|v| **v).eq(0..32));
                            assert!(target
                                .iter()
                                .any(|v| std::ptr::from_ref(v.as_ref()) == original));
                            drop(target);
                            drop(r);
                        }};
                    }
                    if old {
                        run!(fused_before_frontier)
                    } else {
                        run!(frontier)
                    }
                    drop(b);
                })
            })
        };
        let old = observe(true);
        contains_tests::reset_banks();

pub(super) fn common_saving<T: Ord>() -> usize {
    let removed = 4 * size_of::<frontier::Incoming<T>>()
        + size_of::<Box<T>>()
        + 2 * size_of::<BTreeSet<Box<T>>>();
    let new = size_of::<&mut Box<T>>()
        + size_of::<&mut BTreeSet<Box<T>>>()
        + 2 * size_of::<&Box<T>>()
        + 2 * size_of::<&BTreeSet<Box<T>>>();
    let saving = removed
        .checked_sub(new)
        .expect("complete new arm receiver bank");
    assert_eq!(
        fused_before_frontier::Insertions::<T>::entry_controls(),
        frontier::Insertions::<T>::entry_controls()
            .checked_add(saving)
            .unwrap()
    );
    saving
}
pub(super) fn promotion<T: Ord>() -> usize {
    frontier::Insertions::<T>::promotion_controls()
}
// Compose every predecessor's contains-only bank with this producer's real
// successful payment count and distinct One promotions, including setup and
// the final unused renewal. No refund or baseline padding enters either run.
pub(super) fn prior_entry_saving<T: Ord>() -> usize {
    contains_tests::paid_banks()
        .checked_mul(contains_tests::entry_delta::<T>())
        .unwrap()
        .checked_sub(promotions().checked_mul(promotion::<T>()).unwrap())
        .expect("whole fixture net")
}

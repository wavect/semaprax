all_carriers::count_modular(c, imports).unwrap();\n        assert_eq!(slots.slots, 2);\n        assert_eq!(\n            data.roots,\n            call_carriers::count(c.program, &i, imports).roots\n        );\n    }\n    // Entire immediate-old constructor, not a restated eligibility predicate.\n    let mut old = None;\n    shared_local_callees::modular_session::record_before::Session::observe(\n        &mut old,\n        c,\n        &p[0].functions[1],\n        &p[0].functions[0],\n        1,\n    )\n    .unwrap();\n    assert_eq!(\n        shared_local_callees::modular_session::record_before::Session::checkpoint(&old),\n        0\n    );\n    shared_local_callees::modular_session::record_before::Session::rollback(&mut old, 0).unwrap();\n    assert_eq!(\n        shared_local_callees::modular_session::record_before::Session::finish(old, c)\n            .unwrap()\n            .slots,\n        0\n    );\n}\n\n#[test]\nfn recursive_generic_unknown_nonrecord_and_import_alias_signatures_remain_unproved() {\n    for attack in 0..7 {\n        let mut p = programs();\n        match attack {\n            0 => {\n                if let TypeDeclarationKind::Record { fields } = &mut p[0].types[0].kind {\n                    fields[0].ty = Type::Named {\n                        name: \"Outer\".into(),\n                        arguments: vec![],\n                    };\n                }\n            }\n            1 => p[0].types[0].explicit_id = false,\n            2 => p[0].types[0].invariants = Some(Box::new(vec![])),\n            3 => p[0].types[0].extends = Some(Type::I64),\n            4 => p[0].types[0].kind = TypeDeclarationKind::Resource { lifecycles: vec![] },\n            5 => p[0].types[0].name = \"Unknown\".into(),\n            _ => {\n                let mut alias = p[0].module_uses[0].clone();\n                alias.alias = \"Leaf\".into();\n                p[0].module_uses.push(alias);\n            }\n        }\n        let i = crate::workspace_graph::index_authored(&p).unwrap();\n        for imports in [false, true] {\n            assert_eq!(\n                call_carriers::count_modular(context(&p, &i), imports)\n                    .unwrap()\n                    .1\n                    .slots,\n                0,\n                \"attack={attack}\"\n            );\n        }\n    }\n    let mut p = programs();\n    p[0] = crate::parse(\n        &SOURCE.replace(\"record Leaf {\", \"record Leaf<T> {\"),\n        \"record.spx\",\n    )\n    .unwrap();\n    let i = crate::workspace_graph::index_authored(&p).unwrap();\n    assert_eq!(\n        call_carriers::count_modular(context(&p, &i), false)\n            .unwrap()\n            .1\n            .slots,\n        0\n    );\n}\n\n#[test]\nfn copied_type_wrong_kind_provider_or_source_never_authenticate_a_record_loan() {\n    let p = programs();\n    let copied = p[0].types[0].clone();\n    for attack in 0..4 {\n        let mut i = crate::workspace_graph::index_authored(&p).unwrap();\n        let target = i.get_mut(\"leaf\").unwrap();\n        match attack {\n            0 => target.ty = Some(&copied),\n            1 => target.kind = crate::workspace_graph::AuthoredKind::Function,\n            2 => target.module = \"record.provider\",\n            _ => target.path = \"other.spx\",\n        }\n        assert_eq!(\n            call_carriers::count_modular(context(&p, &i), false)\n                .unwrap()\n                .1\n                .slots,\n            0\n        );\n    }\n    let i = crate::workspace_graph::index_authored(&p).unwrap();\n    let foreign = [p[0].clone(), p[1].clone()];\n    let invoice = Invoice::acquire().unwrap();\n    assert!(!ordinary(\n        Context {\n            program: &p[0],\n            authored: &i,\n            programs: &foreign\n        },\n        &p[0].functions[0],\n        &invoice\n    )\n    .unwrap());\n}\n\n#[test]\nfn record_constructor_exact_short_zero_foreign_sticky_and_full_drop() {\n    let p = programs();\n    let i = crate::workspace_graph::index_authored(&p).unwrap();\n    let c = context(&p, &i);\n    let run = |limit| {\n        with_limit_usage_refusal(limit, || {\n            measure(|| {\n                let result = call_carriers::count_modular(c, false);\n                let ok = result.is_ok();\n                drop(result);\n                if !ok {\n                    assert!(!reserve_active_required(0));\n                }\n                ok\n            })\n        })\n    };\n    let ((ok, a), refused, paid, first) = run(usize::MAX);\n    assert!(ok && !refused && first.is_none());\n    assert_eq!(a.live, 0);\n    assert_eq!(a.allocated, a.freed);\n    for (limit, expected) in [(paid, true), (paid - 1, false), (0, false)] {\n        let ((ok, a), refused, _, first) = run(limit);\n        assert_eq!(ok, expected);\n        assert_eq!(refused, !expected);\n        assert_eq!(first.is_some(), !expected);\n        assert!(!a.invalid && a.live == 0);\n        assert_eq!(a.allocated, a.freed);\n    }\n    let ((), refused, _, first) = with_limit_usage_refusal(usize::MAX, || {\n        let invoice = Invoice::acquire().unwrap();\n        let ((), inner_refused, paid, selected) = with_limit_usage_refusal(usize::MAX, || {\n            assert_eq!(\n                ordinary(c, &p[0].functions[0], &invoice),\n                Err(Failure::Foreign)\n            );\n        });\n        assert!(!inner_refused && selected.is_none());\n        assert_eq!(paid, 0);\n        assert_eq!(\n            ordinary(c, &p[0].functions[0], &invoice),\n            Err(Failure::Physical)\n        );\n        assert!(!reserve_active_required(0));\n    });\n    assert!(refused && first.is_some());\n}\n\n#[test]\nfn optional_cycle_walk_exhaustion_cannot_publish_a_partial_record_certificate() {\n    let p = programs();\n    let i = crate::workspace_graph::index_authored(&p).unwrap();\n    let c = context(&p, &i);\n    let invoice = Invoice::acquire().unwrap();\n    assert_eq!(\n        invoice.work(shared_local_callees::WORK + 1),\n        Err(Failure::Work)\n    );\n    assert_eq!(\n        ordinary(c, &p[0].functions[0], &invoice),\n        Err(Failure::Work)\n    );\n    let mut held = None;\n    shared_local_callees::modular_session::Session::observe(\n        &mut held,\n        c,\n        &p[0].functions[1],\n        &p[0].functions[0],\n        1,\n    )\n    .unwrap();\n    assert_eq!(\n        held.as_ref()\n            .unwrap()\n            .invoice\n            .work(shared_local_callees::WORK + 1),\n        Err(Failure::Work)\n    );\n    shared_local_callees::modular_session::Session::observe(\n        &mut held,\n        c,\n        &p[0].functions[1],\n        &p[0].functions[2],\n        0,\n    )\n    .unwrap();\n    assert_eq!(\n        shared_local_callees::modular_session::Session::checkpoint(&held),\n        0\n    );\n    shared_local_callees::modular_session::Session::rollback(&mut held, 1).unwrap();\n    assert_eq!(\n        shared_local_callees::modular_session::Session::finish(held, c)\n            .unwrap()\n            .slots,\n        0\n    );\n}\n\npub(in crate::workspace_graph::expected_projection) fn restore(\n    path: &str,\n    current: &str,\n) -> String {\n    let packet: serde_json::Value =\n        serde_json::from_str(include_str!(\"record_signature_inverse.json\")).unwrap();\n    let canonical = if path.starts_with(\"src/\") {\n        path.to_owned()\n    } else {\n        format!(\"src/workspace_graph/expected_projection/{path}\")\n    };\n    let Some(entry) = packet[\"entries\"].get(&canonical) else {\n        return current.to_owned();\n    };\n    let hash = |s: &str| {\n        format!(\n            \"{:x}\",\n            crate::digest_hex::LowerHex(Sha256::digest(s.as_bytes()))\n        )\n    };\n    assert_eq!(hash(current), entry[\"current_sha256\"].as_str().unwrap());\n    let mut raw = current.to_owned();\n    for splice in entry[\"splices\"].as_array().unwrap() {\n        let after = splice[\"current\"].as_str().unwrap();\n        assert_eq!(raw.matches(after).count(), 1);\n        raw = raw.replacen(after, splice[\"prior\"].as_str().unwrap(), 1);\n    }\n    assert_eq!(hash(&raw), entry[\"prior_sha256\"].as_str().unwrap());\n    raw\n}\n#[test]\nfn complete_immediate_old_session_census_and_executable_constructor_are_exact() {\n    for (path, raw, prior) in [\n        (\n            \"shared_local_callees/modular_session.rs\",\n            include_str!(\"modular_session.rs\"),\n            include_str!(\"record_session.before.txt\"),\n        ),\n        (\n            \"shared_local_callees/modular_census.rs\",\n            include_str!(\"modular_census.rs\"),\n            include_str!(\"record_census.before.txt\"),\n        ),\n    ] {\n        assert_eq!(restore(path, raw), prior);\n    }\n    let tail=\"\\n#[cfg(test)]\\n#[path = \\\"modular_tests.rs\\\"]\\npub(in crate::workspace_graph::expected_projection) mod tests;\\n\";\n    assert_eq!(\n        include_str!(\"record_before.rs\"),\n        include_str!(\"record_session.before.txt\")\n            .strip_suffix(tail)\n            .unwrap()\n    );\n}\n\n#[test]\nfn full_old_forecasters_remain_independent_and_all_nonidentity_terms_match() {\n    use crate::workspace_graph::expected_projection::{\n        before_shared_local_projection, cached_exact, dependency_identity_max,\n        HIR_IDENTITY_COPY_FACTOR,\n    };\n    let p = programs();\n    let i = crate::workspace_graph::index_authored(&p).unwrap();\n    let maximum = Some(dependency_identity_max(&p[0], &i, &p).unwrap());\n    let old_pair =\n        shared_local_callees::paired::estimates(&p[0], &i, &p, maximum, 6, true, None).unwrap();\n    let current_pair =\n        shared_local_callees::modular_pair::estimates(&p[0], &i, &p, maximum, 6, true, None)\n            .unwrap();\n    assert_eq!(HIR_IDENTITY_COPY_FACTOR, 16);\n    for (imports, old, current) in [\n        (true, old_pair.0, current_pair.0),\n        (false, old_pair.1, current_pair.1),\n    ] {\n        let baseline = before_shared_local_projection::synthetic_builder_bytes_scoped_with_retention_with_registry(\n            &p[0], &i, &p, maximum, imports, (6, cached_exact::Retention::Parsed), None,\n        ).unwrap();\n        for observed in [&old, &current] {\n            assert_eq!(observed.synthetic_ast, baseline.synthetic_ast);\n            assert_eq!(observed.runtime, baseline.runtime);\n            assert_eq!(\n                observed.transient_import_clone,\n                baseline.transient_import_clone\n            );\n        }\n        // Observe the whole old baseline and immediate predecessor; this\n        // reports the actual fee tradeoff and makes no unmeasured gain claim.\n        eprintln!(\n            \"local-record imports={imports} pre916={} immediateold={} current={}\",\n            baseline.retained_hir, old.retained_hir, current.retained_hir\n        );\n    }\n}\n","target_git_head":"648b0082a2ea29b3a58072abeb1720d72bf50954"},"src/workspace_graph/expected_projection/shared_local_callees/tests.rs":{"source_kind":"COMPLETE_PHYSICAL_SOURCE_TO_ENTIRE_PRE_903_INPUT_VIEW","current":{"length":9771,"sha256":"6bc21d00d4e682c890abfdeb056b0752b88f58723403e8f138ab49fd762504a5"},"target":{"length":9590,"sha256":"a3079d6e5f427d20801582413905630ac9106a189bce6d49af977cf8a2133099"},"edits":[{"start":8118,"end":8337,"after":"903 = crate::source_reflows::next_custody_before(\"constructor903\", \"src/workspace_graph/expected_projection/shared_local_callees/before_projection.rs\", include_str!(\"before_projection.rs\"));\n    let old = old903.as_str(","before":" = include_str!(\"before_projection.rs\""}],"before_text":"//! Complete immediate-old forecast and real shared-backing controls.\nuse super::super::{\n    before_shared_local_projection as before, cached_exact, dependency_identity_max,\n    held_projection,\n};\nuse super::*;\nuse crate::hir::{ResolvedExpr, ResolvedExprKind, ResolvedProgram};\nuse sha2::{Digest, Sha256};\n\n#[path = \"controls_tests.rs\"]\nmod controls;\n\nfn source(calls: usize) -> String {\n    let body = std::iter::repeat_n(\"helper(1)\", calls)\n        .collect::<Vec<_>>()\n        .join(\" + \");\n    format!(\"module shared.local; @id(\\\"shared.helper\\\") fn helper(x:i64)->i64{{x}} @id(\\\"shared.main\\\") fn main()->i64{{{body}}}\")\n}\n\n#[test]\nfn full_immediate_old_projection_keeps_all_modes_and_exact_new_invoice() {\n    for count in [1, 64] {\n        let source = source(count);\n        let programs = vec![crate::parse(&source, \"shared.spx\").unwrap()];\n        let authored = crate::workspace_graph::index_authored(&programs).unwrap();\n        let program = &programs[0];\n        let maximum = dependency_identity_max(program, &authored, &programs).unwrap();\n        let proof = costs(Context {\n            program,\n            authored: &authored,\n            programs: &programs,\n        })\n        .unwrap();\n        assert_eq!(proof.slots, count);\n        assert!(proof.bytes > 0);\n        for mode in 0..=7 {\n            for retention in [\n                cached_exact::Retention::Parsed,\n                cached_exact::Retention::Semantic,\n            ] {\n                for imports in [false, true] {\n                    let old = before::synthetic_builder_bytes_scoped_with_retention_with_registry(\n                        program,\n                        &authored,\n                        &programs,\n                        Some(maximum),\n                        imports,\n                        (mode, retention),\n                        None,\n                    )\n                    .unwrap();\n                    let now = held_projection::synthetic_builder_bytes_scoped_with_retention_with_registry(\n                        program, &authored, &programs, Some(maximum), imports, (mode, retention), None).unwrap();\n                    let (fee, removed) =\n                        if mode == 6 && retention == cached_exact::Retention::Parsed {\n                            (\n                                proof.bytes,\n                                proof.slots * maximum * super::super::HIR_IDENTITY_COPY_FACTOR,\n                            )\n                        } else {\n                            (0, 0)\n                        };\n                    assert_eq!(now.retained_hir + removed, old.retained_hir + fee);\n                    assert_eq!(\n                        now.retained_clone_and_hir + removed,\n                        old.retained_clone_and_hir + fee\n                    );\n                }\n            }\n        }\n    }\n}\n\nfn shared_calls(expression: &ResolvedExpr, program: &ResolvedProgram) -> usize {\n    let mut count = 0;\n    match &expression.kind {\n        ResolvedExprKind::Call {\n            callee,\n            type_arguments,\n            instance,\n            args,\n            ..\n        } => {\n            assert!(type_arguments.is_empty());\n            assert!(instance.is_none());\n            let declaration = program\n                .functions\n                .iter()\n                .find(|function| function.id == *callee)\n                .unwrap();\n            let held = program.declarations.function_id(&declaration.name).unwrap();\n            assert!(callee.shared_allocation_key().is_some());\n            assert_eq!(callee.shared_allocation_key(), held.shared_allocation_key());\n            assert_eq!(\n                callee.shared_allocation_key(),\n                declaration.id.shared_allocation_key()\n            );\n            assert_eq!(\n                callee.owned_allocation_bytes(),\n                held.owned_allocation_bytes()\n            );\n            count += 1;\n            for argument in args {\n                count += shared_calls(argument, program);\n            }\n        }\n        ResolvedExprKind::Block { statements, tail } => {\n            assert!(statements.is_empty());\n            count += shared_calls(tail, program);\n        }\n        ResolvedExprKind::Binary { left, right, .. } => {\n            count += shared_calls(left, program);\n            count += shared_calls(right, program);\n        }\n        ResolvedExprKind::Int(_) | ResolvedExprKind::Place(_) => {}\n        other => panic!(\"closed fixture added unowned HIR shape: {other:?}\"),\n    }\n    count\n}\n\n#[test]\nfn tiny_repeated_proof_and_whole_resolver_backing_are_measured_through_drop() {\n    for count in [1, 64] {\n        let source = source(count);\n        let programs = vec![crate::parse(&source, \"shared.spx\").unwrap()];\n        let authored = crate::workspace_graph::index_authored(&programs).unwrap();\n        let context = Context {\n            program: &programs[0],\n            authored: &authored,\n            programs: &programs,\n        };\n        // Budget harness setup precedes observation; the complete proof,\n        // captured ledger loan, header nodes and their Drop remain inside.\n        let ((proof, proof_alloc), refused, charged, first) =\n            crate::bounded_output::with_limit_usage_refusal(usize::MAX, || {\n                crate::test_allocation_observer::measure(|| costs(context).unwrap())\n            });\n        assert!(!refused);\n        assert!(first.is_none());\n        assert_eq!(proof.slots, count);\n        assert_eq!(proof.bytes, charged);\n        assert!(!proof_alloc.invalid);\n        assert_eq!(proof_alloc.live, 0);\n        assert_eq!(proof_alloc.allocated, proof_alloc.freed);\n        assert!(proof_alloc.highwater <= charged);\n        let checked = crate::check(&source, \"shared.spx\").unwrap();\n        let ((actual, after_resolve, after_validate), allocation) =\n            crate::test_allocation_observer::measure_with_capacity(1 << 16, || {\n                let resolved = crate::hir::resolve(&checked).unwrap();\n                let after_resolve = crate::test_allocation_observer::current_metrics();\n                crate::hir::validate(&resolve
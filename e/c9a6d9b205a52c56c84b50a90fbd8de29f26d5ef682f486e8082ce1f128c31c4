ojection/shared_local_callees/paired.rs":{"source_kind":"COMPLETE_PHYSICAL_SOURCE_TO_ENTIRE_PRE_903_INPUT_VIEW","current":{"length":8693,"sha256":"5303b15254477d9b5d3598326ebbb076dce7a76c609804bb1131534bc3641bea"},"target":{"length":8606,"sha256":"fe826f4e36cccd454d198513f640998934f963d136359d3063883cbb797d2c3d"},"edits":[{"start":6526,"end":6613,"after":"    retained: proof.retained,\n                    ..Default::default()\n                ","before":""}],"before_text":"//! Two bounded consumers of one invocation's immutable literal census.\n//! The finished certificate remains DATA; every handoff has its own lender fee.\nuse super::super::{call_carriers, held_projection, private_layout, SyntheticBuilderCosts};\nuse super::{Context, Costs, Failure, Index, Invoice, Program};\nuse crate::diagnostic::Diagnostic;\n\ntype ResultPair = Result<(call_carriers::Proof, Costs), Vec<Diagnostic>>;\n// Internal lender rejection must not format/debit a diagnostic in a foreign\n// current budget. Only the owning production boundary publishes diagnostics.\n#[derive(Debug)]\nenum ReadError {\n    Payment(Failure),\n    Census(Vec<Diagnostic>),\n}\ntype ReadResult = Result<(call_carriers::Proof, Costs), ReadError>;\n\npub(in crate::workspace_graph::expected_projection) struct Census<'p, 'a> {\n    context: Context<'p, 'a>,\n    invoice: Invoice,\n    cached: Option<(call_carriers::Proof, Costs)>,\n    used: u8,\n    reusable: bool,\n    failed: bool,\n}\n\ntype Entry<'p, 'a> = (\n    &'p Program,\n    &'p Program,\n    &'a Index<'a>,\n    &'a Index<'a>,\n    &'a [Program],\n    &'a [Program],\n    Option<usize>,\n    Option<usize>,\n    u8,\n    u8,\n    bool,\n    bool,\n    Option<&'p private_layout::registry::LayoutRegistry<'p>>,\n    Option<&'p private_layout::registry::LayoutRegistry<'p>>,\n    SyntheticBuilderCosts,\n    SyntheticBuilderCosts,\n    SyntheticBuilderCosts,\n    SyntheticBuilderCosts,\n    Result<(SyntheticBuilderCosts, SyntheticBuilderCosts), Vec<Diagnostic>>,\n    Result<(SyntheticBuilderCosts, SyntheticBuilderCosts), Vec<Diagnostic>>,\n);\ntype Acquire<'p, 'a> = (\n    ReadResult,\n    ReadResult,\n    ReadError,\n    ReadError,\n    Entry<'p, 'a>,\n    Census<'p, 'a>,\n    Census<'p, 'a>,\n    Context<'p, 'a>,\n    Context<'p, 'a>,\n    &'p Program,\n    &'p Program,\n    &'p Vec<crate::ast::ModuleUse>,\n    &'p Vec<crate::ast::ModuleUse>,\n    &'p Vec<crate::ast::InterfaceDeclaration>,\n    &'p Vec<crate::ast::InterfaceDeclaration>,\n    bool,\n    bool,\n    bool,\n    bool,\n    u8,\n    u8,\n    Option<(call_carriers::Proof, Costs)>,\n    Option<(call_carriers::Proof, Costs)>,\n    ResultPair,\n    ResultPair,\n    Result<Invoice, Failure>,\n    Result<Invoice, Failure>,\n);\n\ntype Read<'p, 'a> = (\n    ReadResult,\n    ReadResult,\n    ReadError,\n    ReadError,\n    Option<&'p mut Census<'p, 'a>>,\n    Option<&'p mut Census<'p, 'a>>,\n    &'p mut Census<'p, 'a>,\n    &'p mut Census<'p, 'a>,\n    Context<'p, 'a>,\n    Context<'p, 'a>,\n    &'p Program,\n    &'p Program,\n    &'p Program,\n    &'p Program,\n    &'p Index<'a>,\n    &'p Index<'a>,\n    &'p Index<'a>,\n    &'p Index<'a>,\n    &'p [Program],\n    &'p [Program],\n    &'p [Program],\n    &'p [Program],\n    &'p Invoice,\n    &'p Invoice,\n    &'p Option<(call_carriers::Proof, Costs)>,\n    &'p mut Option<(call_carriers::Proof, Costs)>,\n    &'p mut Option<(call_carriers::Proof, Costs)>,\n    Option<(call_carriers::Proof, Costs)>,\n    Option<(call_carriers::Proof, Costs)>,\n    bool,\n    bool,\n    bool,\n    bool,\n    &'p (call_carriers::Proof, Costs),\n    &'p (call_carriers::Proof, Costs),\n    (call_carriers::Proof, Costs),\n    (call_carriers::Proof, Costs),\n    &'p call_carriers::Proof,\n    &'p Costs,\n    call_carriers::Proof,\n    call_carriers::Proof,\n    Costs,\n    Costs,\n    bool,\n    bool,\n    bool,\n    bool,\n    bool,\n    bool,\n    u8,\n    u8,\n    u8,\n    usize,\n    usize,\n    usize,\n    Option<usize>,\n    Result<(), Failure>,\n    ResultPair,\n    ResultPair,\n);\n\nfn diagnostic(_: Failure) -> Vec<Diagnostic> {\n    vec![super::super::super::limit_error(\n        \"builder_bytes\",\n        super::super::super::active_builder_limit(),\n    )]\n}\n\nimpl<'p, 'a> Census<'p, 'a> {\n    fn acquire(\n        context: Context<'p, 'a>,\n        mode: u8,\n        first_imports: bool,\n    ) -> Result<Self, Vec<Diagnostic>> {\n        let invoice = Invoice::acquire_with::<Acquire<'p, 'a>>().map_err(diagnostic)?;\n        if mode != 6 || !first_imports {\n            return Err(diagnostic(Failure::Foreign));\n        }\n        // These are the ONLY source surfaces inspected by the lookup selector\n        // under include_imports. With both empty, true/false select the exact\n        // same directory, names walk, body and constructor loans. The bool's\n        // typed control width is equal; no arbitrary model equivalence is used.\n        let reusable =\n            context.program.module_uses.is_empty() && context.program.interfaces.is_empty();\n        Ok(Self {\n            context,\n            invoice,\n            cached: None,\n            used: 0,\n            reusable,\n            failed: false,\n        })\n    }\n\n    #[allow(\n        clippy::redundant_pattern_matching,\n        reason = \"direct discriminants preserve separately prepaid receiver boundaries\"\n    )]\n    fn read(&mut self, context: Context<'p, 'a>, imports: bool) -> ReadResult {\n        // The live Invoice checks the real current lender BEFORE either use.\n        // Its cumulative paid bytes remain in both conservative forecasts;\n        // retaining a scalar fee does not debit a second census in the ledger.\n        self.invoice\n            .pay::<Read<'_, '_>>()\n            .map_err(ReadError::Payment)?;\n        if !std::ptr::eq(self.context.program, context.program)\n            || !std::ptr::eq(self.context.authored, context.authored)\n            || !std::ptr::eq(self.context.programs, context.programs)\n            || self.failed\n            || !matches!((self.used, imports), (0, true) | (1, false))\n        {\n            return Err(ReadError::Payment(Failure::Foreign));\n        }\n        // Consume this phase before any fallible fallback. A failed read is\n        // never a token that may be replayed after restoring the old budget.\n        self.used += 1;\n        let fresh = if !self.reusable || matches!(self.cached, None) {\n            match call_carriers::count_joint(context, imports) {\n                Ok(fresh) => Some(fresh),\n                Err(error) => {\n                    self.failed = true;\n                    return Err(ReadError::Census(error));\n                }\n            }\n        } else {\n            None\n        };\n        let (proof, mut cost) = if self.reusable {\n            if let Some(fresh) = fresh {\n                self.cached = Some(fresh);\n            }\n            let Some((proof, cost)) = &self.cached else {\n                return Err(ReadError::Payment(Failure::Foreign));\n            };\n            (\n                call_carriers::Proof {\n                    roots: proof.roots,\n                    bytes: proof.bytes,\n                },\n                Costs {\n                    slots: cost.slots,\n                    bytes: cost.bytes,\n                },\n            )\n        } else {\n            match fresh {\n                Some(fresh) => fresh,\n                None => return Err(ReadError::Payment(Failure::Foreign)),\n            }\n        };\n        cost.bytes = cost\n            .bytes\n            .checked_add(self.invoice.bytes())\n            .ok_or(ReadError::Payment(Failure::Arithmetic))?;\n        Ok((proof, cost))\n    }\n}\n\npub(in crate::workspace_graph::expected_projection) fn read_or_count<'p, 'a>(\n    census: Option<&mut Census<'p, 'a>>,\n    context: Context<'p, 'a>,\n    imports: bool,\n) -> ResultPair {\n    match census {\n        Some(census) => census.read(context, imports).map_err(|error| match error {\n            ReadError::Payment(failure) => diagnostic(failure),\n            ReadError::Census(error) => error,\n        }),\n        None => call_carriers::count_joint(context, imports),\n    }\n}\n\npub(in crate::workspace_graph::expected_projection) fn estimates<'a>(\n    program: &Program,\n    authored: &'a Index<'a>,\n    programs: &'a [Program],\n    maximum: Option<usize>,\n    mode: u8,\n    first_imports: bool,\n    registry: Option<&private_layout::registry::LayoutRegistry<'_>>,\n) -> Result<(SyntheticBuilderCosts, SyntheticBuilderCosts), Vec<Diagnostic>> {\n    let context = Context {\n        program,\n        authored,\n        programs,\n    };\n    let mut census = Census::acquire(context, mode, first_imports)?;\n    let full = held_projection::paired_projection::estimate_with_census(\n        program,\n        authored,\n        programs,\n        maximum,\n        6,\n        true,\n        registry,\n        &mut census,\n    )?;\n    let retained = held_projection::paired_projection::estimate_with_census(\n        program,\n        authored,\n        programs,\n        maximum,\n        6,\n        false,\n        registry,\n        &mut census,\n    )?;\n    Ok((full, retained))\n}\n\n#[cfg(test)]\n#[path = \"paired_tests.rs\"]\npub(in crate::workspace_graph::expected_projection) mod tests;\n","target_git_head":"1b40398bf362eb02d4dfb2326b38eb001e757c65"},"src/workspace_graph/expected_projection/shared_local_callees/paired_projection.rs":{"source_kind":"COMPLETE_PHYSICAL_SOURCE_TO_ENTIRE_PRE_903_INPUT_VIEW","current":{"length":14812,"sha256":"3ed69281d636cc6ad65593b6e47319f48deb7cda1f325d738aec2497b649e4af"},"target":{"length":14766,"sha256":"a997eed41a794bb5d0e80db0703fd07c480cd40c06dc1f51b1124e023a82cbc2"},"edits":[{"start":14527,"end":14573,"after":"retained_scratch: call_data.retained,\n        ","before":""}],"before_text":"//! Uncached coupled census; the complete immediate-old estimate stays live.\n//! Only local-callee acquisition changes. Fixed/nominal/expression/writer and\n//! all sixteen identity copies retain their original independent equations.\nuse super::{\n    active_builder_limit, ast_function_contract_cost, ast_function_cost,\n    ast_function_identity_slots, ast_function_signature_cost, ast_program_cost,\n    ast_program_identity_slots, ast_type_declaration_cost, ast_type_declaration_identity_slots,\n    ast_type_identity_slots, cached_exact, call_identity, checked_builder_sum, checked_usage, cost,\n    generic_instance_source_cost, import_stub, limit_error, private_layout,\n    synthetic_main_runtime_cost, type_rewrite, AuthoredDeclaration, StructuralCost,\n    SyntheticBuilderCosts, HIR_IDENTITY_COPY_FACTOR, HIR_STRING_COPY_FACTOR,\n    HIR_STRUCTURE_EXPANSION_FACTOR,\n};\nuse crate::ast::{ModuleUseKind, Program};\nuse crate::diagnostic::Diagnostic;\nuse crate::{hir, prelude};\nuse std::collections::{BTreeMap, BTreeSet};\n\n#[allow(\n    clippy::too_many_arguments,\n    reason = \"complete original forecast inputs plus same-invocation census loan\"\n)]\npub(in crate::workspace_graph::expected_projection) fn estimate_with_census<'p, 'a>(\n    program: &'p Program,\n    authored: &'a BTreeMap<&'a str, AuthoredDeclaration<'a>>,\n    programs: &'a [Program],\n    maximum_identity: Option<usize>,\n    layout_mode: u8,\n    include_imports: bool,\n    registry: Option<&private_layout::registry::LayoutRegistry<'_>>,\n    census: &mut super::super::shared_local_callees::paired::Census<'p, 'a>,\n) -> Result<SyntheticBuilderCosts, Vec<Diagnostic>> {\n    if layout_mode != 6 {\n        return Err(vec![limit_error(\"builder_bytes\", active_builder_limit())]);\n    }\n    let core = None;\n    let retention = cached_exact::Retention::Parsed;\n    let mut raw = StructuralCost::raw_ast(layout_mode >= 1).with_inline_values(layout_mode >= 2);\n    ast_program_cost(program, &mut raw, include_imports)?;\n    let (call_data, shared_callees) = super::super::s
ve validator independently asserts this exact physical layout.\n#[doc(hidden)]\npub const VALIDATOR_FRAME_BYTES: usize = 248;\n\n/// Physical source verifier frame, shared without exposing its private module.\n#[doc(hidden)]\npub const SOURCE_VERIFIER_FRAME_BYTES: usize = crate::source_verify::VERIFIER_FRAME_BYTES;\n\n#[cfg(test)]\n#[path = \"hir/provisional_result_borrow_tests.rs\"]\nmod provisional_result_borrow_tests;\n\nmod function_reuse_source;\n","target_git_head":"1b40398bf362eb02d4dfb2326b38eb001e757c65"},"src/hir/function_directory.rs":{"source_kind":"COMPLETE_PHYSICAL_SOURCE_TO_ENTIRE_PRE_903_INPUT_VIEW","current":{"length":2465,"sha256":"7e41363cbf230c349abd49221930f53618f15a19e51d9fdaf70ce9452a648167"},"target":{"length":1455,"sha256":"6e1c3057fbddc6eeba06987b638330997a194475a34cd09e80ecaeea378d4d77"},"edits":[{"start":1455,"end":2465,"after":"\n/// Additional later-validation directory allowance for constructor-covered\n/// scalar functions. Actual caller allocation uses exactly these entry/carrier\n/// layouts, plus the receiving canonical-storage Rc even when its loan vectors\n/// have no backing. Permits/unknown functions keep their complete old forecast.\npub(crate) fn retained_scalar_directory_bound(functions: usize) -> Option<usize> {\n    if functions == 0 {\n        return Some(0);\n    }\n    let backing = functions.checked_mul(std::mem::size_of::<Entry<'_>>())?;\n    let carrier = std::alloc::Layout::new::<[usize; 2]>()\n        .extend(std::alloc::Layout::new::<Directory<'_>>())\n        .ok()?\n        .0\n        .pad_to_align()\n        .size();\n    let storage = std::alloc::Layout::new::<[usize; 2]>()\n        .extend(std::alloc::Layout::new::<\n            super::canonical_loan_storage::Storage<'_>,\n        >())\n        .ok()?\n        .0\n        .pad_to_align()\n        .size();\n    backing.checked_add(carrier)?.checked_add(storage)\n}\n","before":""}],"before_text":"//! Exact-program borrowed function lookup; construction is owned by the caller.\nuse super::{DeclarationId, ResolvedFunction, ResolvedProgram};\n\npub(super) struct Entry<'a> {\n    pub(super) ordinal: usize,\n    pub(super) function: &'a ResolvedFunction,\n}\npub(super) struct Directory<'a> {\n    program: &'a ResolvedProgram,\n    entries: Vec<Entry<'a>>,\n    permits: Vec<&'a str>,\n}\nimpl<'a> Directory<'a> {\n    pub(super) fn is_current(&self, program: &ResolvedProgram) -> bool {\n        std::ptr::eq(self.program, program)\n    }\n    #[cfg(test)]\n    pub(super) fn entries(&self) -> &[Entry<'a>] {\n        &self.entries\n    }\n    pub(super) fn permits(&self) -> &[&'a str] {\n        &self.permits\n    }\n    pub(super) fn member_is(&self, ordinal: usize, function: &ResolvedFunction) -> bool {\n        self.program\n            .functions\n            .get(ordinal)\n            .is_some_and(|current| std::ptr::eq(current, function))\n    }\n    pub(super) fn first(&self, id: &DeclarationId) -> Option<&Entry<'a>> {\n        let index = self\n            .entries\n            .partition_point(|entry| entry.function.id < *id);\n        self.entries.get(index).filter(|entry| {\n            entry.function.id == *id\n                && self\n                    .program\n                    .functions\n                    .get(entry.ordinal)\n                    .is_some_and(|current| std::ptr::eq(current, entry.function))\n        })\n    }\n}\n\npub(super) mod caller;\n","target_git_head":"1b40398bf362eb02d4dfb2326b38eb001e757c65"},"src/loan_plan/owned_capacity.rs":{"source_kind":"COMPLETE_PHYSICAL_SOURCE_TO_ENTIRE_PRE_903_INPUT_VIEW","current":{"length":7745,"sha256":"4c92a94a5837bb794e0e5023b058da68c6bf9bf5b7b17c95b2a16f39f5ca8399"},"target":{"length":7127,"sha256":"5d78a649a04bddd62467626af987716a8966b1ca4a7f51a7dbab5c773c644d25"},"edits":[{"start":225,"end":843,"after":"/// Independent qualification observes the existing complete CFG constructor.\n/// It never uses an attached LoanPlan as sizing or constructor authority.\n#[cfg(test)]\npub(crate) fn inspect_retention_cfg(\n    function: &crate::hir::ResolvedFunction,\n    mut visit: impl FnMut(&crate::hir::ResolvedExpr),\n) -> Result<(usize, usize), crate::diagnostic::Diagnostic> {\n    let mut work = super::WorkCounter::new(super::MAX_LOAN_PLAN_WORK_V1);\n    let cfg = super::build_cfg(function, &mut work)?;\n    for expression in &cfg.expressions {\n        visit(expression);\n    }\n    Ok((cfg.expressions.len(), cfg.points.len()))\n}\n\n","before":""}],"before_text":"//! Physical retained loan-proof capacities; byte equality never implies shared storage.\nuse super::{Loan, LoanEdge, LoanEndpoint, LoanId, LoanPlan, LoanProgramPoint};\nuse crate::hir::{ExpressionId, Place, PlaceProjection};\n\npub(super) fn owned_capacity_bytes(plan: &LoanPlan) -> Option<usize> {\n    owned_capacity_bytes_excluding(plan, &[])\n}\n\n/// Physical union with HIR backing already covered by the caller's retained\n/// HIR prebound. Keys must come from live authoritative HIR, never byte equality.\n/// Empty exclusions preserve the independent full-proof census used by caches.\npub(crate) fn owned_capacity_bytes_excluding(\n    plan: &LoanPlan,\n    covered_hir_keys: &[usize],\n) -> Option<usize> {\n    if covered_hir_keys.windows(2).any(|pair| pair[0] >= pair[1]) {\n        return None;\n    }\n    clone_capacity_bytes(plan)?.checked_add(shared_identity_bytes(plan, covered_hir_keys)?)\n}\n\n/// Final uncached retention reuses its charged candidate-key and state vectors.\n/// State 1 proves live HIR backing; state 0 must be charged independently. State\n/// 2 records a charged proof backing, never HIR sharing authority.\npub(crate) fn owned_capacity_bytes_partitioned(\n    plan: &LoanPlan,\n    candidate_keys: &[usize],\n    states: &mut [u8],\n) -> Option<usize> {\n    if candidate_keys.len() != states.len()\n        || candidate_keys.windows(2).any(|pair| pair[0] >= pair[1])\n        || states.iter().any(|state| *state > 1)\n    {\n        return None;\n    }\n    let mut shared_bytes = 0usize;\n    for identity in proof_identities(plan) {\n        let key = identity.shared_allocation_key()?;\n        let bytes = identity.shared_allocation_bytes()?;\n        let index = candidate_keys.binary_search(&key).ok()?;\n        if states[index] == 0 {\n            shared_bytes = shared_bytes.checked_add(bytes)?;\n            states[index] = 2;\n        }\n    }\n    clone_capacity_bytes(plan)?.checked_add(shared_bytes)\n}\n\n/// Capacity that can shrink on clone; immutable identity backing is charged separately.\npub(crate) fn clone_capacity_bytes(plan: &LoanPlan) -> Option<usize> {\n    fn add(total: &mut usize, bytes: usize) -> Option<()> {\n        *total = total.checked_add(bytes)?;\n        Some(())\n    }\n    fn place_bytes(place: &Place) -> Option<usize> {\n        let mut bytes = place.root.as_str().len();\n        add(\n            &mut bytes,\n            place\n                .projections\n                .capacity()\n                .checked_mul(std::mem::size_of::<PlaceProjection>())?,\n        )?;\n        for projection in &place.projections {\n            match projection {\n                PlaceProjection::Field(field) => add(&mut bytes, field.as_str().len())?,\n                PlaceProjection::VariantField { case, field } => {\n                    add(&mut bytes, case.as_str().len())?;\n                    add(&mut bytes, field.as_str().len())?;\n                }\n            }\n        }\n        Some(bytes)\n    }\n\n    let mut bytes = plan\n        .loans\n        .capacity()\n        .checked_mul(std::mem::size_of::<Loan>())?;\n    add(\n        &mut bytes,\n        plan.endpoints\n            .capacity()\n            .checked_mul(std::mem::size_of::<LoanEndpoint>())?,\n    )?;\n    add(\n        &mut bytes,\n        plan.edges\n            .capacity()\n            .checked_mul(std::mem::size_of::<LoanEdge>())?,\n    )?;\n    for loan in &plan.loans {\n        add(&mut bytes, place_bytes(&loan.origin)?)?;\n        add(\n            &mut bytes,\n            loan.ends\n                .capacity()\n                .checked_mul(std::mem::size_of::<LoanProgramPoint>())?,\n        )?;\n        add(\n            &mut bytes,\n            loan.end_edges\n                .capacity()\n                .checked_mul(std::mem::size_of::<u16>())?,\n        )?;\n    }\n    for endpoint in &plan.endpoints {\n        for ids in [\n            &endpoint.live_before,\n            &endpoint.starts,\n            &endpoint.kills,\n            &endpoint.live_after,\n        ] {\n            add(\n                &mut bytes,\n                ids.len().checked_mul(std::mem::size_of::<LoanId>())?,\n            )?;\n        }\n    }\n    for edge in &plan.edges {\n        add(\n            &mut bytes,\n            edge.live.len().checked_mul(std::mem::size_of::<LoanId>())?,\n        )?;\n    }\n    Some(bytes)\n}\n\n/// Count one backing allocation per pointer, including Arc headers and the\n/// moved String carrier. Separate allocations with equal bytes remain distinct.\n/// The temporary inventory is charged before allocation and is not refunded.\nfn shared_identity_bytes(plan: &LoanPlan, covered_hir_keys: &[usize]) -> Option<usize> {\n    crate::bounded_output::with_reservation_stage(\n        crate::bounded_output::ReservationStage::LoanIdentityInventory,\n        || shared_identity_inventory_bytes(plan, covered_hir_keys),\n    )\n}\n\nfn shared_identity_inventory_bytes(plan: &LoanPlan, covered_hir_keys: &[usize]) -> Option<usize> {\n    let mut count = 0usize;\n    // Validate every physical backing before allocating scratch. The caller\n    // already owns and charged its sorted HIR keys; covered references need\n    // neither a second physical debit nor an inventory entry here.\n    for identity in proof_identities(plan) {\n        let key = identity.shared_allocation_key()?;\n        identity.shared_allocation_bytes()?;\n        if covered_hir_keys.binary_search(&key).is_err() {\n            count = count.checked_add(1)?;\n        }\n    }\n    if count == 0 {\n        return Some(0);\n    }\n    let inventory_bytes = count.checked_mul(std::mem::size_of::<&ExpressionId>())?;\n    if !crate::bounded_output::reserve_active_required(inventory_bytes) {\n        return None;\n    }\n    let mut identities = Vec::with_capacity(count);\n    let excess = identities\n        .capacity()\n        .checked_sub(count)?\n        .checked_mul(std::mem::size_of::<&ExpressionId>())?;\n    if !crate::bounded_output::reserve_active_required(excess) {\n        return None;\n    }\n    for identity in proof_identities(plan) {\n        if covered_hir_keys\n            .binary_search(&identity.shared_allocation_key()?)\n            .is_err()\n        {\n            identities.push(identity);\n        }\n    }\n    debug_assert_eq!(identities.len(), count);\n    identities.sort_unstable_by_key(|identity| identity.shared_allocation_key());\n    let mut previous = None;\n    let mut bytes = 0usize;\n    for identity in identities {\n        let key = identity.shared_allocation_key()?;\n        if previous != Some(key) {\n            // Equal bytes in independent allocations still own separate bytes.\n            bytes = bytes.checked_add(identity.shared_allocation_bytes()?)?;\n            previous = Some(key);\n        }\n    }\n    Some(bytes)\n}\n\npub(crate) fn proof_identities(plan: &LoanPlan) -> impl Iterator<Item = &ExpressionId> {\n    plan.loans\n        .iter()\n        .flat_map(|loan| {\n            [&loan.site, &loan.start.expression]\n                .into_iter()\n                .chain(loan.ends.iter().map(|point| &point.expression))\n        })\n        .chain(\n            plan.endpoints\n                .iter()\n                .map(|endpoint| &endpoint.point.expression),\n        )\n}\n","target_git_head":"1b40398bf362eb02d4dfb2326b38eb001e757c65"},"src/workspace_graph/diagnostics.rs":{"source_kind":"COMPLETE_PHYSICAL_SOURCE_TO_ENTIRE_PRE_90
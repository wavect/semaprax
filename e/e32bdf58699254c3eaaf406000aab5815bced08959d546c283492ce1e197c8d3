allocation controls can measure it through Drop without the cache.\n#[cfg(test)]\npub(crate) fn owned_declarations_for_tests() -> Vec<TypeDeclaration> {\n    owned_declarations()\n}\n\n/// Independent reference: the complete original `OnceLock` initializer body,\n/// retained verbatim before the owning factory was extracted.\n#[cfg(test)]\n#[allow(\n    clippy::redundant_closure_call,\n    reason = \"complete original OnceLock initializer retained byte-exact as an independent receiving oracle\"\n)]\npub(crate) fn original_initializer_reference() -> Vec<TypeDeclaration> {\n    (|| {\n        vec![\n            option(),\n            result(),\n            owned_vec(),\n            owned_box(),\n            owned_iter(),\n            iter_step(),\n            immutable_list(),\n            list_step(),\n            crate::stdin_stream_ops::declaration(),\n            collections::declaration(false),\n            collections::declaration(true),\n        ]\n    })()\n}\n\npub(crate) fn declarations_for_program(program: &dyn ProgramSource) -> &'static [TypeDeclaration] {\n    if crate::map_ops::program_uses(program) {\n        declarations()\n    } else if crate::stdin_stream_ops::program_uses(program)\n        || crate::source_verify::program_uses_record_iterator(program)\n    {\n        &declarations()[..9]\n    } else if crate::list_ops::program_uses_list(program) {\n        &declarations()[..8]\n    } else if crate::iterator_ops::program_uses_iterator(program) {\n        &declarations()[..6]\n    } else if crate::box_ops::program_uses_owned_payload(program) || program_uses_box(program) {\n        &declarations()[..4]\n    } else if program_uses_vec(program) {\n        &declarations()[..3]\n    } else {\n        &declarations()[..2]\n    }\n}\n\npub(crate) fn is_reserved_type_name(name: &str) -> bool {\n    matches!(\n        name,\n        \"Option\"\n            | \"Result\"\n            | \"Vec\"\n            | \"Iter\"\n            | \"IterStep\"\n            | \"
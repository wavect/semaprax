ectory<'_, $N>);\n    bill!(proof; ([Header<'_>; $N], Header<'_>, Source<'_>, &Program, &Index<'_>, bool, usize, Option<usize>));\n    let mut directory = Directory {\n        rows: [Header::EMPTY; $N],\n        len: 0,\n        last: None,\n    };\n    bill!(proof; 2 * (&mut Directory<'_, $N>, &Program, bool, &mut Proof));\n    directory.populate($program, $imports, &mut proof);\n    bill!(proof; 2 * (&mut Directory<'_, $N>, &mut Proof));\n    directory.sort(&mut proof);\n    for function in &$program.functions {\n        proof.charge(&function);\n        // Generic owner bodies can be materialized repeatedly; no discount.\n        if !function.type_parameters.is_empty() {\n            continue;\n        }\n        let mut names = Names {\n            entries: [None; 128],\n            len: 0,\n        };\n        proof.charge(&names);\n        let mut complete = function.params.iter().all(|p| {\n            proof.charge(&p);\n            names.insert(&p.name, &mut proof)\n        });\n        for root in call_identity::roots(function) {\n            // Fixed walker scratch is retained for this complete pass, including\n            // failed proofs. Each visited formal/reference is charged too.\n            proof.bytes = proof\n                .bytes\n                .saturating_add(std::mem::size_of::<[Option<(&Expr, usize)>; 129]>());\n            complete &= call_identity::walk(root, &mut |expression| {\n                proof.charge(&expression);\n                match &expression.kind {\n                    ExprKind::Block { statements, .. } => statements.iter().all(|s| match s {\n                        Statement::Let { name, .. } | Statement::Assign { name, .. } => {\n                            names.insert(name, &mut proof)\n                        }\n                        Statement::For { item, .. } | Statement::ForOwn { item, .. } => {\n                            names.insert(item, &mut proof)\n                        }\n                        Statement::ForBorrow { item, index, .. } => {\n                            names.insert(item, &mut proof)\n                                && index\n                                    .as_ref()\n                                    .is_none_or(|i| names.insert(&i.name, &mut proof))\n                        }\n                        _ => true,\n                    }),\n                    ExprKind::Closure { params, .. } => params.iter().all(|p| {\n                        proof.charge(&p);\n                        names.insert(&p.name, &mut proof)\n                    }),\n                    ExprKind::Match { arms, .. } => arms\n                        .iter()\n                        .all(|a| names.pattern(&a.pattern, 0, &mut proof)),\n                    _ => true,\n                }\n            });\n        }\n        proof.charge(&complete);\n        if !complete {\n            continue;\n        }\n        let before = proof.roots;\n        proof.charge(&before);\n        for root in call_identity::roots(function) {\n            if !visit(\n                root,\n                false,\n                true,\n                0,\n                &names,\n                &mut directory,\n                $authored,\n                &mut proof,\n            ) {\n                proof.roots = before;\n                break;\n            }\n        }\n    }\n    proof\n    }};\n}\n\nfn indexed<const N: usize>(\n    program: &Program,\n    authored: &BTreeMap<&str, AuthoredDeclaration<'_>>,\n    imports: bool,\n    selector: usize,\n) -> Proof {\n    #[cfg(test)]\n    if crate::workspace_graph::expected_projection::call_carriers::before_scratch_selected() {\n        return before_scratch_body!(N, program, authored, imports, selector);\n    }\n    let mut proof = Proof {\n        roots: 0,\n        bytes: selector,\n        ..Default::default()\n    };\n    proof.charge(&(program, authored, imports));\n    proof.bytes = proof.bytes.saturating_add(std::mem::size_of::<Proof>());\n    // Full directory field/init/caller footprint is recorded before formation.\n    bill!(proof; 2 * Directory<'_, N>);\n    bill!(proof; ([Header<'_>; N], Header<'_>, Source<'_>, &Program, &Index<'_>, bool, usize, Option<usize>));\n    let mut directory = Directory {\n        rows: [Header::EMPTY; N],\n        len: 0,\n        last: None,\n    };\n    bill!(proof; 2 * (&mut Directory<'_, N>, &Program, bool, &mut Proof));\n    directory.populate(program, imports, &mut proof);\n    bill!(proof; 2 * (&mut Directory<'_, N>, &mut Proof));\n    directory.sort(&mut proof);\n    // The complete array/aggregate is constructed once in this invocation.\n    // Its immutable Program loans can outlive a function iteration; only the\n    // packed active prefix is read, so stale tail slots grant no name authority.\n    proof.bytes = proof.bytes.saturating_add(\n        std::mem::size_of::<Names<'_>>()\n            + std::mem::size_of::<&mut Proof>()\n            + std::mem::size_of::<&Names<'_>>(),\n    );\n    let mut names = Names {\n        entries: [None; 128],\n        len: 0,\n    };\n    for function in &program.functions {\n        proof.charge(&function);\n        // Generic owner bodies can be materialized repeatedly; no discount.\n        if !function.type_parameters.is_empty() {\n            continue;\n        }\n        // Reset scalar/actual-formal mutable and shared scope loans are paid\n        // before the first write. All existing per-node visit/insert/contains\n        // invoices remain complete; no old aggregate credit survives here.\n        proof.bytes = proof.bytes.saturating_add(std::mem::size_of::<(\n            [usize; 4],\n            [&mut Names<'_>; 2],\n            [&Names<'_>; 2],\n            [bool; 2],\n        )>());\n        names.len = 0;\n        let mut complete = function.params.iter().all(|p| {\n            proof.charge(&p);\n            names.insert(&p.name, &mut proof)\n        });\n        for root in call_identity::roots(function) {\n            // Fixed walker scratch is retained for this complete pass, including\n            // failed proofs. Each visited formal/reference is charged too.\n            proof.bytes = proof\n                .bytes\n                .saturating_add(std::mem::size_of::<[Option<(&Expr, usize)>; 129]>());\n            complete &= call_identity::walk(root, &mut |expression| {\n                proof.charge(&expression);\n                match &expression.kind {\n                    ExprKind::Block { statements, .. } => statements.iter().all(|s| match s {\n                        Statement::Let { name, .. } | Statement::Assign { name, .. } => {\n                            names.insert(name, &mut proof)\n                        }\n                        Statement::For { item, .. } | Statement::ForOwn { item, .. } => {\n                            names.insert(item, &mut proof)\n                        }\n                        Statement::ForBorrow { item, index, .. } => {\n                            names.insert(item, &mut proof)\n                                && index\n                                    .as_ref()\n                                    .is_none_or(|i| names.insert(&i.name, &mut proof))\n                        }\n                        _ => true,\n                    }),\n                    ExprKind::Closure { params, .. } => params.iter().all(|p| {\n                        proof.charge(&p);\n                        names.insert(&p.name, &mut proof)\n                    }),\n                    ExprKind::Match { arms, .. } => arms\n                        .iter()\n                        .all(|a| names.pattern(&a.pattern, 0, &mut proof)),\n                    _ => true,\n                }\n            });\n        }\n        proof.charge(&complete);\n        if !complete {\n            continue;\n        }\n        let before = proof.roots;\n        proof.charge(&before);\n        for root in call_identity::roots(function) {\n            if !visit(\n                root,\n                false,\n                true,\n                0,\n                &names,\n                &mut directory,\n                authored,\n                &mut proof,\n            ) {\n                proof.roots = before;\n                break;\n            }\n        }\n    }\n    proof\n}\n\n#[allow(clippy::too_many_arguments)]\nfn visit<const N: usize>(\n    expression: &Expr,\n    free: bool,\n    outside: bool,\n    depth: usize,\n    names: &Names<'_>,\n    directory: &mut Directory<'_, N>,\n    authored: &BTreeMap<&str, AuthoredDeclaration<'_>>,\n    proof: &mut Proof,\n) -> bool {\n    bill!(proof; &mut Directory<'_, N>);\n    proof.charge(&(\n        expression,\n        free,\n        outside,\n        depth,\n        names,\n        &mut *directory,\n        authored,\n    ));\n    if depth == 128 {\n        return false;\n    }\n    if let ExprKind::Call {\n        name,\n        type_arguments,\n        args,\n    } = &expression.kind\n    {\n        if free && outside && type_arguments.is_empty() && !names.contains(name, proof) && {\n            bill!(proof; 2 * (&mut Directory<'_, N>, &Index<'_>, &str, usize, &mut Proof, bool));\n            directory.target(authored, name, args.len(), proof)\n        } {\n            proof.roots = proof.roots.saturating_add(1);\n        }\n    }\n    let outside = outside && !matches!(expression.kind, ExprKind::Closure { .. });\n    let mut index = 0;\n    while let Some(child) = expression.child(index) {\n        let free = match &expression.kind {\n            ExprKind::Unary { .. }\n            | ExprKind::Binary { .. }\n            | ExprKind::If { .. }\n            | ExprKind::Call { .. } => true,\n            ExprKind::Block { tail, .. } => std::ptr::eq(child, tail.as_ref()),\n            _ => false,\n        };\n        proof.charge(&(index, child, free, outside));\n        if !visit(\n            child,\n            free,\n            outside,\n            depth + 1,\n            names,\n            directory,\n            authored,\n            proof,\n        ) {\n            return false;\n        }\n        index += 1;\n    }\n    let complete = true;\n    proof.charge(&complete);\n    complete\n}\n\n#[cfg(test)]\n#[derive(Clone, Copy, Debug, Default)]\nstruct Census {\n    builds: usize,\n    rows: usize,\n    sort_compares: usize,\n    swaps: usize,\n    queries: usize,\n    query_compares: usize,\n    last_hits: usize,\n}\n#[cfg(test)]\nenum Event {\n    Build,\n    Row,\n    SortCompare,\n    Swap,\n    Query,\n    QueryCompare,\n    LastHit,\n}\n#[cfg(test)]\nthread_local! { static CENSUS: std::cell::Cell<Census> = const { std::cell::Cell::new(Census { builds:0, rows:0, sort_compares:0, swaps:0, queries:0, query_compares:0, last_hits:0 }) }; }\n#[cfg(test)]\nfn note(event: Event) {\n    CENSUS.with(|cell| {\n        let mut value = cell.get();\n        let count = match event {\n            Event::Build => &mut value.builds,\n            Event::Row => &mut value.rows,\n            Event::SortCompare => &mut value.sort_compares,\n            Event::Swap => &mut value.swaps,\n            Event::Query => &mut value.queries,\n            Event::QueryCompare => &mut value.query_compares,\n            Event::LastHit => &mut value.last_hits,\n        };\n        *count = count\n            .checked_add(1)\n            .expect(\"bounded test event counter overflow\");\n        cell.set(value);\n    });\n}\n#[cfg(test)]\nfn take_census() -> Census {\n    CENSUS.with(|cell| cell.replace(Census::default()))\n}\n#[cfg(test)]\n#[path = \"call_carriers_directory_tests.rs\"]\nmod tests;\n\n#[path = \"call_carriers_directory/reused.rs\"]\nmod reused;\npub(super) use reused::count as count_joint;\n\n#[path = \"call_carriers_directory/modular.rs\"]\nmod modular;\npub(super) use modular::count as count_modular;\n\n#[cfg(test)]\npub(in crate::workspace_graph::expected_projection) use modular::indexed_loan as indexed_modular_loan;\n"}]},{"source":"src/workspace_graph/expected_projection/call_carriers_joint.rs","current":{"length":36913,"sha256":"6a09e4ccd3a02ed05ae4025f19bc6a54d14c3e47c8ffa702d33c6f531f50d562"},"before":{"length":28951,"sha256":"052aab52a22047138ce773f90da05a78f39ef638cc1cabf53395de2f9a1ac8c4"},"edits":[{"start":0,"end":36913,"after":"//! One source traversal, separate auxiliary and local-callee results.\nuse super::super::shared_local_callees::{Context, Costs, Failure, Session};\nuse super::{\n    call_identity, compiler_dispatch, AuthoredDeclaration, BTreeMap, Expr, ExprKind, ModuleUseKind,\n    Names, Program, Proof, Statement,\n};\nuse crate::ast::{Function, Type};\nuse std::mem::size_of;\ntype Error = Failure;\ntype Index<'a> = BTreeMap<&'a str, AuthoredDeclaration<'a>>;\n\npub(super) struct Loan<'a> {\n    pub(super) auxiliary: bool,\n    pub(super) local: Option<&'a Function>,\n}\nimpl Loan<'_> {\n    pub(super) const NONE: Self = Self {\n        auxiliary: false,\n        local: None,\n    };\n}\npub(super) trait Lookup<'p> {\n    fn target(\n        &mut self,\n        authored: &Index<'_>,\n        name: &str,\n        arity: usize,\n        proof: &mut Proof,\n    ) -> Loan<'p>;\n}\nstruct Linear<'p> {\n    program: &'p Program,\n    imports: bool,\n}\nimpl<'p> Lookup<'p> for Linear<'p> {\n    fn target(\n        &mut self,\n        authored: &Index<'_>,\n        name: &str,\n        arity: usize,\n        proof: &mut Proof,\n    ) -> Loan<'p> {\n        let program = self.program;\n        let imports = self.imports;\n        proof.charge(&(program, authored, imports, name, arity));\n        proof.bytes = proof\n            .bytes\n            .saturating_add(2 * size_of::<Loan<'_>>() + 2 * size_of::<&mut Self>());\n        if compiler_dispatch(name, proof) {\n            return Loan::NONE;\n        }\n        for interface in &program.interfaces {\n            proof.charge(&interface);\n            for import in &interface.imports {\n                proof.charge(&import);\n                if import.name == name {\n                    return Loan::NONE;\n                }\n            }\n        }\n        let mut found = None;\n        let mut ambiguous = false;\n        let mut local = None;\n        for function in &program.functions {\n            proof.charge(&function);\n            if function.name == name {\n                ambiguous |= found.is_some();\n                found = Some(function);\n                local = Some(function);\n            }\n        }\n        for item in program.module_uses.iter().filter(|_| imports) {\n            proof.charge(&item);\n            if item.alias != name {\n                continue;\n            }\n            // Any competing nonfunction alias also closes the proof.\n            if item.kind != ModuleUseKind::Function {\n                return Loan::NONE;\n            }\n            let Some(header) = authored.get(item.persistent_id.as_str()) else {\n                return Loan::NONE;\n            };\n            proof.charge(&header);\n            if header.module != item.target_module {\n                return Loan::NONE;\n            }\n            let Some(function) = header.function else {\n                return Loan::NONE;\n            };\n            proof.charge(&function);\n            if function.stable_id != item.persistent_id {\n                return Loan::NONE;\n            }\n            ambiguous |= found.is_some();\n            found = Some(function);\n            local = None;\n        }\n        proof.charge(&(found, ambiguous));\n        let admitted = !ambiguous\n            && found.is_some_and(|f| f.type_parameters.is_empty() && f.params.len() == arity);\n        proof.charge(&admitted);\n        Loan {\n            auxiliary: admitted,\n            local: if admitted { local } else { None },\n        }\n    }\n}\n\nfn plain(ty: &Type) -> bool {\n    matches!(\n        ty,\n        Type::I64\n            | Type::I32\n            | Type::U8\n            | Type::Usize\n            | Type::Char\n            | Type::F32\n            | Type::F64\n            | Type::Bool\n            | Type::String\n            | Type::Bytes\n            | Type::Str\n            | Type::SliceU8\n    )\n}\nfn ordinary_data(function: &Function, proof: &mut Proof) -> bool {\n    proof.charge(&(function, &function.params, &function.return_type));\n    function.explicit_id\n        && function.type_parameters.is_empty()\n        && function.yields.is_none()\n        && function.follows.is_none()\n        && plain(&function.return_type)\n        && function.params.iter().all(|p| {\n            proof.charge(&p);\n            plain(&p.ty)\n        })\n}\nfn supported(expression: &Expr, proof: &mut Proof) -> bool {\n    proof.charge(&(expression, &expression.kind));\n    // Reuse the existing constructor/statement match. No second child walk or\n    // statement iterator is formed for retention. The extra predicate value\n    // is accounted independently of the old classifier's returned boolean.\n    proof.bytes = proof.bytes.saturating_add(2 * size_of::<bool>());\n    if !matches!(\n        expression.kind,\n        ExprKind::Call { .. }\n            | ExprKind::If { .. }\n            | ExprKind::Unary { .. }\n            | ExprKind::Binary { .. }\n            | ExprKind::Var(_)\n            | ExprKind::Int(_)\n            | ExprKind::Int32(_)\n            | ExprKind::Uint8(_)\n            | ExprKind::Usize(_)\n            | ExprKind::Char(_)\n            | ExprKind::Float32(_)\n            | ExprKind::Float64(_)\n            | ExprKind::Bool(_)\n            | ExprKind::Block { .. }\n    ) {\n        proof.retention_closed = false;\n    }\n    match &expression.kind {\n        ExprKind::Call { .. }\n        | ExprKind::If { .. }\n        | ExprKind::Unary { .. }\n        | ExprKind::Binary { .. }\n        | ExprKind::Var(_)\n        | ExprKind::Int(_)\n        | ExprKind::Int32(_)\n        | ExprKind::Uint8(_)\n        | ExprKind::Usize(_)\n        | ExprKind::Char(_)\n        | ExprKind::Float32(_)\n        | ExprKind::Float64(_)\n        | ExprKind::Bool(_)\n        | ExprKind::String(_)\n        | ExprKind::BorrowedUtf8Literal(_)\n        | ExprKind::ArrayU8(_)\n        | ExprKind::RepeatArrayU8 { .. } => true,\n        ExprKind::Block { statements, .. } => statements.iter().all(|s| {\n            proof.charge(&s);\n            match s {\n                Statement::Let { declared, .. } => {\n                    // The original Option callback now carries this one lender;\n                    // its original type loan and plain-result control survive.\n                    proof.bytes = proof\n                        .bytes\n                        .saturating_add(size_of::<&mut Proof>() + 2 * size_of::<bool>());\n                    declared.as_ref().is_none_or(|ty| {\n                        proof.retention_closed &= matches!(\n                            ty,\n                            Type::I64\n                                | Type::I32\n                                | Type::U8\n                                | Type::Usize\n                                | Type::Char\n                                | Type::F32\n                                | Type::F64\n                                | Type::Bool\n                        );\n                        plain(ty)\n                    })\n                }\n                Statement::Assign { field: None, .. } | Statement::While { .. } => true,\n                _ => {\n                    proof.retention_closed = false;\n                    false\n                }\n            }\n        }),\n        _ => false,\n    }\n}\n\npub(in crate::workspace_graph::expected_projection) fn count(\n    context: Context<'_, '_>,\n    imports: bool,\n) -> Result<(Proof, Costs), Vec<crate::diagnostic::Diagnostic>> {\n    // The directory owns its original selector and selected capacity. Its\n    // coupled entry will invoke the same visitor below on that already-built DATA.\n    super::directory::count_joint(context, imports).map_err(|_| {\n        vec![super::super::super::limit_error(\n            \"builder_bytes\",\n            super::super::super::active_builder_limit(),\n        )]\n    })\n}\n\npub(super) fn linear(\n    context: Context<'_, '_>,\n    imports: bool,\n    selector: usize,\n) -> Result<(Proof, Costs), Error> {\n    let mut lookup = Linear {\n        program: context.program,\n        imports,\n    };\n    let proof = Proof {\n        roots: 0,\n        bytes: selector,\n        ..Default::default()\n    };\n    count_with_lookup(context, imports, proof, &mut lookup)\n}\n\n#[cfg(test)]\nmacro_rules! before_scratch_body {\n    ($context:ident, $imports:ident, $proof:ident, $lookup:ident) => {{\n        let program = $context.program;\n        $proof.charge(&(program, $context.authored, $imports));\n        $proof.bytes = $proof.bytes.saturating_add(size_of::<Proof>());\n        $proof.charge(&($context, &mut *$lookup, Option::<Session<'_, '_>>::None));\n        let mut session = None;\n        for function in &program.functions {\n            $proof.charge(&function);\n            if !function.type_parameters.is_empty() {\n                continue;\n            }\n            let mut names = Names {\n                entries: [None; 128],\n                len: 0,\n            };\n            $proof.charge(&names);\n            $proof.current_retained = 0;\n            $proof.retention_closed = match function.yields {\n                Some(_) => false,\n                None => match function.follows {\n                    Some(_) => false,\n                    None => matches!(\n                        function.return_type,\n                        Type::I64\n                            | Type::I32\n                            | Type::U8\n                            | Type::Usize\n                            | Type::Char\n                            | Type::F32\n                            | Type::F64\n                            | Type::Bool\n                    ),\n                },\n            };\n            $proof.charge(&($proof.current_retained, $proof.retention_closed));\n            let mut complete = function.params.iter().all(|p| {\n                $proof.charge(&p);\n                let scalar = matches!(p.mode, crate::ast::ParamMode::Value)\n                    && matches!(\n                        p.ty,\n                        Type::I64\n                            | Type::I32\n                            | Type::U8\n                            | Type::Usize\n                            | Type::Char\n                            | Type::F32\n                            | Type::F64\n                            | Type::Bool\n                    );\n                $proof.charge(&scalar);\n                $proof.retention_closed &= scalar;\n                names.insert(&p.name, &mut $proof)\n            });\n            for root in call_identity::roots(function) {\n                $proof.bytes = $proof\n                    .bytes\n                    .saturating_add(size_of::<[Option<(&Expr, usize)>; 129]>());\n                complete &= call_identity::walk(root, &mut |expression| {\n                    $proof.charge(&expression);\n                    match &expression.kind {\n                        ExprKind::Block { statements, .. } => statements.iter().all(|s| match s {\n                            Statement::Let { name, .. } | Statement::Assign { name, .. } => {\n                                names.insert(name, &mut $proof)\n                            }\n                            Statement::For { item, .. } | Statement::ForOwn { item, .. } => {\n                                names.insert(item, &mut $proof)\n                            }\n                            Statement::ForBorrow { item, index, .. } => {\n                                names.insert(item, &mut $proof)\n                                    && index\n                                        .as_ref()\n                                        .is_none_or(|i| names.insert(&i.name, &mut $proof))\n                            }\n                            _ => true,\n                        }),\n                        ExprKind::Closure { params, .. } => params.iter().all(|p| {\n                            $proof.charge(&p);\n                            names.insert(&p.name, &mut $proof)\n                        }),\n                        ExprKind::Match { arms, .. } => arms\n                            .iter()\n                            .all(|a| names.pattern(&a.pattern, 0, &mut $proof)),\n                        _ => true,\n                    }\n                });\n            }\n            $proof.charge(&complete);\n            if !complete {\n                continue;\n            }\n            let before = $proof.roots;\n            let callee_before = Session::checkpoint(&session);\n            let body_allowed = Session::eligible(program) && ordinary_data(function, &mut $proof);\n            let mut body_complete = true;\n            $proof.charge(&(before, callee_before, body_allowed, body_complete));\n            for root in call_identity::roots(function) {\n                if !visit(\n                    root,\n                    false,\n                    true,\n                    0,\n                    &names,\n                    $lookup,\n                    $context,\n                    function,\n                    body_allowed && std::ptr::eq(root, &function.body),\n                    &mut body_complete,\n                    &mut session,\n                    &mut $proof,\n                )? {\n                    $proof.roots = before;\n                    body_complete = false;\n                    $proof.retention_closed = false;\n                    break;\n                }\n            }\n            // No partial function can authorize an exclusion. Generic functions\n            // were rejected be
n        }\n        let mut found = None;\n        let mut ambiguous = false;\n        let mut local = None;\n        for function in &program.functions {\n            proof.charge(&function);\n            if function.name == name {\n                ambiguous |= found.is_some();\n                found = Some(function);\n                local = Some(function);\n            }\n        }\n        for item in program.module_uses.iter().filter(|_| imports) {\n            proof.charge(&item);\n            if item.alias != name {\n                continue;\n            }\n            // Any competing nonfunction alias also closes the proof.\n            if item.kind != ModuleUseKind::Function {\n                return Loan::NONE;\n            }\n            let Some(header) = authored.get(item.persistent_id.as_str()) else {\n                return Loan::NONE;\n            };\n            proof.charge(&header);\n            if header.module != item.target_module {\n                return Loan::NONE;\n            }\n            let Some(function) = header.function else {\n                return Loan::NONE;\n            };\n            proof.charge(&function);\n            if function.stable_id != item.persistent_id {\n                return Loan::NONE;\n            }\n            ambiguous |= found.is_some();\n            found = Some(function);\n            local = None;\n        }\n        proof.charge(&(found, ambiguous));\n        let admitted = !ambiguous\n            && found.is_some_and(|f| f.type_parameters.is_empty() && f.params.len() == arity);\n        proof.charge(&admitted);\n        Loan {\n            auxiliary: admitted,\n            local: if admitted { local } else { None },\n        }\n    }\n}\n\nfn plain(ty: &Type) -> bool {\n    matches!(\n        ty,\n        Type::I64\n            | Type::I32\n            | Type::U8\n            | Type::Usize\n            | Type::Char\n            | Type::F32\n            | Type::F64\n            | Type::Bool\n            | Type::String\n            | Type::Bytes\n            | Type::Str\n            | Type::SliceU8\n    )\n}\nfn ordinary_data(function: &Function, proof: &mut Proof) -> bool {\n    proof.charge(&(function, &function.params, &function.return_type));\n    function.explicit_id\n        && function.type_parameters.is_empty()\n        && function.yields.is_none()\n        && function.follows.is_none()\n        && plain(&function.return_type)\n        && function.params.iter().all(|p| {\n            proof.charge(&p);\n            plain(&p.ty)\n        })\n}\nfn supported(expression: &Expr, proof: &mut Proof) -> bool {\n    proof.charge(&(expression, &expression.kind));\n    // Reuse the existing constructor/statement match. No second child walk or\n    // statement iterator is formed for retention. The extra predicate value\n    // is accounted independently of the old classifier's returned boolean.\n    proof.bytes = proof.bytes.saturating_add(2 * size_of::<bool>());\n    if !matches!(\n        expression.kind,\n        ExprKind::Call { .. }\n            | ExprKind::If { .. }\n            | ExprKind::Unary { .. }\n            | ExprKind::Binary { .. }\n            | ExprKind::Var(_)\n            | ExprKind::Int(_)\n            | ExprKind::Int32(_)\n            | ExprKind::Uint8(_)\n            | ExprKind::Usize(_)\n            | ExprKind::Char(_)\n            | ExprKind::Float32(_)\n            | ExprKind::Float64(_)\n            | ExprKind::Bool(_)\n            | ExprKind::Block { .. }\n    ) {\n        proof.retention_closed = false;\n    }\n    match &expression.kind {\n        ExprKind::Call { .. }\n        | ExprKind::If { .. }\n        | ExprKind::Unary { .. }\n        | ExprKind::Binary { .. }\n        | ExprKind::Var(_)\n        | ExprKind::Int(_)\n        | ExprKind::Int32(_)\n        | ExprKind::Uint8(_)\n        | ExprKind::Usize(_)\n        | ExprKind::Char(_)\n        | ExprKind::Float32(_)\n        | ExprKind::Float64(_)\n        | ExprKind::Bool(_)\n        | ExprKind::String(_)\n        | ExprKind::BorrowedUtf8Literal(_)\n        | ExprKind::ArrayU8(_)\n        | ExprKind::RepeatArrayU8 { .. } => true,\n        ExprKind::Block { statements, .. } => statements.iter().all(|s| {\n            proof.charge(&s);\n            match s {\n                Statement::Let { declared, .. } => {\n                    // The original Option callback now carries this one lender;\n                    // its original type loan and plain-result control survive.\n                    proof.bytes = proof\n                        .bytes\n                        .saturating_add(size_of::<&mut Proof>() + 2 * size_of::<bool>());\n                    declared.as_ref().is_none_or(|ty| {\n                        proof.retention_closed &= matches!(\n                            ty,\n                            Type::I64\n                                | Type::I32\n                                | Type::U8\n                                | Type::Usize\n                                | Type::Char\n                                | Type::F32\n                                | Type::F64\n                                | Type::Bool\n                        );\n                        plain(ty)\n                    })\n                }\n                Statement::Assign { field: None, .. } | Statement::While { .. } => true,\n                _ => {\n                    proof.retention_closed = false;\n                    false\n                }\n            }\n        }),\n        _ => false,\n    }\n}\n\npub(in crate::workspace_graph::expected_projection) fn count(\n    context: Context<'_, '_>,\n    imports: bool,\n) -> Result<(Proof, Costs), Vec<crate::diagnostic::Diagnostic>> {\n    // The directory owns its original selector and selected capacity. Its\n    // coupled entry will invoke the same visitor below on that already-built DATA.\n    super::directory::count_joint(context, imports).map_err(|_| {\n        vec![super::super::super::limit_error(\n            \"builder_bytes\",\n            super::super::super::active_builder_limit(),\n        )]\n    })\n}\n\npub(super) fn linear(\n    context: Context<'_, '_>,\n    imports: bool,\n    selector: usize,\n) -> Result<(Proof, Costs), Error> {\n    let mut lookup = Linear {\n        program: context.program,\n        imports,\n    };\n    let proof = Proof {\n        roots: 0,\n        bytes: selector,\n        ..Default::default()\n    };\n    count_with_lookup(context, imports, proof, &mut lookup)\n}\n\n#[cfg(test)]\nmacro_rules! before_scratch_body {\n    ($context:ident, $imports:ident, $proof:ident, $lookup:ident) => {{\n        let program = $context.program;\n        $proof.charge(&(program, $context.authored, $imports));\n        $proof.bytes = $proof.bytes.saturating_add(size_of::<Proof>());\n        $proof.charge(&($context, &mut *$lookup, Option::<Session<'_, '_>>::None));\n        let mut session = None;\n        for function in &program.functions {\n            $proof.charge(&function);\n            if !function.type_parameters.is_empty() {\n                continue;\n            }\n            let mut names = Names {\n                entries: [None; 128],\n                len: 0,\n            };\n            $proof.charge(&names);\n            $proof.current_retained = 0;\n            $proof.retention_closed = match function.yields {\n                Some(_) => false,\n                None => match function.follows {\n                    Some(_) => false,\n                    None => matches!(\n                        function.return_type,\n                        Type::I64\n                            | Type::I32\n                            | Type::U8\n                            | Type::Usize\n                            | Type::Char\n                            | Type::F32\n                            | Type::F64\n                            | Type::Bool\n                    ),\n                },\n            };\n            $proof.charge(&($proof.current_retained, $proof.retention_closed));\n            let mut complete = function.params.iter().all(|p| {\n                $proof.charge(&p);\n                let scalar = matches!(p.mode, crate::ast::ParamMode::Value)\n                    && matches!(\n                        p.ty,\n                        Type::I64\n                            | Type::I32\n                            | Type::U8\n                            | Type::Usize\n                            | Type::Char\n                            | Type::F32\n                            | Type::F64\n                            | Type::Bool\n                    );\n                $proof.charge(&scalar);\n                $proof.retention_closed &= scalar;\n                names.insert(&p.name, &mut $proof)\n            });\n            for root in call_identity::roots(function) {\n                $proof.bytes = $proof\n                    .bytes\n                    .saturating_add(size_of::<[Option<(&Expr, usize)>; 129]>());\n                complete &= call_identity::walk(root, &mut |expression| {\n                    $proof.charge(&expression);\n                    match &expression.kind {\n                        ExprKind::Block { statements, .. } => statements.iter().all(|s| match s {\n                            Statement::Let { name, .. } | Statement::Assign { name, .. } => {\n                                names.insert(name, &mut $proof)\n                            }\n                            Statement::For { item, .. } | Statement::ForOwn { item, .. } => {\n                                names.insert(item, &mut $proof)\n                            }\n                            Statement::ForBorrow { item, index, .. } => {\n                                names.insert(item, &mut $proof)\n                                    && index\n                                        .as_ref()\n                                        .is_none_or(|i| names.insert(&i.name, &mut $proof))\n                            }\n                            _ => true,\n                        }),\n                        ExprKind::Closure { params, .. } => params.iter().all(|p| {\n                            $proof.charge(&p);\n                            names.insert(&p.name, &mut $proof)\n                        }),\n                        ExprKind::Match { arms, .. } => arms\n                            .iter()\n                            .all(|a| names.pattern(&a.pattern, 0, &mut $proof)),\n                        _ => true,\n                    }\n                });\n            }\n            $proof.charge(&complete);\n            if !complete {\n                continue;\n            }\n            let before = $proof.roots;\n            let callee_before = Session::checkpoint(&session);\n            let body_allowed = Session::eligible(program) && ordinary_data(function, &mut $proof);\n            let mut body_complete = true;\n            $proof.charge(&(before, callee_before, body_allowed, body_complete));\n            for root in call_identity::roots(function) {\n                if !visit(\n                    root,\n                    false,\n                    true,\n                    0,\n                    &names,\n                    $lookup,\n                    $context,\n                    function,\n                    body_allowed && std::ptr::eq(root, &function.body),\n                    &mut body_complete,\n                    &mut session,\n                    &mut $proof,\n                )? {\n                    $proof.roots = before;\n                    body_complete = false;\n                    $proof.retention_closed = false;\n                    break;\n                }\n            }\n            // No partial function can authorize an exclusion. Generic functions\n            // were rejected before this existing traversal; runtime trees never enter.\n            if $proof.retention_closed {\n                // Prepay the physical u16 source plus widening result/local before\n                // forming them. Aggregate Counts and MAX remain full usize values.\n                $proof.bytes = $proof\n                    .bytes\n                    .saturating_add(size_of::<(u16, usize, usize)>());\n                let completed = $proof.current_retained as usize;\n                $proof.charge(&($proof.current_retained, $proof.retained));\n                // Two checked aggregate additions (actual/formal operands and\n                // returned/receiving Options), plus the MAX operand/result bank.\n                $proof.bytes = $proof.bytes.saturating_add(size_of::<(\n                    [usize; 12],\n                    [Option<usize>; 4],\n                    [bool; 4],\n                )>());\n                $proof.retained.expressions = $proof\n                    .retained\n                    .expressions\n                    .checked_add(completed)\n                    .ok_or(Error::Arithmetic)?;\n                $proof.retained.maximum_function = $proof.retained.maximum_function.max(completed);\n                $proof.retained.functions = $proof\n                    .retained\n                    .functions\n                    .checked_add(1)\n                    .ok_or(Error::Arithmetic)?;\n            }\n            if !body_complete {\n                Session::rollback(&mut session, callee_before)?;\n            }\n        }\n        let costs = Session::finish(session, $context)?;\n        Ok(($proof, costs))\n    }};\n}\n\npub(super) fn count_with_lookup<'p, 'a, L: Lookup<'p>>(\n    context: Context<'p, 'a>,\n    imports: bool,\n    mut proof: Proof,\n    lookup: &mut L,\n) -> Result<(Proof, Costs), Error> {\n    #[cfg(test)]\n    if crate::workspace_graph::expected_projection::call_carriers::before_scratch_selected() {\n        return before_scratch_body!(context, imports, proof, lookup);\n    }\n    let program = context.program;\n    proof.charge(&(program, context.authored, imports));\n    proof.bytes = proof.bytes.saturating_add(size_of::<Proof>());\n    proof.charge(&(context, &mut *lookup, Option::<Session<'_, '_>>::None));\n    let mut session = None;\n    // The complete array/aggregate is constructed once in this invocation.\n    // Its immutable Program loans can outlive a function iteration; only the\n    // packed active prefix is read, so stale tail slots grant no name authority.\n    proof.bytes = proof.bytes.saturating_add(\n        std::mem::size_of::<Names<'_>>()\n            + std::mem::size_of::<&mut Proof>()\n            + std::mem::size_of::<&Names<'_>>(),\n    );\n    let mut names = Names {\n        entries: [None; 128],\n        len: 0,\n    };\n    for function in &program.functions {\n        proof.charge(&function);\n        if !function.type_parameters.is_empty() {\n            continue;\n        }\n        // Reset scalar/actual-formal mutable and shared scope loans are paid\n        // before the first write. All existing per-node visit/insert/contains\n        // invoices remain complete; no old aggregate credit survives here.\n        proof.bytes = proof.bytes.saturating_add(std::mem::size_of::<(\n            [usize; 4],\n            [&mut Names<'_>; 2],\n            [&Names<'_>; 2],\n            [bool; 2],\n        )>());\n        names.len = 0;\n        proof.current_retained = 0;\n        proof.retention_closed = match function.yields {\n            Some(_) => false,\n            None => match function.follows {\n                Some(_) => false,\n                None => matches!(\n                    function.return_type,\n                    Type::I64\n                        | Type::I32\n                        | Type::U8\n                        | Type::Usize\n                        | Type::Char\n                        | Type::F32\n                        | Type::F64\n                        | Type::Bool\n                ),\n            },\n        };\n        proof.charge(&(proof.current_retained, proof.retention_closed));\n        let mut complete = function.params.iter().all(|p| {\n            proof.charge(&p);\n            let scalar = matches!(p.mode, crate::ast::ParamMode::Value)\n                && matches!(\n                    p.ty,\n                    Type::I64\n                        | Type::I32\n                        | Type::U8\n                        | Type::Usize\n                        | Type::Char\n                        | Type::F32\n                        | Type::F64\n                        | Type::Bool\n                );\n            proof.charge(&scalar);\n            proof.retention_closed &= scalar;\n            names.insert(&p.name, &mut proof)\n        });\n        for root in call_identity::roots(function) {\n            proof.bytes = proof\n                .bytes\n                .saturating_add(size_of::<[Option<(&Expr, usize)>; 129]>());\n            complete &= call_identity::walk(root, &mut |expression| {\n                proof.charge(&expression);\n                match &expression.kind {\n                    ExprKind::Block { statements, .. } => statements.iter().all(|s| match s {\n                        Statement::Let { name, .. } | Statement::Assign { name, .. } => {\n                            names.insert(name, &mut proof)\n                        }\n                        Statement::For { item, .. } | Statement::ForOwn { item, .. } => {\n                            names.insert(item, &mut proof)\n                        }\n                        Statement::ForBorrow { item, index, .. } => {\n                            names.insert(item, &mut proof)\n                                && index\n                                    .as_ref()\n                                    .is_none_or(|i| names.insert(&i.name, &mut proof))\n                        }\n                        _ => true,\n                    }),\n                    ExprKind::Closure { params, .. } => params.iter().all(|p| {\n                        proof.charge(&p);\n                        names.insert(&p.name, &mut proof)\n                    }),\n                    ExprKind::Match { arms, .. } => arms\n                        .iter()\n                        .all(|a| names.pattern(&a.pattern, 0, &mut proof)),\n                    _ => true,\n                }\n            });\n        }\n        proof.charge(&complete);\n        if !complete {\n            continue;\n        }\n        let before = proof.roots;\n        let callee_before = Session::checkpoint(&session);\n        let body_allowed = Session::eligible(program) && ordinary_data(function, &mut proof);\n        let mut body_complete = true;\n        proof.charge(&(before, callee_before, body_allowed, body_complete));\n        for root in call_identity::roots(function) {\n            if !visit(\n                root,\n                false,\n                true,\n                0,\n                &names,\n                lookup,\n                context,\n                function,\n                body_allowed && std::ptr::eq(root, &function.body),\n                &mut body_complete,\n                &mut session,\n                &mut proof,\n            )? {\n                proof.roots = before;\n                body_complete = false;\n                proof.retention_closed = false;\n                break;\n            }\n        }\n        // No partial function can authorize an exclusion. Generic functions\n        // were rejected before this existing traversal; runtime trees never enter.\n        if proof.retention_closed {\n            // Prepay the physical u16 source plus widening result/local before\n            // forming them. Aggregate Counts and MAX remain full usize values.\n            proof.bytes = proof.bytes.saturating_add(size_of::<(u16, usize, usize)>());\n            let completed = proof.current_retained as usize;\n            proof.charge(&(proof.current_retained, proof.retained));\n            // Two checked aggregate additions (actual/formal operands and\n            // returned/receiving Options), plus the MAX operand/result bank.\n            proof.bytes =\n                proof\n                    .bytes\n                    .saturating_add(size_of::<([usize; 12], [Option<usize>; 4], [bool; 4])>());\n            proof.retained.expressions = proof\n                .retained\n                .expressions\n                .checked_add(completed)\n                .ok_or(Error::Arithmetic)?;\n            proof.retained.maximum_function = proof.retained.maximum_function.max(completed);\n            proof.retained.functions = proof\n                .retained\n                .functions\n                .checked_add(1)\n                .ok_or(Error::Arithmetic)?;\n        }\n        if !body_complete {\n            Session::rollback(&mut session, callee_before)?;\n        }\n    }\n    let costs = Session::finish(session, context)?;\n    Ok((proof, costs))\n}\n\n#[allow(clippy::too_many_arguments)]\nfn visit<'p, 'a, L: Lookup<'p>>(\n    expression: &Expr,\n    free: bool,\n    outside: bool,\n    depth: usize,\n    names: &Names<'_>,\n    lookup: &mut L,\n    context: Context<'p, 'a>,\n    owner: &'p Function,\n    body: bool,\n    body_complete: &mut bool,\n    session: &mut Option<Session<'p, 'a>>,\n    proof: &mut Proof,\n) -> Result<bool, Error> {\n    proof.charge(&(\n        expression,\n        free,\n        outside,\n        depth,\n        names,\n        &mut *lookup,\n        context,\n        owner,\n        body,\n        &mut *body_complete,\n        &mut *session,\n    ));\n    proof.bytes = proof.bytes.saturating_add(size_of::<Result<bool, Error>>());\n    if depth == 128 {\n        return Ok(false);\n    }\n    if body || proof.retention_closed {\n        let supported = supported(expression, proof);\n        if body && !supported {\n            *body_complete = false;\n        }\n    }\n    // Only one bounded scalar field is added to the already executing visit.\n    // Preserve both usize depth operands. Only the five counter comparison /\n    // increment operands/results narrow with the actual u16 field; both\n    // predicates remain paid. There is no checked_add Option ABI.\n    proof.bytes = proof.bytes.saturating_add(size_of::<bool>());\n    if proof.retention_closed {\n        proof.bytes = proof\n            .bytes\n            .saturating_add(size_of::<([usize; 2], [u16; 5], [bool; 2])>());\n        if depth < 32 && proof.current_retained < crate::workspace_graph::expected_projection::retained_scratch::MAX_COVERED_EXPRESSIONS {\n            // The const-checked bound dominates this sole increment. Unknown or\n            // incomplete functions never reopen it before the next reset.\n            proof.current_retained += 1;\n        } else {\n            proof.retention_closed = false;\n        }\n    }\n    if let ExprKind::Call {\n        name,\n        type_arguments,\n        args,\n    } = &expression.kind\n    {\n        let callee = body && *body_complete && outside;\n        proof.charge(&callee);\n        let retained_call = proof.retention_closed;\n        proof.charge(&retained_call);\n        if (free || callee || retained_call)\n            && outside\n            && type_arguments.is_empty()\n            && !names.contains(name, proof)\n        {\n            let loan = lookup.target(context.authored, name, args.len(), proof);\n            if retained_call {\n                // The directory's local loan authenticates exact membership,\n                // arity and absence of competing/import/interface names.\n                let mut scalar = false;\n                proof.charge(&scalar);\n                if let Some(target) = loan.local {\n                    proof.charge(&target);\n                    scalar = matches!(\n                        target.return_type,\n                        Type::I64\n                            | Type::I32\n                            | Type::U8\n                            | Type::Usize\n                            | Type::Char\n                            | Type::F32\n                            | Type::F64\n                            | Type::Bool\n                    );\n                    // A distinct iterator is formed here; a borrowed Function\n                    // or Param does not pay its IntoIterator/next receivers.\n                    proof.bytes = proof.bytes.saturating_add(size_of::<(\n                        &Vec<crate::ast::Param>,\n                        &Vec<crate::ast::Param>,\n                        std::slice::Iter<'_, crate::ast::Param>,\n                        std::slice::Iter<'_, crate::ast::Param>,\n                    )>());\n                    for parameter in &target.params {\n                        proof.bytes = proof.bytes.saturating_add(size_of::<(\n                            [&mut std::slice::Iter<'_, crate::ast::Param>; 4],\n                            [Option<&crate::ast::Param>; 2],\n                            [&crate::ast::Param; 2],\n                            [bool; 4],\n                        )>());\n                        proof.charge(&parameter);\n                        scalar &= matches!(parameter.mode, crate::ast::ParamMode::Value)\n                            && matches!(\n                                parameter.ty,\n                                Type::I64\n                                    | Type::I32\n                                    | Type::U8\n                                    | Type::Usize\n                                    | Type::Char\n                                    | Type::F32\n                                    | Type::F64\n                                    | Type::Bool\n                            );\n                    }\n                    // The terminal next/None publication is reached even by\n                    // a zero-parameter target and cannot use a prior item bank.\n                    proof.bytes = proof.bytes.saturating_add(size_of::<(\n                        [&mut std::slice::Iter<'_, crate::ast::Param>; 4],\n                        [Option<&crate::ast::Param>; 2],\n                        [bool; 4],\n                    )>());\n                }\n                proof.retention_closed &= scalar;\n            }\n            if free && loan.auxiliary {\n                proof.roots = proof.roots.saturating_add(1);\n            }\n            if callee {\n                if let Some(target) = loan.local {\n                    Session::observe(session, context, owner, target, args.len())?;\n                }\n            }\n        } else if retained_call {\n            proof.retention_closed = false;\n        }\n    }\n    let outside = outside && !matches!(expression.kind, ExprKind::Closure { .. });\n    let mut index = 0;\n    while let Some(child) = expression.child(index) {\n        let free = match &expression.kind {\n            ExprKind::Unary { .. }\n            | ExprKind::Binary { .. }\n            | ExprKind::If { .. }\n            | ExprKind::Call { .. } => true,\n            ExprKind::Block { tail, .. } => std::ptr::eq(child, tail.as_ref()),\n            _ => false,\n        };\n        proof.charge(&(index, child, free, outside));\n        if !visit(\n            child,\n            free,\n            outside,\n            depth + 1,\n            names,\n            lookup,\n            context,\n            owner,\n            body,\n            body_complete,\n            session,\n            proof,\n        )? {\n            return Ok(false);\n        }\n        index += 1;\n    }\n    let complete = true;\n    proof.charge(&complete);\n    Ok(complete)\n}\n\n#[cfg(test)]\n#[path = \"shared_local_callees/reuse_tests.rs\"]\nmod tests;\n\n#[path = \"shared_local_callees/modular_census.rs\"]\npub(in crate::workspace_graph::expected_projection) mod modular_census;\n"}]},{"source":"src/workspace_graph/expected_projection/shared_local_callees/modul
{
  "name": "semaprax-saved-source",
  "displayName": "SEMAPRAX Saved Source",
  "description": "SEMAPRAX syntax highlighting for .spx files, plus explicit, read-only source previews and semantic candidates through a host-selected local MCP session.",
  "version": "0.1.0",
  "publisher": "semaprax",
  "engines": { "vscode": "^1.85.0" },
  "main": "./extension.js",
  "extensionKind": ["workspace"],
  "capabilities": { "untrustedWorkspaces": { "supported": false }, "virtualWorkspaces": false },
  "activationEvents": ["onCommand:semaprax.start"],
  "scripts": { "test": "node --test test/*.test.js" },
  "contributes": {
    "languages": [
      {
        "id": "semaprax",
        "aliases": ["SEMAPRAX", "semaprax"],
        "extensions": [".spx"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "semaprax",
        "scopeName": "source.semaprax",
        "path": "./syntaxes/semaprax.tmLanguage.json"
      }
    ],
    "commands": [
      { "command": "semaprax.start", "title": "SEMAPRAX: Start Saved-Source Session" },
      { "command": "semaprax.stop", "title": "SEMAPRAX: Stop Session" },
      { "command": "semaprax.openCandidate", "title": "SEMAPRAX: Open Candidate" },
      { "command": "semaprax.selectTarget", "title": "SEMAPRAX: Select Stable Target ID" },
      { "command": "semaprax.changeCatalog", "title": "SEMAPRAX: Show Target Change Catalog" },
      { "command": "semaprax.newIntent", "title": "SEMAPRAX: New Typed Intent Scratch" },
      { "command": "semaprax.applyIntent", "title": "SEMAPRAX: Apply Active Typed Intent" },
      { "command": "semaprax.tryIntent", "title": "SEMAPRAX: Try Active Typed Intent with Diagnostics" },
      { "command": "semaprax.attemptSummary", "title": "SEMAPRAX: Show Rejected Attempt Summary" },
      { "command": "semaprax.attemptDiagnostics", "title": "SEMAPRAX: Show Retained Attempt Diagnostics" },
      { "command": "semaprax.repairCatalog", "title": "SEMAPRAX: Show Compiler-Admitted Repair Catalog" },
      { "command": "semaprax.applyRepair", "title": "SEMAPRAX: Select and Apply Exact Diagnostic Repair" },
      { "command": "semaprax.discardAttempt", "title": "SEMAPRAX: Discard Diagnostic Attempt" },
      { "command": "semaprax.previewSourceDiff", "title": "SEMAPRAX: Preview Candidate Source Diff" },
      { "command": "semaprax.runCandidateTests", "title": "SEMAPRAX: Run Candidate Interpreter Tests" },
      { "command": "semaprax.cancelCandidateTests", "title": "SEMAPRAX: Cancel Candidate Interpreter Tests" },
      { "command": "semaprax.openHole", "title": "SEMAPRAX: Open Typed Hole" },
      { "command": "semaprax.selectHole", "title": "SEMAPRAX: Select Pending Hole" },
      { "command": "semaprax.holeSummary", "title": "SEMAPRAX: Show Descriptive Hole Summary" },
      { "command": "semaprax.holeFacet", "title": "SEMAPRAX: Show Hole Facet Page or Next Page" },
      { "command": "semaprax.holeContext", "title": "SEMAPRAX: Show Full Hole Context (Unbundled)" },
      { "command": "semaprax.showHoleConstructors", "title": "SEMAPRAX: Show Typed Hole Constructor Schemas" },
      { "command": "semaprax.newHoleFillScratch", "title": "SEMAPRAX: New Hole Fill Scratch" },
      { "command": "semaprax.suggestHoleFill", "title": "SEMAPRAX: Choose Checked Hole Fill for Scratch" },
      { "command": "semaprax.fillHole", "title": "SEMAPRAX: Fill Selected Hole from Active Scratch" },
      { "command": "semaprax.completeDraft", "title": "SEMAPRAX: Complete Ready Draft as Candidate" },
      { "command": "semaprax.discardDraft", "title": "SEMAPRAX: Discard Typed-Hole Draft" },
      { "command": "semaprax.refresh", "title": "SEMAPRAX: Preview and Explicitly Refresh Saved Source" }
    ],
    "configuration": {
      "title": "SEMAPRAX Saved Source",
      "properties": {
        "semaprax.compilerPath": { "type": "string", "default": "", "scope": "machine", "description": "User-selected absolute compiler binary path. Never read from workspace settings." },
        "semaprax.manifestPath": { "type": "string", "default": "", "scope": "machine", "description": "User-selected absolute saved semaprax.toml path." },
        "semaprax.hostPolicyPath": { "type": "string", "default": "", "scope": "machine", "description": "User-selected absolute existing v1-v7 host-policy JSON path. Candidate tests remain unavailable unless that policy explicitly selects its fixed interpreter limits; this extension cannot invoke builds, approval, or publication." }
      }
    }
  }
}

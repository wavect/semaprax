module apex.optimization;
use function @id("apex.demand.forecast") from apex.demand as forecast;
use function @id("apex.inventory.reorder-point") from apex.inventory as reorder_point;
use function @id("apex.pricing.final-price") from apex.pricing as final_price;
use function @id("apex.risk.adjusted-cost") from apex.risk as adjusted_cost;
use function @id("apex.routing.fuel-cost") from apex.routing as fuel_cost;

@id("apex.optimization.landed-cost")
fn landed_cost(product_cost: i64, routing_cost: i64, risk_cost: i64, holding: i64) -> i64
{
    product_cost + routing_cost + risk_cost + holding
}

@id("apex.optimization.service-level")
fn service_level(fulfilled: i64, total: i64) -> i64
    requires total != 0
{
    fulfilled * 100 / total
}

@id("apex.optimization.score")
fn score(cost: i64, service: i64) -> i64
{
    service * 1000 - cost
}

@id("apex.optimization.iterative-cost")
fn iterative_cost(seed: i64, iterations: i64) -> i64
    requires iterations >= 0
    requires iterations <= 20
{
    let mut best = seed;
    let mut index = 0;
    while index < iterations {
        let candidate = forecast(100, index * 2, index);
        let reord = reorder_point(candidate, 5, 10);
        let price = final_price(100, candidate, 5, 3);
        let fuel = fuel_cost(candidate, 10, 5);
        let risk = adjusted_cost(20, candidate / 10);
        let total = landed_cost(price, fuel, risk, 15);
        best = if total < best { total } else { best };
        index = index + 1;
        index < iterations
    }
    best
}

@id("apex.optimization.batch-optimizer")
fn batch_optimizer(seed: i64, batches: i64) -> i64
    requires batches >= 0
    requires batches <= 10
{
    let mut total = seed;
    let mut index = 0;
    while index < batches {
        let cost = iterative_cost(500 + index * 10, 3);
        total = total + cost;
        index = index + 1;
        index < batches
    }
    total
}

module catalog_normalizer.record;
use type @id("std.data.json.dec.string-scan") from std.data.json.dec as StringScan;
use function @id("std.data.json.dec.scan-string-info") from std.data.json.dec as scan_string_info;
use function @id("std.data.json.dec.decoded_len") from std.data.json.dec as decoded_len;
use function @id("std.data.json.dec.is_failure") from std.data.json.dec as is_failure;
use function @id("std.data.json.dec.emit_at") from std.data.json.dec as emit_at;
use function @id("std.data.json.dec.emit_len") from std.data.json.dec as emit_len;
use function @id("std.data.json.dec.token_end") from std.data.json.dec as token_end;
use function @id("std.data.json.doc.at_in") from std.data.json.doc as at_in;
use function @id("std.data.json.doc.skip_space") from std.data.json.doc as skip_space;
use function @id("std.data.json.doc.string_end") from std.data.json.doc as doc_string_end;
use function @id("std.data.json.doc.document_end") from std.data.json.doc as document_end;
use function @id("std.data.json.doc.digits_end") from std.data.json.doc as digits_end;
use function @id("std.data.json.doc.whole_end") from std.data.json.doc as whole_end;
use function @id("catalog_normalizer.limits.max_id_bytes") from catalog_normalizer.limits as max_id_bytes;
use function @id("catalog_normalizer.limits.max_label_bytes") from catalog_normalizer.limits as max_label_bytes;

// A parser result is packed as `category * 1024 + byte_offset`.  Record
// lines are bounded at 512 bytes, so this scalar envelope retains an exact
// local fault position without introducing an owned record/collection before
// the all-or-nothing batch writer is admitted.  Categories follow limits.spx:
// 0 none, 1 oversized_input, 3 malformed_json, and 4 schema.
@id("catalog_normalizer.record.pack-problem")
fn pack_problem(category: usize, offset: usize) -> usize
{
    category * 1024usize + offset
}

@id("catalog_normalizer.record.problem-category")
fn problem_category(problem: usize) -> usize
{
    problem / 1024usize
}

@id("catalog_normalizer.record.problem-offset")
fn problem_offset(problem: usize) -> usize
{
    problem % 1024usize
}

@id("catalog_normalizer.record.object-open")
fn object_open(line: borrow Slice<u8>) -> usize
{
    skip_space(line, 0usize)
}

// `std.data.json.doc` remains the structural authority. This application
// layer only narrows its accepted top-level value to an object and preserves
// the scanner's exact failure-marker convention.
@id("catalog_normalizer.record.structural-problem")
fn structural_problem(line: borrow Slice<u8>) -> usize
{
    let length = byte_len(line);
    let end = whole_end(line, 8usize);
    let open = object_open(line);
    if end > length { pack_problem(3usize, end - length - 1usize) } else { if !at_in(line, open, 123u8, 123u8) { pack_problem(3usize, open) } else { 0usize } }
}

@id("catalog_normalizer.record.key-is-id")
fn key_is_id(line: borrow Slice<u8>, key: usize) -> bool
{
    at_in(line, key, 34u8, 34u8) && at_in(line, key + 1usize, 105u8, 105u8) && at_in(line, key + 2usize, 100u8, 100u8) && at_in(line, key + 3usize, 34u8, 34u8)
}

@id("catalog_normalizer.record.key-is-label")
fn key_is_label(line: borrow Slice<u8>, key: usize) -> bool
{
    at_in(line, key, 34u8, 34u8) && at_in(line, key + 1usize, 108u8, 108u8) && at_in(line, key + 2usize, 97u8, 97u8) && at_in(line, key + 3usize, 98u8, 98u8) && at_in(line, key + 4usize, 101u8, 101u8) && at_in(line, key + 5usize, 108u8, 108u8) && at_in(line, key + 6usize, 34u8, 34u8)
}

@id("catalog_normalizer.record.key-is-quantity")
fn key_is_quantity(line: borrow Slice<u8>, key: usize) -> bool
{
    at_in(line, key, 34u8, 34u8) && at_in(line, key + 1usize, 113u8, 113u8) && at_in(line, key + 2usize, 117u8, 117u8) && at_in(line, key + 3usize, 97u8, 97u8) && at_in(line, key + 4usize, 110u8, 110u8) && at_in(line, key + 5usize, 116u8, 116u8) && at_in(line, key + 6usize, 105u8, 105u8) && at_in(line, key + 7usize, 116u8, 116u8) && at_in(line, key + 8usize, 121u8, 121u8) && at_in(line, key + 9usize, 34u8, 34u8)
}

@id("catalog_normalizer.record.key-kind")
fn key_kind(line: borrow Slice<u8>, key: usize) -> usize
{
    if key_is_id(line, key) { 1usize } else { if key_is_label(line, key) { 2usize } else { if key_is_quantity(line, key) { 3usize } else { 0usize } } }
}

@id("catalog_normalizer.record.key-value")
fn key_value(line: borrow Slice<u8>, key: usize) -> usize
{
    let colon = skip_space(line, doc_string_end(line, key));
    skip_space(line, colon + 1usize)
}

@id("catalog_normalizer.record.next-key")
fn next_key(line: borrow Slice<u8>, key: usize) -> usize
{
    let value = key_value(line, key);
    let after = skip_space(line, document_end(line, value, 8usize));
    if at_in(line, after, 44u8, 44u8) { skip_space(line, after + 1usize) } else { byte_len(line) }
}

// The structural scanner intentionally treats an escape as two bytes so it
// can locate object members without decoding them. Before key spelling is
// classified as schema, re-run the standard decoder over each key: `"\\q"`
// is malformed JSON, never an unknown schema key.
@id("catalog_normalizer.record.key-decode-problem")
fn key_decode_problem(line: borrow Slice<u8>) -> usize
{
    let length = byte_len(line);
    let mut key = skip_space(line, object_open(line) + 1usize);
    let mut fault = length + 1usize;
    let mut scanning = at_in(line, key, 34u8, 34u8);
    while scanning {
        let decoded = decoded_len(line, key);
        fault = if fault > length && is_failure(line, decoded) { decoded - length - 1usize } else { fault };
        key = if fault > length { next_key(line, key) } else { key };
        scanning = fault > length && at_in(line, key, 34u8, 34u8);
        scanning
    }
    fault
}

// CNORM-008 scans keys in source order, rejecting an unknown, escaped, or
// repeated required key at that key's opening quote.  Structural validation
// runs first, so this walker is deliberately not a second JSON grammar.
@id("catalog_normalizer.record.key-problem")
fn key_problem(line: borrow Slice<u8>) -> usize
{
    let length = byte_len(line);
    let mut key = skip_space(line, object_open(line) + 1usize);
    let mut seen_id = false;
    let mut seen_label = false;
    let mut seen_quantity = false;
    let mut problem = length + 1usize;
    let mut scanning = at_in(line, key, 34u8, 34u8);
    while scanning {
        let kind = key_kind(line, key);
        let duplicate = kind == 1usize && seen_id || kind == 2usize && seen_label || kind == 3usize && seen_quantity;
        problem = if problem > length && (kind == 0usize || duplicate) { key } else { problem };
        seen_id = seen_id || kind == 1usize;
        seen_label = seen_label || kind == 2usize;
        seen_quantity = seen_quantity || kind == 3usize;
        key = if problem > length { next_key(line, key) } else { key };
        scanning = problem > length && at_in(line, key, 34u8, 34u8);
        scanning
    }
    if problem <= length { problem } else { if !seen_id || !seen_label || !seen_quantity { object_open(line) } else { length + 1usize } }
}

@id("catalog_normalizer.record.field-value")
fn field_value(line: borrow Slice<u8>, sought: usize) -> usize
{
    let length = byte_len(line);
    let mut key = skip_space(line, object_open(line) + 1usize);
    let mut value = length + 1usize;
    let mut scanning = at_in(line, key, 34u8, 34u8) && value > length;
    while scanning {
        value = if key_kind(line, key) == sought { key_value(line, key) } else { value };
        key = if value > length { next_key(line, key) } else { key };
        scanning = value > length && at_in(line, key, 34u8, 34u8);
        scanning
    }
    value
}

@id("catalog_normalizer.record.string-problem")
fn string_problem(line: borrow Slice<u8>, value: usize, maximum: usize, minimum: usize) -> usize
{
    let decoded = decoded_len(line, value);
    if !at_in(line, value, 34u8, 34u8) { pack_problem(4usize, value) } else { if is_failure(line, decoded) { pack_problem(3usize, decoded - byte_len(line) - 1usize) } else { if decoded < minimum { pack_problem(4usize, value) } else { if decoded > maximum { pack_problem(1usize, value) } else { 0usize } } } }
}

@id("catalog_normalizer.record.quantity-problem")
fn quantity_problem(line: borrow Slice<u8>, value: usize) -> usize
{
    let quantity = quantity_or(line, value, -1);
    if quantity < 0 { pack_problem(4usize, value) } else { 0usize }
}

@id("catalog_normalizer.record.decimal-digit")
fn decimal_digit(line: borrow Slice<u8>, index: usize) -> i64
{
    match byte_get(line, index) { Option::Some { value } => match value { 48u8 => 0, 49u8 => 1, 50u8 => 2, 51u8 => 3, 52u8 => 4, 53u8 => 5, 54u8 => 6, 55u8 => 7, 56u8 => 8, 57u8 => 9, _ => -1, }, Option::None {} => -1, }
}

@id("catalog_normalizer.record.quantity-tail-invalid")
fn quantity_tail_invalid(line: borrow Slice<u8>, index: usize) -> bool
{
    match byte_get(line, index) { Option::Some { value } => value == 46u8 || value == 101u8 || value == 69u8, Option::None {} => false, }
}

// CNORM-009's admitted quantity is a bare, nonnegative RFC JSON integer.
// The structural scanner owns general number grammar; this compact second
// pass supplies the exact i64 magnitude check without importing the broader
// token package into this capacity-bounded application.
@id("catalog_normalizer.record.quantity-or")
fn quantity_or(line: borrow Slice<u8>, start: usize, fallback: i64) -> i64
{
    let first = decimal_digit(line, start);
    let mut index = if first == 0 { start + 1usize } else { start };
    let mut value = 0;
    let mut bad = first < 0;
    let mut scanning = !bad && index < byte_len(line);
    while scanning {
        let digit = decimal_digit(line, index);
        let over = value < -922337203685477580 || value == -922337203685477580 && digit > 7;
        let present = digit >= 0;
        bad = bad || present && over;
        value = if present && !bad { value * 10 - digit } else { value };
        index = if present && !bad { index + 1usize } else { index };
        scanning = present && !bad && index < byte_len(line);
        scanning
    }
    let tail = quantity_tail_invalid(line, index);
    if bad || tail { fallback } else { 0 - value }
}

// Exact current-byte recognition of the compact key order. Other orders,
// whitespace and unsupported value shapes retain the complete member walker.
@id("catalog_normalizer.record.compact-id-prefix")
fn compact_id_prefix(line: borrow Slice<u8>) -> bool
{
    match byte_read_le(line, 0usize, 6usize) { Option::Some { value } => value == 63919387910779usize, Option::None {} => false, }
}

@id("catalog_normalizer.record.compact-label-value")
fn compact_label_value(line: borrow Slice<u8>) -> usize
{
    let missing = byte_len(line) + 1usize;
    if compact_id_prefix(line) && at_in(line, 6usize, 34u8, 34u8) { let end = doc_string_end(line, 6usize); let marker = match byte_read_le(line, end, 8usize) { Option::Some { value } => value == 2480468967989977644usize, Option::None {} => false, }; if marker && at_in(line, end + 8usize, 58u8, 58u8) { skip_space(line, end + 9usize) } else { missing } } else { missing }
}

@id("catalog_normalizer.record.compact-quantity-value")
fn compact_quantity_value(line: borrow Slice<u8>) -> usize
{
    let missing = byte_len(line) + 1usize;
    let label = compact_label_value(line);
    if label < byte_len(line) && at_in(line, label, 34u8, 34u8) { let end = doc_string_end(line, label); let first = match byte_read_le(line, end, 8usize) { Option::Some { value } => value == 7598819836142101036usize, Option::None {} => false, }; let last = match byte_read_le(line, end + 8usize, 4usize) { Option::Some { value } => value == 975337844usize, Option::None {} => false, }; if first && last { skip_space(line, end + 12usize) } else { missing } } else { missing }
}

// This fast path grants only success after proving the complete object grammar,
// all three exact keys, both fully decoded string bounds, canonical integer
// spelling/magnitude and exact EOF. Every other subject uses the original
// structural -> key decode -> schema -> value pipeline, including its precedence.
@id("catalog_normalizer.record.compact-record-valid")
fn compact_record_valid(line: borrow Slice<u8>) -> bool
{
    let length = byte_len(line);
    if !compact_id_prefix(line) { false } else { let id = scan_string_info(line, 6usize); if id.end > length || id.decoded_length < 1usize || id.decoded_length > max_id_bytes() { false } else { let label_key = match byte_read_le(line, id.end, 8usize) { Option::Some { value } => value == 2480468967989977644usize, Option::None {} => false, }; if !label_key || !at_in(line, id.end + 8usize, 58u8, 58u8) { false } else { let label = scan_string_info(line, skip_space(line, id.end + 9usize)); if label.end > length || label.decoded_length > max_label_bytes() { false } else { let first = match byte_read_le(line, label.end, 8usize) { Option::Some { value } => value == 7598819836142101036usize, Option::None {} => false, }; let last = match byte_read_le(line, label.end + 8usize, 4usize) { Option::Some { value } => value == 975337844usize, Option::None {} => false, }; if !first || !last { false } else { let quantity = skip_space(line, label.end + 12usize); let end = digits_end(line, quantity); end <= length && (!at_in(line, quantity, 48u8, 48u8) || end == quantity + 1usize) && at_in(line, end, 125u8, 125u8) && end + 1usize == length && quantity_or(line, quantity, -1) >= 0 } } } } }
}

// CNORM-006..011 per-record classification.  The key set is checked before
// values; once the set is exact, value checks run in the stable id, label,
// quantity order.  The batch coordinator can therefore stop on its first
// nonzero problem without publishing a prefix.
@id("catalog_normalizer.record.structure-and-key-problem")
fn structure_and_key_problem(line: borrow Slice<u8>) -> usize
{
    let structural = structural_problem(line);
    if structural != 0usize { structural } else { let decoded_key_fault = key_decode_problem(line); if decoded_key_fault <= byte_len(line) { pack_problem(3usize, decoded_key_fault) } else { let keys = key_problem(line); if keys <= byte_len(line) { pack_problem(4usize, keys) } else { 0usize } } }
}

@id("catalog_normalizer.record.id-field-problem")
fn id_field_problem(line: borrow Slice<u8>) -> usize
{
    string_problem(line, field_value(line, 1usize), max_id_bytes(), 1usize)
}

@id("catalog_normalizer.record.label-field-problem")
fn label_field_problem(line: borrow Slice<u8>) -> usize
{
    string_problem(line, field_value(line, 2usize), max_label_bytes(), 0usize)
}

@id("catalog_normalizer.record.quantity-field-problem")
fn quantity_field_problem(line: borrow Slice<u8>) -> usize
{
    quantity_problem(line, field_value(line, 3usize))
}

@id("catalog_normalizer.record.value-problem")
fn value_problem(line: borrow Slice<u8>) -> usize
{
    let id = id_field_problem(line);
    if id != 0usize { id } else { let label = label_field_problem(line); if label != 0usize { label } else { quantity_field_problem(line) } }
}

@id("catalog_normalizer.record.record-problem")
fn record_problem(line: borrow Slice<u8>) -> usize
{
    if compact_record_valid(line) { 0usize } else { let keys = structure_and_key_problem(line); if keys != 0usize { keys } else { value_problem(line) } }
}

// Validated callers use this token position for duplicate-id and overflow
// envelopes.  Invalid records must be rejected by `record_problem` first.
@id("catalog_normalizer.record.id-value")
fn id_value(line: borrow Slice<u8>) -> usize
{
    // After record_problem accepts the line, an exact first id key needs
    // only the whitespace after its colon located. Other key orders and
    // whitespace before the key retain the general member walker.
    let first_key = compact_id_prefix(line);
    let compact = if first_key { skip_space(line, 6usize) } else { byte_len(line) + 1usize };
    if first_key && at_in(line, compact, 34u8, 34u8) { compact } else { field_value(line, 1usize) }
}

@id("catalog_normalizer.record.quantity-value")
fn quantity_value(line: borrow Slice<u8>) -> usize
{
    let compact = compact_quantity_value(line);
    if compact <= byte_len(line) { compact } else { field_value(line, 3usize) }
}

@id("catalog_normalizer.record.label-value")
fn label_value(line: borrow Slice<u8>) -> usize
{
    let compact = compact_label_value(line);
    if compact <= byte_len(line) { compact } else { field_value(line, 2usize) }
}

// One pair-step walks both decoded tokens once.  Its packed result carries
// two four-slot UTF-8 cursors, the decoded-byte count, and a terminal state:
// 0 reject, 1 continue, 2 equal and closed.  The caller has no independent
// branches, keeping the bounded comparison cheap in the quadratic batch scan.
@id("catalog_normalizer.record.id-pair-emitted")
fn id_pair_emitted(input: borrow Slice<u8>, opening: bool, left_index: usize, right_index: usize, left_width: usize, right_width: usize, left_part: usize, right_part: usize, count: usize) -> bool
{
    let ready = opening && !at_in(input, left_index, 34u8, 34u8) && !at_in(input, right_index, 34u8, 34u8) && count < max_id_bytes() && left_width > 0usize && right_width > 0usize;
    if !ready { false } else { let first = emit_at(input, left_index, left_part); let second = emit_at(input, right_index, right_part); first >= 0 && first == second }
}

// A rejected byte pair never advances either cursor. Keeping this branch in
// one scalar callee avoids multiplying the caller's cleanup replay paths.
@id("catalog_normalizer.record.id-advanced-cursor")
fn id_advanced_cursor(input: borrow Slice<u8>, cursor: usize, width: usize, emitted: bool) -> usize
{
    if !emitted { cursor } else { if cursor % 4usize + 1usize >= width { token_end(input, cursor / 4usize) * 4usize } else { cursor + 1usize } }
}

@id("catalog_normalizer.record.id-pair-step")
fn id_pair_step(input: borrow Slice<u8>, left: usize, right: usize, left_cursor: usize, right_cursor: usize, count: usize) -> usize
{
    let left_index = left_cursor / 4usize;
    let right_index = right_cursor / 4usize;
    let left_part = left_cursor % 4usize;
    let right_part = right_cursor % 4usize;
    let opening = if count == 0usize { at_in(input, left, 34u8, 34u8) && at_in(input, right, 34u8, 34u8) } else { true };
    let left_closed = at_in(input, left_index, 34u8, 34u8);
    let right_closed = at_in(input, right_index, 34u8, 34u8);
    let closed = left_closed && right_closed;
    let left_width = emit_len(input, left_index);
    let right_width = emit_len(input, right_index);
    let emitted = id_pair_emitted(input, opening, left_index, right_index, left_width, right_width, left_part, right_part, count);
    let advanced_left = id_advanced_cursor(input, left_cursor, left_width, emitted);
    let advanced_right = id_advanced_cursor(input, right_cursor, right_width, emitted);
    let next_valid = emitted && !is_failure(input, advanced_left / 4usize) && !is_failure(input, advanced_right / 4usize);
    let status = if opening && closed && count > 0usize { 2usize } else { if emitted && next_valid { 1usize } else { 0usize } };
    let advanced_count = if emitted { count + 1usize } else { count };
    ((advanced_left * 524300usize + advanced_right) * 65usize + advanced_count) * 4usize + status
}

@id("catalog_normalizer.record.same-id")
fn same_decoded_id(input: borrow Slice<u8>, left: usize, right: usize) -> bool
{
    let plain = id_plain_comparison(input, left, right);
    if plain == 2usize { true } else { if plain == 1usize { false } else { decoded_id_comparison(input, left, right) } }
}

// Both inputs have already passed record_problem. An aligned ordinary byte
// mismatch is final, while any escape needs the decoder from the beginning.
// Status: 0 decoded fallback, 1 unequal or missing, 2 equal.
@id("catalog_normalizer.record.id-plain-comparison")
fn id_plain_comparison(input: borrow Slice<u8>, left: usize, right: usize) -> usize
{
    let opening = at_in(input, left, 34u8, 34u8) && at_in(input, right, 34u8, 34u8);
    let mut offset = 1usize;
    let mut status = if opening { 3usize } else { 1usize };
    while status == 3usize {
        status = id_plain_step(input, left + offset, right + offset, offset);
        offset = offset + 1usize;
        status == 3usize
    }
    status
}

// Status 3 continues the raw walk; all other statuses terminate it.
@id("catalog_normalizer.record.id-plain-step")
fn id_plain_step(input: borrow Slice<u8>, left_index: usize, right_index: usize, offset: usize) -> usize
{
    let first = match byte_get(input, left_index) { Option::Some { value } => value, Option::None {} => 0u8, };
    let second = match byte_get(input, right_index) { Option::Some { value } => value, Option::None {} => 0u8, };
    if first == 92u8 || second == 92u8 { 0usize } else { if first != second { 1usize } else { if first == 34u8 { if offset > 1usize && offset <= max_id_bytes() + 1usize { 2usize } else { 1usize } } else { if first < 32u8 || offset > max_id_bytes() { 1usize } else { 3usize } } } }
}

@id("catalog_normalizer.record.id-decoded-comparison")
fn decoded_id_comparison(input: borrow Slice<u8>, left: usize, right: usize) -> bool
{
    // CNORM-014 calls this for every prior accepted id.  Do not pre-measure
    // both tokens and then restart the decoder for equality: a single pair
    // of pull cursors proves validity, the 1..64-byte id bound, and exact
    // decoded-byte equality together.  In particular, a multi-byte UTF-8
    // expansion advances its `part` cursor instead of re-reading its prefix.
    let mut left_cursor = (left + 1usize) * 4usize;
    let mut right_cursor = (right + 1usize) * 4usize;
    let mut count = 0usize;
    let mut state = id_pair_step(input, left, right, left_cursor, right_cursor, count);
    let mut status = state % 4usize;
    while status == 1usize {
        left_cursor = state / 136318000usize;
        right_cursor = state / 260usize % 524300usize;
        count = state / 4usize % 65usize;
        state = id_pair_step(input, left, right, left_cursor, right_cursor, count);
        status = state % 4usize;
        status == 1usize
    }
    status == 2usize
}

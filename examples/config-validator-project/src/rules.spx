module config_validator.rules;

@id("config-validator.accepts-line")
fn accepts_line(line: borrow str, prefix: borrow str, forbidden: borrow str) -> bool
{
    if str_is_empty(line) { false } else { str_starts_with(line, prefix) && !str_contains(line, forbidden) }
}

@id("config-validator.byte-length")
fn byte_length(line: borrow str) -> i64
{
    str_len_bytes(line)
}

@id("config-validator.classify")
fn classify(line: borrow str, prefix: borrow str, forbidden: borrow str) -> i64
{
    if str_is_empty(line) { 0 } else { if !str_starts_with(line, prefix) { 1 } else { if str_contains(line, forbidden) { 2 } else { 3 } } }
}

@id("config-validator.unselected")
fn unselected(line: borrow str) -> bool
{
    str_is_empty(line)
}

module everyday.v2.agent.lifecycle;

// This is a Project-admitted V2 sibling of the Everyday Agent V1 product.
// Its source policy names the only OpenCode profile the private source-live
// repair host admits. The declaration grants no provider, credential, process,
// candidate-test, publication, or source-write authority.
@id("everyday.v2.agent.type.task")
record Task {
    @id("everyday.v2.agent.type.task.objective")
    objective: Bytes,
    @id("everyday.v2.agent.type.task.budget")
    budget: i64,
}

@id("everyday.v2.agent.type.state")
record State {
    @id("everyday.v2.agent.type.state.objective")
    objective: Bytes,
    @id("everyday.v2.agent.type.state.budget")
    budget: i64,
    @id("everyday.v2.agent.type.state.epoch")
    epoch: i64,
}

@id("everyday.v2.agent.type.observation")
record Observation {
    @id("everyday.v2.agent.type.observation.budget")
    budget: i64,
    @id("everyday.v2.agent.type.observation.epoch")
    epoch: i64,
}

@id("everyday.v2.agent.type.proposal")
record Proposal {
    @id("everyday.v2.agent.type.proposal.budget")
    budget: i64,
    @id("everyday.v2.agent.type.proposal.urgent")
    urgent: bool,
    @id("everyday.v2.agent.type.proposal.sequence")
    sequence: usize,
}

@id("everyday.v2.agent.type.decision")
variant Decision {
    @id("everyday.v2.agent.type.decision.granted")
    Granted {
        @id("everyday.v2.agent.type.decision.granted.seal")
        seal: Bytes,
        @id("everyday.v2.agent.type.decision.granted.budget")
        budget: i64,
    },
    @id("everyday.v2.agent.type.decision.refused")
    Refused {
        @id("everyday.v2.agent.type.decision.refused.code")
        code: i64,
    },
}

@id("everyday.v2.agent.type.outcome")
record Outcome {
    @id("everyday.v2.agent.type.outcome.value")
    value: Bytes,
    @id("everyday.v2.agent.type.outcome.status")
    status: i64,
}

@id("everyday.v2.agent.type.result")
record Report {
    @id("everyday.v2.agent.type.result.summary")
    summary: Bytes,
    @id("everyday.v2.agent.type.result.budget")
    budget: i64,
    @id("everyday.v2.agent.type.result.status")
    status: i64,
}

// V2 binds this precise shape from checked source. Continue and Suspend carry
// State's fields in order; Complete carries Report's fields in order; Fail is
// the one i64 terminal code case.
@id("everyday.v2.agent.type.step")
variant Step {
    @id("everyday.v2.agent.step.continue")
    Continue {
        @id("everyday.v2.agent.step.continue.objective")
        objective: Bytes,
        @id("everyday.v2.agent.step.continue.budget")
        budget: i64,
        @id("everyday.v2.agent.step.continue.epoch")
        epoch: i64,
    },
    @id("everyday.v2.agent.step.complete")
    Complete {
        @id("everyday.v2.agent.step.complete.summary")
        summary: Bytes,
        @id("everyday.v2.agent.step.complete.budget")
        budget: i64,
        @id("everyday.v2.agent.step.complete.status")
        status: i64,
    },
    @id("everyday.v2.agent.step.suspend")
    Suspend {
        @id("everyday.v2.agent.step.suspend.objective")
        objective: Bytes,
        @id("everyday.v2.agent.step.suspend.budget")
        budget: i64,
        @id("everyday.v2.agent.step.suspend.epoch")
        epoch: i64,
    },
    @id("everyday.v2.agent.step.fail")
    Fail {
        @id("everyday.v2.agent.step.fail.code")
        code: i64,
    },
}

@id("everyday.v2.agent")
agent EverydayAgentV2 {
    types {
        @id("everyday.v2.agent.type.task")
        type task;
        @id("everyday.v2.agent.type.state")
        type state;
        @id("everyday.v2.agent.type.observation")
        type observation;
        @id("everyday.v2.agent.type.proposal")
        type proposal;
        @id("everyday.v2.agent.type.outcome")
        type outcome;
        @id("everyday.v2.agent.type.result")
        type result;
    }
    operations {
        @id("everyday.v2.agent.fn.initialize")
        fn initialize;
        @id("everyday.v2.agent.fn.observe")
        fn observe;
        @id("everyday.v2.agent.fn.propose")
        model fn propose;
        @id("everyday.v2.agent.fn.authorize")
        fn authorize;
        @id("everyday.v2.agent.fn.execute")
        effect fn execute;
        @id("everyday.v2.agent.fn.reduce")
        fn reduce;
    }
    runtime_v1 {
        canonical_json "{\"models\":[{\"provider_id\":\"opencode\",\"model_id\":\"muse-spark-1.3-contributor-free\",\"locality\":\"remote\",\"quality_tier\":\"basic\",\"tokenizer_id\":\"fake.bytes-v1\",\"max_context_tokens\":4096,\"input_usd_microunits_per_million_tokens\":0,\"output_usd_microunits_per_million_tokens\":0,\"capabilities\":[\"text\"]}],\"tools\":[{\"tool_id\":\"everyday.v2.read\",\"description\":\"Return one bounded observation.\",\"arguments_schema\":{\"type\":\"object\",\"fields\":[{\"name\":\"query\",\"type\":\"integer\",\"required\":true,\"max_bytes\":20}],\"additional_properties\":false},\"result_schema\":{\"type\":\"object\",\"fields\":[{\"name\":\"value\",\"type\":\"integer\",\"required\":true,\"max_bytes\":20}],\"additional_properties\":false},\"effects\":[\"read\"],\"required_capabilities\":[\"tool.read\"]}],\"policy\":{\"allowed_provider_ids\":[\"opencode\"],\"allowed_model_ids\":[\"muse-spark-1.3-contributor-free\"],\"required_locality\":\"remote_allowed\",\"minimum_quality_tier\":\"basic\",\"required_model_capabilities\":[\"text\"],\"granted_capabilities\":[\"tool.read\"],\"allowed_tool_ids\":[\"everyday.v2.read\"]},\"limits\":{\"max_turns\":2,\"max_provider_attempts\":2,\"max_retries_per_turn\":1,\"max_concurrency\":1,\"max_elapsed_ms\":1000,\"max_provider_request_bytes\":65536,\"max_provider_response_bytes\":4096,\"max_stream_chunks\":64,\"max_total_provider_input_bytes\":131072,\"max_total_provider_output_bytes\":8192,\"max_reported_model_input_tokens\":131072,\"max_reported_model_output_tokens\":8192,\"max_usd_microunits\":0,\"max_tool_calls\":2,\"max_tool_arguments_bytes\":4096,\"max_tool_result_bytes\":4096,\"max_total_tool_bytes\":8192,\"max_retained_state_bytes\":131072,\"max_trace_events\":64,\"max_trace_bytes\":131072,\"max_evidence_bytes\":262144,\"max_builder_bytes\":1048576}}";
    }
}

@id("everyday.v2.agent.fn.initialize")
fn initialize(task: own Task) -> State
{
    State { objective: task.objective, budget: task.budget, epoch: 1 }
}

@id("everyday.v2.agent.fn.observe")
fn observe(state: borrow State) -> Observation
{
    Observation { budget: state.budget, epoch: state.epoch }
}

@id("everyday.v2.agent.fn.authorize")
fn authorize(state: borrow State, budget: i64, urgent: bool, sequence: usize) -> Decision
{
    let seal = [65u8, 90u8];
    if budget <= state.budget && sequence > 0usize { Decision::Granted { seal: bytes_copy(array_as_slice(seal)), budget: budget } } else { Decision::Refused { code: if urgent { 2 } else { 1 } } }
}

@id("everyday.v2.agent.fn.reduce")
fn reduce(state: own State, budget: i64, urgent: bool, sequence: usize, outcome: own Outcome) -> Step
{
    if state.epoch < 2 { Step::Continue { objective: state.objective, budget: state.budget, epoch: state.epoch + 1 } } else { Step::Complete { summary: outcome.value, budget: state.budget - budget, status: outcome.status } }
}

@id("app.main")
fn main() -> i64
{
    0
}

module frame_payload.frame;

@id("frame.octet-to-usize")
fn octet_to_usize(value: u8) -> usize
{
    octet_step_128(value, 0usize)
}

@id("frame.octet-step-128")
fn octet_step_128(value: u8, converted: usize) -> usize
{
    if value >= 128u8 { octet_step_64(value - 128u8, converted + 128usize) } else { octet_step_64(value, converted) }
}

@id("frame.octet-step-64")
fn octet_step_64(value: u8, converted: usize) -> usize
{
    if value >= 64u8 { octet_step_32(value - 64u8, converted + 64usize) } else { octet_step_32(value, converted) }
}

@id("frame.octet-step-32")
fn octet_step_32(value: u8, converted: usize) -> usize
{
    if value >= 32u8 { octet_step_16(value - 32u8, converted + 32usize) } else { octet_step_16(value, converted) }
}

@id("frame.octet-step-16")
fn octet_step_16(value: u8, converted: usize) -> usize
{
    if value >= 16u8 { octet_step_8(value - 16u8, converted + 16usize) } else { octet_step_8(value, converted) }
}

@id("frame.octet-step-8")
fn octet_step_8(value: u8, converted: usize) -> usize
{
    if value >= 8u8 { octet_step_4(value - 8u8, converted + 8usize) } else { octet_step_4(value, converted) }
}

@id("frame.octet-step-4")
fn octet_step_4(value: u8, converted: usize) -> usize
{
    if value >= 4u8 { octet_step_2(value - 4u8, converted + 4usize) } else { octet_step_2(value, converted) }
}

@id("frame.octet-step-2")
fn octet_step_2(value: u8, converted: usize) -> usize
{
    if value >= 2u8 { octet_step_1(value - 2u8, converted + 2usize) } else { octet_step_1(value, converted) }
}

@id("frame.octet-step-1")
fn octet_step_1(value: u8, converted: usize) -> usize
{
    if value == 1u8 { converted + 1usize } else { converted }
}

@id("frame.has-magic")
fn has_magic(frame: borrow Slice<u8>) -> bool
{
    match byte_get(frame, 0usize) { Option::Some { value: first } => match byte_get(frame, 1usize) { Option::Some { value: second } => match byte_get(frame, 2usize) { Option::Some { value: third } => match byte_get(frame, 3usize) { Option::Some { value: fourth } => first == 83u8 && second == 80u8 && third == 88u8 && fourth == 49u8, Option::None {} => false, }, Option::None {} => false, }, Option::None {} => false, }, Option::None {} => false, }
}

@id("frame.declared-length")
fn declared_length(frame: borrow Slice<u8>) -> usize
{
    match byte_get(frame, 4usize) { Option::Some { value: first } => match byte_get(frame, 5usize) { Option::Some { value: second } => match byte_get(frame, 6usize) { Option::Some { value: third } => match byte_get(frame, 7usize) { Option::Some { value: fourth } => octet_to_usize(first) * 16777216usize + octet_to_usize(second) * 65536usize + octet_to_usize(third) * 256usize + octet_to_usize(fourth), Option::None {} => 0usize, }, Option::None {} => 0usize, }, Option::None {} => 0usize, }, Option::None {} => 0usize, }
}

@id("frame.payload")
fn payload(frame: borrow Slice<u8>) -> Bytes
{
    bytes_copy(byte_range(frame, 8usize, byte_len(frame)))
}

@id("frame.status")
fn frame_status(frame: borrow Slice<u8>) -> i64
{
    let length = byte_len(frame);
    if length < 8usize { 2 } else { if !has_magic(frame) { 1 } else { if declared_length(frame) == length - 8usize { 0 } else { 3 } } }
}

@id("frame.payload-maybe")
fn payload_maybe(frame: borrow Slice<u8>) -> Option<Bytes>
{
    let length = byte_len(frame);
    if length < 8usize { Option<Bytes>::None {} } else { if !has_magic(frame) { Option<Bytes>::None {} } else { if declared_length(frame) == length - 8usize { Option<Bytes>::Some { value: bytes_copy(byte_range(frame, 8usize, length)) } } else { Option<Bytes>::None {} } } }
}

@id("frame.payload-result")
fn payload_result(frame: borrow Slice<u8>) -> Result<Bytes, i64>
{
    let length = byte_len(frame);
    if length < 8usize { Result<Bytes, i64>::Err { error: 2 } } else { if !has_magic(frame) { Result<Bytes, i64>::Err { error: 1 } } else { if declared_length(frame) == length - 8usize { Result<Bytes, i64>::Ok { value: bytes_copy(byte_range(frame, 8usize, length)) } } else { Result<Bytes, i64>::Err { error: 3 } } } }
}

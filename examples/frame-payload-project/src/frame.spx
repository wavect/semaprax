@id("frame.has-magic")
fn has_magic(frame: borrow Slice<u8>) -> bool
{
    match byte_get(frame, 0usize) {
        Option::Some { value: first } =>
            match byte_get(frame, 1usize) {
                Option::Some { value: second } =>
                    match byte_get(frame, 2usize) {
                        Option::Some { value: third } =>
                            match byte_get(frame, 3usize) {
                                Option::Some { value: fourth } =>
                                    first == 83u8 && second == 80u8 && third == 88u8 && fourth == 49u8,
                                Option::None {} => false,
                            },
                        Option::None {} => false,
                    },
                Option::None {} => false,
            },
        Option::None {} => false,
    }
}

@id("frame.declared-length")
fn declared_length(frame: borrow Slice<u8>) -> Option<usize>
{
    match byte_get(frame, 4usize) {
        Option::Some { value: first } =>
            match byte_get(frame, 5usize) {
                Option::Some { value: second } =>
                    match byte_get(frame, 6usize) {
                        Option::Some { value: third } =>
                            match byte_get(frame, 7usize) {
                                Option::Some { value: fourth } =>
                                    Option<usize>::Some {
                                        value: octet_to_usize(first) * 16777216usize
                                            + octet_to_usize(second) * 65536usize
                                            + octet_to_usize(third) * 256usize
                                            + octet_to_usize(fourth),
                                    },
                                Option::None {} => Option<usize>::None {},
                            },
                        Option::None {} => Option<usize>::None {},
                    },
                Option::None {} => Option<usize>::None {},
            },
        Option::None {} => Option<usize>::None {},
    }
}

@id("frame.payload")
fn payload(frame: borrow Slice<u8>) -> Bytes
{
    bytes_copy(byte_range(frame, 8usize, byte_len(frame)))
}

@id("frame.payload-maybe")
fn payload_maybe(frame: borrow Slice<u8>) -> Option<Bytes>
{
    let length = byte_len(frame);
    if length < 8usize || !has_magic(frame) {
        Option<Bytes>::None {}
    } else {
        match declared_length(frame) {
            Option::Some { value: declared } =>
                if declared == length - 8usize {
                    Option<Bytes>::Some {
                        value: bytes_copy(byte_range(frame, 8usize, length)),
                    }
                } else {
                    Option<Bytes>::None {}
                },
            Option::None {} => Option<Bytes>::None {},
        }
    }
}

@id("frame.payload-result")
fn payload_result(frame: borrow Slice<u8>) -> Result<Bytes, i64>
{
    let length = byte_len(frame);
    if length < 8usize {
        Result<Bytes, i64>::Err { error: 2 }
    } else if !has_magic(frame) {
        Result<Bytes, i64>::Err { error: 1 }
    } else {
        match declared_length(frame) {
            Option::Some { value: declared } =>
                if declared == length - 8usize {
                    Result<Bytes, i64>::Ok {
                        value: bytes_copy(byte_range(frame, 8usize, length)),
                    }
                } else {
                    Result<Bytes, i64>::Err { error: 3 }
                },
            Option::None {} => Result<Bytes, i64>::Err { error: 2 },
        }
    }
}

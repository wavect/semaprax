module frame_payload.tests;
use function @id("frame.status") from frame_payload.frame as frame_status;

@id("frame-payload.tests.main")
fn main() -> i64
{
    let valid = [83u8, 80u8, 88u8, 49u8, 0u8, 0u8, 0u8, 3u8, 65u8, 0u8, 66u8];
    let mismatch = [83u8, 80u8, 88u8, 49u8, 0u8, 0u8, 0u8, 2u8, 1u8];
    let valid_ok = frame_status(array_as_slice(valid)) == 0;
    let mismatch_ok = frame_status(array_as_slice(mismatch)) == 3;
    if valid_ok && mismatch_ok { 0 } else { 1 }
}

module owned.data;

@id("owned.data.Entry")
record Entry {
    @id("owned.data.Entry.name")
    name: string,
    @id("owned.data.Entry.priority")
    priority: i64,
}

@id("owned.data.verify")
fn verify() -> i64
{
    let mut rows = vec_with_capacity<Entry>(2usize);
    rows = vec_push<Entry>(rows, Entry { name: "beta", priority: 20 });
    rows = vec_push<Entry>(rows, Entry { name: "alpha", priority: 10 });
    rows = vec_sort_owned<Entry>(rows);
    let first = vec_clone_at<Entry>(rows, 0usize);
    let first_ok = match own first { Entry { name, priority } => if name == "alpha" && priority == 10 { 1 } else { 0 }, };
    rows = vec_replace<Entry>(rows, 0usize, Entry { name: "gamma", priority: 30 });
    let mut total = 0;
    for own row in vec_into_iter<Entry>(rows) {
        match own row { Entry { name, priority } => { total = total + priority; 0 }, }
    }
    if first_ok == 1 && total == 50 { 0 } else { 1 }
}

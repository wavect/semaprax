module examples.records;

@id("geometry.point")
record Point {
    @id("geometry.point.x")
    x: i64,
    @id("geometry.point.y")
    y: i64,
    @id("geometry.point.enabled")
    enabled: bool,
}

@id("geometry.line")
record Line {
    @id("geometry.line.start")
    start: Point,
    @id("geometry.line.end")
    end: Point,
}

@id("geometry.line.shift")
fn shift(line: Line, amount: i64) -> Line
{
    line with { start: line.start with { x: line.start.x + amount } }
}

@id("app.main")
fn main() -> i64
{
    let point = Point { y: 22, enabled: true, x: 18 };
    let line = Line { end: Point { x: 0, y: 0, enabled: false }, start: point };
    let shifted = shift(line, 2);
    if shifted.start.enabled { shifted.start.x + shifted.start.y } else { 0 }
}

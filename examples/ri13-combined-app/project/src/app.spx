module ri13.combined;

@id("regex.resource") resource Regex { @id("regex.resource.drop") drop import "regex.drop"; }
@id("url.resource") resource Url { @id("url.resource.drop") drop import "url.drop"; }
@id("regex.host") interface RegexHost permits { } {
    @id("regex.drop") import fn drop_regex(regex: own Regex) -> unit effects { } failure infallible consumes regex always;
    @id("regex.new") import rust selected fn regex_new from "regex_alias::Regex::new" effects { } failure infallible;
    @id("regex.match") import rust selected fn regex_match from "regex_alias::Regex::is_match" effects { } failure infallible;
}
@id("url.host") interface UrlHost permits { } {
    @id("url.drop") import fn drop_url(url: own Url) -> unit effects { } failure infallible consumes url always;
    @id("url.new") import rust selected fn url_new from "url_alias::Url::parse" effects { } failure infallible;
    @id("url.view") import rust selected fn url_view from "url_alias::Url::as_str" effects { } failure infallible;
}
@id("regex.run") fn regex_probe() -> i64 { let pattern = "example"; let input = "https://example.invalid/path"; let created = regex_new(pattern); match borrow created { Result::Ok { value: owner } => if regex_match(owner, input) { 41 } else { 7 }, Result::Err { error } => 9, } }
@id("url.run") fn url_probe() -> i64 { let input = "https://example.invalid/path"; let created = url_new(input); match borrow created { Result::Ok { value: owner } => { let view = url_view(owner); let bytes = str_as_bytes(view); if byte_len(bytes) == 28usize { 41 } else { 7 } }, Result::Err { error } => 9, } }

@id("ri13.event") record Event { @id("ri13.event.value") value: i64, @id("ri13.event.label") label: string, }
@id("callback.factory") fn factory(offset: i64) -> fn(i64) -> i64 { fn(value: i64) -> i64 { value + offset } }
@id("callback.advance") fn advance(state: i64, value: i64) -> i64 requires value >= 0 { state + value }

@id("ri13.m3.score") fn score(seed: i64) -> i64 yields i64 -> i64 requires seed >= 0 && seed <= 1000 ensures result >= 0 { let response = yield seed + 1; response + seed }
@id("app.main") fn main() -> i64 { 0 }

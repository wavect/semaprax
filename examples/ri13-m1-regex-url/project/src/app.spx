module ri13.regex_url;

@id("regex.resource")
resource Regex {
    @id("regex.resource.drop")
    drop import "regex.drop";
}

@id("url.resource")
resource Url {
    @id("url.resource.drop")
    drop import "url.drop";
}

@id("regex.host")
interface RegexHost
    permits {  }
{
    @id("regex.drop")
    import fn drop_regex(regex: own Regex) -> unit
        effects {  }
        failure infallible
        consumes regex always;
    @id("regex.new")
    import rust selected fn regex_new from "regex_alias::Regex::new"
        effects {  }
        failure infallible;
    @id("regex.match")
    import rust selected fn regex_match from "regex_alias::Regex::is_match"
        effects {  }
        failure infallible;
}

@id("url.host")
interface UrlHost
    permits {  }
{
    @id("url.drop")
    import fn drop_url(url: own Url) -> unit
        effects {  }
        failure infallible
        consumes url always;
    @id("url.new")
    import rust selected fn url_new from "url_alias::Url::parse"
        effects {  }
        failure infallible;
    @id("url.view")
    import rust selected fn url_view from "url_alias::Url::as_str"
        effects {  }
        failure infallible;
}

@id("regex.run")
fn regex_probe() -> i64
{
    let pattern = "example";
    let input = "https://example.invalid/path";
    let created = regex_new(pattern);
    match borrow created { Result::Ok { value: owner } => if regex_match(owner, input) { 41 } else { 7 }, Result::Err { error } => 9, }
}

@id("url.run")
fn url_probe() -> i64
{
    let input = "https://example.invalid/path";
    let created = url_new(input);
    match borrow created { Result::Ok { value: owner } => { let view = url_view(owner); let bytes = str_as_bytes(view); if byte_len(bytes) == 28usize { 41 } else { 7 } }, Result::Err { error } => 9, }
}

@id("app.main")
fn main() -> i64
{
    0
}

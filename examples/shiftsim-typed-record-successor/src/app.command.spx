module shiftsim.app;

use type @id("shiftsim.request") from shiftsim.request_schema as Request;
use type @id("shiftsim.request.json.stream-input") from shiftsim.request_schema as StreamInput;
use type @id("shiftsim.request.json.owned-result") from shiftsim.request_schema as Decode;
use type @id("shiftsim.report.json.collection-response.encode-result") from shiftsim.response_schema as Encoded;
use type @id("shiftsim.schedule_result") from shiftsim.model as ScheduleResult;
use function @id("shiftsim.request.json.stream.normalize") from shiftsim.request_schema as normalize;
use function @id("shiftsim.request.json.owned.decode") from shiftsim.request_schema as decode;
use function @id("shiftsim.report.json.collection-response.encode") from shiftsim.response_schema as encode;
use function @id("shiftsim.schedule.run") from shiftsim.schedule as run;

permit { process.stdin.read, process.stdout.write, process.stderr.write }

@id("shiftsim.receive")
fn receive() -> Decode uses { process.stdin.read }
{
    let stream_input = normalize();
    match own stream_input {
        StreamInput::Error { code, offset, field } => Decode::Error {
            code: code,
            offset: offset,
            field: field,
        },
        StreamInput::Ready { bytes, length } => {
            decode(byte_range(bytes_as_slice(bytes), 0usize, length))
        },
    }
}

@id("shiftsim.reject")
fn reject() -> i64 uses { process.stderr.write }
{
    let message = "invalid ShiftSim request\n";
    let diagnostic = str_as_bytes(string_as_str(message));
    let _ = stderr_write(diagnostic);
    2
}

@id("shiftsim.command")
fn command() -> i64 uses { process.stdin.read, process.stdout.write, process.stderr.write }
{
    let decoded = receive();
    match own decoded {
        Decode::Error { code: _error_code, offset: _error_offset, field: _error_field } => reject(),
        Decode::Decoded { servers, patients } => {
            let outcome = run(Request { servers, patients });
            match own outcome {
                ScheduleResult { valid: false, report: _invalid_report } => reject(),
                ScheduleResult { valid: true, report } => {
                    let encoded = encode(report, 131071usize);
                    match own encoded {
                        Encoded::Refused { required: _required } => reject(),
                        Encoded::Encoded { text } => {
                            let line = string_concat(text, "\n");
                            let output = str_as_bytes(string_as_str(line));
                            let written = stdout_write(output);
                            if written == byte_len(output) { 0 } else { 1 }
                        },
                    }
                },
            }
        },
    }
}

@id("shiftsim.app.main")
fn main() -> i64 { 0 }

module shiftsim.app;

permit { process.stdin.read }

@id("shiftsim.command")
fn command() -> i64
    uses { process.stdin.read }
{
    let mut reader = stdin_stream_open();
    while !stdin_stream_eof(reader) { reader = stdin_stream_next(reader); 0 }
    0
}

@id("shiftsim.app.main")
fn main() -> i64
{
    0
}

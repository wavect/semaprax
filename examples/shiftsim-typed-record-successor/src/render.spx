module shiftsim.render;
use type @id("shiftsim.assignment") from shiftsim.model as Assignment;
use type @id("shiftsim.metrics") from shiftsim.model as Metrics;
use type @id("shiftsim.report") from shiftsim.model as Report;

@id("shiftsim.render.report")
fn render(value: own Report) -> string
{
    match own value {
        Report { assignments, metrics } => {
            let mut out = "{\"assignments\":[";
            let mut first = true;
            for own assignment in vec_into_iter<Assignment>(assignments) {
                match own assignment {
                    Assignment { id, server, arrival, start, finish, wait, late } => {
                        let prefix = if first { "" } else { "," };
                        let late_json = if late { "true" } else { "false" };
                        out = string_concat(out, prefix);
                        out = string_concat(out, "{\"id\":\"");
                        out = string_concat(out, id);
                        out = string_concat(out, "\",\"server\":\"");
                        out = string_concat(out, server);
                        out = string_concat(out, "\",\"arrival\":");
                        out = string_concat(out, string_from_i64(arrival));
                        out = string_concat(out, ",\"start\":");
                        out = string_concat(out, string_from_i64(start));
                        out = string_concat(out, ",\"finish\":");
                        out = string_concat(out, string_from_i64(finish));
                        out = string_concat(out, ",\"wait\":");
                        out = string_concat(out, string_from_i64(wait));
                        out = string_concat(out, ",\"late\":");
                        out = string_concat(out, late_json);
                        out = string_concat(out, "}");
                        first = false;
                        0
                    },
                }
            }
            out = string_concat(out, "],\"metrics\":{\"patients\":");
            out = string_concat(out, string_from_i64(metrics.patients));
            out = string_concat(out, ",\"total_wait\":");
            out = string_concat(out, string_from_i64(metrics.total_wait));
            out = string_concat(out, ",\"max_wait\":");
            out = string_concat(out, string_from_i64(metrics.max_wait));
            out = string_concat(out, ",\"late\":");
            out = string_concat(out, string_from_i64(metrics.late));
            out = string_concat(out, ",\"busy_time\":");
            out = string_concat(out, string_from_i64(metrics.busy_time));
            out = string_concat(out, ",\"makespan\":");
            out = string_concat(out, string_from_i64(metrics.makespan));
            out = string_concat(out, ",\"peak_queue\":");
            out = string_concat(out, string_from_i64(metrics.peak_queue));
            out = string_concat(out, ",\"utilization_ppm\":");
            out = string_concat(out, string_from_i64(metrics.utilization_ppm));
            string_concat(out, "}}\n")
        },
    }
}

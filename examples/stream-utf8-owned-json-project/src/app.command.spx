module catalog.app;

use type @id("catalog.row") from catalog.schema as Row;
use type @id("catalog.request.json.stream-input") from catalog.schema as StreamInput;
use type @id("catalog.request.json.utf8.owned-result") from catalog.schema as Outcome;
use type @id("catalog.row.json.view-encode") from catalog.schema as Encoded;
use function @id("catalog.request.json.stream.normalize") from catalog.schema as normalize;
use function @id("catalog.request.json.utf8.owned.decode") from catalog.schema as decode;
use function @id("catalog.request.json.utf8.owned.encode") from catalog.schema as encode;

permit { process.args.read, process.stderr.write, process.stdin.read, process.stdout.write }

@id("catalog.receive")
fn receive() -> Outcome uses { process.stdin.read } {
    let normalized = normalize();
    match own normalized {
        StreamInput::Error { code, offset, field } => Outcome::Error { code: code, offset: offset, field: field },
        StreamInput::Ready { bytes, length } => decode(byte_range(bytes_as_slice(bytes), 0usize, length)),
    }
}

@id("catalog.bump")
fn bump(value: own Row) -> Row {
    match own value {
        Row { number, text } => Row { number: number + 1, text: text },
    }
}

@id("catalog.command")
fn command() -> i64 uses { process.stdin.read, process.stdout.write } {
    let result = receive();
    match own result {
        Outcome::Error { code, offset, field } => 2,
        Outcome::Decoded { labels, rows } => {
            if vec_len<Row>(rows) == 0usize { 2 } else {
                let first = vec_clone_at<Row>(rows, 0usize);
                let revised = bump(first);
                let rows = vec_replace<Row>(rows, 0usize, revised);
                let rendered = encode(labels, rows, 131072usize);
                match own rendered {
                    Encoded::Refused { required } => 2,
                    Encoded::Encoded { text } => {
                        let bytes = str_as_bytes(string_as_str(text));
                        let written = stdout_write(bytes);
                        if written == byte_len(bytes) { 0 } else { 1 }
                    },
                }
            }
        },
    }
}

@id("catalog.app.main")
fn main() -> i64 { 0 }

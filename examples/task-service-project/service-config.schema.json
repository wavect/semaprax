{
  "$id": "urn:semaprax:service-config:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "fixture" } } },
      "then": {
        "properties": {
          "database": { "properties": { "adapter": { "const": "fixture" }, "dsn_secret_ref": { "const": null } } },
          "http": { "properties": { "adapter": { "const": "fixture" }, "listen_origin": { "const": null }, "tls_profile": { "const": "fixture" } } },
          "secrets": { "properties": { "password_pepper_ref": { "const": null }, "session_signing_key_ref": { "const": null }, "webhook_signing_key_ref": { "const": null } } },
          "telemetry": { "properties": { "adapter": { "const": "fixture" }, "endpoint_origin": { "const": null } } }
        }
      }
    },
    {
      "if": { "properties": { "mode": { "const": "host" } } },
      "then": {
        "properties": {
          "database": { "properties": { "adapter": { "const": "snapshot" }, "dsn_secret_ref": { "const": null } } },
          "http": { "properties": { "adapter": { "const": "native" }, "listen_origin": { "type": "string", "pattern": "^https://[a-z0-9][a-z0-9.-]*[a-z0-9](:(?:[1-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?$" }, "tls_profile": { "const": "modern" } } },
          "secrets": { "properties": { "password_pepper_ref": { "type": "string" }, "session_signing_key_ref": { "type": "string" }, "webhook_signing_key_ref": { "type": "string" } } },
          "telemetry": { "properties": { "adapter": { "enum": ["semaprax-json-events", "semaprax-json-events-v2", "otlp-http-json"] }, "endpoint_origin": { "type": "string", "pattern": "^https://[a-z0-9][a-z0-9.-]*[a-z0-9](:(?:[1-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?$" } } }
        }
      }
    }
  ],
  "properties": {
    "database": {
      "additionalProperties": false,
      "properties": {
        "adapter": { "enum": ["fixture", "snapshot"] },
        "dsn_secret_ref": { "type": ["string", "null"], "maxLength": 128, "pattern": "^[a-z][a-z0-9._-]*$" },
        "migration_table": { "type": "string", "const": "semaprax_migrations" }
      },
      "required": ["adapter", "dsn_secret_ref", "migration_table"],
      "type": "object"
    },
    "http": {
      "additionalProperties": false,
      "properties": {
        "adapter": { "enum": ["fixture", "native"] },
        "listen_origin": { "type": ["string", "null"], "maxLength": 2048 },
        "tls_profile": { "enum": ["fixture", "modern"] }
      },
      "required": ["adapter", "listen_origin", "tls_profile"],
      "type": "object"
    },
    "mode": { "enum": ["fixture", "host"] },
    "schema": { "const": "semaprax.service-config.v1" },
    "secrets": {
      "additionalProperties": false,
      "properties": {
        "password_pepper_ref": { "type": ["string", "null"], "maxLength": 128, "pattern": "^[a-z][a-z0-9._-]*$" },
        "session_signing_key_ref": { "type": ["string", "null"], "maxLength": 128, "pattern": "^[a-z][a-z0-9._-]*$" },
        "webhook_signing_key_ref": { "type": ["string", "null"], "maxLength": 128, "pattern": "^[a-z][a-z0-9._-]*$" }
      },
      "required": ["password_pepper_ref", "session_signing_key_ref", "webhook_signing_key_ref"],
      "type": "object"
    },
    "telemetry": {
      "additionalProperties": false,
      "properties": {
        "adapter": { "enum": ["fixture", "semaprax-json-events", "semaprax-json-events-v2", "otlp-http-json"] },
        "endpoint_origin": { "type": ["string", "null"], "maxLength": 2048 }
      },
      "required": ["adapter", "endpoint_origin"],
      "type": "object"
    }
  },
  "required": ["schema", "mode", "database", "http", "secrets", "telemetry"],
  "title": "SEMAPRAX service host configuration v1",
  "type": "object"
}

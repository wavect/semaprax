module task_service.tests;
use function @id("task_service.core.enqueue_outcome") from task_service.core as enqueue_outcome;
use function @id("task_service.core.completed_job_export_is_admitted") from task_service.core as completed_job_export_is_admitted;
use function @id("task_service.core.completed_job_metric_is_admitted") from task_service.core as completed_job_metric_is_admitted;
use function @id("task_service.core.create_is_committed") from task_service.core as create_is_committed;
use function @id("task_service.core.identifier_is_valid") from task_service.core as identifier_is_valid;
use function @id("task_service.core.job_status_is_complete") from task_service.core as job_status_is_complete;
use function @id("task_service.core.mark_job_succeeded") from task_service.core as mark_job_succeeded;
use function @id("task_service.core.method_is_rejected") from task_service.core as method_is_rejected;
use function @id("task_service.core.migration_is_admitted") from task_service.core as migration_is_admitted;
use function @id("task_service.core.registration_admitted") from task_service.core as registration_admitted;
use function @id("task_service.core.request_is_admitted") from task_service.core as request_is_admitted;
use function @id("task_service.core.run_scenario") from task_service.core as run_scenario;
use function @id("task_service.core.structured_log_policy_is_admitted") from task_service.core as structured_log_policy_is_admitted;
use function @id("task_service.core.task_owner_authorized") from task_service.core as task_owner_authorized;
use function @id("task_service.core.trace_context_is_admitted") from task_service.core as trace_context_is_admitted;
use function @id("task_service.core.update_is_committed") from task_service.core as update_is_committed;
use function @id("task_service.core.webhook_delivery_policy_is_admitted") from task_service.core as webhook_delivery_policy_is_admitted;

// The whole acceptance scenario succeeds end to end.
@id("task_service.tests.scenario_succeeds")
fn scenario_succeeds() -> bool
{
    run_scenario() == 0
}

// Success: registration, ownership, and job completion all admit on
// well-formed input.
@id("task_service.tests.success_path")
fn success_path() -> bool
{
    let username = [98u8, 111u8, 98u8];
    let job_state = mark_job_succeeded(0u8, 3u8);
    let table_name = [116u8, 97u8, 115u8, 107u8, 115u8];
    registration_admitted(array_as_slice(username), 2usize, 10usize, 65536usize, 3usize, 4usize) && task_owner_authorized(3, 3, true) && job_status_is_complete(job_state) && identifier_is_valid(array_as_slice(table_name))
}

// Reject unauthorized: a session bound to a different account is refused
// row access even though the row itself exists.
@id("task_service.tests.unauthorized_is_rejected")
fn unauthorized_is_rejected() -> bool
{
    !task_owner_authorized(3, 4, true)
}

// Reject invalid: a malformed HTTP method and an unsafe table identifier
// (leading digit) are both refused before touching storage or routing.
@id("task_service.tests.invalid_is_rejected")
fn invalid_is_rejected() -> bool
{
    let bad_method = [103u8, 101u8, 116u8];
    let bad_identifier = [57u8, 120u8];
    let get = [71u8, 69u8, 84u8];
    let userinfo_target = [104u8, 116u8, 116u8, 112u8, 58u8, 47u8, 47u8, 117u8, 115u8, 101u8, 114u8, 64u8, 101u8, 120u8, 97u8, 109u8, 112u8, 108u8, 101u8, 46u8, 99u8, 111u8, 109u8, 47u8, 116u8, 97u8, 115u8, 107u8, 115u8];
    method_is_rejected(array_as_slice(bad_method)) && !identifier_is_valid(array_as_slice(bad_identifier)) && !request_is_admitted(array_as_slice(get), array_as_slice(userinfo_target))
}

// The next migration must be the unique successor and a task update starts
// from an idle transaction state. Replays or skipped versions stay refused.
@id("task_service.tests.migration_and_transaction_are_checked")
fn migration_and_transaction_are_checked() -> bool
{
    let applied = [1u8, 2u8];
    migration_is_admitted(2u8, array_as_slice(applied), 3u8) && !migration_is_admitted(2u8, array_as_slice(applied), 2u8) && !migration_is_admitted(2u8, array_as_slice(applied), 4u8) && create_is_committed(0usize) && !create_is_committed(1usize) && update_is_committed(0usize)
}

// A retried enqueue with the same idempotency key is a harmless duplicate
// (outcome 1), never a second job.
@id("task_service.tests.duplicate_enqueue_is_idempotent")
fn duplicate_enqueue_is_idempotent() -> bool
{
    let key = [1u8, 4u8, 3u8];
    enqueue_outcome(true, array_as_slice(key), array_as_slice(key)) == 1usize
}

// Structured-log admission is an effect-free policy only. The exact level and
// field-count ceilings are bounded, and every protected-field classification
// refuses before any host writer, exporter, or delivery adapter could observe
// the event.
@id("task_service.tests.structured_log_is_bounded_and_redacted")
fn structured_log_is_bounded_and_redacted() -> bool
{
    let admitted = structured_log_policy_is_admitted(2u8, 2u8, 32usize, false, false, false, false, false, false);
    let filtered = !structured_log_policy_is_admitted(1u8, 4u8, 1usize, false, false, false, false, false, false);
    let invalid_level = !structured_log_policy_is_admitted(6u8, 2u8, 1usize, false, false, false, false, false, false);
    let too_many_fields = !structured_log_policy_is_admitted(2u8, 2u8, 33usize, false, false, false, false, false, false);
    let password = !structured_log_policy_is_admitted(2u8, 2u8, 1usize, true, false, false, false, false, false);
    let api_key = !structured_log_policy_is_admitted(2u8, 2u8, 1usize, false, true, false, false, false, false);
    let bearer = !structured_log_policy_is_admitted(2u8, 2u8, 1usize, false, false, true, false, false, false);
    let session = !structured_log_policy_is_admitted(2u8, 2u8, 1usize, false, false, false, true, false, false);
    let webhook_secret = !structured_log_policy_is_admitted(2u8, 2u8, 1usize, false, false, false, false, true, false);
    let smtp_credential = !structured_log_policy_is_admitted(2u8, 2u8, 1usize, false, false, false, false, false, true);
    admitted && filtered && invalid_level && too_many_fields && password && api_key && bearer && session && webhook_secret && smtp_credential
}

// A valid W3C-shaped trace context with no classified secret is admitted by
// the pure policy. It does not emit a log or span.
@id("task_service.tests.trace_context_is_admitted")
fn trace_context_is_admitted_test() -> bool
{
    let trace_id = [52u8, 98u8, 102u8, 57u8, 50u8, 102u8, 51u8, 53u8, 55u8, 55u8, 98u8, 51u8, 52u8, 100u8, 97u8, 54u8, 97u8, 51u8, 99u8, 101u8, 57u8, 50u8, 57u8, 100u8, 48u8, 101u8, 48u8, 101u8, 52u8, 55u8, 51u8, 54u8];
    let parent_id = [48u8, 48u8, 102u8, 48u8, 54u8, 55u8, 97u8, 97u8, 48u8, 98u8, 97u8, 57u8, 48u8, 50u8, 98u8, 55u8];
    let trace_flags = [48u8, 49u8];
    trace_context_is_admitted(array_as_slice(trace_id), array_as_slice(parent_id), array_as_slice(trace_flags), false)
}

// Every trace-context field is independently refused when malformed; the
// trace ID also rejects same-length non-hex and all-zero values. A
// caller-classified secret is refused before any adapter could emit telemetry.
@id("task_service.tests.trace_context_is_refused")
fn trace_context_is_refused_test() -> bool
{
    let trace_id = [52u8, 98u8, 102u8, 57u8, 50u8, 102u8, 51u8, 53u8, 55u8, 55u8, 98u8, 51u8, 52u8, 100u8, 97u8, 54u8, 97u8, 51u8, 99u8, 101u8, 57u8, 50u8, 57u8, 100u8, 48u8, 101u8, 48u8, 101u8, 52u8, 55u8, 51u8, 54u8];
    let parent_id = [48u8, 48u8, 102u8, 48u8, 54u8, 55u8, 97u8, 97u8, 48u8, 98u8, 97u8, 57u8, 48u8, 50u8, 98u8, 55u8];
    let trace_flags = [48u8, 49u8];
    let malformed_trace_id = [48u8];
    let non_hex_trace_id = [71u8; 32];
    let all_zero_trace_id = [48u8; 32];
    let malformed_parent_id = [48u8];
    let malformed_trace_flags = [48u8];
    !trace_context_is_admitted(array_as_slice(malformed_trace_id), array_as_slice(parent_id), array_as_slice(trace_flags), false) && !trace_context_is_admitted(array_as_slice(non_hex_trace_id), array_as_slice(parent_id), array_as_slice(trace_flags), false) && !trace_context_is_admitted(array_as_slice(all_zero_trace_id), array_as_slice(parent_id), array_as_slice(trace_flags), false) && !trace_context_is_admitted(array_as_slice(trace_id), array_as_slice(malformed_parent_id), array_as_slice(trace_flags), false) && !trace_context_is_admitted(array_as_slice(trace_id), array_as_slice(parent_id), array_as_slice(malformed_trace_flags), false) && !trace_context_is_admitted(array_as_slice(trace_id), array_as_slice(parent_id), array_as_slice(trace_flags), true)
}

// Metrics have both a shape boundary and a caller-classified secret boundary;
// a safe completed-job label admits, while a secret-classified one does not.
@id("task_service.tests.completed_job_metric_is_guarded")
fn completed_job_metric_is_guarded() -> bool
{
    let label = [106u8, 111u8, 98u8, 95u8, 115u8, 116u8, 97u8, 116u8, 101u8];
    let value = [115u8, 117u8, 99u8, 99u8, 101u8, 101u8, 100u8, 101u8, 100u8];
    completed_job_metric_is_admitted(array_as_slice(label), array_as_slice(value), false) && !completed_job_metric_is_admitted(array_as_slice(label), array_as_slice(value), true)
}

// Export admission refuses a full queue and a target that could splice a
// second header. Neither refusal represents an attempted delivery.
@id("task_service.tests.completed_job_export_is_bounded")
fn completed_job_export_is_bounded() -> bool
{
    let target = [116u8, 97u8, 115u8, 107u8, 45u8, 115u8, 101u8, 114u8, 118u8, 105u8, 99u8, 101u8, 45u8, 111u8, 98u8, 115u8, 101u8, 114u8, 118u8, 97u8, 98u8, 105u8, 108u8, 105u8, 116u8, 121u8];
    let injected_target = [116u8, 97u8, 114u8, 103u8, 101u8, 116u8, 13u8, 10u8, 120u8];
    completed_job_export_is_admitted(0, 1usize, 32usize, array_as_slice(target)) && !completed_job_export_is_admitted(1024, 1usize, 32usize, array_as_slice(target)) && !completed_job_export_is_admitted(0, 1usize, 32usize, array_as_slice(injected_target))
}

// A webhook is only a policy decision in this reference application. Fresh
// and exact-duplicate delivery descriptors are admitted, while a key conflict,
// stale timestamp, ninth retry, or caller-classified secret is refused before
// any signing, queueing, retry scheduling, or transport could occur.
@id("task_service.tests.webhook_delivery_is_idempotent_and_bounded")
fn webhook_delivery_is_idempotent_and_bounded() -> bool
{
    let signature = [97u8; 64];
    let descriptor = [116u8, 97u8, 115u8, 107u8, 45u8, 49u8];
    let conflicting_descriptor = [116u8, 97u8, 115u8, 107u8, 45u8, 50u8];
    let fresh = webhook_delivery_policy_is_admitted(array_as_slice(signature), 128usize, 1000, 1100, false, array_as_slice(descriptor), array_as_slice(descriptor), 1, false);
    let exact_duplicate = webhook_delivery_policy_is_admitted(array_as_slice(signature), 128usize, 1000, 1100, true, array_as_slice(descriptor), array_as_slice(descriptor), 1, false);
    let conflict_refused = !webhook_delivery_policy_is_admitted(array_as_slice(signature), 128usize, 1000, 1100, true, array_as_slice(descriptor), array_as_slice(conflicting_descriptor), 1, false);
    let stale_refused = !webhook_delivery_policy_is_admitted(array_as_slice(signature), 128usize, 1000, 1401, false, array_as_slice(descriptor), array_as_slice(descriptor), 1, false);
    let ninth_attempt_refused = !webhook_delivery_policy_is_admitted(array_as_slice(signature), 128usize, 1000, 1100, false, array_as_slice(descriptor), array_as_slice(descriptor), 9, false);
    let secret_refused = !webhook_delivery_policy_is_admitted(array_as_slice(signature), 128usize, 1000, 1100, false, array_as_slice(descriptor), array_as_slice(descriptor), 1, true);
    fresh && exact_duplicate && conflict_refused && stale_refused && ninth_attempt_refused && secret_refused
}

@id("task_service.tests.main")
fn main() -> i64
{
    if scenario_succeeds() && success_path() && unauthorized_is_rejected() && invalid_is_rejected() && migration_and_transaction_are_checked() && duplicate_enqueue_is_idempotent() && structured_log_is_bounded_and_redacted() && trace_context_is_admitted_test() && trace_context_is_refused_test() && completed_job_metric_is_guarded() && completed_job_export_is_bounded() && webhook_delivery_is_idempotent_and_bounded() { 0 } else { 1 }
}

// A required disjoint follower cannot consume a byte removed from this run.
// This proof reads six metadata bytes and at most one bitmap byte. No input
// byte is inspected and no accept-capable count vector is skipped.
@id("experiment.pattern.disjoint")
variant Disjoint {
    @id("experiment.pattern.disjoint.checked")
    Checked {
        @id("experiment.pattern.disjoint.checked.value") value: usize,
        @id("experiment.pattern.disjoint.checked.work") work: usize,
    },
}

@id("experiment.pattern.disjoint-follower")
fn disjoint_follower(state: borrow Matcher, atom: usize) -> Disjoint
    requires carrier_valid(state) && atom < 127usize
{
    let current_kind = read(state, 64usize + atom * 8usize);
    let current_value = read(state, 65usize + atom * 8usize);
    let next_kind = read(state, 72usize + atom * 8usize);
    let next_value = read(state, 73usize + atom * 8usize);
    let next_minimum = load2(state, 74usize + atom * 8usize);
    let mut work = 6usize;
    let mut separated = false;
    if next_minimum != 0usize {
        if current_kind == 0usize && next_kind == 0usize { separated = current_value != next_value; } else {
            if current_kind == 2usize && next_kind == 0usize {
                let bitmap = read(state, 1088usize + current_value * 32usize + next_value / 8usize);
                work = 7usize;
                separated = bitmap / bit(next_value % 8usize) % 2usize == 0usize;
            } else {
                if current_kind == 0usize && next_kind == 2usize {
                    let bitmap = read(state, 1088usize + next_value * 32usize + current_value / 8usize);
                    work = 7usize;
                    separated = bitmap / bit(current_value % 8usize) % 2usize == 0usize;
                }
            }
        }
    }
    Disjoint::Checked { value: if separated { 1usize } else { 0usize }, work: work }
}

// Provisional compiled header: SPAC, version 1, ready=1, atom/class/capture
// counts, then zeros through byte 63. Each used atom occupies eight bytes:
// kind (0 literal, 1 any, 2 class), value, u16 minimum, u32 maximum.
// 0xffffffff denotes an unbounded maximum. No unused frame is ever loaded.
@id("experiment.pattern.full-match")
fn full_match(state: own Matcher, input: borrow Slice<u8>, work_limit: usize) -> Matcher
    requires carrier_valid(state)
    requires 32usize <= work_limit && work_limit <= 262144usize
{
    let mut matcher = state;
    let length = byte_len(input);
    let mut work = 0usize;
    let mut exhausted = false;
    let mut invalid = false;
    let mut detail = 0usize;
    let mut reason = 0usize;
    let mut atoms = 0usize;
    let mut classes = 0usize;
    let mut captures = 0usize;
    let mut header = 0usize;
    if length > 65536usize {
        exhausted = true;
        reason = 2usize;
        detail = length;
    }
    while header < 64usize && !exhausted && !invalid {
        if affords(work, 2usize, work_limit) {
            work = work + 2usize;
            let value = read(matcher, header);
            let expected = if header == 0usize { 83usize } else {
                if header == 1usize { 80usize } else {
                    if header == 2usize { 65usize } else {
                        if header == 3usize { 67usize } else {
                            if header == 4usize || header == 5usize { 1usize } else { 0usize }
                        }
                    }
                }
            };
            if header == 6usize {
                atoms = value;
                invalid = atoms > 128usize;
            } else {
                if header == 7usize {
                    classes = value;
                    invalid = classes > 16usize;
                } else {
                    if header == 8usize {
                        captures = value;
                        invalid = captures > 16usize;
                    } else { invalid = value != expected; }
                }
            }
            if invalid { detail = header; }
            header = header + 1usize;
            0
        } else {
            exhausted = true;
            reason = 7usize;
            0
        }
        0
    }
    let mut checked_atom = 0usize;
    while checked_atom < atoms && !exhausted && !invalid {
        if affords(work, 9usize, work_limit) {
            work = work + 9usize;
            let offset = 64usize + checked_atom * 8usize;
            let kind = read(matcher, offset);
            let value = read(matcher, offset + 1usize);
            let minimum = load2(matcher, offset + 2usize);
            let maximum = load4(matcher, offset + 4usize);
            if kind > 2usize {
                invalid = true;
                detail = offset;
            } else {
                if kind == 1usize && value != 0usize || kind == 2usize && value >= classes {
                    invalid = true;
                    detail = offset + 1usize;
                } else {
                    if minimum > 255usize {
                        invalid = true;
                        detail = offset + 2usize;
                    } else {
                        if maximum != 4294967295usize && (maximum < minimum || maximum > 255usize) {
                            invalid = true;
                            detail = offset + 4usize;
                        } else { 0usize }
                    }
                }
            }
            checked_atom = checked_atom + 1usize;
            0
        } else {
            exhausted = true;
            reason = 7usize;
            0
        }
        0
    }
    let mut checked_capture = 0usize;
    let mut previous_end = 0usize;
    while checked_capture < captures && !exhausted && !invalid {
        if affords(work, 5usize, work_limit) {
            work = work + 5usize;
            let offset = 1600usize + checked_capture * 4usize;
            let start = load2(matcher, offset);
            let end = load2(matcher, offset + 2usize);
            invalid = start < previous_end || start > end || end > atoms;
            if invalid { detail = offset; }
            previous_end = end;
            checked_capture = checked_capture + 1usize;
            0
        } else {
            exhausted = true;
            reason = 7usize;
            0
        }
        0
    }
    let mut atom = 0usize;
    let mut position = 0usize;
    let mut rewinding = false;
    let mut accepted = false;
    let mut finished = false;
    // A positive minimum on the final atom requires it to consume the final
    // input byte in every accepting count vector. Authenticate the complete
    // table above before using this bounded necessary-condition rejection.
    if length >= 64usize && atoms != 0usize && !exhausted && !invalid {
        if affords(work, 2usize, work_limit) {
            work = work + 2usize;
            let final_atom = atoms - 1usize;
            let minimum = load2(matcher, 66usize + final_atom * 8usize);
            if minimum != 0usize {
                if affords(work, 3usize, work_limit) {
                    work = work + 3usize;
                    let kind = read(matcher, 64usize + final_atom * 8usize);
                    let value = read(matcher, 65usize + final_atom * 8usize);
                    let byte = input_byte(input, length - 1usize);
                    if kind == 2usize {
                        if affords(work, 1usize, work_limit) {
                            work = work + 1usize;
                            let bitmap = read(matcher, 1088usize + value * 32usize + byte / 8usize);
                            finished = bitmap / bit(byte % 8usize) % 2usize == 0usize;
                        } else { exhausted = true; reason = 7usize; }
                    } else { finished = kind == 0usize && byte != value; }
                } else { exhausted = true; reason = 7usize; }
            }
        } else { exhausted = true; reason = 7usize; }
    }
    while !finished && !exhausted && !invalid {
        if rewinding {
            if atom == 0usize {
                if affords(work, 1usize, work_limit) {
                    work = work + 1usize;
                    finished = true;
                    0
                } else {
                    exhausted = true;
                    reason = 7usize;
                    0
                }
                0
            } else {
                if affords(work, 11usize, work_limit) {
                    work = work + 11usize;
                    atom = atom - 1usize;
                    let minimum = load2(matcher, 66usize + atom * 8usize);
                    let start = load4(matcher, 1664usize + atom * 8usize);
                    let count = load4(matcher, 1668usize + atom * 8usize);
                    if count > minimum {
                        let mut separated = false;
                        if length >= 64usize && atom + 1usize < atoms && affords(work, 7usize, work_limit) {
                            let checked = match disjoint_follower(matcher, atom) { Disjoint::Checked { value: proof, work: used } => { separated = proof != 0usize; work = work + used; 0 }, };
                        }
                        if !separated {
                            if affords(work, 4usize, work_limit) {
                                work = work + 4usize;
                                matcher = store4(matcher, 1668usize + atom * 8usize, count - 1usize);
                                position = start + count - 1usize;
                                atom = atom + 1usize;
                                rewinding = false;
                                0
                            } else {
                                exhausted = true;
                                reason = 7usize;
                                0
                            }
                            0
                        } else { 0 }
                        0
                    } else { 0 }
                    0
                } else {
                    exhausted = true;
                    reason = 7usize;
                    0
                }
                0
            }
            0
        } else {
            if atom == atoms {
                if affords(work, 9usize, work_limit) {
                    work = work + 9usize;
                    matcher = frame(matcher, atom, position, 0usize);
                    accepted = position == length;
                    finished = accepted;
                    rewinding = !accepted;
                    0
                } else {
                    exhausted = true;
                    reason = 7usize;
                    0
                }
                0
            } else {
                if affords(work, 9usize, work_limit) {
                    work = work + 9usize;
                    let kind = read(matcher, 64usize + atom * 8usize);
                    let value = read(matcher, 65usize + atom * 8usize);
                    let minimum = load2(matcher, 66usize + atom * 8usize);
                    let maximum = load4(matcher, 68usize + atom * 8usize);
                    let remaining = length - position;
                    let bound = if maximum < remaining { maximum } else { remaining };
                    let mut count = 0usize;
                    let mut scanning = true;
                    if bound >= 64usize {
                        if kind == 1usize {
                            // Any-byte membership follows from the checked input
                            // extent. There are no input reads or scan iterations.
                            count = bound;
                            scanning = false;
                        } else {
                            let mut mode = 0usize;
                            if kind == 2usize && affords(work, 32usize, work_limit) {
                                work = work + 32usize;
                                mode = class_scan_mode(matcher, value);
                            }
                            if mode == 3usize {
                                count = bound;
                                scanning = false;
                            } else {
                                if kind == 0usize || mode != 0usize {
                                    let scanned = if kind == 0usize || mode >= 512usize { scan_literal(input, position, bound, work_limit - 32usize - work, u8_from_i64(i64_from_usize(if kind == 0usize { value } else { mode - 512usize }))) } else { if mode >= 256usize { scan_excluding(input, position, bound, work_limit - 32usize - work, u8_from_i64(i64_from_usize(mode - 256usize))) } else { if mode == 4usize { scan_token(input, position, bound, work_limit - 32usize - work) } else { if mode == 5usize { scan_path(input, position, bound, work_limit - 32usize - work) } else { if mode == 1usize { scan_cr_lf(input, position, bound, work_limit - 32usize - work) } else { scan_nul_lf(input, position, bound, work_limit - 32usize - work) } } } } };
                                    let consumed = match scanned { Scan::Done { count: found, work: used, exhausted: stopped } => { count = found; work = work + used; exhausted = stopped != 0usize; if exhausted { reason = 7usize; } 0 }, };
                                    scanning = false;
                                }
                            }
                        }
                    }
                    while count < bound && scanning && !exhausted {
                        let cost = if kind == 2usize { 3usize } else { 2usize };
                        if affords(work, cost, work_limit) {
                            work = work + cost;
                            let byte = input_byte(input, position + count);
                            let matched = if kind == 0usize { byte == value } else {
                                if kind == 1usize { true } else {
                                    let bitmap = read(matcher, 1088usize + value * 32usize + byte / 8usize);
                                    bitmap / bit(byte % 8usize) % 2usize == 1usize
                                }
                            };
                            if matched { count = count + 1usize; } else { scanning = false; }
                            0
                        } else {
                            exhausted = true;
                            reason = 7usize;
                            0
                        }
                        0
                    }
                    if !exhausted {
                        if affords(work, 8usize, work_limit) {
                            work = work + 8usize;
                            matcher = frame(matcher, atom, position, count);
                            if count < minimum { rewinding = true; } else {
                                // With a fixed prefix, reducing the terminal
                                // atom can never cover an already uncovered
                                // input suffix. Skip only those dead alternatives.
                                if length >= 64usize && atom + 1usize == atoms && count < remaining { rewinding = true; } else {
                                    position = position + count;
                                    atom = atom + 1usize;
                                }
                            }
                            0
                        } else {
                            exhausted = true;
                            reason = 7usize;
                            0
                        }
                        0
                    } else { 0 }
                    0
                } else {
                    exhausted = true;
                    reason = 7usize;
                    0
                }
                0
            }
            0
        }
        0
    }
    let final_cost = 32usize + captures * 29usize;
    if accepted && !exhausted && final_cost > work_limit - work {
        exhausted = true;
        reason = 7usize;
    }
    if accepted && !exhausted {
        let mut capture = 0usize;
        while capture < captures {
            work = work + 29usize;
            let begin_atom = load2(matcher, 1600usize + capture * 4usize);
            let end_atom = load2(matcher, 1602usize + capture * 4usize);
            let start = load4(matcher, 1664usize + begin_atom * 8usize);
            let end = load4(matcher, 1664usize + end_atom * 8usize);
            matcher = capture_result(matcher, capture, start, end);
            capture = capture + 1usize;
            0
        }
        packet(matcher, 1usize, captures, 0usize, length, work + 32usize, 0usize)
    } else {
        let code = if exhausted { 4usize } else { if invalid { 3usize } else { 2usize } };
        let why = if invalid { 2usize } else { reason };
        packet(matcher, code, 0usize, why, length, work + 32usize, detail)
    }
}

// Result observers inspect only the logical packet, never program or scratch
// bytes. Field loads remain usize throughout; there is no narrowing cast.
@id("experiment.pattern.result-valid")
fn result_valid(state: borrow Matcher) -> bool
{
    let mut valid = carrier_valid(state);
    if valid {
        valid = read(state, 2696usize) == 83usize && read(state, 2697usize) == 80usize
            && read(state, 2698usize) == 65usize && read(state, 2699usize) == 84usize
            && read(state, 2700usize) == 1usize;
        if valid {
            let code = read(state, 2701usize);
            let count = read(state, 2702usize);
            let reason = read(state, 2703usize);
            let length = load8(state, 2704usize);
            let work = load8(state, 2712usize);
            let detail = load8(state, 2720usize);
            valid = code <= 4usize && count <= 16usize && work >= 32usize && work <= 262144usize;
            valid = valid && (code == 1usize || count == 0usize);
            valid = valid && (code == 4usize && (reason >= 1usize && reason <= 5usize || reason == 7usize)
                || code == 3usize && (reason == 1usize || reason == 2usize)
                || code <= 2usize && reason == 0usize);
            valid = valid && (code != 3usize || reason == 1usize && detail <= 1024usize || reason == 2usize && detail < 1664usize);
            valid = valid && (length <= 65536usize || code == 4usize && reason == 2usize);
            valid = valid && (code != 0usize || length == 0usize);
            valid = valid && (code != 3usize || reason != 1usize || length == 0usize);
            valid = valid && (code != 4usize || reason != 1usize || length == 0usize && detail > 1024usize);
            valid = valid && (code != 4usize || reason != 2usize || length > 65536usize && detail == length);
            valid = valid && (code != 4usize || reason < 3usize || reason > 5usize || length == 0usize && detail <= 1024usize);
            valid = valid && (code != 4usize || reason != 7usize || detail == 0usize);
            valid = valid && (code == 3usize || code == 4usize || detail == 0usize);
            let mut capture = 0usize;
            while valid && capture < count {
                let start = load8(state, 2728usize + capture * 16usize);
                let end = load8(state, 2736usize + capture * 16usize);
                valid = start <= end && end <= length;
                capture = capture + 1usize;
                0
            }
            valid
        } else { false }
    } else { false }
}

@id("experiment.pattern.status")
fn status(state: borrow Matcher) -> usize
    requires result_valid(state)
{
    read(state, 2701usize)
}

@id("experiment.pattern.capture-count")
fn capture_count(state: borrow Matcher) -> usize
    requires result_valid(state)
{
    read(state, 2702usize)
}

@id("experiment.pattern.work-used")
fn work_used(state: borrow Matcher) -> usize
    requires result_valid(state)
{
    load8(state, 2712usize)
}

@id("experiment.pattern.capture-start")
fn capture_start(state: borrow Matcher, capture: usize) -> usize
    requires result_valid(state) && read(state, 2701usize) == 1usize && capture < read(state, 2702usize)
{
    load8(state, 2728usize + capture * 16usize)
}

@id("experiment.pattern.capture-end")
fn capture_end(state: borrow Matcher, capture: usize) -> usize
    requires result_valid(state) && read(state, 2701usize) == 1usize && capture < read(state, 2702usize)
{
    load8(state, 2736usize + capture * 16usize)
}


// A pair observer validates the complete packet once and returns only Copy
// offsets. Its result carries no authority or borrowed input lifetime.
@id("experiment.pattern.capture")
variant Capture {
    @id("experiment.pattern.capture.span")
    Span {
        @id("experiment.pattern.capture.span.start") start: usize,
        @id("experiment.pattern.capture.span.end") end: usize,
    },
}

@id("experiment.pattern.capture-bounds")
fn capture_bounds(state: borrow Matcher, capture: usize) -> Capture
    requires result_valid(state) && read(state, 2701usize) == 1usize && capture < read(state, 2702usize)
{
    Capture::Span { start: load8(state, 2728usize + capture * 16usize), end: load8(state, 2736usize + capture * 16usize) }
}

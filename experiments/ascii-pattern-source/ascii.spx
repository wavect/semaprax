}

@id("experiment.pattern.compiled-header")
fn compiled_header(state: own Matcher, atoms: usize, classes: usize, captures: usize) -> Matcher
    requires atoms <= 128usize && classes <= 16usize && captures <= 16usize
    requires carrier_valid(state)
{
    match own state {
        Matcher { storage, position } => {
            let mut next = storage;
            next = bytes_set5(next, 0usize, 83u8, 80u8, 65u8, 67u8, 1u8);
            next = bytes_set5(next, 5usize, 1u8, u8_from_i64(i64_from_usize(atoms)), u8_from_i64(i64_from_usize(classes)), u8_from_i64(i64_from_usize(captures)), 0u8);
            next = bytes_set5(next, 10usize, 0u8, 0u8, 0u8, 0u8, 0u8);
            next = bytes_set5(next, 15usize, 0u8, 0u8, 0u8, 0u8, 0u8);
            next = bytes_set5(next, 20usize, 0u8, 0u8, 0u8, 0u8, 0u8);
            next = bytes_set5(next, 25usize, 0u8, 0u8, 0u8, 0u8, 0u8);
            next = bytes_set5(next, 30usize, 0u8, 0u8, 0u8, 0u8, 0u8);
            next = bytes_set5(next, 35usize, 0u8, 0u8, 0u8, 0u8, 0u8);
            next = bytes_set5(next, 40usize, 0u8, 0u8, 0u8, 0u8, 0u8);
            next = bytes_set5(next, 45usize, 0u8, 0u8, 0u8, 0u8, 0u8);
            next = bytes_set5(next, 50usize, 0u8, 0u8, 0u8, 0u8, 0u8);
            next = bytes_set5(next, 55usize, 0u8, 0u8, 0u8, 0u8, 0u8);
            next = bytes_set(next, 60usize, 0u8);
            next = bytes_set(next, 61usize, 0u8);
            next = bytes_set(next, 62usize, 0u8);
            next = bytes_set(next, 63usize, 0u8);
            Matcher { storage: next, position: position }
        },
    }
}

// Compile invalidates byte5 first, even on an extent or work refusal. Its
// minimum budget is therefore33: one invalidating store plus32 packet stores.
@id("experiment.pattern.compile")
fn compile(state: own Matcher, pattern: borrow Slice<u8>, work_limit: usize) -> Matcher
    requires carrier_valid(state)
    requires 33usize <= work_limit && work_limit <= 262144usize
{
    let invalidated = store1(state, 5usize, 0usize);
    let mut matcher = invalidated;
    let length = byte_len(pattern);
    let mut work = 1usize;
    let mut cursor = 0usize;
    let mut atoms = 0usize;
    let mut classes = 0usize;
    let mut captures = 0usize;
    let mut open = 16usize;
    let mut invalid = false;
    let mut exhausted = false;
    let mut reason = 0usize;
    let mut detail = 0usize;
    if length > 1024usize { exhausted = true; reason = 1usize; detail = length; }
    while cursor < length && !invalid && !exhausted {
        if affords(work, 2usize, work_limit) {
            work = work + 2usize;
            let byte = input_byte(pattern, cursor);
            if byte == 40usize || byte == 41usize {
                if byte == 40usize {
                    if open != 16usize { invalid = true; detail = cursor; } else {
                        if captures == 16usize { exhausted = true; reason = 5usize; detail = cursor; } else {
                            if affords(work, 2usize, work_limit) {
                                work = work + 2usize;
                                matcher = store2(matcher, 1600usize + captures * 4usize, atoms);
                                open = captures;
                                captures = captures + 1usize;
                                cursor = cursor + 1usize;
                                0
                            } else { exhausted = true; reason = 7usize; 0 }
                        }
                    }
                } else {
                    if open == 16usize { invalid = true; detail = cursor; } else {
                        if affords(work, 2usize, work_limit) {
                            work = work + 2usize;
                            matcher = store2(matcher, 1602usize + open * 4usize, atoms);
                            open = 16usize;
                            cursor = cursor + 1usize;
                            0
                        } else { exhausted = true; reason = 7usize; 0 }
                    }
                }
            } else {
                let atom_offset = cursor;
                let mut kind = 0usize;
                let mut value = 0usize;
                if byte == 46usize { kind = 1usize; cursor = cursor + 1usize; } else {
                    if byte == 91usize {
                        kind = 2usize;
                        cursor = cursor + 1usize;
                        if affords(work, 32usize, work_limit) {
                            work = work + 32usize;
                            matcher = clear_candidate(matcher);
                            0
                        } else { exhausted = true; reason = 7usize; 0 }
                        let mut complement = false;
                        if cursor < length && !exhausted {
                            if affords(work, 1usize, work_limit) {
                                work = work + 1usize;
                                if input_byte(pattern, cursor) == 94usize { complement = true; cursor = cursor + 1usize; }
                                0
                            } else { exhausted = true; reason = 7usize; 0 }
                        }
                        let mut closed = false;
                        let mut items = 0usize;
                        while !closed && !invalid && !exhausted {
                            if cursor == length {
                                if affords(work, 1usize, work_limit) { work = work + 1usize; invalid = true; detail = length; 0 } else { exhausted = true; reason = 7usize; 0 }
                            } else {
                                if affords(work, 2usize, work_limit) {
                                    work = work + 2usize;
                                    let first_byte = input_byte(pattern, cursor);
                                    if first_byte == 93usize {
                                        if items == 0usize { invalid = true; detail = cursor; } else { closed = true; cursor = cursor + 1usize; }
                                    } else {
                                        if first_byte == 45usize {
                                            if cursor + 1usize == length { invalid = true; detail = length; } else {
                                                if affords(work, 1usize, work_limit) {
                                                    work = work + 1usize;
                                                    if input_byte(pattern, cursor + 1usize) != 93usize { invalid = true; detail = cursor; }
                                                    0
                                                } else { exhausted = true; reason = 7usize; 0 }
                                            }
                                        }
                                        let mut low = 0usize;
                                        let mut high = 0usize;
                                        if !invalid && !exhausted {
                                            let parsed = match read_token(pattern, cursor, true, work_limit - 32usize - work) {
                                            Token::Byte { value: token_value, next, work: token_work } => {
                                                work = work + token_work; low = token_value; high = token_value; cursor = next; 0
                                            },
                                            Token::Invalid { offset, work: token_work } => {
                                                work = work + token_work; invalid = true; detail = offset; 0
                                            },
                                            Token::Exhausted { work: token_work } => {
                                                work = work + token_work; exhausted = true; reason = 7usize; 0
                                            },
                                        };
                                        }
                                        let mut range = false;
                                        if cursor < length && !invalid && !exhausted {
                                            if affords(work, 1usize, work_limit) {
                                                work = work + 1usize;
                                                if input_byte(pattern, cursor) == 45usize {
                                                    if cursor + 1usize == length { invalid = true; detail = length; } else {
                                                        if affords(work, 1usize, work_limit) {
                                                            work = work + 1usize;
                                                            let following = input_byte(pattern, cursor + 1usize);
                                                            if following == 45usize { invalid = true; detail = cursor + 1usize; } else { range = following != 93usize; }
                                                            0
                                                        } else { exhausted = true; reason = 7usize; 0 }
                                                    }
                                                }
                                                0
                                            } else { exhausted = true; reason = 7usize; 0 }
                                        }
                                        if range && !invalid && !exhausted {
                                            cursor = cursor + 1usize;
                                            let endpoint_offset = cursor;
                                            let parsed_end = match read_token(pattern, cursor, true, work_limit - 32usize - work) {
                                                Token::Byte { value: token_value, next, work: token_work } => {
                                                    work = work + token_work; high = token_value; cursor = next;
                                                    if high < low { invalid = true; detail = endpoint_offset; }
                                                    0
                                                },
                                                Token::Invalid { offset, work: token_work } => {
                                                    work = work + token_work; invalid = true; detail = offset; 0
                                                },
                                                Token::Exhausted { work: token_work } => {
                                                    work = work + token_work; exhausted = true; reason = 7usize; 0
                                                },
                                            };
                                        }
                                        let mut member = low;
                                        while member <= high && !invalid && !exhausted {
                                            if affords(work, 3usize, work_limit) {
                                                work = work + 3usize;
                                                let slot = 2984usize + member / 8usize;
                                                let old = read(matcher, slot);
                                                let mask = bit(member % 8usize);
                                                let updated = if old / mask % 2usize == 0usize { old + mask } else { old };
                                                matcher = store1(matcher, slot, updated);
                                                member = member + 1usize;
                                                0
                                            } else { exhausted = true; reason = 7usize; 0 }
                                            0
                                        }
                                        items = items + 1usize;
                                        0
                                    }
                                    0
                                } else { exhausted = true; reason = 7usize; 0 }
                            }
                            0
                        }
                        let mut bitmap_byte = 0usize;
                        while complement && bitmap_byte < 32usize && !invalid && !exhausted {
                            if affords(work, 3usize, work_limit) {
                                work = work + 3usize;
                                let old = read(matcher, 2984usize + bitmap_byte);
                                matcher = store1(matcher, 2984usize + bitmap_byte, 255usize - old);
                                bitmap_byte = bitmap_byte + 1usize;
                                0
                            } else { exhausted = true; reason = 7usize; 0 }
                            0
                        }
                        let mut candidate = 0usize;
                        let mut found = false;
                        while candidate < classes && !found && !invalid && !exhausted {
                            if affords(work, 1usize, work_limit) {
                                work = work + 1usize;
                                let mut same = true;
                                let mut compared = 0usize;
                                while compared < 32usize && same && !exhausted {
                                    if affords(work, 3usize, work_limit) {
                                        work = work + 3usize;
                                        same = read(matcher, 2984usize + compared) == read(matcher, 1088usize + candidate * 32usize + compared);
                                        compared = compared + 1usize;
                                        0
                                    } else { exhausted = true; reason = 7usize; 0 }
                                    0
                                }
                                if same && !exhausted { found = true; value = candidate; } else { candidate = candidate + 1usize; }
                                0
                            } else { exhausted = true; reason = 7usize; 0 }
                            0
                        }
                        if !found && !invalid && !exhausted {
                            if classes == 16usize { exhausted = true; reason = 4usize; detail = atom_offset; } else {
                                value = classes;
                                let mut copied = 0usize;
                                while copied < 32usize && !exhausted {
                                    if affords(work, 3usize, work_limit) {
                                        work = work + 3usize;
                                        let source = read(matcher, 2984usize + copied);
                                        matcher = store1(matcher, 1088usize + classes * 32usize + copied, source);
                                        copied = copied + 1usize;
                                        0
                                    } else { exhausted = true; reason = 7usize; 0 }
                                    0
                                }
                                if !exhausted { classes = classes + 1usize; }
                            }
                        }
                    } else {
                        let parsed = match read_token(pattern, cursor, false, work_limit - 32usize - work) {
                            Token::Byte { value: token_value, next, work: token_work } => {
                                work = work + token_work; value = token_value; cursor = next; 0
                            },
                            Token::Invalid { offset, work: token_work } => {
                                work = work + token_work; invalid = true; detail = offset; 0
                            },
                            Token::Exhausted { work: token_work } => {
                                work = work + token_work; exhausted = true; reason = 7usize; 0
                            },
                        };
                    }
                }
                let mut minimum = 1usize;
                let mut maximum = 1usize;
                if !invalid && !exhausted {
                    let parsed_bounds = match read_quantifier(pattern, cursor, work_limit - 32usize - work) {
                        Quantifier::Bounds { minimum: low, maximum: high, next, work: token_work } => {
                            work = work + token_work; minimum = low; maximum = high; cursor = next; 0
                        },
                        Quantifier::Invalid { offset, work: token_work } => {
                            work = work + token_work; invalid = true; detail = offset; 0
                        },
                        Quantifier::Exhausted { work: token_work } => {
                            work = work + token_work; exhausted = true; reason = 7usize; 0
                        },
                    };
                }
                if !invalid && !exhausted {
                    if atoms == 128usize { exhausted = true; reason = 3usize; detail = atom_offset; } else {
                        if affords(work, 8usize, work_limit) {
                            work = work + 8usize;
                            matcher = store_atom(matcher, atoms, kind, value, minimum, maximum);
                            atoms = atoms + 1usize;
                            0
                        } else { exhausted = true; reason = 7usize; 0 }
                    }
                }
            }
            0
        } else { exhausted = true; reason = 7usize; 0 }
        0
    }
    if !invalid && !exhausted && open != 16usize { invalid = true; detail = length; }
    if !invalid && !exhausted && 96usize > work_limit - work { exhausted = true; reason = 7usize; }
    if !invalid && !exhausted {
        let ready = compiled_header(matcher, atoms, classes, captures);
        packet(ready, 0usize, 0usize, 0usize, 0usize, work + 96usize, 0usize)
    } else {
        packet(matcher, if invalid { 3usize } else { 4usize }, 0usize, if invalid { 1usize } else { reason }, 0usize, work + 32usize, detail)
    }
}

// Long-run scans retain no loan and return only direct Copy scalar payloads.
// Work is actual input reads plus entered scan-loop iterations. The caller
// passes its remaining work after reserving the refusal packet.
@id("experiment.pattern.scan")
variant Scan {
    @id("experiment.pattern.scan.done")
    Done {
        @id("experiment.pattern.scan.done.count") count: usize,
        @id("experiment.pattern.scan.done.work") work: usize,
        @id("experiment.pattern.scan.done.exhausted") exhausted: usize,
    },
}

// Fixed scalar work; no byte event or loop. Return 64 unless the word is
// exactly one set bit. Checked unsigned division keeps every intermediate bounded.
@id("experiment.pattern.single-bit-index")
fn single_bit_index(word: usize) -> usize
{
    let mut candidate = word;
    let mut index = 0usize;
    let mut valid = true;
    if candidate >= 4294967296usize {
        valid = valid && candidate % 4294967296usize == 0usize;
        candidate = candidate / 4294967296usize;
        index = index + 32usize;
    }
    if candidate >= 65536usize {
        valid = valid && candidate % 65536usize == 0usize;
        candidate = candidate / 65536usize;
        index = index + 16usize;
    }
    if candidate >= 256usize {
        valid = valid && candidate % 256usize == 0usize;
        candidate = candidate / 256usize;
        index = index + 8usize;
    }
    if candidate >= 16usize {
        valid = valid && candidate % 16usize == 0usize;
        candidate = candidate / 16usize;
        index = index + 4usize;
    }
    if candidate >= 4usize {
        valid = valid && candidate % 4usize == 0usize;
        candidate = candidate / 4usize;
        index = index + 2usize;
    }
    if candidate >= 2usize {
        valid = valid && candidate % 2usize == 0usize;
        candidate = candidate / 2usize;
        index = index + 1usize;
    }
    if valid && candidate == 1usize { index } else { 64usize }
}

// Four loads authenticate every membership bit. No class name or source
// spelling selects this optimization, and no stored cache grants authority.
// Cost: 32 reads. Modes: 0 generic, 1 CR/LF exclusion, 2 NUL/LF
// exclusion, 3 all bytes, 4 token, 5 path, 256+byte excludes one,
// 512+byte includes one. Token excludes 0..32 and 127; path also 34/92.
@id("experiment.pattern.class-scan-mode")
fn class_scan_mode(state: borrow Matcher, value: usize) -> usize
    requires carrier_valid(state) && value < 16usize
{
    let offset = 1088usize + value * 32usize;
    let first = load8(state, offset);
    let second = load8(state, offset + 8usize);
    let third = load8(state, offset + 16usize);
    let fourth = load8(state, offset + 24usize);
    let full = 18446744073709551615usize;
    let mut mode = 0usize;
    if second == full && third == full && fourth == full {
        if first == 18446744073709542399usize { mode = 1usize; } else {
            if first == 18446744073709550590usize { mode = 2usize; } else {
                if first == full { mode = 3usize; }
            }
        }
    }
    if mode == 0usize && third == full && fourth == full {
        if first == 18446744065119617024usize && second == 9223372036854775807usize { mode = 4usize; } else {
            if first == 18446744047939747840usize && second == 9223372036586340351usize { mode = 5usize; }
        }
    }
    if mode == 0usize {
        let mut block = 4usize;
        let mut singleton = 0usize;
        let mut excluded = false;
        if second == 0usize && third == 0usize && fourth == 0usize { block = 0usize; singleton = first; } else {
            if first == 0usize && third == 0usize && fourth == 0usize { block = 1usize; singleton = second; } else {
                if first == 0usize && second == 0usize && fourth == 0usize { block = 2usize; singleton = third; } else {
                    if first == 0usize && second == 0usize && third == 0usize { block = 3usize; singleton = fourth; }
                }
            }
        }
        if block == 4usize {
            excluded = true;
            if second == full && third == full && fourth == full { block = 0usize; singleton = full - first; } else {
                if first == full && third == full && fourth == full { block = 1usize; singleton = full - second; } else {
                    if first == full && second == full && fourth == full { block = 2usize; singleton = full - third; } else {
                        if first == full && second == full && third == full { block = 3usize; singleton = full - fourth; }
                    }
                }
            }
        }
        if block < 4usize {
            let index = single_bit_index(singleton);
            if index < 64usize { mode = (if excluded { 256usize } else { 512usize }) + block * 64usize + index; }
        }
    }
    mode
}

// Eight direct total reads; the offset bound prevents fixed additions
// overflowing. Missing bytes stop the span without granting input authority.
@id("experiment.pattern.span8-cr-lf")
fn span8_cr_lf(input: borrow Slice<u8>, start: usize) -> usize
    requires start <= 18446744073709551608usize
{
    match byte_get(input, start) { Option::Some { value: byte0 } => match byte0 { 10u8 | 13u8 => 0usize, _ => match byte_get(input, start + 1usize) { Option::Some { value: byte1 } => match byte1 { 10u8 | 13u8 => 1usize, _ => match byte_get(input, start + 2usize) { Option::Some { value: byte2 } => match byte2 { 10u8 | 13u8 => 2usize, _ => match byte_get(input, start + 3usize) { Option::Some { value: byte3 } => match byte3 { 10u8 | 13u8 => 3usize, _ => match byte_get(input, start + 4usize) { Option::Some { value: byte4 } => match byte4 { 10u8 | 13u8 => 4usize, _ => match byte_get(input, start + 5usize) { Option::Some { value: byte5 } => match byte5 { 10u8 | 13u8 => 5usize, _ => match byte_get(input, start + 6usize) { Option::Some { value: byte6 } => match byte6 { 10u8 | 13u8 => 6usize, _ => match byte_get(input, start + 7usize) { Option::Some { value: byte7 } => match byte7 { 10u8 | 13u8 => 7usize, _ => 8usize, }, Option::None {} => 7usize, }, }, Option::None {} => 6usize, }, }, Option::None {} => 5usize, }, }, Option::None {} => 4usize, }, }, Option::None {} => 3usize, }, }, Option::None {} => 2usize, }, }, Option::None {} => 1usize, }, }, Option::None {} => 0usize, }
}

// At most 48 direct total reads, stopping at the first rejected byte.
// Six shallow helpers keep source traversal below the old nested-if depth.
@id("experiment.pattern.span48-cr-lf")
fn span48_cr_lf(input: borrow Slice<u8>, start: usize) -> usize
    requires start <= byte_len(input) && 48usize <= byte_len(input) - start
{
    let first = span8_cr_lf(input, start);
    if first < 8usize { first } else {
        let second = span8_cr_lf(input, start + 8usize);
        if second < 8usize { 8usize + second } else {
            let third = span8_cr_lf(input, start + 16usize);
            if third < 8usize { 16usize + third } else {
                let fourth = span8_cr_lf(input, start + 24usize);
                if fourth < 8usize { 24usize + fourth } else {
                    let fifth = span8_cr_lf(input, start + 32usize);
                    if fifth < 8usize { 32usize + fifth } else { 40usize + span8_cr_lf(input, start + 40usize) }
                }
            }
        }
    }
}

@id("experiment.pattern.scan-cr-lf")
fn scan_cr_lf(input: borrow Slice<u8>, start: usize, bound: usize, available: usize) -> Scan
    requires start <= byte_len(input) && bound <= byte_len(input) - start
    requires bound <= 65536usize && available <= 262112usize
{
    let mut count = 0usize;
    let mut work = 0usize;
    let mut scanning = true;
    let mut exhausted = false;
    while count < bound && scanning && !exhausted {
        if 48usize <= bound - count {
            if 49usize <= available - work {
                let width = span48_cr_lf(input, start + count);
                work = work + 1usize + width + if width < 48usize { 1usize } else { 0usize };
                count = count + width;
                scanning = width == 48usize;
            } else { exhausted = true; }
        } else {
            if 2usize <= available - work {
                let matched = match byte_get(input, start + count) { Option::Some { value } => match value { 10u8 | 13u8 => false, _ => true, }, Option::None {} => false, };
                work = work + 2usize;
                if matched { count = count + 1usize; } else { scanning = false; }
            } else { exhausted = true; }
        }
        0
    }
    Scan::Done { count: count, work: work, exhausted: if exhausted { 1usize } else { 0usize } }
}

// Eight direct total reads; the offset bound prevents fixed additions
// overflowing. Missing bytes stop the span without granting input authority.
@id("experiment.pattern.span8-nul-lf")
fn span8_nul_lf(input: borrow Slice<u8>, start: usize) -> usize
    requires start <= 18446744073709551608usize
{
    match byte_get(input, start) { Option::Some { value: byte0 } => match byte0 { 0u8 | 10u8 => 0usize, _ => match byte_get(input, start + 1usize) { Option::Some { value: byte1 } => match byte1 { 0u8 | 10u8 => 1usize, _ => match byte_get(input, start + 2usize) { Option::Some { value: byte2 } => match byte2 { 0u8 | 10u8 => 2usize, _ => match byte_get(input, start + 3usize) { Option::Some { value: byte3 } => match byte3 { 0u8 | 10u8 => 3usize, _ => match byte_get(input, start + 4usize) { Option::Some { value: byte4 } => match byte4 { 0u8 | 10u8 => 4usize, _ => match byte_get(input, start + 5usize) { Option::Some { value: byte5 } => match byte5 { 0u8 | 10u8 => 5usize, _ => match byte_get(input, start + 6usize) { Option::Some { value: byte6 } => match byte6 { 0u8 | 10u8 => 6usize, _ => match byte_get(input, start + 7usize) { Option::Some { value: byte7 } => match byte7 { 0u8 | 10u8 => 7usize, _ => 8usize, }, Option::None {} => 7usize, }, }, Option::None {} => 6usize, }, }, Option::None {} => 5usize, }, }, Option::None {} => 4usize, }, }, Option::None {} => 3usize, }, }, Option::None {} => 2usize, }, }, Option::None {} => 1usize, }, }, Option::None {} => 0usize, }
}

// At most 48 direct total reads, stopping at the first rejected byte.
// Six shallow helpers keep source traversal below the old nested-if depth.
@id("experiment.pattern.span48-nul-lf")
fn span48_nul_lf(input: borrow Slice<u8>, start: usize) -> usize
    requires start <= byte_len(input) && 48usize <= byte_len(input) - start
{

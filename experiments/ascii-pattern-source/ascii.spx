            next = bytes_set(next, 55usize, u8_from_i64(i64_from_usize(0usize)));
            next = bytes_set(next, 56usize, u8_from_i64(i64_from_usize(0usize)));
            next = bytes_set(next, 57usize, u8_from_i64(i64_from_usize(0usize)));
            next = bytes_set(next, 58usize, u8_from_i64(i64_from_usize(0usize)));
            next = bytes_set(next, 59usize, u8_from_i64(i64_from_usize(0usize)));
            next = bytes_set(next, 60usize, u8_from_i64(i64_from_usize(0usize)));
            next = bytes_set(next, 61usize, u8_from_i64(i64_from_usize(0usize)));
            next = bytes_set(next, 62usize, u8_from_i64(i64_from_usize(0usize)));
            next = bytes_set(next, 63usize, u8_from_i64(i64_from_usize(0usize)));
            Matcher { storage: next, position: position }
        },
    }
}

// Compile invalidates byte5 first, even on an extent or work refusal. Its
// minimum budget is therefore33: one invalidating store plus32 packet stores.
@id("experiment.pattern.compile")
fn compile(state: own Matcher, pattern: borrow Slice<u8>, work_limit: usize) -> Matcher
    requires carrier_valid(state)
    requires 33usize <= work_limit && work_limit <= 262144usize
{
    let invalidated = store1(state, 5usize, 0usize);
    let mut matcher = invalidated;
    let length = byte_len(pattern);
    let mut work = 1usize;
    let mut cursor = 0usize;
    let mut atoms = 0usize;
    let mut classes = 0usize;
    let mut captures = 0usize;
    let mut open = 16usize;
    let mut invalid = false;
    let mut exhausted = false;
    let mut reason = 0usize;
    let mut detail = 0usize;
    if length > 1024usize { exhausted = true; reason = 1usize; detail = length; }
    while cursor < length && !invalid && !exhausted {
        if affords(work, 2usize, work_limit) {
            work = work + 2usize;
            let byte = input_byte(pattern, cursor);
            if byte == 40usize || byte == 41usize {
                if byte == 40usize {
                    if open != 16usize { invalid = true; detail = cursor; } else {
                        if captures == 16usize { exhausted = true; reason = 5usize; detail = cursor; } else {
                            if affords(work, 2usize, work_limit) {
                                work = work + 2usize;
                                matcher = store2(matcher, 1600usize + captures * 4usize, atoms);
                                open = captures;
                                captures = captures + 1usize;
                                cursor = cursor + 1usize;
                                0
                            } else { exhausted = true; reason = 7usize; 0 }
                        }
                    }
                } else {
                    if open == 16usize { invalid = true; detail = cursor; } else {
                        if affords(work, 2usize, work_limit) {
                            work = work + 2usize;
                            matcher = store2(matcher, 1602usize + open * 4usize, atoms);
                            open = 16usize;
                            cursor = cursor + 1usize;
                            0
                        } else { exhausted = true; reason = 7usize; 0 }
                    }
                }
            } else {
                let atom_offset = cursor;
                let mut kind = 0usize;
                let mut value = 0usize;
                if byte == 46usize { kind = 1usize; cursor = cursor + 1usize; } else {
                    if byte == 91usize {
                        kind = 2usize;
                        cursor = cursor + 1usize;
                        if affords(work, 32usize, work_limit) {
                            work = work + 32usize;
                            matcher = clear_candidate(matcher);
                            0
                        } else { exhausted = true; reason = 7usize; 0 }
                        let mut complement = false;
                        if cursor < length && !exhausted {
                            if affords(work, 1usize, work_limit) {
                                work = work + 1usize;
                                if input_byte(pattern, cursor) == 94usize { complement = true; cursor = cursor + 1usize; }
                                0
                            } else { exhausted = true; reason = 7usize; 0 }
                        }
                        let mut closed = false;
                        let mut items = 0usize;
                        while !closed && !invalid && !exhausted {
                            if cursor == length {
                                if affords(work, 1usize, work_limit) { work = work + 1usize; invalid = true; detail = length; 0 } else { exhausted = true; reason = 7usize; 0 }
                            } else {
                                if affords(work, 2usize, work_limit) {
                                    work = work + 2usize;
                                    let first_byte = input_byte(pattern, cursor);
                                    if first_byte == 93usize {
                                        if items == 0usize { invalid = true; detail = cursor; } else { closed = true; cursor = cursor + 1usize; }
                                    } else {
                                        if first_byte == 45usize {
                                            if cursor + 1usize == length { invalid = true; detail = length; } else {
                                                if affords(work, 1usize, work_limit) {
                                                    work = work + 1usize;
                                                    if input_byte(pattern, cursor + 1usize) != 93usize { invalid = true; detail = cursor; }
                                                    0
                                                } else { exhausted = true; reason = 7usize; 0 }
                                            }
                                        }
                                        let mut low = 0usize;
                                        let mut high = 0usize;
                                        if !invalid && !exhausted {
                                            let parsed = match read_token(pattern, cursor, true, work_limit - 32usize - work) {
                                            Token::Byte { value: token_value, next, work: token_work } => {
                                                work = work + token_work; low = token_value; high = token_value; cursor = next; 0
                                            },
                                            Token::Invalid { offset, work: token_work } => {
                                                work = work + token_work; invalid = true; detail = offset; 0
                                            },
                                            Token::Exhausted { work: token_work } => {
                                                work = work + token_work; exhausted = true; reason = 7usize; 0
                                            },
                                        };
                                        }
                                        let mut range = false;
                                        if cursor < length && !invalid && !exhausted {
                                            if affords(work, 1usize, work_limit) {
                                                work = work + 1usize;
                                                if input_byte(pattern, cursor) == 45usize {
                                                    if cursor + 1usize == length { invalid = true; detail = length; } else {
                                                        if affords(work, 1usize, work_limit) {
                                                            work = work + 1usize;
                                                            let following = input_byte(pattern, cursor + 1usize);
                                                            if following == 45usize { invalid = true; detail = cursor + 1usize; } else { range = following != 93usize; }
                                                            0
                                                        } else { exhausted = true; reason = 7usize; 0 }
                                                    }
                                                }
                                                0
                                            } else { exhausted = true; reason = 7usize; 0 }
                                        }
                                        if range && !invalid && !exhausted {
                                            cursor = cursor + 1usize;
                                            let endpoint_offset = cursor;
                                            let parsed_end = match read_token(pattern, cursor, true, work_limit - 32usize - work) {
                                                Token::Byte { value: token_value, next, work: token_work } => {
                                                    work = work + token_work; high = token_value; cursor = next;
                                                    if high < low { invalid = true; detail = endpoint_offset; }
                                                    0
                                                },
                                                Token::Invalid { offset, work: token_work } => {
                                                    work = work + token_work; invalid = true; detail = offset; 0
                                                },
                                                Token::Exhausted { work: token_work } => {
                                                    work = work + token_work; exhausted = true; reason = 7usize; 0
                                                },
                                            };
                                        }
                                        let mut member = low;
                                        while member <= high && !invalid && !exhausted {
                                            if affords(work, 3usize, work_limit) {
                                                work = work + 3usize;
                                                let slot = 2984usize + member / 8usize;
                                                let old = read(matcher, slot);
                                                let mask = bit(member % 8usize);
                                                let updated = if old / mask % 2usize == 0usize { old + mask } else { old };
                                                matcher = store1(matcher, slot, updated);
                                                member = member + 1usize;
                                                0
                                            } else { exhausted = true; reason = 7usize; 0 }
                                            0
                                        }
                                        items = items + 1usize;
                                        0
                                    }
                                    0
                                } else { exhausted = true; reason = 7usize; 0 }
                            }
                            0
                        }
                        let mut bitmap_byte = 0usize;
                        while complement && bitmap_byte < 32usize && !invalid && !exhausted {
                            if affords(work, 3usize, work_limit) {
                                work = work + 3usize;
                                let old = read(matcher, 2984usize + bitmap_byte);
                                matcher = store1(matcher, 2984usize + bitmap_byte, 255usize - old);
                                bitmap_byte = bitmap_byte + 1usize;
                                0
                            } else { exhausted = true; reason = 7usize; 0 }
                            0
                        }
                        let mut candidate = 0usize;
                        let mut found = false;
                        while candidate < classes && !found && !invalid && !exhausted {
                            if affords(work, 1usize, work_limit) {
                                work = work + 1usize;
                                let mut same = true;
                                let mut compared = 0usize;
                                while compared < 32usize && same && !exhausted {
                                    if affords(work, 3usize, work_limit) {
                                        work = work + 3usize;
                                        same = read(matcher, 2984usize + compared) == read(matcher, 1088usize + candidate * 32usize + compared);
                                        compared = compared + 1usize;
                                        0
                                    } else { exhausted = true; reason = 7usize; 0 }
                                    0
                                }
                                if same && !exhausted { found = true; value = candidate; } else { candidate = candidate + 1usize; }
                                0
                            } else { exhausted = true; reason = 7usize; 0 }
                            0
                        }
                        if !found && !invalid && !exhausted {
                            if classes == 16usize { exhausted = true; reason = 4usize; detail = atom_offset; } else {
                                value = classes;
                                let mut copied = 0usize;
                                while copied < 32usize && !exhausted {
                                    if affords(work, 3usize, work_limit) {
                                        work = work + 3usize;
                                        let source = read(matcher, 2984usize + copied);
                                        matcher = store1(matcher, 1088usize + classes * 32usize + copied, source);
                                        copied = copied + 1usize;
                                        0
                                    } else { exhausted = true; reason = 7usize; 0 }
                                    0
                                }
                                if !exhausted { classes = classes + 1usize; }
                            }
                        }
                    } else {
                        let parsed = match read_token(pattern, cursor, false, work_limit - 32usize - work) {
                            Token::Byte { value: token_value, next, work: token_work } => {
                                work = work + token_work; value = token_value; cursor = next; 0
                            },
                            Token::Invalid { offset, work: token_work } => {
                                work = work + token_work; invalid = true; detail = offset; 0
                            },
                            Token::Exhausted { work: token_work } => {
                                work = work + token_work; exhausted = true; reason = 7usize; 0
                            },
                        };
                    }
                }
                let mut minimum = 1usize;
                let mut maximum = 1usize;
                if !invalid && !exhausted {
                    let parsed_bounds = match read_quantifier(pattern, cursor, work_limit - 32usize - work) {
                        Quantifier::Bounds { minimum: low, maximum: high, next, work: token_work } => {
                            work = work + token_work; minimum = low; maximum = high; cursor = next; 0
                        },
                        Quantifier::Invalid { offset, work: token_work } => {
                            work = work + token_work; invalid = true; detail = offset; 0
                        },
                        Quantifier::Exhausted { work: token_work } => {
                            work = work + token_work; exhausted = true; reason = 7usize; 0
                        },
                    };
                }
                if !invalid && !exhausted {
                    if atoms == 128usize { exhausted = true; reason = 3usize; detail = atom_offset; } else {
                        if affords(work, 8usize, work_limit) {
                            work = work + 8usize;
                            matcher = store_atom(matcher, atoms, kind, value, minimum, maximum);
                            atoms = atoms + 1usize;
                            0
                        } else { exhausted = true; reason = 7usize; 0 }
                    }
                }
            }
            0
        } else { exhausted = true; reason = 7usize; 0 }
        0
    }
    if !invalid && !exhausted && open != 16usize { invalid = true; detail = length; }
    if !invalid && !exhausted && 96usize > work_limit - work { exhausted = true; reason = 7usize; }
    if !invalid && !exhausted {
        let ready = compiled_header(matcher, atoms, classes, captures);
        packet(ready, 0usize, 0usize, 0usize, 0usize, work + 96usize, 0usize)
    } else {
        packet(matcher, if invalid { 3usize } else { 4usize }, 0usize, if invalid { 1usize } else { reason }, 0usize, work + 32usize, detail)
    }
}

// Provisional compiled header: SPAC, version 1, ready=1, atom/class/capture
// counts, then zeros through byte 63. Each used atom occupies eight bytes:
// kind (0 literal, 1 any, 2 class), value, u16 minimum, u32 maximum.
// 0xffffffff denotes an unbounded maximum. No unused frame is ever loaded.
@id("experiment.pattern.full-match")
fn full_match(state: own Matcher, input: borrow Slice<u8>, work_limit: usize) -> Matcher
    requires carrier_valid(state)
    requires 32usize <= work_limit && work_limit <= 262144usize
{
    let mut matcher = state;
    let length = byte_len(input);
    let mut work = 0usize;
    let mut exhausted = false;
    let mut invalid = false;
    let mut detail = 0usize;
    let mut reason = 0usize;
    let mut atoms = 0usize;
    let mut classes = 0usize;
    let mut captures = 0usize;
    let mut header = 0usize;
    if length > 65536usize {
        exhausted = true;
        reason = 2usize;
        detail = length;
    }
    while header < 64usize && !exhausted && !invalid {
        if affords(work, 2usize, work_limit) {
            work = work + 2usize;
            let value = read(matcher, header);
            let expected = if header == 0usize { 83usize } else {
                if header == 1usize { 80usize } else {
                    if header == 2usize { 65usize } else {
                        if header == 3usize { 67usize } else {
                            if header == 4usize || header == 5usize { 1usize } else { 0usize }
                        }
                    }
                }
            };
            if header == 6usize {
                atoms = value;
                invalid = atoms > 128usize;
            } else {
                if header == 7usize {
                    classes = value;
                    invalid = classes > 16usize;
                } else {
                    if header == 8usize {
                        captures = value;
                        invalid = captures > 16usize;
                    } else { invalid = value != expected; }
                }
            }
            if invalid { detail = header; }
            header = header + 1usize;
            0
        } else {
            exhausted = true;
            reason = 7usize;
            0
        }
        0
    }
    let mut checked_atom = 0usize;
    while checked_atom < atoms && !exhausted && !invalid {
        if affords(work, 9usize, work_limit) {
            work = work + 9usize;
            let offset = 64usize + checked_atom * 8usize;
            let kind = read(matcher, offset);
            let value = read(matcher, offset + 1usize);
            let minimum = load2(matcher, offset + 2usize);
            let maximum = load4(matcher, offset + 4usize);
            if kind > 2usize {
                invalid = true;
                detail = offset;
            } else {
                if kind == 1usize && value != 0usize || kind == 2usize && value >= classes {
                    invalid = true;
                    detail = offset + 1usize;
                } else {
                    if minimum > 255usize {
                        invalid = true;
                        detail = offset + 2usize;
                    } else {
                        if maximum != 4294967295usize && (maximum < minimum || maximum > 255usize) {
                            invalid = true;
                            detail = offset + 4usize;
                        } else { 0usize }
                    }
                }
            }
            checked_atom = checked_atom + 1usize;
            0
        } else {
            exhausted = true;
            reason = 7usize;
            0
        }
        0
    }
    let mut checked_capture = 0usize;
    let mut previous_end = 0usize;
    while checked_capture < captures && !exhausted && !invalid {
        if affords(work, 5usize, work_limit) {
            work = work + 5usize;
            let offset = 1600usize + checked_capture * 4usize;
            let start = load2(matcher, offset);
            let end = load2(matcher, offset + 2usize);
            invalid = start < previous_end || start > end || end > atoms;
            if invalid { detail = offset; }
            previous_end = end;
            checked_capture = checked_capture + 1usize;
            0
        } else {
            exhausted = true;
            reason = 7usize;
            0
        }
        0
    }
    let mut atom = 0usize;
    let mut position = 0usize;
    let mut rewinding = false;
    let mut accepted = false;
    let mut finished = false;
    while !finished && !exhausted && !invalid {
        if rewinding {
            if atom == 0usize {
                if affords(work, 1usize, work_limit) {
                    work = work + 1usize;
                    finished = true;
                    0
                } else {
                    exhausted = true;
                    reason = 7usize;
                    0
                }
                0
            } else {
                if affords(work, 11usize, work_limit) {
                    work = work + 11usize;
                    atom = atom - 1usize;
                    let minimum = load2(matcher, 66usize + atom * 8usize);
                    let start = load4(matcher, 1664usize + atom * 8usize);
                    let count = load4(matcher, 1668usize + atom * 8usize);
                    if count > minimum {
                        if affords(work, 4usize, work_limit) {
                            work = work + 4usize;
                            matcher = store4(matcher, 1668usize + atom * 8usize, count - 1usize);
                            position = start + count - 1usize;
                            atom = atom + 1usize;
                            rewinding = false;
                            0
                        } else {
                            exhausted = true;
                            reason = 7usize;
                            0
                        }
                        0
                    } else { 0 }
                    0
                } else {
                    exhausted = true;
                    reason = 7usize;
                    0
                }
                0
            }
            0
        } else {
            if atom == atoms {
                if affords(work, 9usize, work_limit) {
                    work = work + 9usize;
                    matcher = frame(matcher, atom, position, 0usize);
                    accepted = position == length;
                    finished = accepted;
                    rewinding = !accepted;
                    0
                } else {
                    exhausted = true;
                    reason = 7usize;
                    0
                }
                0
            } else {
                if affords(work, 9usize, work_limit) {
                    work = work + 9usize;
                    let kind = read(matcher, 64usize + atom * 8usize);
                    let value = read(matcher, 65usize + atom * 8usize);
                    let minimum = load2(matcher, 66usize + atom * 8usize);
                    let maximum = load4(matcher, 68usize + atom * 8usize);
                    let remaining = length - position;
                    let bound = if maximum < remaining { maximum } else { remaining };
                    let mut count = 0usize;
                    let mut scanning = true;
                    while count < bound && scanning && !exhausted {
                        let cost = if kind == 2usize { 3usize } else { 2usize };
                        if affords(work, cost, work_limit) {
                            work = work + cost;
                            let byte = input_byte(input, position + count);
                            let matched = if kind == 0usize { byte == value } else {
                                if kind == 1usize { true } else {
                                    let bitmap = read(matcher, 1088usize + value * 32usize + byte / 8usize);
                                    bitmap / bit(byte % 8usize) % 2usize == 1usize
                                }
                            };
                            if matched { count = count + 1usize; } else { scanning = false; }
                            0
                        } else {
                            exhausted = true;
                            reason = 7usize;
                            0
                        }
                        0
                    }
                    if !exhausted {
                        if affords(work, 8usize, work_limit) {
                            work = work + 8usize;
                            matcher = frame(matcher, atom, position, count);
                            if count < minimum { rewinding = true; } else {
                                position = position + count;
                                atom = atom + 1usize;
                            }
                            0
                        } else {
                            exhausted = true;
                            reason = 7usize;
                            0
                        }
                        0
                    } else { 0 }
                    0
                } else {
                    exhausted = true;
                    reason = 7usize;
                    0
                }
                0
            }
            0
        }
        0
    }
    let final_cost = 32usize + captures * 29usize;
    if accepted && !exhausted && final_cost > work_limit - work {
        exhausted = true;
        reason = 7usize;
    }
    if accepted && !exhausted {
        let mut capture = 0usize;
        while capture < captures {
            work = work + 29usize;
            let begin_atom = load2(matcher, 1600usize + capture * 4usize);
            let end_atom = load2(matcher, 1602usize + capture * 4usize);
            let start = load4(matcher, 1664usize + begin_atom * 8usize);
            let end = load4(matcher, 1664usize + end_atom * 8usize);
            matcher = capture_result(matcher, capture, start, end);
            capture = capture + 1usize;
            0
        }
        packet(matcher, 1usize, captures, 0usize, length, work + 32usize, 0usize)
    } else {
        let code = if exhausted { 4usize } else { if invalid { 3usize } else { 2usize } };
        let why = if invalid { 2usize } else { reason };
        packet(matcher, code, 0usize, why, length, work + 32usize, detail)
    }
}

// Result observers inspect only the logical packet, never program or scratch
// bytes. Field loads remain usize throughout; there is no narrowing cast.
@id("experiment.pattern.result-valid")
fn result_valid(state: borrow Matcher) -> bool
{
    let mut valid = carrier_valid(state);
    if valid {
        valid = read(state, 2696usize) == 83usize && read(state, 2697usize) == 80usize
            && read(state, 2698usize) == 65usize && read(state, 2699usize) == 84usize
            && read(state, 2700usize) == 1usize;
        if valid {
            let code = read(state, 2701usize);
            let count = read(state, 2702usize);
            let reason = read(state, 2703usize);
            let length = load8(state, 2704usize);
            let work = load8(state, 2712usize);
            let detail = load8(state, 2720usize);
            valid = code <= 4usize && count <= 16usize && work >= 32usize && work <= 262144usize;
            valid = valid && (code == 1usize || count == 0usize);
            valid = valid && (code == 4usize && (reason >= 1usize && reason <= 5usize || reason == 7usize)
                || code == 3usize && (reason == 1usize || reason == 2usize)
                || code <= 2usize && reason == 0usize);
            valid = valid && (code != 3usize || reason == 1usize && detail <= 1024usize || reason == 2usize && detail < 1664usize);
            valid = valid && (length <= 65536usize || code == 4usize && reason == 2usize);
            valid = valid && (code != 0usize || length == 0usize);
            valid = valid && (code != 3usize || reason != 1usize || length == 0usize);
            valid = valid && (code != 4usize || reason != 1usize || length == 0usize && detail > 1024usize);
            valid = valid && (code != 4usize || reason != 2usize || length > 65536usize && detail == length);
            valid = valid && (code != 4usize || reason < 3usize || reason > 5usize || length == 0usize && detail <= 1024usize);
            valid = valid && (code != 4usize || reason != 7usize || detail == 0usize);
            valid = valid && (code == 3usize || code == 4usize || detail == 0usize);
            let mut capture = 0usize;
            while valid && capture < count {
                let start = load8(state, 2728usize + capture * 16usize);
                let end = load8(state, 2736usize + capture * 16usize);
                valid = start <= end && end <= length;
                capture = capture + 1usize;
                0
            }
            valid
        } else { false }
    } else { false }
}

@id("experiment.pattern.status")
fn status(state: borrow Matcher) -> usize
    requires result_valid(state)
{
    read(state, 2701usize)
}

@id("experiment.pattern.capture-count")
fn capture_count(state: borrow Matcher) -> usize
    requires result_valid(state)
{
    read(state, 2702usize)
}

@id("experiment.pattern.work-used")
fn work_used(state: borrow Matcher) -> usize
    requires result_valid(state)
{
    load8(state, 2712usize)
}

@id("experiment.pattern.capture-start")
fn capture_start(state: borrow Matcher, capture: usize) -> usize
    requires result_valid(state) && status(state) == 1usize && capture < capture_count(state)
{
    load8(state, 2728usize + capture * 16usize)
}

@id("experiment.pattern.capture-end")
fn capture_end(state: borrow Matcher, capture: usize) -> usize
    requires result_valid(state) && status(state) == 1usize && capture < capture_count(state)
{
    load8(state, 2736usize + capture * 16usize)
}

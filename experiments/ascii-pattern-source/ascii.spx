            next = bytes_set(next, 41usize, u8_from_i64(i64_from_usize(0usize)));
            next = bytes_set(next, 42usize, u8_from_i64(i64_from_usize(0usize)));
            next = bytes_set(next, 43usize, u8_from_i64(i64_from_usize(0usize)));

// Private source experiment. No manifest, registration, public ABI or gate claim.
module experiment.pattern.ascii;

@id("experiment.pattern.matcher")
record Matcher {
    @id("experiment.pattern.matcher.storage")
    storage: Bytes,
    @id("experiment.pattern.matcher.position")
    position: usize,
}

@id("experiment.pattern.from-bytes")
fn matcher_from_bytes(storage: own Bytes) -> Matcher
    requires byte_len(bytes_as_slice(storage)) == 3072usize
{
    Matcher { storage: storage, position: 0usize }
}

@id("experiment.pattern.extent")
fn extent(state: borrow Matcher) -> usize
{
    match borrow state { Matcher { storage, position } => byte_len(bytes_as_slice(storage)), }
}

// The scalar field is caller-visible metadata, never compiled authority.
@id("experiment.pattern.carrier-valid")
fn carrier_valid(state: borrow Matcher) -> bool
{
    match borrow state { Matcher { storage, position } => byte_len(bytes_as_slice(storage)) == 3072usize && position <= 3072usize, }
}

// One byte read. The fallback is unreachable after these checked preconditions.
@id("experiment.pattern.read")
fn read(state: borrow Matcher, offset: usize) -> usize
    requires carrier_valid(state) && offset < 3072usize
{
    match borrow state {
        Matcher { storage, position } => match byte_get(bytes_as_slice(storage), offset) {
            Option::Some { value } => usize_from_u8(value),
            Option::None {} => 0usize,
        },
    }
}

@id("experiment.pattern.input-byte")
fn input_byte(input: borrow Slice<u8>, offset: usize) -> usize
    requires offset < byte_len(input)
{
    match byte_get(input, offset) {
        Option::Some { value } => usize_from_u8(value),
        Option::None {} => 0usize,
    }
}

@id("experiment.pattern.bit")
fn bit(index: usize) -> usize
    requires index < 8usize
{
    if index == 0usize { 1usize } else {
        if index == 1usize { 2usize } else {
            if index == 2usize { 4usize } else {
                if index == 3usize { 8usize } else {
                    if index == 4usize { 16usize } else {
                        if index == 5usize { 32usize } else {
                            if index == 6usize { 64usize } else { 128usize }
                        }
                    }
                }
            }
        }
    }
}

// Costs are actual storage events. The engine owns the scalar meter and
// preflights each helper's fixed cost before calling it; these helpers never
// retain a borrowed view across an owning update.

@id("experiment.pattern.load-2")
fn load2(state: borrow Matcher, offset: usize) -> usize
    requires carrier_valid(state) && offset <= 3070usize
{
    match borrow state {
        Matcher { storage, position } => {
            let view = bytes_as_slice(storage);
            (match byte_get(view, offset) { Option::Some { value } => usize_from_u8(value), Option::None {} => 0usize, }) * 1usize + (match byte_get(view, offset + 1usize) { Option::Some { value } => usize_from_u8(value), Option::None {} => 0usize, }) * 256usize
        },
    }
}

@id("experiment.pattern.load-4")
fn load4(state: borrow Matcher, offset: usize) -> usize
    requires carrier_valid(state) && offset <= 3068usize
{
    match borrow state {
        Matcher { storage, position } => {
            let view = bytes_as_slice(storage);
            (match byte_get(view, offset) { Option::Some { value } => usize_from_u8(value), Option::None {} => 0usize, }) * 1usize + (match byte_get(view, offset + 1usize) { Option::Some { value } => usize_from_u8(value), Option::None {} => 0usize, }) * 256usize + (match byte_get(view, offset + 2usize) { Option::Some { value } => usize_from_u8(value), Option::None {} => 0usize, }) * 65536usize + (match byte_get(view, offset + 3usize) { Option::Some { value } => usize_from_u8(value), Option::None {} => 0usize, }) * 16777216usize
        },
    }
}

@id("experiment.pattern.load-8")
fn load8(state: borrow Matcher, offset: usize) -> usize
    requires carrier_valid(state) && offset <= 3064usize
{
    match borrow state {
        Matcher { storage, position } => {
            let view = bytes_as_slice(storage);
            (match byte_get(view, offset) { Option::Some { value } => usize_from_u8(value), Option::None {} => 0usize, }) * 1usize + (match byte_get(view, offset + 1usize) { Option::Some { value } => usize_from_u8(value), Option::None {} => 0usize, }) * 256usize + (match byte_get(view, offset + 2usize) { Option::Some { value } => usize_from_u8(value), Option::None {} => 0usize, }) * 65536usize + (match byte_get(view, offset + 3usize) { Option::Some { value } => usize_from_u8(value), Option::None {} => 0usize, }) * 16777216usize + (match byte_get(view, offset + 4usize) { Option::Some { value } => usize_from_u8(value), Option::None {} => 0usize, }) * 4294967296usize + (match byte_get(view, offset + 5usize) { Option::Some { value } => usize_from_u8(value), Option::None {} => 0usize, }) * 1099511627776usize + (match byte_get(view, offset + 6usize) { Option::Some { value } => usize_from_u8(value), Option::None {} => 0usize, }) * 281474976710656usize + (match byte_get(view, offset + 7usize) { Option::Some { value } => usize_from_u8(value), Option::None {} => 0usize, }) * 72057594037927936usize
        },
    }
}

@id("experiment.pattern.store-1")
fn store1(state: own Matcher, offset: usize, value: usize) -> Matcher
    requires carrier_valid(state) && offset <= 3071usize && value <= 255usize
{
    match own state {
        Matcher { storage, position } => {
            let mut next = storage;
            next = bytes_set(next, offset, u8_from_i64(i64_from_usize(value % 256usize)));
            Matcher { storage: next, position: position }
        },
    }
}

@id("experiment.pattern.store-2")
fn store2(state: own Matcher, offset: usize, value: usize) -> Matcher
    requires carrier_valid(state) && offset <= 3070usize && value <= 65535usize
{
    match own state {
        Matcher { storage, position } => {
            let mut next = storage;
            next = bytes_set(next, offset, u8_from_i64(i64_from_usize(value % 256usize)));
            next = bytes_set(next, offset + 1usize, u8_from_i64(i64_from_usize(value / 256usize % 256usize)));
            Matcher { storage: next, position: position }
        },
    }
}

@id("experiment.pattern.store-4")
fn store4(state: own Matcher, offset: usize, value: usize) -> Matcher
    requires carrier_valid(state) && offset <= 3068usize && value <= 4294967295usize
{
    match own state {
        Matcher { storage, position } => {
            let mut next = storage;
            next = bytes_set(next, offset, u8_from_i64(i64_from_usize(value % 256usize)));
            next = bytes_set(next, offset + 1usize, u8_from_i64(i64_from_usize(value / 256usize % 256usize)));
            next = bytes_set(next, offset + 2usize, u8_from_i64(i64_from_usize(value / 65536usize % 256usize)));
            next = bytes_set(next, offset + 3usize, u8_from_i64(i64_from_usize(value / 16777216usize % 256usize)));
            Matcher { storage: next, position: position }
        },
    }
}

@id("experiment.pattern.store-8")
fn store8(state: own Matcher, offset: usize, value: usize) -> Matcher
    requires carrier_valid(state) && offset <= 3064usize
{
    match own state {
        Matcher { storage, position } => {
            let mut next = storage;
            next = bytes_set5(next, offset, u8_from_i64(i64_from_usize(value % 256usize)), u8_from_i64(i64_from_usize(value / 256usize % 256usize)), u8_from_i64(i64_from_usize(value / 65536usize % 256usize)), u8_from_i64(i64_from_usize(value / 16777216usize % 256usize)), u8_from_i64(i64_from_usize(value / 4294967296usize % 256usize)));
            next = bytes_set(next, offset + 5usize, u8_from_i64(i64_from_usize(value / 1099511627776usize % 256usize)));
            next = bytes_set(next, offset + 6usize, u8_from_i64(i64_from_usize(value / 281474976710656usize % 256usize)));
            next = bytes_set(next, offset + 7usize, u8_from_i64(i64_from_usize(value / 72057594037927936usize % 256usize)));
            Matcher { storage: next, position: position }
        },
    }
}

@id("experiment.pattern.frame")
fn frame(state: own Matcher, atom: usize, start: usize, count: usize) -> Matcher
    requires atom <= 128usize && start <= 65536usize && count <= 65536usize
    requires carrier_valid(state)
{
    match own state {
        Matcher { storage, position } => {
            let mut next = storage;
            next = bytes_set5(next, 1664usize + atom * 8usize, u8_from_i64(i64_from_usize(start % 256usize)), u8_from_i64(i64_from_usize(start / 256usize % 256usize)), u8_from_i64(i64_from_usize(start / 65536usize % 256usize)), u8_from_i64(i64_from_usize(start / 16777216usize % 256usize)), u8_from_i64(i64_from_usize(count % 256usize)));
            next = bytes_set(next, (1664usize + atom * 8usize) + 5usize, u8_from_i64(i64_from_usize(count / 256usize % 256usize)));
            next = bytes_set(next, (1664usize + atom * 8usize) + 6usize, u8_from_i64(i64_from_usize(count / 65536usize % 256usize)));
            next = bytes_set(next, (1664usize + atom * 8usize) + 7usize, u8_from_i64(i64_from_usize(count / 16777216usize % 256usize)));
            Matcher { storage: next, position: position }
        },
    }
}

// Exactly 32 writes. The caller includes those stores in work_used before
// entering this helper. No header or stale capture slot is read here.
@id("experiment.pattern.packet")
fn packet(state: own Matcher, status: usize, captures: usize, reason: usize, length: usize, work: usize, detail: usize) -> Matcher
    requires status <= 4usize && captures <= 16usize && reason <= 7usize
    requires work <= 262144usize
    requires carrier_valid(state)
{
    match own state {
        Matcher { storage, position } => {
            let mut next = storage;
            next = bytes_set5(next, 2696usize, 83u8, 80u8, 65u8, 84u8, 1u8);
            next = bytes_set5(next, 2701usize, u8_from_i64(i64_from_usize(status)), u8_from_i64(i64_from_usize(captures)), u8_from_i64(i64_from_usize(reason)), u8_from_i64(i64_from_usize(length % 256usize)), u8_from_i64(i64_from_usize(length / 256usize % 256usize)));
            next = bytes_set5(next, 2706usize, u8_from_i64(i64_from_usize(length / 65536usize % 256usize)), u8_from_i64(i64_from_usize(length / 16777216usize % 256usize)), u8_from_i64(i64_from_usize(length / 4294967296usize % 256usize)), u8_from_i64(i64_from_usize(length / 1099511627776usize % 256usize)), u8_from_i64(i64_from_usize(length / 281474976710656usize % 256usize)));
            next = bytes_set5(next, 2711usize, u8_from_i64(i64_from_usize(length / 72057594037927936usize % 256usize)), u8_from_i64(i64_from_usize(work % 256usize)), u8_from_i64(i64_from_usize(work / 256usize % 256usize)), u8_from_i64(i64_from_usize(work / 65536usize % 256usize)), u8_from_i64(i64_from_usize(work / 16777216usize % 256usize)));
            next = bytes_set5(next, 2716usize, u8_from_i64(i64_from_usize(work / 4294967296usize % 256usize)), u8_from_i64(i64_from_usize(work / 1099511627776usize % 256usize)), u8_from_i64(i64_from_usize(work / 281474976710656usize % 256usize)), u8_from_i64(i64_from_usize(work / 72057594037927936usize % 256usize)), u8_from_i64(i64_from_usize(detail % 256usize)));
            next = bytes_set5(next, 2721usize, u8_from_i64(i64_from_usize(detail / 256usize % 256usize)), u8_from_i64(i64_from_usize(detail / 65536usize % 256usize)), u8_from_i64(i64_from_usize(detail / 16777216usize % 256usize)), u8_from_i64(i64_from_usize(detail / 4294967296usize % 256usize)), u8_from_i64(i64_from_usize(detail / 1099511627776usize % 256usize)));
            next = bytes_set(next, 2726usize, u8_from_i64(i64_from_usize(detail / 281474976710656usize % 256usize)));
            next = bytes_set(next, 2727usize, u8_from_i64(i64_from_usize(detail / 72057594037927936usize % 256usize)));
            Matcher { storage: next, position: position }
        },
    }
}

@id("experiment.pattern.capture-result")
fn capture_result(state: own Matcher, capture: usize, start: usize, end: usize) -> Matcher
    requires capture < 16usize && start <= end && end <= 65536usize
    requires carrier_valid(state)
{
    match own state {
        Matcher { storage, position } => {
            let mut next = storage;
            next = bytes_set5(next, 2728usize + capture * 16usize, u8_from_i64(i64_from_usize(start % 256usize)), u8_from_i64(i64_from_usize(start / 256usize % 256usize)), u8_from_i64(i64_from_usize(start / 65536usize % 256usize)), u8_from_i64(i64_from_usize(start / 16777216usize % 256usize)), u8_from_i64(i64_from_usize(start / 4294967296usize % 256usize)));
            next = bytes_set5(next, (2728usize + capture * 16usize) + 5usize, u8_from_i64(i64_from_usize(start / 1099511627776usize % 256usize)), u8_from_i64(i64_from_usize(start / 281474976710656usize % 256usize)), u8_from_i64(i64_from_usize(start / 72057594037927936usize % 256usize)), u8_from_i64(i64_from_usize(end % 256usize)), u8_from_i64(i64_from_usize(end / 256usize % 256usize)));
            next = bytes_set5(next, (2728usize + capture * 16usize) + 10usize, u8_from_i64(i64_from_usize(end / 65536usize % 256usize)), u8_from_i64(i64_from_usize(end / 16777216usize % 256usize)), u8_from_i64(i64_from_usize(end / 4294967296usize % 256usize)), u8_from_i64(i64_from_usize(end / 1099511627776usize % 256usize)), u8_from_i64(i64_from_usize(end / 281474976710656usize % 256usize)));
            next = bytes_set(next, (2728usize + capture * 16usize) + 15usize, u8_from_i64(i64_from_usize(end / 72057594037927936usize % 256usize)));
            Matcher { storage: next, position: position }
        },
    }
}

// Budget comparison subtracts the already reserved refusal header first.
// No event is performed when its complete fixed charge would cross the bound.
@id("experiment.pattern.affords")
fn affords(work: usize, cost: usize, limit: usize) -> bool
    requires 32usize <= limit && limit <= 262144usize && work <= limit
{
    work <= limit - 32usize && cost <= limit - 32usize - work
}

// Token helpers return only flat Copy cases. Their work field is the exact
// number of pattern reads (and decimal-loop iterations), never AST fuel.
@id("experiment.pattern.token")
variant Token {
    @id("experiment.pattern.token.byte")
    Byte {
        @id("experiment.pattern.token.byte.value") value: usize,
        @id("experiment.pattern.token.byte.next") next: usize,
        @id("experiment.pattern.token.byte.work") work: usize,
    },
    @id("experiment.pattern.token.invalid")
    Invalid {
        @id("experiment.pattern.token.invalid.offset") offset: usize,
        @id("experiment.pattern.token.invalid.work") work: usize,
    },
    @id("experiment.pattern.token.exhausted")
    Exhausted {
        @id("experiment.pattern.token.exhausted.work") work: usize,
    },
}

@id("experiment.pattern.hex")
fn hex(byte: usize) -> usize
{
    if byte >= 48usize && byte <= 57usize { byte - 48usize } else {
        if byte >= 65usize && byte <= 70usize { byte - 55usize } else {
            if byte >= 97usize && byte <= 102usize { byte - 87usize } else { 16usize }
        }
    }
}

@id("experiment.pattern.punctuation")
fn punctuation(byte: usize) -> bool
{
    byte >= 33usize && byte <= 126usize
        && !(byte >= 48usize && byte <= 57usize)
        && !(byte >= 65usize && byte <= 90usize)
        && !(byte >= 97usize && byte <= 122usize)
}

@id("experiment.pattern.literal")
fn literal(byte: usize, in_class: bool) -> bool
{
    byte >= 32usize && byte <= 126usize && byte != 92usize
        && if in_class { byte != 93usize && byte != 94usize } else {
            byte != 46usize && byte != 91usize && byte != 93usize
                && byte != 40usize && byte != 41usize && byte != 63usize
                && byte != 42usize && byte != 43usize && byte != 123usize
                && byte != 125usize && byte != 124usize && byte != 94usize && byte != 36usize
        }
}

// EOF is diagnosed without a read. Escape parsing debits each actual byte
// before reading it, so a malformed third hex byte wins before the fourth.
@id("experiment.pattern.read-token")
fn read_token(pattern: borrow Slice<u8>, offset: usize, in_class: bool, available: usize) -> Token
    requires byte_len(pattern) <= 1024usize && offset <= byte_len(pattern)
{
    let length = byte_len(pattern);
    if offset == length { Token::Invalid { offset: length, work: 0usize } } else {
        if available < 1usize { Token::Exhausted { work: 0usize } } else {
            let first = input_byte(pattern, offset);
            if first != 92usize {
                if literal(first, in_class) { Token::Byte { value: first, next: offset + 1usize, work: 1usize } } else {
                    Token::Invalid { offset: offset, work: 1usize }
                }
            } else {
                if offset + 1usize == length { Token::Invalid { offset: length, work: 1usize } } else {
                    if available < 2usize { Token::Exhausted { work: 1usize } } else {
                        let second = input_byte(pattern, offset + 1usize);
                        if second != 120usize {
                            if punctuation(second) { Token::Byte { value: second, next: offset + 2usize, work: 2usize } } else {
                                Token::Invalid { offset: offset + 1usize, work: 2usize }
                            }
                        } else {
                            if offset + 2usize == length { Token::Invalid { offset: length, work: 2usize } } else {
                                if available < 3usize { Token::Exhausted { work: 2usize } } else {
                                    let high = hex(input_byte(pattern, offset + 2usize));
                                    if high == 16usize { Token::Invalid { offset: offset + 2usize, work: 3usize } } else {
                                        if offset + 3usize == length { Token::Invalid { offset: length, work: 3usize } } else {
                                            if available < 4usize { Token::Exhausted { work: 3usize } } else {
                                                let low = hex(input_byte(pattern, offset + 3usize));
                                                if low == 16usize { Token::Invalid { offset: offset + 3usize, work: 4usize } } else {
                                                    Token::Byte { value: high * 16usize + low, next: offset + 4usize, work: 4usize }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

@id("experiment.pattern.quantifier")
variant Quantifier {
    @id("experiment.pattern.quantifier.bounds")
    Bounds {
        @id("experiment.pattern.quantifier.bounds.minimum") minimum: usize,
        @id("experiment.pattern.quantifier.bounds.maximum") maximum: usize,
        @id("experiment.pattern.quantifier.bounds.next") next: usize,
        @id("experiment.pattern.quantifier.bounds.work") work: usize,
    },
    @id("experiment.pattern.quantifier.invalid")
    Invalid {
        @id("experiment.pattern.quantifier.invalid.offset") offset: usize,
        @id("experiment.pattern.quantifier.invalid.work") work: usize,
    },
    @id("experiment.pattern.quantifier.exhausted")
    Exhausted {
        @id("experiment.pattern.quantifier.exhausted.work") work: usize,
    },
}

@id("experiment.pattern.read-quantifier")
fn read_quantifier(pattern: borrow Slice<u8>, offset: usize, available: usize) -> Quantifier
    requires byte_len(pattern) <= 1024usize && offset <= byte_len(pattern)
{
    let length = byte_len(pattern);
    if offset == length { Quantifier::Bounds { minimum: 1usize, maximum: 1usize, next: offset, work: 0usize } } else {
        if available == 0usize { Quantifier::Exhausted { work: 0usize } } else {
            let first = input_byte(pattern, offset);
            if first == 63usize || first == 42usize || first == 43usize {
                Quantifier::Bounds { minimum: if first == 43usize { 1usize } else { 0usize }, maximum: if first == 63usize { 1usize } else { 4294967295usize }, next: offset + 1usize, work: 1usize }
            } else {
                if first != 123usize { Quantifier::Bounds { minimum: 1usize, maximum: 1usize, next: offset, work: 1usize } } else {
                    let mut cursor = offset + 1usize;
                    let mut work = 1usize;
                    let mut minimum = 0usize;
                    let mut number = 0usize;
                    let mut digits = 0usize;
                    let mut second = false;
                    let mut closed = false;
                    let mut invalid = false;
                    let mut exhausted = false;
                    let mut detail = length;
                    while !closed && !invalid && !exhausted {
                        if cursor == length {
                            if available - work < 1usize { exhausted = true; } else { work = work + 1usize; invalid = true; }
                        } else {
                            if 2usize > available - work { exhausted = true; } else {
                                work = work + 2usize;
                                let byte = input_byte(pattern, cursor);
                                if byte >= 48usize && byte <= 57usize {
                                    if digits > 0usize && number == 0usize { invalid = true; detail = cursor; } else {
                                        number = number * 10usize + byte - 48usize;
                                        if number > 255usize { invalid = true; detail = cursor; } else {
                                            digits = digits + 1usize;
                                            cursor = cursor + 1usize;
                                        }
                                    }
                                } else {
                                    if byte == 44usize && !second && digits > 0usize {
                                        minimum = number;
                                        number = 0usize;
                                        digits = 0usize;
                                        second = true;
                                        cursor = cursor + 1usize;
                                    } else {
                                        if byte == 125usize && digits > 0usize && (!second || minimum <= number) {
                                            if !second { minimum = number; }
                                            cursor = cursor + 1usize;
                                            closed = true;
                                        } else { invalid = true; detail = cursor; }
                                    }
                                }
                                0
                            }
                        }
                        0
                    }
                    if exhausted { Quantifier::Exhausted { work: work } } else {
                        if invalid { Quantifier::Invalid { offset: detail, work: work } } else {
                            Quantifier::Bounds { minimum: minimum, maximum: number, next: cursor, work: work }
                        }
                    }
                }
            }
        }
    }
}

@id("experiment.pattern.store-atom")
fn store_atom(state: own Matcher, atom: usize, kind: usize, value: usize, minimum: usize, maximum: usize) -> Matcher
    requires atom < 128usize && kind <= 2usize && value <= 255usize
    requires minimum <= 255usize && (maximum == 4294967295usize || minimum <= maximum && maximum <= 255usize)
    requires carrier_valid(state)
{
    match own state {
        Matcher { storage, position } => {
            let mut next = storage;
            next = bytes_set5(next, 64usize + atom * 8usize, u8_from_i64(i64_from_usize(kind)), u8_from_i64(i64_from_usize(value)), u8_from_i64(i64_from_usize(minimum % 256usize)), u8_from_i64(i64_from_usize(minimum / 256usize % 256usize)), u8_from_i64(i64_from_usize(maximum % 256usize)));
            next = bytes_set(next, (64usize + atom * 8usize) + 5usize, u8_from_i64(i64_from_usize(maximum / 256usize % 256usize)));
            next = bytes_set(next, (64usize + atom * 8usize) + 6usize, u8_from_i64(i64_from_usize(maximum / 65536usize % 256usize)));
            next = bytes_set(next, (64usize + atom * 8usize) + 7usize, u8_from_i64(i64_from_usize(maximum / 16777216usize % 256usize)));
            Matcher { storage: next, position: position }
        },
    }
}

@id("experiment.pattern.clear-candidate")
fn clear_candidate(state: own Matcher) -> Matcher
    requires carrier_valid(state)
{
    match own state {
        Matcher { storage, position } => {
            let mut next = storage;
            next = bytes_set5(next, 2984usize, 0u8, 0u8, 0u8, 0u8, 0u8);
            next = bytes_set5(next, 2989usize, 0u8, 0u8, 0u8, 0u8, 0u8);
            next = bytes_set5(next, 2994usize, 0u8, 0u8, 0u8, 0u8, 0u8);
            next = bytes_set5(next, 2999usize, 0u8, 0u8, 0u8, 0u8, 0u8);
            next = bytes_set5(next, 3004usize, 0u8, 0u8, 0u8, 0u8, 0u8);
            next = bytes_set5(next, 3009usize, 0u8, 0u8, 0u8, 0u8, 0u8);
            next = bytes_set(next, 3014usize, 0u8);
            next = bytes_set(next, 3015usize, 0u8);
            Matcher { storage: next, position: position }

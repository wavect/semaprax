            next = bytes_set(next, 50usize, u8_from_i64(i64_from_usize(0usize)));
            next = bytes_set(next, 51usize, u8_from_i64(i64_from_usize(0usize)));
            next = bytes_set(next, 52usize, u8_from_i64(i64_from_usize(0usize)));
            next = bytes_set(next, 53usize, u8_from_i64(i64_from_usize(0usize)));

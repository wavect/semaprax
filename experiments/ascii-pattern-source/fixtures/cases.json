      "expected": {"compile": {"status": "ready", "atom_count": 1},
                   "match": {"status": "matched", "status_code": 1, "spans": [[0, 3]]}}
    },
    {
      "id": "source-nonreserved-printable-literal",
      "source_differential": true,
      "purpose": "Printable punctuation not reserved by the grammar remains an ordinary literal.",
      "pattern": "a!b",
      "input": {"ascii": "a!b"},
      "expected": {"compile": {"status": "ready", "atom_count": 3},
                   "match": {"status": "matched", "status_code": 1, "spans": []}}
    },
    {
      "id": "source-long-adjacent-repeats-valid",
      "source_differential": true,
      "purpose": "Long adjacent finite repeats select the lexicographically greatest complete vector.",
      "pattern": "([ab]{0,64})([ab]{0,64})",

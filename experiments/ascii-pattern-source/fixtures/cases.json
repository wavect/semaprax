      "engine_work_status": "not_predicted_by_oracle",
      "expected": {"compile": {"status": "ready", "capture_boundaries": [[0, 1], [1, 2]]},
                   "match": {"status": "matched", "status_code": 1, "spans": [[0, 64], [64, 64]]}}
    },
    {
      "id": "source-long-adjacent-repeats-no-match",
      "source_differential": true,
      "purpose": "Long adjacent repeats still require the trailing literal and the entire input.",
      "pattern": "(a{0,64})(a{0,64})b",
      "input": {"ascii": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},
      "engine_work_status": "not_predicted_by_oracle",
      "expected": {"compile": {"status": "ready"},
                   "match": {"status": "no_match", "status_code": 2, "spans": []}}
    },
    {
      "id": "source-hostile-adjacent-repeats-no-match",
      "source_differential": true,
      "purpose": "Several adjacent bounded repeats must reject a complete-input near miss.",
      "pattern": "a{0,4}a{0,4}a{0,4}a{0,4}a{0,4}b",
      "input": {"ascii": "aaaaaaaaaaaaaaaaaaaac"},
      "engine_work_status": "not_predicted_by_oracle",
      "expected": {"compile": {"status": "ready"},
                   "match": {"status": "no_match", "status_code": 2, "spans": []}}
    },
    {
      "id": "source-independent-header-capture",
      "source_differential": true,
      "purpose": "A header-shaped independent record preserves separate key and value byte spans.",
      "pattern": "([A-Za-z-]+):[ \\x09]*([^\\x0D\\x0A]*)",
      "input": {"ascii": "X-Key: value"},
      "expected": {"compile": {"status": "ready", "atom_count": 5, "class_count": 2,

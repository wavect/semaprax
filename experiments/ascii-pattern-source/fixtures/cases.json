    },
    {
      "id": "source-independent-key-value-capture",
      "source_differential": true,
      "purpose": "A key=value record captures identifier and value independently.",
      "pattern": "([A-Za-z_][A-Za-z0-9_]*)=([^\\x00\\x0A]*)",

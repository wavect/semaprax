{
  "schema": "semaprax.ascii-pattern-source-fixtures.v1",
  "semantics": "docs/proposals/ASCII-PATTERN-CAPTURES-DRAFT.md; proposed only",
  "representation": {
    "atom_fields": ["kind", "value", "min", "max"],
    "atom_kinds": {"literal": 0, "any_byte": 1, "class_bitmap": 2},
    "class_bitmap": "32 little-bit-order bytes; bit n is bitmap[n//8] bit (n%8)",
    "capture_boundaries": "half-open atom-index pairs [begin,end), flat and nonoverlapping",
    "input_descriptors": ["ascii", "hex", "repeat_ascii", "repeat_hex"],
    "pattern_repeat_descriptor": "repeat unit count then optional suffix; expansion is ASCII byte text"
  },
  "status_codes": {"ready": 0, "matched": 1, "no_match": 2, "invalid_pattern": 3, "resource_refusal": 4},
  "limits": {"pattern_bytes": 1024, "input_bytes": 65536, "atoms": 128, "distinct_classes": 16, "captures": 16},
  "oracle_scope": "semantic parser and whole-input matcher only; no engine work-meter prediction",
  "cases": [
    {
      "id": "literal-plus-timezone",
      "purpose": "The timezone separator is literal plus, not either sign.",
      "pattern": "([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2})\\x2B([0-9]{2}):([0-9]{2})",
      "input": {"ascii": "2026-10-09T07:00:00+02:00"},
      "expected": {
        "compile": {"status": "ready", "status_code": 0, "atom_count": 15, "class_count": 1,
                     "capture_boundaries": [[0, 11], [12, 13], [14, 15]]},
        "match": {"status": "matched", "status_code": 1, "spans": [[0, 19], [20, 22], [23, 25]]}
      }
    },
    {
      "id": "literal-plus-timezone-rejects-minus",
      "purpose": "A leading minus is a valid nonmatch, not timezone normalization.",
      "pattern": "([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2})\\x2B([0-9]{2}):([0-9]{2})",
      "input": {"ascii": "2026-10-09T07:00:00-02:00"},
      "expected": {"compile": {"status": "ready"}, "match": {"status": "no_match", "status_code": 2, "spans": []}}
    },
    {
      "id": "independent-header-record",
      "purpose": "An unrelated header-shaped record preserves key and value byte spans.",
      "pattern": "([A-Za-z]+):[ \\x09]*([^\\x0D\\x0A]*)",
      "input": {"ascii": "Xtest: value"},
      "expected": {
        "compile": {"status": "ready", "status_code": 0, "atom_count": 5, "class_count": 2,
                     "capture_boundaries": [[0, 1], [3, 4]]},
        "match": {"status": "matched", "status_code": 1, "count_vector": [5, 1, 5],
                  "spans": [[0, 5], [7, 12]]}
      }
    },
    {
      "id": "independent-key-value-record",
      "purpose": "An unrelated key=value record captures the identifier and value independently.",
      "pattern": "([A-Za-z_][A-Za-z0-9_]*)=([^\\x00\\x0A]*)",
      "input": {"ascii": "event_id=abc123"},
      "expected": {
        "compile": {"status": "ready", "status_code": 0, "atom_count": 4, "class_count": 3,
                     "capture_boundaries": [[0, 2], [3, 4]]},
        "match": {"status": "matched", "status_code": 1, "count_vector": [7, 6],
                  "spans": [[0, 8], [9, 15]]}
      }
    },
    {
      "id": "greedy-repeat-required-suffix",
      "purpose": "A required final digit forces the greedy capture to backtrack one byte.",
      "pattern": "([0-9]+)[0-9]",
      "input": {"ascii": "123"},
      "expected": {
        "compile": {"status": "ready", "status_code": 0, "atom_count": 2, "class_count": 1,
                     "capture_boundaries": [[0, 1]]},
        "match": {"status": "matched", "status_code": 1, "count_vector": [2], "spans": [[0, 2]]}
      }
    },
    {
      "id": "adjacent-repeats-lexicographic-greed",
      "purpose": "For equal complete paths, the first repetition count is preferred lexicographically.",
      "pattern": "(a*)(a*)",
      "input": {"ascii": "aa"},
      "expected": {
        "compile": {"status": "ready", "status_code": 0, "atom_count": 2, "class_count": 0,
                     "capture_boundaries": [[0, 1], [1, 2]]},
        "match": {"status": "matched", "status_code": 1, "count_vector": [2, 0],
                  "spans": [[0, 2], [2, 2]]}
      }
    },
    {
      "id": "adjacent-repeats-fallback-to-required-suffix",
      "purpose": "A later required atom rejects the maximal first count and selects the next complete vector.",
      "pattern": "(a+)(a)",
      "input": {"ascii": "aa"},
      "expected": {
        "compile": {"status": "ready", "status_code": 0, "atom_count": 2, "class_count": 0,
                     "capture_boundaries": [[0, 1], [1, 2]]},
        "match": {"status": "matched", "status_code": 1, "count_vector": [1],
                  "spans": [[0, 1], [1, 2]]}
      }
    },
    {
      "id": "empty-captures-are-present",
      "purpose": "Empty capture spans remain explicit and ordered.",
      "pattern": "()(a*)()",
      "input": {"ascii": "a"},
      "expected": {
        "compile": {"status": "ready", "status_code": 0, "atom_count": 1, "class_count": 0,
                     "capture_boundaries": [[0, 0], [0, 1], [1, 1]]},
        "match": {"status": "matched", "status_code": 1, "count_vector": [1],
                  "spans": [[0, 0], [0, 1], [1, 1]]}
      }
    },
    {
      "id": "bounded-adjacent-repeat-no-match",
      "purpose": "Semantic no-match remains distinct from any work-meter refusal.",
      "pattern": "a*a*a*a*a*b",
      "input": {"ascii": "aaaaaa"},
      "engine_work_status": "not_predicted_by_oracle",
      "expected": {
        "compile": {"status": "ready"},
        "match": {"status": "no_match", "status_code": 2, "spans": []}
      }
    },
    {
      "id": "all-byte-values",
      "purpose": "Dot and repetition operate on all 256 byte values, including NUL and 0xFF.",
      "pattern": ".*",
      "input": {"hex": ""},
      "expected": {"compile": {"status": "ready", "atom_count": 1}, "match": {"status": "matched", "status_code": 1, "spans": []}}
    },
    {
      "id": "capture-may-split-utf8",
      "purpose": "Offsets are bytes; a successful capture may end inside a UTF-8 sequence.",
      "pattern": "(.).",
      "input": {"hex": "c3a9"},
      "expected": {
        "compile": {"status": "ready", "atom_count": 2, "capture_boundaries": [[0, 1]]},
        "match": {"status": "matched", "status_code": 1, "spans": [[0, 1]]}
      }
    },
    {
      "id": "source-escaped-printable-punctuation",
      "source_differential": true,
      "purpose": "A quoted printable punctuation byte is a literal atom.",
      "pattern": "a\\+b",
      "input": {"ascii": "a+b"},
      "expected": {"compile": {"status": "ready", "atom_count": 3},
                   "match": {"status": "matched", "status_code": 1, "spans": []}}
    },
    {
      "id": "source-class-terminal-hyphen-and-complement",
      "source_differential": true,
      "purpose": "The terminal raw hyphen is literal while leading class caret complements.",
      "pattern": "([^A-C-]+)",

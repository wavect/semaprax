module loglens;
use function @id("std.int.decimal.add") from std.int.decimal as decimal_add;
use function @id("std.int.decimal.canonicalize") from std.int.decimal as decimal_canonicalize;
use function @id("std.int.decimal.divide") from std.int.decimal as decimal_divide;
use type @id("std.pattern.matcher") from std.pattern as Matcher;
use function @id("std.pattern.capture-count") from std.pattern as matcher_capture_count;
use function @id("std.pattern.capture-end") from std.pattern as matcher_capture_end;
use function @id("std.pattern.capture-start") from std.pattern as matcher_capture_start;
use function @id("std.pattern.compile") from std.pattern as matcher_compile;
use function @id("std.pattern.full-match") from std.pattern as matcher_full_match;
use function @id("std.pattern.make") from std.pattern as matcher_make;
use function @id("std.pattern.status") from std.pattern as matcher_status;

permit { fs.read, process.args.read, process.stderr.write, process.stdout.write }

@id("loglens.digits")
fn digits(s: string, start: i64, end: i64) -> bool
{
    let mut ok = end > start;
    let mut i = start;
    while i < end {
        let b = string_byte_at(s, i);
        ok = ok && b >= 48 && b <= 57;
        i = i + 1;
        0
    }
    ok
}

@id("loglens.token")
fn token(s: string, start: i64, end: i64) -> bool
{
    let mut ok = end > start;
    let mut i = start;
    while i < end {
        let b = string_byte_at(s, i);
        ok = ok && b > 32 && b != 127;
        i = i + 1;
        0
    }
    ok
}

@id("loglens.ascii")
fn ascii(s: string, start: i64, end: i64) -> bool
{
    let mut i = start;
    let mut ok = true;
    while i < end {
        ok = ok && string_byte_at(s, i) < 128;
        i = i + 1;
        0
    }
    ok
}

// Decimal arithmetic keeps byte totals exact even beyond machine integers.
@id("loglens.add")
fn add(a: string, b: string) -> string
{
    decimal_add(decimal_canonicalize(a), decimal_canonicalize(b))
}

@id("loglens.divide")
fn divide(a: string, divisor: i64) -> string
{
    if divisor == 0 { "0" } else { let denominator = string_from_i64(divisor); decimal_divide(decimal_canonicalize(a), string_as_str(denominator)) }
}

@id("loglens.usage")
fn usage() -> i64
    uses { process.stderr.write }
{
    let message = "usage: loglens <file> [--top N] [--json]\n";
    let v = string_as_str(message);
    let written = stderr_write(str_as_bytes(v));
    2
}

@id("loglens.report")
fn report(top: i64, json: bool) -> i64
    uses { fs.read, process.args.read, process.stderr.write, process.stdout.write }
{
    let file = arg_utf8(0usize);
    let input = file_read_text(file);
    let mut lines = 0;
    let mut requests = 0;
    let mut s2 = 0;
    let mut s3 = 0;
    let mut s4 = 0;
    let mut s5 = 0;
    let mut total = "0";
    let mut matcher_failed = false;
    let pattern = "([^\\x00-\\x20\\x7F]+) - - \\x5B[0-9]{2}/[A-Za-z]{3}/[0-9]{4}:([0-2][0-9]):[0-9]{2}:[0-9]{2} \\x2B[0-9]{4}\\x5D \\x22([A-Z]+) (/[^\\x00-\\x20\\x7F\\x22\\x5C]*) [^\\x00-\\x20\\x7F]+\\x22 ([1-5][0-9]{2}) ([0-9-]+)";
    let pattern_view = string_as_str(pattern);
    let pattern_bytes = str_as_bytes(pattern_view);
    let mut parser: Matcher = matcher_compile(matcher_make(), pattern_bytes, 262144usize);
    matcher_failed = matcher_status(parser) != 0usize;
    let mut ips = map_new(65536usize);
    let mut paths = map_new(65536usize);
    let mut hours = map_new(24usize);
    let mut pos = 0;
    while pos < string_len(input) {
        let mut end = pos;
        while end < string_len(input) && string_byte_at(input, end) != 10 && string_byte_at(input, end) != 13 {
            end = end + 1;
            0
        }
        if end > pos { lines = lines + 1; if !matcher_failed { let line = string_slice(input, pos, end); let line_view = string_as_str(line); let line_bytes = str_as_bytes(line_view); parser = matcher_full_match(parser, line_bytes, 262144usize); let result_status = matcher_status(parser); if result_status == 4usize || result_status == 3usize { matcher_failed = true; } else { if result_status == 1usize { if matcher_capture_count(parser) != 6usize { matcher_failed = true; } else { let ip = string_slice(line, i64_from_usize(matcher_capture_start(parser, 0usize)), i64_from_usize(matcher_capture_end(parser, 0usize))); let hour = string_slice(line, i64_from_usize(matcher_capture_start(parser, 1usize)), i64_from_usize(matcher_capture_end(parser, 1usize))); let path = string_slice(line, i64_from_usize(matcher_capture_start(parser, 3usize)), i64_from_usize(matcher_capture_end(parser, 3usize))); let status = string_slice(line, i64_from_usize(matcher_capture_start(parser, 4usize)), i64_from_usize(matcher_capture_end(parser, 4usize))); let bytes = string_slice(line, i64_from_usize(matcher_capture_start(parser, 5usize)), i64_from_usize(matcher_capture_end(parser, 5usize))); let ip_valid = token(ip, 0, string_len(ip)); let path_valid = token(path, 0, string_len(path)) && !string_contains(path, "\"") && !string_contains(path, "\\"); let hour_valid = string_compare(hour, "23") <= 0; let bytes_valid = string_compare(bytes, "-") == 0 || digits(bytes, 0, string_len(bytes)); if ip_valid && path_valid && hour_valid && bytes_valid { requests = requests + 1; ips = map_set(ips, ip, 1); paths = map_add(paths, path, 1); hours = map_add(hours, hour, 1); let status_code = string_byte_at(status, 0); if status_code == 50 { s2 = s2 + 1; } if status_code == 51 { s3 = s3 + 1; } if status_code == 52 { s4 = s4 + 1; } if status_code == 53 { s5 = s5 + 1; } if string_compare(bytes, "-") != 0 { total = add(total, bytes); } } } } else { if result_status != 2usize { matcher_failed = true; } } } } }
        pos = end;
        if pos < string_len(input) { let terminator = string_byte_at(input, pos); pos = pos + 1; if terminator == 13 && pos < string_len(input) && string_byte_at(input, pos) == 10 { pos = pos + 1; } }
        0
    }
    let rate = if requests == 0 { 0 } else { ((s4 + s5) * 2000 + requests) / (requests * 2) };
    let percent = string_format("{}.{}", rate / 10, rate % 10);
    let average = divide(string_slice(total, 0, string_len(total)), requests);
    let mut out = if json { string_format("{{\"lines\":{},\"requests\":{},\"malformed\":{},\"unique_ips\":{},\"status\":{{\"2xx\":{},\"3xx\":{},\"4xx\":{},\"5xx\":{}}},\"error_rate\":{},\"bytes\":{},\"avg_bytes\":{},\"top_paths\":[", lines, requests, lines - requests, map_len(ips), s2, s3, s4, s5, percent, total, average) } else { string_format("lines: {}\nrequests: {}\nmalformed: {}\nunique_ips: {}\nstatus: 2xx={} 3xx={} 4xx={} 5xx={}\nerror_rate: {}%\nbytes: {}\navg_bytes: {}\ntop_paths:\n", lines, requests, lines - requests, map_len(ips), s2, s3, s4, s5, percent, total, average) };
    let mut rank = 0;
    while rank < top && rank < i64_from_usize(map_len(paths)) {
        let mut best = 0usize;
        let mut index = 0usize;
        while index < map_len(paths) {
            if map_value_at(paths, index) > map_value_at(paths, best) { best = index; }
            index = index + 1usize;
            0
        }
        let key = map_key_at(paths, best);
        let count = map_value_at(paths, best);
        if json { if rank > 0 { out = string_concat(out, ","); } out = string_format("{}{{\"path\":\"{}\",\"count\":{}}}", out, string_slice(key, 0, string_len(key)), count); } else { out = string_format("{}  {}. {} {}\n", out, rank + 1, string_slice(key, 0, string_len(key)), count); }
        paths = map_set(paths, key, -1);
        rank = rank + 1;
        0
    }
    out = string_concat(out, if json { "],\"hours\":{" } else { "hours:\n" });
    let mut h = 0usize;
    let mut busiest = "-";
    let mut peak = 0;
    while h < map_len(hours) {
        let hour = map_key_at(hours, h);
        let count = map_value_at(hours, h);
        if count > peak { busiest = string_slice(hour, 0, string_len(hour)); peak = count; }
        if json { if h > 0usize { out = string_concat(out, ","); } out = string_format("{}\"{}\":{}", out, hour, count); } else { out = string_format("{}  {} {}\n", out, hour, count); }
        h = h + 1usize;
        0
    }
    out = if json { string_format("{}}},\"busiest_hour\":\"{}\"}}\n", out, busiest) } else { string_format("{}busiest_hour: {}\n", out, busiest) };
    if matcher_failed { let message = "loglens: request matcher failed\n"; let view = string_as_str(message); let written = stderr_write(str_as_bytes(view)); 1 } else { let view = string_as_str(out); let written = stdout_write(str_as_bytes(view)); 0 }
}

@id("loglens.main")
fn main() -> i64
    uses { fs.read, process.args.read, process.stderr.write, process.stdout.write }
{
    let mut valid = args_len() > 0usize;
    let mut top = 5;
    let mut json = false;
    let mut i = 1usize;
    while i < args_len() {
        let arg = arg_utf8(i);
        let flag = string_from_str(arg);
        if string_compare(flag, "--json") == 0 { json = true; } else { if string_compare(flag, "--top") == 0 && i + 1usize < args_len() { i = i + 1usize; let value = arg_utf8(i); let number = string_from_str(value); let n = match string_to_i64(number) { Option::Some { value: v } => v, Option::None {} => 0, }; if n >= 1 && n <= 50 { top = n; } else { valid = false; } } else { valid = false; } }
        i = i + 1usize;
        0
    }
    if valid { report(top, json) } else { usage() }
}

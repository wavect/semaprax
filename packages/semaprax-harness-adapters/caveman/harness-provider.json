{
  "schema": "semaprax.harness-provider.v1",
  "provider": {"id": "ai.caveman/caveman-command-view", "version": "0.1.0"},
  "adapter": {"runtime": "python", "entry": ["adapter.py"], "version": "0.1.0"},
  "upstream": {"name": "caveman", "package": "host-provisioned:caveman-input-runtime", "repository": "https://github.com/JuliusBrussee/caveman", "versions": ["3.1.0"], "identity_probe": ["--version"]},
  "protocol": {"name": "semaprax.harness-rpc.v1", "min": 1, "max": 1},
  "capabilities": [
    {"kind": "command.view", "version": 1, "required": false, "operations": ["plan", "view"]}
  ],
  "extensions": [],
  "platforms": ["macos-aarch64", "linux-aarch64", "linux-x86_64"],
  "config": {"fields": {}},
  "permissions": {"read": ["retention"], "write": ["retention"], "network": ["loopback:127.0.0.1:8787"], "process": [], "secrets": []},
  "resources": {"handshake_timeout_ms": 5000, "invoke_timeout_ms": 30000, "max_frame_bytes": 1048576, "max_concurrency": 1, "idle_shutdown_ms": 60000},
  "cancellation": "cooperative",
  "support": {"license": "MIT", "isolation": "subprocess", "tested": []}
}

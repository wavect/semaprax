  "permissions": {"read": ["project"], "write": [], "network": [], "process": [], "secrets": []},
  "resources": {"handshake_timeout_ms": 5000, "invoke_timeout_ms": 30000, "max_frame_bytes": 1048576, "max_concurrency": 1, "idle_shutdown_ms": 60000},
  "cancellation": "cooperative",
  "support": {"license": "Apache-2.0", "isolation": "subprocess", "tested": []}

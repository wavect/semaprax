{
  "schema": "semaprax.harness-provider.v1",
  "provider": {"id": "org.example/context-rust", "version": "0.1.0"},
  "adapter": {"runtime": "native", "entry": ["target/debug/examples/context_adapter_rust"], "version": "0.1.0"},
  "upstream": {"name": "context-rust", "package": "local:context_adapter_rust.rs", "repository": "https://github.com/wavect/semaprax", "versions": ["builtin-0.1.0"], "identity_probe": []},
  "protocol": {"name": "semaprax.harness-rpc.v1", "min": 1, "max": 1},
  "capabilities": [
    {"kind": "context.repository", "version": 1, "required": true, "operations": ["search"]}
  ],
  "extensions": [],
  "platforms": ["macos-aarch64", "linux-x86_64"],

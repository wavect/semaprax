{
  "schema": "semaprax.harness-provider.v1",
  "provider": {"id": "ai.rtk/rtk-command-view", "version": "0.1.0"},
  "adapter": {"runtime": "python", "entry": ["adapter.py"], "version": "0.1.0"},
  "upstream": {"name": "rtk", "package": "github-release:rtk-ai/rtk", "repository": "https://github.com/rtk-ai/rtk", "versions": ["0.51.0"], "identity_probe": ["--version"]},
  "protocol": {"name": "semaprax.harness-rpc.v1", "min": 1, "max": 1},
  "capabilities": [
    {"kind": "command.view", "version": 1, "required": false, "operations": ["plan", "view"]}
  ],
  "extensions": [],
  "platforms": ["macos-aarch64", "linux-aarch64"],
  "config": {"fields": {"allow_wrapper": {"type": "bool", "default": false}}},
  "permissions": {"read": ["retention"], "write": ["retention"], "network": [], "process": ["upstream"], "secrets": []},
  "resources": {"handshake_timeout_ms": 5000, "invoke_timeout_ms": 30000, "max_frame_bytes": 1048576, "max_concurrency": 1, "idle_shutdown_ms": 60000},
  "cancellation": "cooperative",
  "support": {"license": "Apache-2.0", "isolation": "subprocess", "tested": [{"upstream": "0.51.0", "os": "macos-aarch64", "result": "pass"}]}
}

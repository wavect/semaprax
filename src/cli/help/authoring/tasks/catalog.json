        "path": "codec-plan.json"
      },
      {
        "content": "schema = \"semaprax.manifest.v1\"\n\n[package]\nname = \"json-tool\"\nversion = \"0.1.0\"\nprofile = \"language-command-io.collection-record.v1\"\n\n[modules]\nentry = \"example.app\"\nsources = [\"src/app.spx\", \"src/request.spx\", \"src/response.spx\", \"src/tests.spx\"]\ntests = [\"example.tests\"]\n\n[exports]\nweb = [\"example.command\"]\n\n[command]\nfunction = \"example.command\"\ninput = \"argv-utf8+stdin-stream.v1\"\n\n[capabilities]\nrequired = [\"process.args.read\", \"process.stderr.write\", \"process.stdin.read\", \"process.stdout.write\"]\n\n[dependencies]\nstd.data.json.digits = \"=0.1.0\"\nstd.data.json.query = \"=0.1.0\"\nstd.data.json.scan = \"=0.1.0\"\nstd.data.json.token = \"=0.1.0\"\nstd.data.json.write = \"=0.1.0\"\n\n[targets]\nmatrix = [\"native64\"]\n",
        "path": "semaprax.toml"
      },
      {
        "content": "module example.app;\n\npermit { process.args.read, process.stderr.write, process.stdin.read, process.stdout.write }\n\n@id(\"example.command\")\nfn command() -> i64\n    uses { process.stdin.read }\n{\n    let mut reader = stdin_stream_open();\n    while !stdin_stream_eof(reader) {\n        reader = stdin_stream_next(reader);\n        0\n    }\n    0\n}\n\n@id(\"example.main\")\nfn main() -> i64\n{\n    0\n}\n",
        "path": "src/app.spx"
      },
      {
        "content": "module example.request_schema;\n\npermit { process.stdin.read }\n\n@id(\"example.item\")\nrecord Item {\n    @id(\"example.item.key\")\n    key: string,\n    @id(\"example.item.value\")\n    value: i64,\n}\n\n@id(\"example.request\")\nrecord Request {\n    @id(\"example.request.labels\")\n    labels: Vec<string>,\n    @id(\"example.request.items\")\n    items: Vec<Item>,\n}\n\n@id(\"example.request.anchor\")\nfn request_anchor() -> i64\n{\n    0\n}\n",
        "path": "src/request.spx"
      },
      {
        "content": "module example.response_schema;\n\n@id(\"example.row\")\nrecord Row {\n    @id(\"example.row.value\")\n    value: i64,\n}\n\n@id(\"example.summary\")\nrecord Summary {\n    @id(\"example.summary.count\")\n    count: i64,\n}\n\n@id(\"example.response\")\nrecord Response {\n    @id(\"example.response.rows\")\n    rows: Vec<Row>,\n    @id(\"example.response.summary\")\n    summary: Summary,\n}\n\n@id(\"example.response.anchor\")\nfn response_anchor() -> i64\n{\n    0\n}\n",
        "path": "src/response.spx"
      },
      {
        "content": "module example.tests;\n\n@id(\"example.tests.main\")\nfn main() -> i64\n{\n    0\n}\n",
        "path": "src/tests.spx"
      }

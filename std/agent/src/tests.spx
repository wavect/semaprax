module std.agent.tests;
use type @id("std.agent.task") from std.agent as Task;
use type @id("std.agent.outcome") from std.agent as Outcome;
use type @id("std.agent.context") from std.agent as Context;
use type @id("std.agent.observation") from std.agent as Observation;
use function @id("std.agent.initialize") from std.agent as initialize;
use function @id("std.agent.observe") from std.agent as observe;
use function @id("std.agent.advance") from std.agent as advance;
use function @id("std.agent.outcome-bytes") from std.agent as outcome_bytes;
use function @id("std.agent.outcome-status") from std.agent as outcome_status;
use function @id("std.agent.stage-after-initialize") from std.agent as stage_after_initialize;
use function @id("std.agent.stage-after-observe") from std.agent as stage_after_observe;
use function @id("std.agent.stage-after-authorize") from std.agent as stage_after_authorize;
use function @id("std.agent.stage-after-reduce") from std.agent as stage_after_reduce;
use function @id("std.agent.stage-transition") from std.agent as stage_transition;
use function @id("std.agent.stage-is-terminal") from std.agent as stage_is_terminal;
use function @id("std.agent.retry-admitted") from std.agent as retry_admitted;
use function @id("std.agent.retry-delay") from std.agent as retry_delay;

@id("std.agent.tests.roles")
fn roles() -> bool
{
    let objective = [97u8, 0u8, 255u8];
    let task = Task { objective: bytes_copy(array_as_slice(objective)), budget: 5 };
    let context = initialize(task);
    let observation = observe(context);
    let next = advance(context);
    let objective_matches = match borrow next { Context { objective: retained_objective, budget: _, epoch: _ } => { let view = bytes_as_slice(retained_objective); let first = match byte_get(view, 0usize) { Option::Some { value } => value, Option::None {} => 1u8, }; let second = match byte_get(view, 1usize) { Option::Some { value } => value, Option::None {} => 1u8, }; let third = match byte_get(view, 2usize) { Option::Some { value } => value, Option::None {} => 1u8, }; byte_len(view) == 3usize && first == 97u8 && second == 0u8 && third == 255u8 }, };
    observation.budget == 5 && observation.epoch == 0 && next.budget == 5 && next.epoch == 1 && objective_matches
}

@id("std.agent.tests.outcome")
fn outcome() -> bool
{
    let data = [255u8, 0u8];
    let item = Outcome { value: bytes_copy(array_as_slice(data)), status: -9 };
    let status = outcome_status(item);
    let released = outcome_bytes(item);
    let view = bytes_as_slice(released);
    let first = match byte_get(view, 0usize) { Option::Some { value } => value, Option::None {} => 1u8, };
    let second = match byte_get(view, 1usize) { Option::Some { value } => value, Option::None {} => 1u8, };
    status == -9 && byte_len(view) == 2usize && first == 255u8 && second == 0u8
}

@id("std.agent.tests.advance-boundary")
fn advance_boundary() -> bool
{
    let objective = [1u8];
    let context = Context { objective: bytes_copy(array_as_slice(objective)), budget: -7, epoch: 9223372036854775806 };
    let next = advance(context);
    next.budget == -7 && next.epoch == 9223372036854775807
}

@id("std.agent.tests.stage-helper-initialize")
fn stage_helper_initialize() -> bool
{
    stage_after_initialize(1) && !stage_after_initialize(0)
}

@id("std.agent.tests.stage-helper-observe")
fn stage_helper_observe() -> bool
{
    stage_after_observe(2) && !stage_after_observe(1)
}

@id("std.agent.tests.stage-helper-authorize")
fn stage_helper_authorize() -> bool
{
    stage_after_authorize(3) && !stage_after_authorize(2)
}

@id("std.agent.tests.stage-helper-reduce")
fn stage_helper_reduce() -> bool
{
    stage_after_reduce(4) && !stage_after_reduce(0)
}

@id("std.agent.tests.stage-row-initialize")
fn stage_row_initialize() -> bool
{
    !stage_transition(0, 0) && stage_transition(0, 1) && !stage_transition(0, 2)
}

@id("std.agent.tests.stage-row-reduce")
fn stage_row_reduce() -> bool
{
    stage_transition(3, 1) && stage_transition(3, 4) && stage_transition(3, 5) && stage_transition(3, 6) && !stage_transition(3, 0) && !stage_transition(3, 2) && !stage_transition(3, 3)
}

@id("std.agent.tests.stage-row-terminal")
fn stage_row_terminal() -> bool
{
    !stage_transition(4, 0) && !stage_transition(4, 6) && !stage_transition(5, 0) && !stage_transition(5, 6) && !stage_transition(6, 0) && !stage_transition(6, 6)
}

@id("std.agent.tests.stage-row-out-of-range")
fn stage_row_out_of_range() -> bool
{
    !stage_transition(-1, 1) && !stage_transition(-1, 6) && !stage_transition(7, 1) && !stage_transition(7, 6)
}

@id("std.agent.tests.stage-terminality")
fn stage_terminality() -> bool
{
    !stage_is_terminal(0) && !stage_is_terminal(3) && stage_is_terminal(4) && stage_is_terminal(6) && stage_is_terminal(-1) && stage_is_terminal(7)
}

@id("std.agent.tests.retry-admitted-policy")
fn retry_admitted_policy() -> bool
{
    retry_admitted(0, 4) && retry_admitted(1, 4) && retry_admitted(3, 4) && !retry_admitted(4, 4) && !retry_admitted(5, 4)
}

@id("std.agent.tests.retry-delay-policy")
fn retry_delay_policy() -> bool
{
    retry_delay(0, 100) == 1 && retry_delay(1, 100) == 2 && retry_delay(3, 100) == 8 && retry_delay(4, 100) == 16 && retry_delay(5, 100) == 32
}

@id("std.agent.tests.main")
fn main() -> i64
{
    if roles() && outcome() && advance_boundary() && stage_helper_initialize() && stage_helper_observe() && stage_helper_authorize() && stage_helper_reduce() && stage_row_initialize() && stage_row_reduce() && stage_row_terminal() && stage_row_out_of_range() && stage_terminality() && retry_admitted_policy() && retry_delay_policy() { 0 } else { 1 }
}

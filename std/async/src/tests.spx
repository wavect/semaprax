module std.async.tests;
use function @id("std.async.clamp_wait_ms") from std.async as clamp_wait_ms;
use function @id("std.async.next_handle") from std.async as next_handle;
use function @id("std.async.next_timeout_ms") from std.async as next_timeout_ms;
use function @id("std.async.remaining_ms") from std.async as remaining_ms;
use function @id("std.async.should_retry") from std.async as should_retry;
use function @id("std.async.stream_ended") from std.async as stream_ended;

@id("std.async.tests.timeouts")
fn timeouts() -> bool
{
    clamp_wait_ms(0usize) == 0usize && clamp_wait_ms(30000usize) == 30000usize && clamp_wait_ms(30001usize) == 30000usize && next_timeout_ms(0usize, 100usize, 30000usize) == 100usize && next_timeout_ms(1usize, 100usize, 30000usize) == 200usize && next_timeout_ms(3usize, 100usize, 30000usize) == 800usize && next_timeout_ms(9usize, 100usize, 30000usize) == 30000usize && next_timeout_ms(40usize, 1usize, 30000usize) == 30000usize && next_timeout_ms(2usize, 700usize, 1000usize) == 1000usize && next_timeout_ms(5usize, 250usize, 250usize) == 250usize
}

@id("std.async.tests.retries")
fn retries() -> bool
{
    should_retry(0usize, 0usize, 3usize) && should_retry(0usize, 2usize, 3usize) && !should_retry(0usize, 3usize, 3usize) && !should_retry(1usize, 0usize, 3usize) && !should_retry(2usize, 0usize, 3usize) && !should_retry(0usize, 0usize, 0usize)
}

@id("std.async.tests.handles")
fn handles() -> bool
{
    next_handle(1usize, 1usize) == 1usize && next_handle(1usize, 3usize) == 2usize && next_handle(2usize, 3usize) == 3usize && next_handle(3usize, 3usize) == 1usize && next_handle(8usize, 8usize) == 1usize && next_handle(7usize, 8usize) == 8usize
}

@id("std.async.tests.streams")
fn streams() -> bool
{
    let chunk = [104u8, 105u8];
    let empty = [0u8; 0];
    !stream_ended(array_as_slice(chunk)) && stream_ended(array_as_slice(empty))
}

@id("std.async.tests.budgets")
fn budgets() -> bool
{
    remaining_ms(0usize, 30000usize) == 30000usize && remaining_ms(12000usize, 30000usize) == 18000usize && remaining_ms(30000usize, 30000usize) == 0usize && remaining_ms(40000usize, 30000usize) == 0usize && remaining_ms(5usize, 0usize) == 0usize
}

@id("std.async.tests.main")
fn main() -> i64
{
    let mut failed = 0;
    failed = failed + if timeouts() { 0 } else { 1 };
    failed = failed + if retries() { 0 } else { 2 };
    failed = failed + if handles() { 0 } else { 4 };
    failed = failed + if budgets() { 0 } else { 8 };
    failed = failed + if streams() { 0 } else { 16 };
    failed
}

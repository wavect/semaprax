module std.data.json.dec;
use type @id("std.io.reader") from std.io as Reader;
use type @id("std.io.writer") from std.io as Writer;

@id("std.data.json.dec.string-scan")
record StringScan {
    @id("std.data.json.dec.string-scan.end")
    end: usize,
    @id("std.data.json.dec.string-scan.decoded-length")
    decoded_length: usize,
}

// A bounded decoded-key fingerprint `length * 65536 + hash`. The hash folds
// the token's canonical decoded bytes as `(hash * 257 + byte) % 65521`, and
// `length` is its decoded byte count in 1..=limit. Zero means the token is
// not a complete JSON string of that size; the walk stops at the first
// decoded byte past `limit`. Equal fingerprints never prove equal keys.
@id("std.data.json.dec.decoded-step")
record DecodedStep {
    @id("std.data.json.dec.decoded-step.value")
    value: i64,
    @id("std.data.json.dec.decoded-step.next")
    next: usize,
    @id("std.data.json.dec.decoded-step.part")
    part: usize,
}

@id("std.data.json.dec.at_is")
fn at_is(input: borrow Slice<u8>, index: usize, expected: u8) -> bool
{
    match byte_get(input, index) { Option::Some { value: byte } => byte == expected, Option::None {} => false, }
}

@id("std.data.json.dec.at_in")
fn at_in(input: borrow Slice<u8>, index: usize, low: u8, high: u8) -> bool
{
    match byte_get(input, index) { Option::Some { value: byte } => byte >= low && byte <= high, Option::None {} => false, }
}

@id("std.data.json.dec.failure")
fn failure(input: borrow Slice<u8>, offset: usize) -> usize
    ensures result > byte_len(input)
{
    byte_len(input) + 1usize + offset
}

@id("std.data.json.dec.is_failure")
fn is_failure(input: borrow Slice<u8>, scan: usize) -> bool
{
    scan > byte_len(input)
}

@id("std.data.json.dec.hex_at")
fn hex_at(input: borrow Slice<u8>, index: usize) -> i64
    ensures result >= -1 && result <= 15
{
    match byte_get(input, index) { Option::Some { value: byte } => match byte { 48u8 => 0, 49u8 => 1, 50u8 => 2, 51u8 => 3, 52u8 => 4, 53u8 => 5, 54u8 => 6, 55u8 => 7, 56u8 => 8, 57u8 => 9, 97u8 => 10, 98u8 => 11, 99u8 => 12, 100u8 => 13, 101u8 => 14, 102u8 => 15, 65u8 => 10, 66u8 => 11, 67u8 => 12, 68u8 => 13, 69u8 => 14, 70u8 => 15, _ => -1, }, Option::None {} => -1, }
}

@id("std.data.json.dec.code_unit")
fn code_unit(input: borrow Slice<u8>, start: usize) -> i64
    ensures result >= -1 && result <= 65535
{
    let first = hex_at(input, start);
    let second = hex_at(input, start + 1usize);
    let third = hex_at(input, start + 2usize);
    let fourth = hex_at(input, start + 3usize);
    let ready = first >= 0 && second >= 0 && third >= 0 && fourth >= 0;
    if ready { first * 4096 + second * 256 + third * 16 + fourth } else { -1 }
}

@id("std.data.json.dec.escape_kind")
fn escape_kind(input: borrow Slice<u8>, start: usize) -> i64
    ensures result >= 0 && result <= 3
{
    let simple = match byte_get(input, start + 1usize) { Option::Some { value: byte } => match byte { 34u8 => true, 92u8 => true, 47u8 => true, 98u8 => true, 102u8 => true, 110u8 => true, 114u8 => true, 116u8 => true, _ => false, }, Option::None {} => false, };
    let unit = if at_is(input, start + 1usize, 117u8) { code_unit(input, start + 2usize) } else { -1 };
    let high = unit >= 55296 && unit <= 56319;
    let scalar = unit >= 0 && unit < 55296 || unit > 57343;
    if !at_is(input, start, 92u8) { 0 } else { if simple { 1 } else { if high { 3 } else { if scalar { 2 } else { 0 } } } }
}

@id("std.data.json.dec.escape_end")
fn escape_end(input: borrow Slice<u8>, start: usize) -> usize
{
    if start > byte_len(input) { escape_end_prior(input, start) } else { let scalar = scalar_at(input, start); if scalar < 0 { failure(input, start) } else { if at_is(input, start + 1usize, 117u8) { if scalar > 65535 { start + 12usize } else { start + 6usize } } else { start + 2usize } } }
}

@id("std.data.json.dec.string_end")
fn string_end(input: borrow Slice<u8>, start: usize) -> usize
{
    scan_string(input, start, false)
}

@id("std.data.json.dec.token_end")
fn token_end(input: borrow Slice<u8>, index: usize) -> usize
{
    if at_is(input, index, 92u8) { escape_end(input, index) } else { if at_in(input, index, 32u8, 255u8) { index + 1usize } else { failure(input, index) } }
}

@id("std.data.json.dec.simple_scalar")
fn simple_scalar(byte: u8) -> i64
    ensures result >= -1 && result <= 92
{
    match byte { 34u8 => 34, 92u8 => 92, 47u8 => 47, 98u8 => 8, 102u8 => 12, 110u8 => 10, 114u8 => 13, 116u8 => 9, _ => -1, }
}

@id("std.data.json.dec.byte_code")
fn byte_code(byte: u8) -> i64
    ensures result >= 0 && result <= 255
{
    i64_from_u8(byte)
}

@id("std.data.json.dec.code_byte")
fn code_byte(value: i64) -> u8
{
    // Preserve the original total clamping behavior before checked conversion.
    u8_from_i64(if value < 0 { 0 } else { if value > 255 { 255 } else { value } })
}

@id("std.data.json.dec.scalar-at-prior")
fn scalar_at_prior(input: borrow Slice<u8>, start: usize) -> i64
    ensures result >= -1 && result <= 1114111
{
    let kind = escape_kind(input, start);
    let mapped = match byte_get(input, start + 1usize) { Option::Some { value: byte } => simple_scalar(byte), Option::None {} => -1, };
    let lead = code_unit(input, start + 2usize);
    let marked = at_is(input, start + 6usize, 92u8) && at_is(input, start + 7usize, 117u8);
    let trailing = if kind == 3 && marked { code_unit(input, start + 8usize) } else { -1 };
    let paired = trailing >= 56320 && trailing <= 57343;
    if kind == 1 { mapped } else { if kind == 2 { lead } else { if paired { 65536 + (lead - 55296) * 1024 + trailing - 56320 } else { -1 } } }
}

@id("std.data.json.dec.escape-end-prior")
fn escape_end_prior(input: borrow Slice<u8>, start: usize) -> usize
{
    let kind = escape_kind(input, start);
    let marked = at_is(input, start + 6usize, 92u8) && at_is(input, start + 7usize, 117u8);
    let trailing = if kind == 3 && marked { code_unit(input, start + 8usize) } else { -1 };
    let paired = trailing >= 56320 && trailing <= 57343;
    if kind == 1 { start + 2usize } else { if kind == 2 { start + 6usize } else { if paired { start + 12usize } else { failure(input, start) } } }
}

@id("std.data.json.dec.scalar_at")
fn scalar_at(input: borrow Slice<u8>, start: usize) -> i64
    ensures result >= -1 && result <= 1114111
{
    if start > byte_len(input) { scalar_at_prior(input, start) } else { if !at_is(input, start, 92u8) { -1 } else { let selector = match byte_get(input, start + 1usize) { Option::Some { value } => value, Option::None {} => 0u8, }; if selector != 117u8 { simple_scalar(selector) } else { let lead = code_unit(input, start + 2usize); if lead < 0 { -1 } else { if lead < 55296 || lead > 57343 { lead } else { if lead <= 56319 && at_is(input, start + 6usize, 92u8) && at_is(input, start + 7usize, 117u8) { let trailing = code_unit(input, start + 8usize); if trailing >= 56320 && trailing <= 57343 { 65536 + (lead - 55296) * 1024 + trailing - 56320 } else { -1 } } else { -1 } } } } } }
}

@id("std.data.json.dec.utf8_len")
fn utf8_len(scalar: i64) -> usize
    ensures result <= 4usize
{
    if scalar < 0 { 0usize } else { if scalar < 128 { 1usize } else { if scalar < 2048 { 2usize } else { if scalar < 65536 { 3usize } else { 4usize } } } }
}

@id("std.data.json.dec.utf8_at")
fn utf8_at(scalar: i64, index: usize) -> i64
    ensures result >= -1 && result <= 255
{
    let width = utf8_len(scalar);
    let steps = if index < width { width - index - 1usize } else { 0usize };
    let scale = if steps == 0usize { 1 } else { if steps == 1usize { 64 } else { if steps == 2usize { 4096 } else { 262144 } } };
    let group = if index < width { scalar / scale } else { 0 };
    let lead = if width == 1usize { 0 } else { if width == 2usize { 192 } else { if width == 3usize { 224 } else { 240 } } };
    if index >= width { -1 } else { if index == 0usize { lead + group } else { 128 + group % 64 } }
}

@id("std.data.json.dec.emit_len")
fn emit_len(input: borrow Slice<u8>, index: usize) -> usize
    ensures result <= 4usize
{
    if at_is(input, index, 92u8) { utf8_len(scalar_at(input, index)) } else { if at_in(input, index, 32u8, 255u8) { 1usize } else { 0usize } }
}

@id("std.data.json.dec.emit_at")
fn emit_at(input: borrow Slice<u8>, index: usize, offset: usize) -> i64
    ensures result >= -1 && result <= 255
{
    if at_is(input, index, 92u8) { utf8_at(scalar_at(input, index), offset) } else { let plain = match byte_get(input, index) { Option::Some { value: byte } => byte_code(byte), Option::None {} => -1, }; if offset == 0usize && plain >= 32 { plain } else { -1 } }
}

@id("std.data.json.dec.scan-string-info")
fn scan_string_info(input: borrow Slice<u8>, start: usize) -> StringScan
{
    let mut index = start + 1usize;
    let mut total = 0usize;
    let mut fault = start;
    let mut bad = !at_is(input, start, 34u8);
    let mut running = !bad;
    while running {
        let plain = byte_prefix_class(input, index, byte_len(input), 32u8, 255u8, 34u8, 92u8);
        index = index + plain;
        total = total + plain;
        let raw = match byte_get(input, index) { Option::Some { value } => usize_from_u8(value), Option::None {} => 256usize, };
        if raw == 34usize { index = index + 1usize; running = false; } else { if raw >= 32usize && raw <= 255usize && raw != 92usize { index = index + 1usize; total = total + 1usize; } else { if raw == 92usize { let scalar = scalar_at(input, index); if scalar >= 0 { let width = if at_is(input, index + 1usize, 117u8) { if scalar > 65535 { 12usize } else { 6usize } } else { 2usize }; index = index + width; total = total + utf8_len(scalar); } else { bad = true; fault = index; running = false; } } else { bad = true; fault = index; running = false; } } }
        0
    }
    if bad { let marker = failure(input, fault); StringScan { end: marker, decoded_length: marker } } else { StringScan { end: index, decoded_length: total } }
}

@id("std.data.json.dec.scan-string")
fn scan_string(input: borrow Slice<u8>, start: usize, measure: bool) -> usize
{
    let parsed = scan_string_info(input, start);
    if measure { parsed.decoded_length } else { parsed.end }
}

@id("std.data.json.dec.decoded_len")
fn decoded_len(input: borrow Slice<u8>, start: usize) -> usize
{
    scan_string(input, start, true)
}

@id("std.data.json.dec.decoded_size")
fn decoded_size(input: borrow Slice<u8>) -> usize
{
    let end = string_end(input, 0usize);
    let total = decoded_len(input, 0usize);
    if is_failure(input, end) { end } else { if end == byte_len(input) { total } else { failure(input, end) } }
}

@id("std.data.json.dec.decode-into")
fn decode_into(input: borrow Reader, output: own Writer) -> Writer
    requires match borrow input { Reader { data: source, position: start } => match borrow output { Writer { data: target, position: write } => start <= byte_len(bytes_as_slice(source)) && !is_failure(bytes_as_slice(source), decoded_len(bytes_as_slice(source), start)) && write <= byte_len(bytes_as_slice(target)) && decoded_len(bytes_as_slice(source), start) <= byte_len(bytes_as_slice(target)) - write, }, }
{
    match own output { Writer { data: output_data, position: output_position } => { let mut next = output_data; let written = match borrow input { Reader { data: source, position: start } => { let view = bytes_as_slice(source); let total = decoded_len(view, start); let mut index = start + 1usize; let mut part = 0usize; let mut count = 0usize; let mut running = count < total; while running { let value = if at_is(view, index, 92u8) { code_byte(emit_at(view, index, part)) } else { match byte_get(view, index) { Option::Some { value } => value, Option::None {} => 0u8, } }; next = bytes_set(next, output_position + count, value); let last = part + 1usize >= emit_len(view, index); index = if last { token_end(view, index) } else { index }; part = if last { 0usize } else { part + 1usize }; count = count + 1usize; running = count < total; running } total }, }; Writer { data: next, position: output_position + written } }, }
}

@id("std.data.json.dec.capacity")
fn capacity() -> usize
    ensures result == 256usize
{
    256usize
}

@id("std.data.json.dec.prefix_eq")
fn prefix_eq(left: borrow Slice<u8>, right: borrow Slice<u8>, length: usize) -> bool
{
    let mut index = 0usize;
    let mut equal = length == byte_len(right) && length <= byte_len(left);
    let mut scanning = equal && index < length;
    while scanning {
        equal = match byte_get(left, index) { Option::Some { value: byte } => at_is(right, index, byte), Option::None {} => false, };
        index = index + 1usize;
        scanning = equal && index < length;
        scanning
    }
    equal
}

@id("std.data.json.dec.slice_eq")
fn slice_eq(left: borrow Slice<u8>, right: borrow Slice<u8>) -> bool
{
    prefix_eq(left, right, byte_len(left))
}

@id("std.data.json.dec.decoded_eq")
fn decoded_eq(input: borrow Slice<u8>, start: usize, expect: borrow Slice<u8>) -> bool
{
    let total = decoded_len(input, start);
    let ready = !is_failure(input, total) && total == byte_len(expect) && total <= 256usize;
    let mut out = bytes_zeroed(256usize);
    let mut index = start + 1usize;
    let mut part = 0usize;
    let mut write = 0usize;
    let mut running = ready && write < total;
    while running {
        out = bytes_set(out, write, code_byte(emit_at(input, index, part)));
        let last = part + 1usize >= emit_len(input, index);
        index = if last { token_end(input, index) } else { index };
        part = if last { 0usize } else { part + 1usize };
        write = write + 1usize;
        running = write < total;
        running
    }
    let view = bytes_as_slice(out);
    ready && prefix_eq(view, expect, write)
}

// Compares two decoded JSON string tokens for equality by walking both
// through the existing pull surface (`emit_at`, `emit_len`, `token_end`)
// with no intermediate buffer, so escapes decode before comparison and
// `"ab"` equals `"ab"`.
@id("std.data.json.dec.decoded_token_eq")
fn decoded_token_eq(input: borrow Slice<u8>, left: usize, right: usize) -> bool
{
    let total = decoded_len(input, left);
    let other = decoded_len(input, right);
    let mut equal = !is_failure(input, total) && !is_failure(input, other) && total == other;
    let mut left_index = left + 1usize;
    let mut left_part = 0usize;
    let mut right_index = right + 1usize;
    let mut right_part = 0usize;
    let mut count = 0usize;
    let mut scanning = equal && count < total;
    while scanning {
        let room = if total - count < 8usize { total - count } else { 8usize };
        let first_plain = if left_part == 0usize { byte_prefix_class(input, left_index, room, 32u8, 255u8, 34u8, 92u8) } else { 0usize };
        let plain = if right_part == 0usize { byte_prefix_class(input, right_index, first_plain, 32u8, 255u8, 34u8, 92u8) } else { 0usize };
        if plain > 0usize { let first = match byte_read_le(input, left_index, plain) { Option::Some { value } => value, Option::None {} => 0usize, }; let second = match byte_read_le(input, right_index, plain) { Option::Some { value } => value, Option::None {} => 0usize, }; equal = first == second; left_index = left_index + plain; right_index = right_index + plain; count = count + plain; } else { let first = pull_step(input, left_index, left_part); let second = pull_step(input, right_index, right_part); { equal = first.value >= 0 && first.value == second.value; left_index = first.next; left_part = first.part; right_index = second.next; right_part = second.part; 0 }; count = count + 1usize; }
        scanning = equal && count < total;
        scanning
    }
    equal
}

// One canonical decoded byte at a pull cursor, or 256 when the cursor emits
// none. An admitted raw byte is its own decoded value; an escape uses
// `emit_at`. Unlike `emit_at`, a raw byte needs no `byte_code` probe.
@id("std.data.json.dec.decoded_byte_at")
fn decoded_byte_at(input: borrow Slice<u8>, index: usize, part: usize) -> usize
    ensures result <= 256usize
{
    if at_is(input, index, 92u8) { let emitted = emit_at(input, index, part); if emitted >= 0 { usize_from_i64(emitted) } else { 256usize } } else { match byte_get(input, index) { Option::Some { value: byte } => if part == 0usize && byte >= 32u8 { usize_from_u8(byte) } else { 256usize }, Option::None {} => 256usize, } }
}

@id("std.data.json.dec.pull-step")
fn pull_step(input: borrow Slice<u8>, index: usize, part: usize) -> DecodedStep
{
    let raw = match byte_get(input, index) { Option::Some { value } => i64_from_u8(value), Option::None {} => -1, };
    if raw >= 32 && raw != 92 { DecodedStep { value: raw, next: index + 1usize, part: 0usize } } else { let scalar = if raw == 92 { scalar_at(input, index) } else { -1 }; if scalar < 0 { DecodedStep { value: -1, next: index, part: 0usize } } else { let width = utf8_len(scalar); let last = part + 1usize >= width; let source_width = if at_is(input, index + 1usize, 117u8) { if scalar > 65535 { 12usize } else { 6usize } } else { 2usize }; DecodedStep { value: utf8_at(scalar, part), next: if last { index + source_width } else { index }, part: if last { 0usize } else { part + 1usize } } } }
}

@id("std.data.json.dec.decoded_fingerprint")
fn decoded_fingerprint(input: borrow Slice<u8>, start: usize, limit: usize) -> usize
    requires limit >= 1usize && limit <= 256usize
    ensures result < 16842752usize
{
    let mut valid = start < byte_len(input) && at_is(input, start, 34u8);
    let mut index = if valid { start + 1usize } else { start };
    let mut part = 0usize;
    let mut count = 0usize;
    let mut hash = 0usize;
    let mut running = valid && !at_is(input, index, 34u8);
    while running {
        let plain = if part == 0usize { byte_prefix_class(input, index, if limit - count < 8usize { limit - count } else { 8usize }, 32u8, 255u8, 34u8, 92u8) } else { 0usize };
        if plain > 0usize { let mut word = match byte_read_le(input, index, plain) { Option::Some { value } => value, Option::None {} => 0usize, }; let mut offset = 0usize; while offset < plain { hash = (hash * 257usize + word % 256usize) % 65521usize; word = word / 256usize; offset = offset + 1usize; 0 } index = index + plain; count = count + plain; } else { let step = pull_step(input, index, part); { let value = step.value; let next = step.next; let next_part = step.part; valid = value >= 0 && value < 256 && count < limit; hash = if valid { (hash * 257usize + usize_from_i64(value)) % 65521usize } else { hash }; count = if valid { count + 1usize } else { count }; index = if valid { next } else { index }; part = if valid { next_part } else { 0usize }; 0 } }
        running = valid && !at_is(input, index, 34u8);
        running
    }
    if valid && count > 0usize { count * 65536usize + hash } else { 0usize }
}

// One bounded Copy index entry: a token's opening offset and fingerprint.
// Offsets admit the 131,072-byte internal owned-view bound.
@id("std.data.json.dec.fingerprint_entry")
fn fingerprint_entry(opening: usize, fingerprint: usize) -> usize
    requires opening <= 131072usize && fingerprint < 16842752usize
{
    opening * 16842752usize + fingerprint
}

@id("std.data.json.dec.entry_opening")
fn entry_opening(entry: usize) -> usize
{
    entry / 16842752usize
}

@id("std.data.json.dec.entry_fingerprint")
fn entry_fingerprint(entry: usize) -> usize
    ensures result < 16842752usize
{
    entry % 16842752usize
}

// A fingerprint only rejects. Every equal fingerprint, including every hash
// collision, is decided by the exact decoded comparison `decoded_token_eq`.
@id("std.data.json.dec.fingerprint_match")
fn fingerprint_match(input: borrow Slice<u8>, entry: usize, current: usize, fingerprint: usize) -> bool
{
    entry_fingerprint(entry) == fingerprint && decoded_token_eq(input, entry_opening(entry), current)
}

@id("std.data.json.dec.tests.primitives")
fn primitives() -> bool
{
    let raw = [34u8, 97u8, 34u8];
    let source = array_as_slice(raw);
    at_is(source, 0usize, 34u8) && !at_is(source, 3usize, 34u8) && at_in(source, 1usize, 97u8, 122u8) && !at_in(source, 9usize, 0u8, 255u8) && is_failure(source, failure(source, 1usize)) && !is_failure(source, 3usize) && failure(source, 1usize) == 5usize
}

@id("std.data.json.dec.tests.hex")
fn hex() -> bool
{
    let raw = [48u8, 57u8, 97u8, 70u8, 122u8];
    let source = array_as_slice(raw);
    hex_at(source, 0usize) == 0 && hex_at(source, 1usize) == 9 && hex_at(source, 2usize) == 10 && hex_at(source, 3usize) == 15 && hex_at(source, 4usize) == -1 && hex_at(source, 5usize) == -1 && code_unit(source, 0usize) == 2479 && code_unit(source, 1usize) == -1
}

@id("std.data.json.dec.tests.escapes")
fn escapes() -> bool
{
    let raw = [92u8, 110u8, 92u8, 117u8, 48u8, 48u8, 101u8, 57u8];
    let source = array_as_slice(raw);
    escape_kind(source, 0usize) == 1 && escape_end(source, 0usize) == 2usize && escape_kind(source, 2usize) == 2 && escape_end(source, 2usize) == 8usize && simple_scalar(110u8) == 10 && simple_scalar(98u8) == 8 && simple_scalar(120u8) == -1 && scalar_at(source, 0usize) == 10 && scalar_at(source, 2usize) == 233 && scalar_at_prior(source, 0usize) == 10 && scalar_at_prior(source, 2usize) == 233 && escape_end_prior(source, 0usize) == 2usize && escape_end_prior(source, 2usize) == 8usize
}

@id("std.data.json.dec.tests.surrogates")
fn surrogates() -> bool
{
    let raw = [92u8, 117u8, 68u8, 56u8, 51u8, 68u8, 92u8, 117u8, 68u8, 69u8, 48u8, 48u8];
    let source = array_as_slice(raw);
    escape_kind(source, 0usize) == 3 && escape_end(source, 0usize) == 12usize && scalar_at(source, 0usize) == 128512 && emit_len(source, 0usize) == 4usize && emit_at(source, 0usize, 0usize) == 240 && emit_at(source, 0usize, 1usize) == 159 && emit_at(source, 0usize, 2usize) == 152 && emit_at(source, 0usize, 3usize) == 128
}

@id("std.data.json.dec.tests.lone_surrogate")
fn lone_surrogate() -> bool
{
    let raw = [34u8, 92u8, 117u8, 68u8, 56u8, 51u8, 68u8, 34u8];
    let source = array_as_slice(raw);
    escape_kind(source, 1usize) == 3 && is_failure(source, escape_end(source, 1usize)) && is_failure(source, decoded_len(source, 0usize)) && is_failure(source, string_end(source, 0usize)) && decoded_len(source, 0usize) == failure(source, 1usize)
}

@id("std.data.json.dec.tests.encoding")
fn encoding() -> bool
{
    utf8_len(-1) == 0usize && utf8_len(65) == 1usize && utf8_len(233) == 2usize && utf8_len(8364) == 3usize && utf8_len(128512) == 4usize && utf8_at(65, 0usize) == 65 && utf8_at(65, 1usize) == -1 && utf8_at(233, 0usize) == 195 && utf8_at(233, 1usize) == 169 && utf8_at(8364, 0usize) == 226 && utf8_at(8364, 1usize) == 130 && utf8_at(8364, 2usize) == 172
}

@id("std.data.json.dec.tests.conversion")
fn conversion() -> bool
{
    let mut byte = 0u8;
    let mut expected = 0;
    let mut valid = true;
    while expected < 255 {
        valid = valid && byte_code(byte) == expected && code_byte(expected) == byte;
        byte = byte + 1u8;
        expected = expected + 1;
        0
    }
    valid && byte_code(0u8) == 0 && byte_code(65u8) == 65 && byte_code(255u8) == 255 && code_byte(0) == 0u8 && code_byte(65) == 65u8 && code_byte(255) == 255u8 && code_byte(-1) == 0u8 && code_byte(-9223372036854775808) == 0u8 && code_byte(256) == 255u8 && code_byte(9223372036854775807) == 255u8
}

@id("std.data.json.dec.tests.tokens")
fn tokens() -> bool
{
    let raw = [34u8, 97u8, 92u8, 110u8, 98u8, 34u8];
    let source = array_as_slice(raw);
    token_end(source, 1usize) == 2usize && token_end(source, 2usize) == 4usize && emit_len(source, 1usize) == 1usize && emit_len(source, 2usize) == 1usize && emit_at(source, 1usize, 0usize) == 97 && emit_at(source, 2usize, 0usize) == 10 && string_end(source, 0usize) == 6usize
}

@id("std.data.json.dec.tests.lengths")
fn lengths() -> bool
{
    let raw = [34u8, 97u8, 92u8, 110u8, 98u8, 34u8];
    let source = array_as_slice(raw);
    let unicode = [34u8, 92u8, 117u8, 68u8, 56u8, 51u8, 68u8, 92u8, 117u8, 68u8, 69u8, 48u8, 48u8, 34u8];
    let emoji = array_as_slice(unicode);
    scan_string(source, 0usize, false) == 6usize && scan_string(source, 0usize, true) == 3usize && decoded_len(source, 0usize) == 3usize && decoded_size(source) == 3usize && decoded_len(emoji, 0usize) == 4usize && decoded_size(emoji) == 4usize && capacity() == 256usize
}

@id("std.data.json.dec.tests.emission-dispatch")
fn emission_dispatch() -> bool
{
    let raw = [97u8, 92u8, 117u8, 48u8, 48u8, 48u8, 49u8, 255u8, 31u8];
    let source = array_as_slice(raw);
    let invalid_escape = [92u8, 113u8];
    let invalid = array_as_slice(invalid_escape);
    emit_at(source, 0usize, 0usize) == 97 && emit_at(source, 0usize, 1usize) == -1 && emit_at(source, 1usize, 0usize) == 1 && emit_at(source, 1usize, 1usize) == -1 && emit_at(source, 7usize, 0usize) == 255 && emit_at(source, 8usize, 0usize) == -1 && emit_at(source, 9usize, 0usize) == -1 && emit_at(invalid, 0usize, 0usize) == -1
}

@id("std.data.json.dec.tests.buffer")
fn buffer() -> bool
{
    let raw = [34u8, 97u8, 92u8, 110u8, 98u8, 34u8];
    let source = array_as_slice(raw);
    let want = [97u8, 10u8, 98u8];
    let expected = array_as_slice(want);
    let other = [97u8, 10u8, 99u8];
    let mismatch = array_as_slice(other);
    slice_eq(expected, expected) && !slice_eq(expected, mismatch) && prefix_eq(expected, expected, 3usize) && !prefix_eq(expected, mismatch, 3usize) && decoded_eq(source, 0usize, expected) && !decoded_eq(source, 0usize, mismatch)
}

@id("std.data.json.dec.tests.buffer_unicode")
fn buffer_unicode() -> bool
{
    let unicode = [34u8, 92u8, 117u8, 68u8, 56u8, 51u8, 68u8, 92u8, 117u8, 68u8, 69u8, 48u8, 48u8, 92u8, 117u8, 48u8, 48u8, 101u8, 57u8, 34u8];
    let emoji = array_as_slice(unicode);
    let want = [240u8, 159u8, 152u8, 128u8, 195u8, 169u8];
    let expected = array_as_slice(want);
    decoded_len(emoji, 0usize) == 6usize && decoded_eq(emoji, 0usize, expected)
}

@id("std.data.json.dec.tests.token_equality")
fn token_equality() -> bool
{
    let raw = [34u8, 97u8, 34u8, 34u8, 97u8, 34u8, 34u8, 97u8, 98u8, 34u8, 34u8, 97u8, 98u8, 34u8, 34u8, 92u8, 110u8, 34u8, 34u8, 92u8, 117u8, 48u8, 48u8, 48u8, 97u8, 34u8, 34u8, 97u8, 99u8, 34u8];
    let source = array_as_slice(raw);
    decoded_token_eq(source, 0usize, 3usize) && decoded_token_eq(source, 6usize, 10usize) && decoded_token_eq(source, 14usize, 18usize) && !decoded_token_eq(source, 6usize, 26usize) && !decoded_token_eq(source, 0usize, 6usize)
}

// Tokens at 0, 5, 10: "BAA", "ACO", "BAA". At 20, 26, 32: raw
// U+00C1 U+0410, raw U+00C0 U+049E, "ÁА". At 46, 56: "\u0000CO",
// "\u0001AA". At 66, 80: "😀" and raw U+1F600. Each unequal pair
// is a deliberate hash collision; only exact decoded comparison separates it.
@id("std.data.json.dec.tests.fingerprints")
fn fingerprints() -> bool
{
    let raw = [34u8, 66u8, 65u8, 65u8, 34u8, 34u8, 65u8, 67u8, 79u8, 34u8, 34u8, 92u8, 117u8, 48u8, 48u8, 52u8, 50u8, 65u8, 65u8, 34u8, 34u8, 195u8, 129u8, 208u8, 144u8, 34u8, 34u8, 195u8, 128u8, 210u8, 158u8, 34u8, 34u8, 92u8, 117u8, 48u8, 48u8, 99u8, 49u8, 92u8, 117u8, 48u8, 52u8, 49u8, 48u8, 34u8, 34u8, 92u8, 117u8, 48u8, 48u8, 48u8, 48u8, 67u8, 79u8, 34u8, 34u8, 92u8, 117u8, 48u8, 48u8, 48u8, 49u8, 65u8, 65u8, 34u8, 34u8, 92u8, 117u8, 68u8, 56u8, 51u8, 68u8, 92u8, 117u8, 68u8, 69u8, 48u8, 48u8, 34u8, 34u8, 240u8, 159u8, 152u8, 128u8, 34u8];
    let source = array_as_slice(raw);
    let ascii = decoded_fingerprint(source, 0usize, 64usize);
    let wide = decoded_fingerprint(source, 20usize, 64usize);
    let nul = decoded_fingerprint(source, 46usize, 64usize);
    let emoji = decoded_fingerprint(source, 66usize, 64usize);
    let bytes = decoded_byte_at(source, 1usize, 0usize) == 66usize && decoded_byte_at(source, 11usize, 0usize) == 66usize && decoded_byte_at(source, 21usize, 0usize) == 195usize && decoded_byte_at(source, 47usize, 0usize) == 0usize && decoded_byte_at(source, 67usize, 1usize) == 159usize && decoded_byte_at(source, 1usize, 1usize) == 256usize && decoded_byte_at(source, 86usize, 0usize) == 256usize;
    let values = ascii == 248226usize && decoded_fingerprint(source, 5usize, 64usize) == ascii && decoded_fingerprint(source, 10usize, 64usize) == ascii && wide == 308571usize && decoded_fingerprint(source, 26usize, 64usize) == wide && decoded_fingerprint(source, 32usize, 64usize) == wide && nul == 213906usize && decoded_fingerprint(source, 56usize, 64usize) == nul && emoji >= 262144usize && decoded_fingerprint(source, 80usize, 64usize) == emoji;
    let bounds = decoded_fingerprint(source, 0usize, 2usize) == 0usize && decoded_fingerprint(source, 0usize, 3usize) == ascii && decoded_fingerprint(source, 1usize, 64usize) == 0usize && decoded_fingerprint(source, 86usize, 64usize) == 0usize && decoded_fingerprint(source, 18446744073709551615usize, 64usize) == 0usize;
    // Independent two-byte polynomial: 32 * 257 + 127 = 8351.
    let endpoints = [34u8, 32u8, 127u8, 34u8];
    let escaped_endpoint = [34u8, 32u8, 92u8, 117u8, 48u8, 48u8, 55u8, 102u8, 34u8];
    let control = [34u8, 0u8, 34u8];
    let unclosed = [34u8, 65u8];
    let empty = [34u8, 34u8];
    let fast = decoded_fingerprint(array_as_slice(endpoints), 0usize, 2usize) == 139423usize && decoded_fingerprint(array_as_slice(endpoints), 0usize, 1usize) == 0usize && decoded_fingerprint(array_as_slice(escaped_endpoint), 0usize, 2usize) == 139423usize && decoded_fingerprint(array_as_slice(control), 0usize, 2usize) == 0usize && decoded_fingerprint(array_as_slice(unclosed), 0usize, 2usize) == 0usize && decoded_fingerprint(array_as_slice(empty), 0usize, 2usize) == 0usize;
    let entry = fingerprint_entry(46usize, nul);
    let packed = entry_opening(entry) == 46usize && entry_fingerprint(entry) == nul;
    let matches = !fingerprint_match(source, fingerprint_entry(0usize, ascii), 5usize, ascii) && fingerprint_match(source, fingerprint_entry(0usize, ascii), 10usize, ascii) && !fingerprint_match(source, fingerprint_entry(0usize, ascii), 10usize, ascii + 1usize) && !fingerprint_match(source, fingerprint_entry(20usize, wide), 26usize, wide) && fingerprint_match(source, fingerprint_entry(20usize, wide), 32usize, wide) && !fingerprint_match(source, entry, 56usize, nul) && fingerprint_match(source, fingerprint_entry(66usize, emoji), 80usize, emoji);
    let old = frozen_fingerprint(source, 0usize, 64usize) == ascii && frozen_fingerprint(source, 20usize, 64usize) == wide && frozen_fingerprint(source, 46usize, 64usize) == nul && frozen_fingerprint(source, 66usize, 64usize) == emoji && frozen_fingerprint(source, 80usize, 64usize) == emoji && frozen_fingerprint(source, 0usize, 2usize) == 0usize && frozen_fingerprint(source, 1usize, 64usize) == 0usize && frozen_fingerprint(source, 86usize, 64usize) == 0usize && frozen_fingerprint(source, 18446744073709551615usize, 64usize) == 0usize;
    bytes && values && bounds && fast && packed && matches && old
}

// Saved pre-generalized raw-byte shortcut. The fallback remains independent
// of the changed production branch, including decoded escape/cursor semantics.
@id("std.data.json.dec.tests.frozen-fingerprint")
fn frozen_fingerprint(input: borrow Slice<u8>, start: usize, limit: usize) -> usize
    requires limit >= 1usize && limit <= 256usize
    ensures result < 16842752usize
{
    let mut valid = start < byte_len(input) && at_is(input, start, 34u8);
    let mut index = if valid { start + 1usize } else { start };
    let mut part = 0usize;
    let mut count = 0usize;
    let mut hash = 0usize;
    let mut running = valid && !at_is(input, index, 34u8);
    while running {
        // Plain ASCII emits one byte. Classify it once rather than repeating
        // emit-width, decoded-byte and token-end probes for the same cursor.
        // Escaped/control/non-ASCII tokens retain the original path.
        let raw = match byte_get(input, index) { Option::Some { value: byte } => usize_from_u8(byte), Option::None {} => 256usize, };
        if part == 0usize && raw >= 32usize && raw <= 127usize && raw != 34usize && raw != 92usize { valid = count < limit; hash = if valid { (hash * 257usize + raw) % 65521usize } else { hash }; count = if valid { count + 1usize } else { count }; index = if valid { index + 1usize } else { index }; part = 0usize; 0 } else { let width = emit_len(input, index); let value = decoded_byte_at(input, index, part); let last = part + 1usize >= width; let next = if last { token_end(input, index) } else { index }; valid = width > 0usize && value < 256usize && count < limit && !is_failure(input, next); hash = if valid { (hash * 257usize + value) % 65521usize } else { hash }; count = if valid { count + 1usize } else { count }; index = if valid { next } else { index }; part = if valid && !last { part + 1usize } else { 0usize }; 0 }
        running = valid && !at_is(input, index, 34u8);
        running
    }
    if valid && count > 0usize { count * 65536usize + hash } else { 0usize }
}

@id("std.data.json.dec.tests.raw-fingerprint-equivalence")
fn raw_fingerprint_equivalence() -> bool
{
    let mut value = 0usize;
    let mut equal = true;
    // Every literal token is stored before the loop; only named slice ranges
    // are constructed inside it. The independent expected values and frozen

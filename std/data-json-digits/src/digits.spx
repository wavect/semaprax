module std.data.json.digits;

@id("std.data.json.digits.i64_len")
fn i64_len(value: i64) -> i64
    ensures result >= 1 && result <= 20
{
    let mut remaining = if value > 0 { 0 - value } else { value };
    let mut digits = 1;
    let mut scanning = remaining <= -10;
    while scanning {
        remaining = remaining / 10;
        digits = digits + 1;
        scanning = remaining <= -10;
        scanning
    }
    if value < 0 { digits + 1 } else { digits }
}

@id("std.data.json.digits.i64_byte")
fn i64_byte(value: i64, index: i64) -> i64
    ensures result >= -1 && result <= 57
{
    let length = i64_len(value);
    let sign = if value < 0 { 1 } else { 0 };
    let inner = index >= sign && index < length;
    let place = if inner { length - index - 1 } else { 0 };
    let mut remaining = if value > 0 { 0 - value } else { value };
    let mut step = 0;
    let mut scanning = step < place;
    while scanning {
        remaining = remaining / 10;
        step = step + 1;
        scanning = step < place;
        scanning
    }
    if index < 0 || index >= length { -1 } else { if index < sign { 45 } else { 48 - remaining % 10 } }
}

@id("std.data.json.digits.literal_len")
fn literal_len(kind: i64) -> i64
    ensures result >= 0 && result <= 5
{
    if kind == 1 { 4 } else { if kind == 2 { 5 } else { if kind == 3 { 4 } else { 0 } } }
}

@id("std.data.json.digits.literal_word")
fn literal_word(kind: i64) -> i64
    ensures result >= 0
{
    if kind == 1 { 1953658213 } else { if kind == 2 { 439721161573 } else { if kind == 3 { 1853189228 } else { 0 } } }
}

@id("std.data.json.digits.literal_byte")
fn literal_byte(kind: i64, index: i64) -> i64
    ensures result >= -1 && result <= 255
{
    let width = literal_len(kind);
    let inside = index >= 0 && index < width;
    let mut shift = 1;
    let mut step = if inside { width - index - 1 } else { 0 };
    let mut scanning = step > 0;
    while scanning {
        shift = shift * 256;
        step = step - 1;
        scanning = step > 0;
        scanning
    }
    if inside { literal_word(kind) / shift % 256 } else { -1 }
}

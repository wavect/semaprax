module std.data.json.query;
use function @id("std.data.json.at_in") from std.data.json as at_in;
use function @id("std.data.json.at_is") from std.data.json as at_is;
use function @id("std.data.json.code_unit") from std.data.json as code_unit;
use function @id("std.data.json.escape_end") from std.data.json as escape_end;
use function @id("std.data.json.escape_kind") from std.data.json as escape_kind;
use function @id("std.data.json.failure") from std.data.json as failure;
use function @id("std.data.json.is_failure") from std.data.json as is_failure;

// Pure borrowed-slice projection of the decoder pull loop. The scalar escape
// and UTF-8 rules intentionally mirror std.data.json.dec; Reader/Writer
// adapters stay in that package's owned-data-api profile.
@id("std.data.json.query.byte_code")
fn byte_code(byte: u8) -> i64
    ensures result >= 0 && result <= 255
{
    let mut probe = 0u8;
    let mut value = 0;
    let mut scanning = probe != byte && value < 255;
    while scanning {
        probe = probe + 1u8;
        value = value + 1;
        scanning = probe != byte && value < 255;
        scanning
    }
    value
}

@id("std.data.json.query.scalar_at")
fn scalar_at(input: borrow Slice<u8>, start: usize) -> i64
    ensures result >= -1 && result <= 1114111
{
    let kind = escape_kind(input, start);
    let mapped = match byte_get(input, start + 1usize) { Option::Some { value: byte } => match byte { 34u8 => 34, 92u8 => 92, 47u8 => 47, 98u8 => 8, 102u8 => 12, 110u8 => 10, 114u8 => 13, 116u8 => 9, _ => -1, }, Option::None {} => -1, };
    let lead = code_unit(input, start + 2usize);
    let marked = at_is(input, start + 6usize, 92u8) && at_is(input, start + 7usize, 117u8);
    let trailing = if kind == 3 && marked { code_unit(input, start + 8usize) } else { -1 };
    let paired = trailing >= 56320 && trailing <= 57343;
    if kind == 1 { mapped } else { if kind == 2 { lead } else { if paired { 65536 + (lead - 55296) * 1024 + trailing - 56320 } else { -1 } } }
}

@id("std.data.json.query.utf8_len")
fn utf8_len(scalar: i64) -> usize
    ensures result <= 4usize
{
    if scalar < 0 { 0usize } else { if scalar < 128 { 1usize } else { if scalar < 2048 { 2usize } else { if scalar < 65536 { 3usize } else { 4usize } } } }
}

@id("std.data.json.query.utf8_at")
fn utf8_at(scalar: i64, index: usize) -> i64
    ensures result >= -1 && result <= 255
{
    let width = utf8_len(scalar);
    let steps = if index < width { width - index - 1usize } else { 0usize };
    let scale = if steps == 0usize { 1 } else { if steps == 1usize { 64 } else { if steps == 2usize { 4096 } else { 262144 } } };
    let group = if index < width { scalar / scale } else { 0 };
    let lead = if width == 1usize { 0 } else { if width == 2usize { 192 } else { if width == 3usize { 224 } else { 240 } } };
    if index >= width { -1 } else { if index == 0usize { lead + group } else { 128 + group % 64 } }
}

@id("std.data.json.query.emit_len")
fn emit_len(input: borrow Slice<u8>, index: usize) -> usize
    ensures result <= 4usize
{
    if at_is(input, index, 92u8) { utf8_len(scalar_at(input, index)) } else { if at_in(input, index, 32u8, 255u8) { 1usize } else { 0usize } }
}

@id("std.data.json.query.emit_at")
fn emit_at(input: borrow Slice<u8>, index: usize, offset: usize) -> i64
    ensures result >= -1 && result <= 255
{
    if at_is(input, index, 92u8) { utf8_at(scalar_at(input, index), offset) } else { let plain = match byte_get(input, index) { Option::Some { value: byte } => byte_code(byte), Option::None {} => -1, }; if offset == 0usize && plain >= 32 { plain } else { -1 } }
}

@id("std.data.json.query.token_end")
fn token_end(input: borrow Slice<u8>, index: usize) -> usize
{
    if at_is(input, index, 92u8) { escape_end(input, index) } else { if at_in(input, index, 32u8, 255u8) { index + 1usize } else { failure(input, index) } }
}

@id("std.data.json.query.scan_string")
fn scan_string(input: borrow Slice<u8>, start: usize, measure: bool) -> usize
{
    let mut index = start + 1usize;
    let mut total = 0usize;
    let mut fault = start;
    let mut bad = !at_is(input, start, 34u8);
    let mut running = !bad;
    while running {
        let closed = at_is(input, index, 34u8);
        let step = if closed { index } else { token_end(input, index) };
        let broken = !closed && is_failure(input, step);
        total = if closed || broken || !measure { total } else { total + emit_len(input, index) };
        fault = if broken { index } else { fault };
        bad = broken;
        index = if closed || broken { index } else { step };
        running = !closed && !broken;
        running
    }
    if bad { failure(input, fault) } else { if measure { total } else { index + 1usize } }
}

@id("std.data.json.query.decoded_len")
fn decoded_len(input: borrow Slice<u8>, start: usize) -> usize
{
    scan_string(input, start, true)
}

@id("std.data.json.query.decoded_token_eq")
fn decoded_token_eq(input: borrow Slice<u8>, left: usize, right: usize) -> bool
{
    let total = decoded_len(input, left);
    let other = decoded_len(input, right);
    let mut equal = !is_failure(input, total) && !is_failure(input, other) && total == other;
    let mut left_index = left + 1usize;
    let mut left_part = 0usize;
    let mut right_index = right + 1usize;
    let mut right_part = 0usize;
    let mut count = 0usize;
    let mut scanning = equal && count < total;
    while scanning {
        let first = emit_at(input, left_index, left_part);
        let second = emit_at(input, right_index, right_part);
        equal = first >= 0 && first == second;
        let left_last = left_part + 1usize >= emit_len(input, left_index);
        left_index = if left_last { token_end(input, left_index) } else { left_index };
        left_part = if left_last { 0usize } else { left_part + 1usize };
        let right_last = right_part + 1usize >= emit_len(input, right_index);
        right_index = if right_last { token_end(input, right_index) } else { right_index };
        right_part = if right_last { 0usize } else { right_part + 1usize };
        count = count + 1usize;
        scanning = equal && count < total;
        scanning
    }
    equal
}

module std.data.ndjson.tests;
use type @id("std.data.ndjson.frame") from std.data.ndjson as Frame;
use type @id("std.data.ndjson.fault") from std.data.ndjson as Fault;
use function @id("std.data.ndjson.record-count") from std.data.ndjson as record_count;
use function @id("std.data.ndjson.frame-at") from std.data.ndjson as frame_at;
use function @id("std.data.ndjson.frame-matches") from std.data.ndjson as frame_matches;
use function @id("std.data.ndjson.global-fault") from std.data.ndjson as global_fault;
use function @id("std.data.ndjson.basic-fault") from std.data.ndjson as basic_fault;
use function @id("std.data.ndjson.line-start") from std.data.ndjson as line_start;
use function @id("std.data.ndjson.line-end") from std.data.ndjson as line_end;
use function @id("std.data.ndjson.basic-line-fault") from std.data.ndjson as basic_line_fault;

@id("std.data.ndjson.tests.framing")
fn framing() -> bool
{
    let empty = [];
    let lone = [10u8];
    let raw = [123u8, 125u8, 10u8, 123u8, 125u8, 10u8];
    let body = array_as_slice(raw);
    let first = frame_at(body, 0usize);
    let last = frame_at(body, 1usize);
    record_count(array_as_slice(empty)) == 0usize && record_count(array_as_slice(lone)) == 0usize && record_count(body) == 2usize && first.start == 0usize && first.end == 2usize && first.next == 3usize && last.start == 3usize && last.end == 5usize && last.next == 6usize && frame_matches(body, first) && frame_matches(body, last) && line_start(body, 0usize) == first.start && line_start(body, 1usize) == last.start && line_start(body, 2usize) == byte_len(body) && line_start(body, 3usize) == byte_len(body) && line_end(body, first.start) == first.end && line_end(body, last.start) == last.end && line_end(body, byte_len(body)) == byte_len(body)
}

@id("std.data.ndjson.tests.empty-cr-and-utf8")
fn empty_cr_and_utf8() -> bool
{
    let empty_line = [123u8, 125u8, 10u8, 10u8, 123u8, 125u8];
    let bad = [65u8, 226u8, 130u8, 10u8];
    let cr = [123u8, 125u8, 13u8, 10u8];
    let empty_body = array_as_slice(empty_line);
    let bad_body = array_as_slice(bad);
    let cr_body = array_as_slice(cr);
    let empty_fault = basic_fault(empty_body, frame_at(empty_body, 1usize));
    let bad_fault = basic_fault(bad_body, frame_at(bad_body, 0usize));
    let cr_frame = frame_at(cr_body, 0usize);
    let direct_empty = basic_line_fault(byte_range(empty_body, 3usize, 3usize), 1usize);
    let direct_bad = basic_line_fault(byte_range(bad_body, 0usize, 3usize), 0usize);
    empty_fault.category == 3 && empty_fault.record_index == 1 && empty_fault.byte_offset == 0usize && bad_fault.category == 2 && bad_fault.byte_offset == 1usize && cr_frame.end == 3usize && basic_fault(cr_body, cr_frame).category == 0 && direct_empty.category == 3 && direct_empty.record_index == 1 && direct_empty.byte_offset == 0usize && direct_bad.category == 2 && direct_bad.record_index == 0 && direct_bad.byte_offset == 1usize
}

@id("std.data.ndjson.tests.forged-cuts")
fn forged_cuts() -> bool
{
    let raw = [123u8, 125u8, 10u8, 123u8, 125u8];
    let changed = [123u8, 10u8, 125u8, 123u8, 125u8];
    let same_cuts = [123u8, 125u8, 10u8, 226u8, 130u8];
    let body = array_as_slice(raw);
    let frame = frame_at(body, 1usize);
    let other_body = array_as_slice(same_cuts);
    let original_fault = basic_fault(body, frame);
    let current_fault = basic_fault(other_body, frame);
    let outside = Frame { ordinal: 1usize, start: 3usize, end: 6usize, next: 6usize };
    let overlap = Frame { ordinal: 1usize, start: 0usize, end: 2usize, next: 3usize };
    let wrong = Frame { ordinal: 0usize, start: 3usize, end: 5usize, next: 5usize };
    frame_matches(body, frame) && !frame_matches(body, outside) && !frame_matches(body, overlap) && !frame_matches(body, wrong) && !frame_matches(array_as_slice(changed), frame) && frame_matches(other_body, frame) && original_fault.category == 0 && current_fault.category == 2 && current_fault.record_index == 1 && current_fault.byte_offset == 0usize
}

@id("std.data.ndjson.tests.line-bounds")
fn line_bounds() -> bool
{
    let exact = bytes_zeroed(512usize);
    let extra = bytes_zeroed(513usize);
    let exact_body = bytes_as_slice(exact);
    let extra_body = bytes_as_slice(extra);
    let good = basic_fault(exact_body, frame_at(exact_body, 0usize));
    let bad = basic_fault(extra_body, frame_at(extra_body, 0usize));
    let direct_good = basic_line_fault(exact_body, 255usize);
    let direct_bad = basic_line_fault(extra_body, 255usize);
    good.category == 0 && bad.category == 1 && bad.byte_offset == 512usize && direct_good.category == 0 && direct_good.record_index == 255 && direct_good.byte_offset == 0usize && direct_bad.category == 1 && direct_bad.record_index == 255 && direct_bad.byte_offset == 512usize
}

@id("std.data.ndjson.tests.body-and-count-bounds")
fn body_and_count_bounds() -> bool
{
    let exact = bytes_zeroed(65536usize);
    let extra = bytes_zeroed(65537usize);
    // The unchanged full normalizer oracle executes the exact 65536-byte global scan.
    let exact_length = byte_len(bytes_as_slice(exact));
    let oversized = global_fault(bytes_as_slice(extra));
    let records = [10u8; 256];
    let many = [10u8; 257];
    let count_limit = global_fault(array_as_slice(records));
    let count_over = global_fault(array_as_slice(many));
    // A final LF is not a record: 257 LFs contain 257 empty records under the existing count rule.
    exact_length == 65536usize && oversized.category == 1 && oversized.record_index == -1 && oversized.byte_offset == 65536usize && count_limit.category == 0 && count_over.category == 1 && count_over.record_index == 256
}

@id("std.data.ndjson.tests.main")
fn main() -> i64
{
    if framing() && empty_cr_and_utf8() && forged_cuts() && line_bounds() && body_and_count_bounds() { 0 } else { 1 }
}

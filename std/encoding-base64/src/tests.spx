module std.encoding.base64.tests;
use type @id("std.io.writer") from std.io as Writer;
use function @id("std.encoding.base64.byte") from std.encoding.base64 as base64_byte;
use function @id("std.encoding.base64.byte_at_or_zero") from std.encoding.base64 as byte_at_or_zero;
use function @id("std.encoding.base64.code-byte") from std.encoding.base64 as code_byte;
use function @id("std.encoding.base64.decode-check") from std.encoding.base64 as decode_check;
use function @id("std.encoding.base64.decode-error-kind") from std.encoding.base64 as decode_error_kind;
use function @id("std.encoding.base64.decode-error-offset") from std.encoding.base64 as decode_error_offset;
use function @id("std.encoding.base64.decode-into") from std.encoding.base64 as decode_into;
use function @id("std.encoding.base64.decoded-byte") from std.encoding.base64 as decoded_byte;
use function @id("std.encoding.base64.decoded-len") from std.encoding.base64 as decoded_len;
use function @id("std.encoding.base64.len") from std.encoding.base64 as base64_len;
use function @id("std.io.writer.finish") from std.io as writer_finish;
use function @id("std.io.writer.from-bytes") from std.io as writer_from_bytes;
use function @id("std.io.writer.cursor") from std.io as writer_position;

// Each vector below was checked byte-for-byte against Python's
// `base64.b64encode`.  Chains stay short (well under the ~28-term bound that
// trips `SPX-H006`) by giving every vector its own function and folding the
// verdicts into a failure bitmask in `main`, as `std.bytes.tests` does.
@id("std.encoding.base64.tests.empty")
fn empty() -> bool
{
    let source = [0u8; 0];
    let view = array_as_slice(source);
    base64_len(byte_len(view)) == 0usize && byte_at_or_zero(view, 0usize) == 0
}

@id("std.encoding.base64.tests.f")
fn f() -> bool
{
    let source = [102u8];
    let view = array_as_slice(source);
    base64_len(byte_len(view)) == 4usize && base64_byte(view, 0usize) == 90 && base64_byte(view, 1usize) == 103 && base64_byte(view, 2usize) == 61 && base64_byte(view, 3usize) == 61
}

@id("std.encoding.base64.tests.fo")
fn fo() -> bool
{
    let source = [102u8, 111u8];
    let view = array_as_slice(source);
    base64_len(byte_len(view)) == 4usize && base64_byte(view, 0usize) == 90 && base64_byte(view, 1usize) == 109 && base64_byte(view, 2usize) == 56 && base64_byte(view, 3usize) == 61
}

@id("std.encoding.base64.tests.foo")
fn foo() -> bool
{
    let source = [102u8, 111u8, 111u8];
    let view = array_as_slice(source);
    base64_len(byte_len(view)) == 4usize && base64_byte(view, 0usize) == 90 && base64_byte(view, 1usize) == 109 && base64_byte(view, 2usize) == 57 && base64_byte(view, 3usize) == 118
}

@id("std.encoding.base64.tests.foob")
fn foob() -> bool
{
    let source = [102u8, 111u8, 111u8, 98u8];
    let view = array_as_slice(source);
    let head = base64_len(byte_len(view)) == 8usize && base64_byte(view, 0usize) == 90 && base64_byte(view, 1usize) == 109 && base64_byte(view, 2usize) == 57 && base64_byte(view, 3usize) == 118;
    let tail = base64_byte(view, 4usize) == 89 && base64_byte(view, 5usize) == 103 && base64_byte(view, 6usize) == 61 && base64_byte(view, 7usize) == 61;
    head && tail
}

@id("std.encoding.base64.tests.fooba")
fn fooba() -> bool
{
    let source = [102u8, 111u8, 111u8, 98u8, 97u8];
    let view = array_as_slice(source);
    let head = base64_len(byte_len(view)) == 8usize && base64_byte(view, 0usize) == 90 && base64_byte(view, 1usize) == 109 && base64_byte(view, 2usize) == 57 && base64_byte(view, 3usize) == 118;
    let tail = base64_byte(view, 4usize) == 89 && base64_byte(view, 5usize) == 109 && base64_byte(view, 6usize) == 69 && base64_byte(view, 7usize) == 61;
    head && tail
}

@id("std.encoding.base64.tests.foobar")
fn foobar() -> bool
{
    let source = [102u8, 111u8, 111u8, 98u8, 97u8, 114u8];
    let view = array_as_slice(source);
    let head = base64_len(byte_len(view)) == 8usize && base64_byte(view, 0usize) == 90 && base64_byte(view, 1usize) == 109 && base64_byte(view, 2usize) == 57 && base64_byte(view, 3usize) == 118;
    let tail = base64_byte(view, 4usize) == 89 && base64_byte(view, 5usize) == 109 && base64_byte(view, 6usize) == 70 && base64_byte(view, 7usize) == 121;
    head && tail
}

@id("std.encoding.base64.tests.binary")
fn binary() -> bool
{
    let source = [0u8, 255u8, 16u8];
    let view = array_as_slice(source);
    base64_len(byte_len(view)) == 4usize && base64_byte(view, 0usize) == 65 && base64_byte(view, 1usize) == 80 && base64_byte(view, 2usize) == 56 && base64_byte(view, 3usize) == 81
}

@id("std.encoding.base64.tests.man")
fn man() -> bool
{
    let source = [77u8, 97u8, 110u8];
    let view = array_as_slice(source);
    base64_len(byte_len(view)) == 4usize && base64_byte(view, 0usize) == 84 && base64_byte(view, 1usize) == 87 && base64_byte(view, 2usize) == 70 && base64_byte(view, 3usize) == 117
}

@id("std.encoding.base64.tests.decode-vectors")
fn decode_vectors() -> bool
{
    let empty = [0u8; 0];
    let f = [90u8, 103u8, 61u8, 61u8];
    let fo = [90u8, 109u8, 56u8, 61u8];
    let foo = [90u8, 109u8, 57u8, 118u8];
    decode_check(array_as_slice(empty), true) == 0usize && decode_error_kind(array_as_slice(empty)) == 0usize && decoded_len(array_as_slice(empty)) == 0usize && decoded_len(array_as_slice(f)) == 1usize && decoded_byte(array_as_slice(f), 0usize) == 102u8 && decoded_len(array_as_slice(fo)) == 2usize && decoded_byte(array_as_slice(fo), 0usize) == 102u8 && decoded_byte(array_as_slice(fo), 1usize) == 111u8 && decoded_len(array_as_slice(foo)) == 3usize && decoded_byte(array_as_slice(foo), 2usize) == 111u8
}

@id("std.encoding.base64.tests.decode-strict")
fn decode_strict() -> bool
{
    let short = [90u8, 103u8, 65u8];
    let alphabet = [90u8, 103u8, 63u8, 61u8];
    let interior = [90u8, 103u8, 61u8, 61u8, 65u8, 65u8, 65u8, 65u8];
    let pad_two = [90u8, 104u8, 61u8, 61u8];
    let pad_one = [90u8, 109u8, 57u8, 61u8];
    decode_error_kind(array_as_slice(short)) == 1usize && decode_error_offset(array_as_slice(short)) == 3usize && decode_error_kind(array_as_slice(alphabet)) == 2usize && decode_error_offset(array_as_slice(alphabet)) == 2usize && decode_error_kind(array_as_slice(interior)) == 3usize && decode_error_offset(array_as_slice(interior)) == 4usize && decode_error_kind(array_as_slice(pad_two)) == 4usize && decode_error_offset(array_as_slice(pad_two)) == 1usize && decode_error_kind(array_as_slice(pad_one)) == 4usize && decode_error_offset(array_as_slice(pad_one)) == 2usize
}

@id("std.encoding.base64.tests.decode-rejections")
fn decode_rejections() -> bool
{
    let leading = [61u8, 65u8, 65u8, 65u8];
    let excess = [90u8, 103u8, 61u8, 61u8, 61u8];
    let whitespace = [90u8, 109u8, 10u8, 61u8];
    let url_safe = [90u8, 109u8, 45u8, 61u8];
    decode_error_kind(array_as_slice(leading)) == 3usize && decode_error_offset(array_as_slice(leading)) == 0usize && decode_error_kind(array_as_slice(excess)) == 3usize && decode_error_offset(array_as_slice(excess)) == 4usize && decode_error_kind(array_as_slice(whitespace)) == 2usize && decode_error_offset(array_as_slice(whitespace)) == 2usize && decode_error_kind(array_as_slice(url_safe)) == 2usize && decode_error_offset(array_as_slice(url_safe)) == 2usize
}

@id("std.encoding.base64.tests.decode-writer")
fn decode_writer() -> bool
{
    let encoded = [90u8, 109u8, 57u8, 118u8];
    let exact_written = decode_into(array_as_slice(encoded), Writer { data: bytes_set(bytes_zeroed(4usize), 0usize, 91u8), position: 1usize });
    let exact_cursor = writer_position(exact_written);
    let exact_output = writer_finish(exact_written);
    let exact_prefix = match byte_get(bytes_as_slice(exact_output), 0usize) { Option::Some { value } => value, Option::None {} => 0u8, };
    let target = bytes_set(bytes_set(bytes_zeroed(5usize), 0usize, 91u8), 4usize, 88u8);
    let written = decode_into(array_as_slice(encoded), Writer { data: target, position: 1usize });
    let cursor = writer_position(written);
    let output = writer_finish(written);
    let first = match byte_get(bytes_as_slice(output), 0usize) { Option::Some { value } => value, Option::None {} => 0u8, };
    let f = match byte_get(bytes_as_slice(output), 1usize) { Option::Some { value } => value, Option::None {} => 0u8, };
    let o1 = match byte_get(bytes_as_slice(output), 2usize) { Option::Some { value } => value, Option::None {} => 0u8, };
    let o2 = match byte_get(bytes_as_slice(output), 3usize) { Option::Some { value } => value, Option::None {} => 0u8, };
    let suffix = match byte_get(bytes_as_slice(output), 4usize) { Option::Some { value } => value, Option::None {} => 0u8, };
    exact_cursor == 4usize && exact_prefix == 91u8 && cursor == 4usize && first == 91u8 && f == 102u8 && o1 == 111u8 && o2 == 111u8 && suffix == 88u8
}

@id("std.encoding.base64.tests.all-bytes-round-trip")
fn all_bytes_round_trip() -> bool
{
    let mut original = bytes_zeroed(256usize);
    let mut source_index = 0usize;
    let mut source_byte = 0u8;
    while source_index < 256usize {
        original = bytes_set(original, source_index, source_byte);
        source_byte = if source_byte == 255u8 { source_byte } else { source_byte + 1u8 };
        source_index = source_index + 1usize;
        source_index < 256usize
    }
    let original_view = bytes_as_slice(original);
    let encoded_source = [65u8, 65u8, 69u8, 67u8, 65u8, 119u8, 81u8, 70u8, 66u8, 103u8, 99u8, 73u8, 67u8, 81u8, 111u8, 76u8, 68u8, 65u8, 48u8, 79u8, 68u8, 120u8, 65u8, 82u8, 69u8, 104u8, 77u8, 85u8, 70u8, 82u8, 89u8, 88u8, 71u8, 66u8, 107u8, 97u8, 71u8, 120u8, 119u8, 100u8, 72u8, 104u8, 56u8, 103u8, 73u8, 83u8, 73u8, 106u8, 74u8, 67u8, 85u8, 109u8, 74u8, 121u8, 103u8, 112u8, 75u8, 105u8, 115u8, 115u8, 76u8, 83u8, 52u8, 118u8, 77u8, 68u8, 69u8, 121u8, 77u8, 122u8, 81u8, 49u8, 78u8, 106u8, 99u8, 52u8, 79u8, 84u8, 111u8, 55u8, 80u8, 68u8, 48u8, 43u8, 80u8, 48u8, 66u8, 66u8, 81u8, 107u8, 78u8, 69u8, 82u8, 85u8, 90u8, 72u8, 83u8, 69u8, 108u8, 75u8, 83u8, 48u8, 120u8, 78u8, 84u8, 107u8, 57u8, 81u8, 85u8, 86u8, 74u8, 84u8, 86u8, 70u8, 86u8, 87u8, 86u8, 49u8, 104u8, 90u8, 87u8, 108u8, 116u8, 99u8, 88u8, 86u8, 53u8, 102u8, 89u8, 71u8, 70u8, 105u8, 89u8, 50u8, 82u8, 108u8, 90u8, 109u8, 100u8, 111u8, 97u8, 87u8, 112u8, 114u8, 98u8, 71u8, 49u8, 117u8, 98u8, 51u8, 66u8, 120u8, 99u8, 110u8, 78u8, 48u8, 100u8, 88u8, 90u8, 51u8, 101u8, 72u8, 108u8, 54u8, 101u8, 51u8, 120u8, 57u8, 102u8, 110u8, 43u8, 65u8, 103u8, 89u8, 75u8, 68u8, 104u8, 73u8, 87u8, 71u8, 104u8, 52u8, 105u8, 74u8, 105u8, 111u8, 117u8, 77u8, 106u8, 89u8, 54u8, 80u8, 107u8, 74u8, 71u8, 83u8, 107u8, 53u8, 83u8, 86u8, 108u8, 112u8, 101u8, 89u8, 109u8, 90u8, 113u8, 98u8, 110u8, 74u8, 50u8, 101u8, 110u8, 54u8, 67u8, 104u8, 111u8, 113u8, 79u8, 107u8, 112u8, 97u8, 97u8, 110u8, 113u8, 75u8, 109u8, 113u8, 113u8, 54u8, 121u8, 116u8, 114u8, 113u8, 43u8, 119u8, 115u8, 98u8, 75u8, 122u8, 116u8, 76u8, 87u8, 50u8, 116u8, 55u8, 105u8, 53u8, 117u8, 114u8, 117u8, 56u8, 118u8, 98u8, 54u8, 47u8, 119u8, 77u8, 72u8, 67u8, 119u8, 56u8, 84u8, 70u8, 120u8, 115u8, 102u8, 73u8, 121u8, 99u8, 114u8, 76u8, 122u8, 77u8, 51u8, 79u8, 122u8, 57u8, 68u8, 82u8, 48u8, 116u8, 80u8, 85u8, 49u8, 100u8, 98u8, 88u8, 50u8, 78u8, 110u8, 97u8, 50u8, 57u8, 122u8, 100u8, 51u8, 116u8, 47u8, 103u8, 52u8, 101u8, 76u8, 106u8, 53u8, 79u8, 88u8, 109u8, 53u8, 43u8, 106u8, 112u8, 54u8, 117u8, 118u8, 115u8, 55u8, 101u8, 55u8, 118u8, 56u8, 80u8, 72u8, 121u8, 56u8, 47u8, 84u8, 49u8, 57u8, 118u8, 102u8, 52u8, 43u8, 102u8, 114u8, 55u8, 47u8, 80u8, 51u8, 43u8, 47u8, 119u8, 61u8, 61u8];
    let encoded = bytes_copy(array_as_slice(encoded_source));
    let written = decode_into(bytes_as_slice(encoded), writer_from_bytes(bytes_zeroed(256usize)));
    let decoded = writer_finish(written);
    let decoded_view = bytes_as_slice(decoded);
    let mut compare = 0usize;
    let mut same = byte_len(decoded_view) == 256usize;
    while same && compare < 256usize {
        let left = match byte_get(original_view, compare) { Option::Some { value } => value, Option::None {} => 0u8, };
        let right = match byte_get(decoded_view, compare) { Option::Some { value } => value, Option::None {} => 1u8, };
        same = left == right;
        compare = compare + 1usize;
        same && compare < 256usize
    }
    same
}

@id("std.encoding.base64.tests.main")
fn main() -> i64
{
    let mut failed = 0;
    failed = failed + if empty() { 0 } else { 1 };
    failed = failed + if f() { 0 } else { 2 };
    failed = failed + if fo() { 0 } else { 4 };
    failed = failed + if foo() { 0 } else { 8 };
    failed = failed + if foob() { 0 } else { 16 };
    failed = failed + if fooba() { 0 } else { 32 };
    failed = failed + if foobar() { 0 } else { 64 };
    failed = failed + if binary() { 0 } else { 128 };
    failed = failed + if man() { 0 } else { 256 };
    failed = failed + if decode_vectors() { 0 } else { 512 };
    failed = failed + if decode_strict() { 0 } else { 1024 };
    failed = failed + if decode_writer() { 0 } else { 2048 };
    failed = failed + if all_bytes_round_trip() { 0 } else { 4096 };
    failed = failed + if decode_rejections() { 0 } else { 8192 };
    failed
}

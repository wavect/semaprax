module std.env;
use type @id("std.io.writer") from std.io as Writer;
use function @id("std.format.append-str") from std.format as append_str;

permit { process.environment.read }

@id("std.env.count")
fn count() -> usize
    uses { process.environment.read }
{
    env_len()
}

@id("std.env.name-len")
fn name_len(index: usize) -> usize
    uses { process.environment.read }
{
    let view = env_name_utf8(index);
    byte_len(str_as_bytes(view))
}

@id("std.env.value-len")
fn value_len(index: usize) -> usize
    uses { process.environment.read }
{
    let view = env_value_utf8(index);
    byte_len(str_as_bytes(view))
}

@id("std.env.name-is")
fn name_is(index: usize, key: borrow str) -> bool
    uses { process.environment.read }
{
    let name = env_name_utf8(index);
    str_len_bytes(name) == str_len_bytes(key) && str_contains(name, key)
}

@id("std.env.index-of")
fn index_of(key: borrow str) -> usize
    uses { process.environment.read }
{
    let total = env_len();
    let mut index = 0usize;
    let mut found = total;
    while index < total && found == total {
        let name = env_name_utf8(index);
        let matches = str_len_bytes(name) == str_len_bytes(key) && str_contains(name, key);
        found = if matches { index } else { found };
        index = index + 1usize;
        true
    }
    found
}

@id("std.env.name-into")
fn name_into(index: usize, output: own Writer) -> Writer
    uses { process.environment.read }
{
    let view = env_name_utf8(index);
    append_str(view, output)
}

@id("std.env.value-into")
fn value_into(index: usize, output: own Writer) -> Writer
    uses { process.environment.read }
{
    let view = env_value_utf8(index);
    append_str(view, output)
}

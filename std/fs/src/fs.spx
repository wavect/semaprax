module std.fs;
use type @id("std.path.value.path") from std.path.value as Path;
use type @id("std.io.reader") from std.io as Reader;
use type @id("std.io.writer") from std.io as Writer;
use function @id("std.path.value.valid") from std.path.value as path_valid;
use function @id("std.io.reader.from-bytes") from std.io as reader_from_bytes;
use function @id("std.io.writer.cursor") from std.io as writer_position;
use function @id("std.io.writer.finish") from std.io as writer_finish;

permit { fs.read, fs.write }

@id("std.fs.file-info")
record FileInfo {
    @id("std.fs.file-info.kind")
    kind: usize,
    @id("std.fs.file-info.size")
    size: usize,
}

@id("std.fs.read")
fn read(path: own Path, max: usize) -> Reader
    uses { fs.read }
    requires path_valid(path)
{
    match own path { Path { data, length } => reader_from_bytes(file_read(bytes_as_slice(data), length, max)), }
}

@id("std.fs.write-new")
fn write_new(path: own Path, writer: own Writer) -> usize
    uses { fs.write }
    requires path_valid(path)
{
    let written = writer_position(writer);
    let buffer = writer_finish(writer);
    match own path { Path { data, length } => file_write_new(bytes_as_slice(data), length, bytes_as_slice(buffer), written), }
}

@id("std.fs.metadata")
fn metadata(path: own Path) -> FileInfo
    uses { fs.read }
    requires path_valid(path)
{
    let packed = match own path { Path { data, length } => file_stat(bytes_as_slice(data), length), };
    FileInfo { kind: packed % 4usize, size: packed / 4usize }
}

@id("std.fs.list")
fn list(path: own Path, max: usize) -> Reader
    uses { fs.read }
    requires path_valid(path)
{
    match own path { Path { data, length } => reader_from_bytes(file_list(bytes_as_slice(data), length, max)), }
}

@id("std.fs.create-dir")
fn create_dir(path: own Path) -> usize
    uses { fs.write }
    requires path_valid(path)
{
    match own path { Path { data, length } => file_create_dir(bytes_as_slice(data), length), }
}

@id("std.fs.remove")
fn remove(path: own Path) -> usize
    uses { fs.write }
    requires path_valid(path)
{
    match own path { Path { data, length } => file_remove(bytes_as_slice(data), length), }
}

@id("std.fs.write-atomic")
fn write_atomic(path: own Path, writer: own Writer) -> usize
    uses { fs.write }
    requires path_valid(path)
{
    let written = writer_position(writer);
    let buffer = writer_finish(writer);
    match own path { Path { data, length } => file_write_atomic(bytes_as_slice(data), length, bytes_as_slice(buffer), written), }
}

@id("std.fs.directory.entry-length")
fn entry_length(reader: borrow Reader) -> usize
    requires match borrow reader { Reader { data, position } => position <= byte_len(bytes_as_slice(data)), }
{
    match borrow reader { Reader { data, position } => { let view = bytes_as_slice(data); let limit = byte_len(view); let mut cursor = position; let mut scanning = true; while cursor < limit && scanning { let value = match byte_get(view, cursor) { Option::Some { value } => value, Option::None {} => 0u8, }; scanning = value != 0u8; cursor = if scanning { cursor + 1usize } else { cursor }; scanning } cursor - position }, }
}

@id("std.fs.directory.entry-byte")
fn entry_byte(reader: borrow Reader, index: usize) -> u8
    requires index < entry_length(reader)
{
    match borrow reader { Reader { data, position } => match byte_get(bytes_as_slice(data), position + index) { Option::Some { value } => value, Option::None {} => 0u8, }, }
}

@id("std.fs.directory.next-entry")
fn next_entry(reader: own Reader) -> Reader
    requires match borrow reader { Reader { data, position } => position <= byte_len(bytes_as_slice(data)), }
{
    let length = entry_length(reader);
    match own reader { Reader { data, position } => { let limit = byte_len(bytes_as_slice(data)); let remaining = limit - position; let count = if remaining == 0usize { 0usize } else { if length < remaining { length + 1usize } else { remaining } }; Reader { data: data, position: position + count } }, }
}

@id("std.fs.listing.entry-end")
fn listing_entry_end(listing: borrow Slice<u8>, start: usize) -> usize
    requires start <= byte_len(listing)
    ensures result >= start && result <= byte_len(listing)
{
    let limit = byte_len(listing);
    let mut index = start;
    let mut scanning = index < limit;
    while scanning {
        let separator = match byte_get(listing, index) { Option::Some { value } => value == 0u8, Option::None {} => true, };
        index = if separator { index } else { index + 1usize };
        scanning = !separator && index < limit;
        scanning
    }
    index
}

@id("std.fs.listing.next-start")
fn listing_next_start(listing: borrow Slice<u8>, start: usize) -> usize
    requires start <= byte_len(listing)
    ensures result >= start && result <= byte_len(listing)
{
    let limit = byte_len(listing);
    let end = listing_entry_end(listing, start);
    if end < limit { end + 1usize } else { limit }
}

@id("std.fs.listing.entry-count")
fn listing_entry_count(listing: borrow Slice<u8>) -> usize
{
    let limit = byte_len(listing);
    let mut index = 0usize;
    let mut count = 0usize;
    let mut scanning = index < limit;
    while scanning {
        let next = listing_next_start(listing, index);
        count = count + 1usize;
        index = next;
        scanning = index < limit;
        scanning
    }
    count
}

@id("std.fs.listing.name-is-dot")
fn listing_name_is_dot(listing: borrow Slice<u8>, start: usize, end: usize) -> bool
    requires start <= end && end <= byte_len(listing)
{
    if end - start == 1usize { match byte_get(listing, start) { Option::Some { value } => value == 46u8, Option::None {} => false, } } else { false }
}

@id("std.fs.listing.name-is-dotdot")
fn listing_name_is_dotdot(listing: borrow Slice<u8>, start: usize, end: usize) -> bool
    requires start <= end && end <= byte_len(listing)
{
    if end - start == 2usize { match byte_get(listing, start) { Option::Some { value } => value == 46u8, Option::None {} => false, } && match byte_get(listing, start + 1usize) { Option::Some { value } => value == 46u8, Option::None {} => false, } } else { false }
}

@id("std.fs.listing.byte-clean")
fn listing_byte_clean(byte: u8) -> bool
{
    byte != 47u8 && byte != 0u8
}

@id("std.fs.listing.name-clean")
fn listing_name_clean(listing: borrow Slice<u8>, start: usize, end: usize) -> bool
    requires start <= end && end <= byte_len(listing)
{
    let mut index = start;
    let mut clean = true;
    while index < end {
        let byte = match byte_get(listing, index) { Option::Some { value } => value, Option::None {} => 0u8, };
        clean = clean && listing_byte_clean(byte);
        index = index + 1usize;
        index < end
    }
    clean
}

@id("std.fs.listing.entry-valid")
fn listing_entry_valid(listing: borrow Slice<u8>, start: usize, end: usize) -> bool
    requires start <= end && end <= byte_len(listing)
{
    if start == end { false } else { if listing_name_is_dot(listing, start, end) { false } else { if listing_name_is_dotdot(listing, start, end) { false } else { listing_name_clean(listing, start, end) } } }
}

@id("std.fs.listing.valid")
fn listing_valid(listing: borrow Slice<u8>) -> bool
{
    let limit = byte_len(listing);
    let mut index = 0usize;
    let mut valid = true;
    while index < limit {
        let end = listing_entry_end(listing, index);
        valid = valid && listing_entry_valid(listing, index, end);
        index = listing_next_start(listing, index);
        index < limit
    }
    valid
}

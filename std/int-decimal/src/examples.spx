module std.int.decimal.examples;
use function @id("std.int.decimal.digits") from std.int.decimal as digits;
use function @id("std.int.decimal.valid") from std.int.decimal as valid;
use function @id("std.int.decimal.canonicalize") from std.int.decimal as canonicalize;
use function @id("std.int.decimal.compare") from std.int.decimal as compare;
use function @id("std.int.decimal.add") from std.int.decimal as add;
use function @id("std.int.decimal.subtract") from std.int.decimal as subtract;
use function @id("std.int.decimal.divide") from std.int.decimal as divide;
use function @id("std.int.decimal.digit") from std.int.decimal as digit;

@id("std.int.decimal.examples.main")
fn main() -> i64
{
    let text_0 = "7";
    let text_1 = "1";
    let text_2 = "2";
    let text_3 = "1";
    let text_4 = "9223372036854775808";
    let raw = "00018446744073709551616";
    let admitted = digits(string_as_str(raw));
    let total = canonicalize(raw);
    let incremented = add(total, text_3);
    let restored = subtract(incremented, string_as_str(text_1));
    let average = divide(restored, string_as_str(text_2));
    if admitted && valid(string_as_str(average)) && compare(string_as_str(average), string_as_str(text_4)) == 0 && digit(string_as_str(text_0), 0) == 7 { 0 } else { 1 }
}

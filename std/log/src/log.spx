module std.log;
use type @id("std.io.reader") from std.io as Reader;
use type @id("std.io.writer") from std.io as Writer;
use function @id("std.data.json.utf8.is_utf8") from std.data.json.utf8 as is_utf8;
use function @id("std.data.json.write.quoted-into") from std.data.json.write as quoted_into;
use function @id("std.data.json.write.quoted_len") from std.data.json.write as quoted_len;
use function @id("std.data.json.write.count-into") from std.data.json.write as count_into;
use function @id("std.data.json.write.usize_len") from std.data.json.write as usize_len;
use function @id("std.io.reader.finish") from std.io as reader_finish;
use function @id("std.io.reader.from-bytes") from std.io as reader_from_bytes;
use function @id("std.log.redact.event_is_safe") from std.log.redact as event_is_safe;

@id("std.log.event")
record Event {
    @id("std.log.event.level")
    level: u8,
    @id("std.log.event.sequence")
    sequence: usize,
    @id("std.log.event.name")
    name: Bytes,
    @id("std.log.event.message")
    message: Bytes,
}

@id("std.log.level-len")
fn level_len(level: u8) -> usize
    requires level <= 5u8
{
    match level { 2u8 => 4usize, 3u8 => 4usize, _ => 5usize, }
}

@id("std.log.level-byte")
fn level_byte(level: u8, index: usize) -> u8
    requires level <= 5u8
    requires index < level_len(level)
{
    let words = [116u8, 114u8, 97u8, 99u8, 101u8, 100u8, 101u8, 98u8, 117u8, 103u8, 105u8, 110u8, 102u8, 111u8, 119u8, 97u8, 114u8, 110u8, 101u8, 114u8, 114u8, 111u8, 114u8, 102u8, 97u8, 116u8, 97u8, 108u8];
    let offset = match level { 0u8 => 0usize, 1u8 => 5usize, 2u8 => 10usize, 3u8 => 14usize, 4u8 => 18usize, _ => 23usize, };
    match byte_get(array_as_slice(words), offset + index) { Option::Some { value } => value, Option::None {} => 0u8, }
}

@id("std.log.fixed-len")
fn fixed_len(kind: u8) -> usize
{
    match kind { 0u8 => 10usize, 1u8 => 13usize, 2u8 => 9usize, 3u8 => 11usize, _ => 2usize, }
}

@id("std.log.fixed-byte")
fn fixed_byte(kind: u8, index: usize) -> u8
    requires kind <= 4u8
    requires index < fixed_len(kind)
{
    let punctuation = [123u8, 34u8, 108u8, 101u8, 118u8, 101u8, 108u8, 34u8, 58u8, 34u8, 34u8, 44u8, 34u8, 115u8, 101u8, 113u8, 117u8, 101u8, 110u8, 99u8, 101u8, 34u8, 58u8, 44u8, 34u8, 101u8, 118u8, 101u8, 110u8, 116u8, 34u8, 58u8, 44u8, 34u8, 109u8, 101u8, 115u8, 115u8, 97u8, 103u8, 101u8, 34u8, 58u8, 125u8, 10u8];
    let offset = match kind { 0u8 => 0usize, 1u8 => 10usize, 2u8 => 23usize, 3u8 => 32usize, _ => 43usize, };
    match byte_get(array_as_slice(punctuation), offset + index) { Option::Some { value } => value, Option::None {} => 0u8, }
}

@id("std.log.write-fixed")
fn write_fixed(kind: u8, output: own Writer) -> Writer
    requires kind <= 4u8
    requires match borrow output { Writer { data, position } => position <= byte_len(bytes_as_slice(data)) && fixed_len(kind) <= byte_len(bytes_as_slice(data)) - position, }
{
    match own output { Writer { data, position } => { let mut next = data; let mut index = 0usize; let mut writing = index < fixed_len(kind); while writing { next = bytes_set(next, position + index, fixed_byte(kind, index)); index = index + 1usize; writing = index < fixed_len(kind); writing } Writer { data: next, position: position + fixed_len(kind) } }, }
}

@id("std.log.write-level")
fn write_level(level: u8, output: own Writer) -> Writer
    requires level <= 5u8
    requires match borrow output { Writer { data, position } => position <= byte_len(bytes_as_slice(data)) && level_len(level) <= byte_len(bytes_as_slice(data)) - position, }
{
    match own output { Writer { data, position } => { let mut next = data; let mut index = 0usize; let mut writing = index < level_len(level); while writing { next = bytes_set(next, position + index, level_byte(level, index)); index = index + 1usize; writing = index < level_len(level); writing } Writer { data: next, position: position + level_len(level) } }, }
}

@id("std.log.quote-bytes")
fn quote_bytes(data: own Bytes, output: own Writer) -> Writer
    requires is_utf8(bytes_as_slice(data))
    requires match borrow output { Writer { data: output_data, position } => position <= byte_len(bytes_as_slice(output_data)) && quoted_len(bytes_as_slice(data)) <= byte_len(bytes_as_slice(output_data)) - position, }
{
    let reader = reader_from_bytes(data);
    let next = quoted_into(reader, output);
    let released = reader_finish(reader);
    next
}

@id("std.log.event-json-len")
fn event_json_len(event: borrow Event) -> usize
    requires event.level <= 5u8
{
    match borrow event { Event { level, sequence, name, message } => 45usize + level_len(level) + usize_len(sequence) + quoted_len(bytes_as_slice(name)) + quoted_len(bytes_as_slice(message)), }
}

@id("std.log.append-event")
fn append_event(event: own Event, output: own Writer) -> Writer
    requires match borrow event { Event { level, sequence: _, name: _, message: _ } => level <= 5u8, }
    requires match borrow event { Event { level: _, sequence: _, name, message } => is_utf8(bytes_as_slice(name)) && is_utf8(bytes_as_slice(message)), }
    requires match borrow output { Writer { data, position } => position <= byte_len(bytes_as_slice(data)) && event_json_len(event) <= byte_len(bytes_as_slice(data)) - position, }
{
    match own event { Event { level, sequence, name, message } => { let prefix = write_fixed(0u8, output); let named_level = write_level(level, prefix); let before_sequence = write_fixed(1u8, named_level); let numbered = count_into(sequence, before_sequence); let before_name = write_fixed(2u8, numbered); let named = quote_bytes(name, before_name); let before_message = write_fixed(3u8, named); let messaged = quote_bytes(message, before_message); write_fixed(4u8, messaged) }, }
}

// Level filtering. Levels run 0 (trace) to 5 (fatal); an event is enabled when
// its level is at or above the threshold.
@id("std.log.level-enabled")
fn level_enabled(level: u8, threshold: u8) -> bool
    requires level <= 5u8 && threshold <= 5u8
{
    level >= threshold
}

// The explicit "dropped by policy" transition: it consumes the event, leaves
// the caller's Writer exactly as it was, and writes nothing.
@id("std.log.discard-event")
fn discard_event(event: own Event, output: own Writer) -> Writer
    requires match borrow output { Writer { data, position } => position <= byte_len(bytes_as_slice(data)), }
{
    output
}

// True when the event both passes the threshold and fits the live capacity.
@id("std.log.event-admitted")
fn event_admitted(event: borrow Event, threshold: u8, output: borrow Writer) -> bool
    requires match borrow event { Event { level, sequence: _, name: _, message: _ } => level <= 5u8, }
    requires threshold <= 5u8
{
    match borrow event { Event { level, sequence: _, name: _, message: _ } => if level_enabled(level, threshold) { match borrow output { Writer { data, position } => position <= byte_len(bytes_as_slice(data)) && event_json_len(event) <= byte_len(bytes_as_slice(data)) - position, } } else { false }, }
}

// Writes the event only when it passes the threshold; a filtered event is
// consumed and the Writer is returned untouched.  Capacity is required only
// for an event that is actually written.
@id("std.log.append-event-if")
fn append_event_if(event: own Event, threshold: u8, output: own Writer) -> Writer
    requires threshold <= 5u8
    requires match borrow event { Event { level, sequence: _, name: _, message: _ } => level <= 5u8, }
    requires match borrow output { Writer { data, position } => position <= byte_len(bytes_as_slice(data)), }
    requires event_admitted(event, threshold, output) || match borrow event { Event { level, sequence: _, name: _, message: _ } => !level_enabled(level, threshold), }
{
    let enabled = match borrow event { Event { level, sequence: _, name: _, message: _ } => level_enabled(level, threshold), };
    if enabled { append_event(event, output) } else { discard_event(event, output) }
}

// ---------------------------------------------------------------------
// Redaction-guarded writing (issue #193)
// ---------------------------------------------------------------------
// The caller's six secret-bearing classification flags -- exactly
// std.log.redact.event_is_safe's own parameter list -- decide whether the
// event is written at all. This writer calls event_is_safe itself rather
// than trusting a caller-computed boolean, so the redaction decision is
// made inside the writer that actually emits bytes rather than somewhere
// upstream that a caller could skip or get wrong. An unsafe event is
// refused outright (mirroring append_event_if's own admitted/discarded
// transition) rather than partly redacted: this package's Event has no
// separate labeled-field structure to redact one field of, so refusing the
// whole event is the sound choice for the fields this schema actually has.
@id("std.log.append-event-guarded")
fn append_event_guarded(event: own Event, carries_password: bool, carries_api_key: bool, carries_bearer_token: bool, carries_session_token: bool, carries_webhook_signing_secret: bool, carries_smtp_credential: bool, output: own Writer) -> Writer
    requires match borrow event { Event { level, sequence: _, name: _, message: _ } => level <= 5u8, }
    requires match borrow event { Event { level: _, sequence: _, name, message } => is_utf8(bytes_as_slice(name)) && is_utf8(bytes_as_slice(message)), }
    requires match borrow output { Writer { data, position } => position <= byte_len(bytes_as_slice(data)) && event_json_len(event) <= byte_len(bytes_as_slice(data)) - position, }
{
    let safe = event_is_safe(carries_password, carries_api_key, carries_bearer_token, carries_session_token, carries_webhook_signing_secret, carries_smtp_credential);
    if safe { append_event(event, output) } else { discard_event(event, output) }
}

@id("std.log.tests.equal")
fn equal(left: borrow Slice<u8>, right: borrow Slice<u8>) -> bool
{
    let mut index = 0usize;
    let mut same = byte_len(left) == byte_len(right);
    while same && index < byte_len(left) {
        let a = match byte_get(left, index) { Option::Some { value: matched_value } => matched_value, Option::None {} => 0u8, };
        let b = match byte_get(right, index) { Option::Some { value: matched_value } => matched_value, Option::None {} => 0u8, };
        same = a == b;
        index = index + 1usize;
        same
    }
    same
}

@id("std.log.tests.test-line")
fn test_line() -> i64
{
    let name = [97u8, 34u8];
    let message = [10u8];
    let event = Event { level: 2u8, sequence: 7usize, name: bytes_copy(array_as_slice(name)), message: bytes_copy(array_as_slice(message)) };
    let output = append_event(event, writer_from_bytes(bytes_zeroed(64usize)));
    let position = writer_position(output);
    let bytes = writer_finish(output);
    let expected = [123u8, 34u8, 108u8, 101u8, 118u8, 101u8, 108u8, 34u8, 58u8, 34u8, 105u8, 110u8, 102u8, 111u8, 34u8, 44u8, 34u8, 115u8, 101u8, 113u8, 117u8, 101u8, 110u8, 99u8, 101u8, 34u8, 58u8, 55u8, 44u8, 34u8, 101u8, 118u8, 101u8, 110u8, 116u8, 34u8, 58u8, 34u8, 97u8, 92u8, 34u8, 34u8, 44u8, 34u8, 109u8, 101u8, 115u8, 115u8, 97u8, 103u8, 101u8, 34u8, 58u8, 34u8, 92u8, 110u8, 34u8, 125u8, 10u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    if position == 59usize && equal(bytes_as_slice(bytes), array_as_slice(expected)) { 0 } else { 1 }
}

@id("std.log.tests.test-filtered")
fn test_filtered() -> i64
{
    let name = [97u8];
    let message = [98u8];
    let event = Event { level: 1u8, sequence: 3usize, name: bytes_copy(array_as_slice(name)), message: bytes_copy(array_as_slice(message)) };
    let output = writer_from_bytes(bytes_zeroed(64usize));
    let written = append_event_if(event, 4u8, output);
    let position = writer_position(written);
    let bytes = writer_finish(written);
    let head = match byte_get(bytes_as_slice(bytes), 0usize) { Option::Some { value } => value, Option::None {} => 1u8, };
    if position == 0usize && head == 0u8 && byte_len(bytes_as_slice(bytes)) == 64usize { 0 } else { 1 }
}

// ---------------------------------------------------------------------
// Redaction guard (issue #193)
// ---------------------------------------------------------------------
// `append-event-guarded` was declared but never exercised by any test in
// this package until this tranche: `use function` imported it (above) and
// nothing ever called it. Pinned here: the safe path writes through exactly
// like the unguarded `append_event`, and a secret-bearing flag discards the
// WHOLE event rather than writing it -- the writer comes back at the
// position it started at, none of the event's bytes appended. This is a
// REFUSAL, not the "visible redacted marker" step 2 also asks for: this
// package's `Event` has no separate labeled-field structure to redact one
// field of (see `append-event-guarded`'s own doc comment in `log.spx`), so
// `std.log.redact.marker_byte`'s fixed marker is never written by this
// function -- discarding the event is a real, sound mitigation, but it does
// not by itself satisfy step 2's marker requirement.
//
// One representative secret-bearing flag is enough to pin the writer-level
// behaviour here: `std.log.redact.tests.event_safety` already exhaustively
// asserts, at the pure decision layer, that EACH of the six flags on its own
// (and combinations) makes `event_is_safe` false. Asserting all six again
// through this writer, each with its own freshly-built `Event` (two
// `bytes_copy` sites apiece), would add no coverage `event_safety` does not
// already give while multiplying this package's bytes-copy call-path budget
// (`SPX-T267`) -- which this tranche found is shared, non-additively, with
// `append-event-if`'s own reachable path once both are exercised from the
// same entry point.
@id("std.log.tests.guarded-writes-through-when-safe")
fn guarded_writes_through_when_safe() -> bool
{
    let name = [97u8];
    let message = [98u8];
    let event = Event { level: 2u8, sequence: 1usize, name: bytes_copy(array_as_slice(name)), message: bytes_copy(array_as_slice(message)) };
    let output = writer_from_bytes(bytes_zeroed(64usize));
    let written = append_event_guarded(event, false, false, false, false, false, false, output);
    writer_position(written) > 0usize
}

@id("std.log.tests.guarded-discards-when-unsafe")
fn guarded_discards_when_unsafe() -> bool
{
    let name = [97u8];
    let message = [98u8];
    let event = Event { level: 2u8, sequence: 1usize, name: bytes_copy(array_as_slice(name)), message: bytes_copy(array_as_slice(message)) };
    let output = writer_from_bytes(bytes_zeroed(64usize));
    let written = append_event_guarded(event, true, false, false, false, false, false, output);
    writer_position(written) == 0usize
}

@id("std.log.tests.main")
fn main() -> i64
{
    let mut failed = 0;
    failed = failed + if test_line() == 0 { 0 } else { 1 };
    failed = failed + if guarded_writes_through_when_safe() { 0 } else { 2 };
    failed = failed + if guarded_discards_when_unsafe() { 0 } else { 4 };
    failed + projection_policy_failures() + structured_event_failures()
}

@id("std.log.tests.projection-policy-cases")
fn projection_policy_cases() -> bool
{
    let protected = [112u8, 97u8, 115u8, 115u8, 119u8, 111u8, 114u8, 100u8];
    let public = [102u8, 105u8, 101u8, 108u8, 100u8];
    let raw = [115u8, 101u8, 99u8, 114u8, 101u8, 116u8];
    let marker = [91u8, 82u8, 69u8, 68u8, 65u8, 67u8, 84u8, 69u8, 68u8, 93u8];
    let suffixed = [91u8, 82u8, 69u8, 68u8, 65u8, 67u8, 84u8, 69u8, 68u8, 93u8, 120u8];
    let injection = [102u8, 10u8];
    let invalid_commitment = [103u8];
    let raw_view = array_as_slice(raw);
    let absent = byte_range(raw_view, 0usize, 0usize);
    let refuses_named = !field_projection_admitted(array_as_slice(protected), false, array_as_slice(raw), absent);
    let refuses_classified = !field_projection_admitted(array_as_slice(public), true, array_as_slice(raw), absent);
    let admits_named_marker = field_projection_admitted(array_as_slice(protected), false, array_as_slice(marker), absent);
    let admits_value_marker = field_projection_admitted(array_as_slice(public), true, array_as_slice(marker), absent);
    let refuses_suffix = !field_projection_admitted(array_as_slice(protected), true, array_as_slice(suffixed), absent);
    let admits_public = field_projection_admitted(array_as_slice(public), false, array_as_slice(raw), absent);
    let refuses_injection = !field_projection_admitted(array_as_slice(injection), false, array_as_slice(raw), absent);
    let refuses_commitment = !field_projection_admitted(array_as_slice(protected), true, array_as_slice(marker), array_as_slice(invalid_commitment));
    refuses_named && refuses_classified && admits_named_marker && admits_value_marker && refuses_suffix && admits_public && refuses_injection && refuses_commitment
}

@id("std.log.tests.projection-value-limit")
fn projection_value_limit() -> bool
{
    // The existing writer closure exhausts the 16-site bytes-builder budget.
    // Other consumers exercise actual 4096/4097-byte projections; this closure
    // checks the very same shared bound without adding an owned allocation.
    projection_len_admitted(4096usize) && !projection_len_admitted(4097usize)
}

@id("std.log.tests.projection-policy-failures")
fn projection_policy_failures() -> i64
{
    if projection_policy_cases() && projection_value_limit() { 0 } else { 1073741824 }
}

// ---------------------------------------------------------------------
// Issue #193: stable event identities and field budgets
// ---------------------------------------------------------------------
@id("std.log.tests.event_name_alphabet")
fn event_name_alphabet() -> bool
{
    event_name_byte_admitted(97u8) && event_name_byte_admitted(122u8) && event_name_byte_admitted(48u8) && event_name_byte_admitted(57u8) && event_name_byte_admitted(46u8) && event_name_byte_admitted(95u8)
}

@id("std.log.tests.event_name_alphabet_refusals")
fn event_name_alphabet_refusals() -> bool
{
    !event_name_byte_admitted(65u8) && !event_name_byte_admitted(90u8) && !event_name_byte_admitted(32u8) && !event_name_byte_admitted(45u8) && !event_name_byte_admitted(10u8) && !event_name_byte_admitted(34u8)
}

// An identity is a dotted lowercase identifier, not a sentence: a message
// interpolated into the name field is refused rather than folded, because an
// identity two call sites spell differently is two identities.
@id("std.log.tests.event_name_is_an_identity_not_a_sentence")
fn event_name_is_an_identity_not_a_sentence() -> bool
{
    let identity = [104u8, 116u8, 116u8, 112u8, 46u8, 114u8, 101u8, 113u8, 117u8, 101u8, 115u8, 116u8, 46u8, 114u8, 101u8, 106u8, 101u8, 99u8, 116u8, 101u8, 100u8];
    let sentence = [82u8, 101u8, 106u8, 101u8, 99u8, 116u8, 101u8, 100u8, 32u8, 114u8, 101u8, 113u8, 117u8, 101u8, 115u8, 116u8, 32u8, 102u8, 114u8, 111u8, 109u8, 32u8, 50u8, 48u8, 51u8, 46u8, 48u8, 46u8, 49u8, 49u8, 51u8, 46u8, 57u8];
    let shouting = [72u8, 84u8, 84u8, 80u8, 46u8, 82u8, 69u8, 81u8, 85u8, 69u8, 83u8, 84u8];
    let empty = [0u8; 0];
    event_name_admitted(array_as_slice(identity)) && !event_name_admitted(array_as_slice(sentence)) && !event_name_admitted(array_as_slice(shouting)) && !event_name_admitted(array_as_slice(empty))
}

@id("std.log.tests.event_name_length_window")
fn event_name_length_window() -> bool
{
    let at_limit = [97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8];
    let over_limit = [97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8, 97u8];
    event_name_admitted(array_as_slice(at_limit)) && !event_name_admitted(array_as_slice(over_limit))
}

@id("std.log.tests.level_vocabulary_is_closed")
fn level_vocabulary_is_closed() -> bool
{
    level_admitted(0u8) && level_admitted(5u8) && !level_admitted(6u8) && !level_admitted(255u8)
}

// Arity and payload are separate budgets: thirty-two fields are inside the
// count ceiling and can still be far past the byte ceiling.
@id("std.log.tests.field_budgets_are_separate")
fn field_budgets_are_separate() -> bool
{
    let bytes_limit = field_bytes_limit();
    let counts = field_count_admitted(0usize) && field_count_admitted(32usize) && !field_count_admitted(33usize);
    let payload = field_bytes_admitted(0usize) && field_bytes_admitted(bytes_limit) && !field_bytes_admitted(bytes_limit + 1usize);
    counts && payload
}

@id("std.log.tests.message_budget_boundary")
fn message_budget_boundary() -> bool
{
    let limit = message_len_limit();
    message_len_admitted(0usize) && message_len_admitted(limit) && !message_len_admitted(limit + 1usize)
}

// Every clause of the composed judgement refuses on its own while the other
// four hold, so a refusal is attributable to a named rule.
@id("std.log.tests.structured_event_admission_is_attributable")
fn structured_event_admission_is_attributable() -> bool
{
    let identity = [104u8, 116u8, 116u8, 112u8, 46u8, 114u8, 101u8, 113u8, 117u8, 101u8, 115u8, 116u8, 46u8, 114u8, 101u8, 106u8, 101u8, 99u8, 116u8, 101u8, 100u8];
    let sentence = [82u8, 101u8, 106u8, 101u8, 99u8, 116u8, 101u8, 100u8, 32u8, 114u8, 101u8, 113u8, 117u8, 101u8, 115u8, 116u8];
    let name = array_as_slice(identity);
    let all_hold = structured_event_admitted(name, 3u8, 256usize, 8usize, 1024usize);
    let name_only = !structured_event_admitted(array_as_slice(sentence), 3u8, 256usize, 8usize, 1024usize);
    let level_only = !structured_event_admitted(name, 6u8, 256usize, 8usize, 1024usize);
    let message_only = !structured_event_admitted(name, 3u8, message_len_limit() + 1usize, 8usize, 1024usize);
    let count_only = !structured_event_admitted(name, 3u8, 256usize, 33usize, 1024usize);
    let bytes_only = !structured_event_admitted(name, 3u8, 256usize, 8usize, field_bytes_limit() + 1usize);
    all_hold && name_only && level_only && message_only && count_only && bytes_only
}

// None of the shape rules has any notion of classified content: an event
// whose fields carry a session token passes every one of them.
@id("std.log.tests.structured_guard_refuses_each_secret_flag")
fn structured_guard_refuses_each_secret_flag() -> bool
{
    let identity = [104u8, 116u8, 116u8, 112u8, 46u8, 114u8, 101u8, 113u8, 117u8, 101u8, 115u8, 116u8, 46u8, 114u8, 101u8, 106u8, 101u8, 99u8, 116u8, 101u8, 100u8];
    let name = array_as_slice(identity);
    let safe = structured_event_admitted_guarded(name, 3u8, 256usize, 8usize, 1024usize, false, false, false, false, false, false);
    let password = !structured_event_admitted_guarded(name, 3u8, 256usize, 8usize, 1024usize, true, false, false, false, false, false);
    let api_key = !structured_event_admitted_guarded(name, 3u8, 256usize, 8usize, 1024usize, false, true, false, false, false, false);
    let bearer = !structured_event_admitted_guarded(name, 3u8, 256usize, 8usize, 1024usize, false, false, true, false, false, false);
    safe && password && api_key && bearer
}

@id("std.log.tests.structured_guard_refuses_the_remaining_flags")
fn structured_guard_refuses_the_remaining_flags() -> bool
{
    let identity = [104u8, 116u8, 116u8, 112u8, 46u8, 114u8, 101u8, 113u8, 117u8, 101u8, 115u8, 116u8, 46u8, 114u8, 101u8, 106u8, 101u8, 99u8, 116u8, 101u8, 100u8];
    let name = array_as_slice(identity);
    let session = !structured_event_admitted_guarded(name, 3u8, 256usize, 8usize, 1024usize, false, false, false, true, false, false);
    let signing = !structured_event_admitted_guarded(name, 3u8, 256usize, 8usize, 1024usize, false, false, false, false, true, false);
    let smtp = !structured_event_admitted_guarded(name, 3u8, 256usize, 8usize, 1024usize, false, false, false, false, false, true);
    session && signing && smtp
}

// A telemetry sink's failure never replaces the application's own status,
// and a deployment gets fail-closed export only by asking for it.
@id("std.log.tests.export_failure_never_masks_the_primary_status")
fn export_failure_never_masks_the_primary_status() -> bool
{
    let ignored = observed_status(0, 9, false) == 0;
    let primary_survives = observed_status(4, 9, false) == 4;
    let primary_survives_fail_closed = observed_status(4, 9, true) == 4;
    let fail_closed_reports = observed_status(0, 9, true) == 9;
    let both_succeed = observed_status(0, 0, true) == 0;
    ignored && primary_survives && primary_survives_fail_closed && fail_closed_reports && both_succeed
}

@id("std.log.tests.structured-event-failures")
fn structured_event_failures() -> i64
{
    let mut failed = 0;
    failed = failed + if event_name_alphabet() { 0 } else { 1048576 };
    failed = failed + if event_name_alphabet_refusals() { 0 } else { 2097152 };
    failed = failed + if event_name_is_an_identity_not_a_sentence() { 0 } else { 4194304 };
    failed = failed + if event_name_length_window() { 0 } else { 8388608 };
    failed = failed + if level_vocabulary_is_closed() { 0 } else { 16777216 };
    failed = failed + if field_budgets_are_separate() { 0 } else { 33554432 };
    failed + structured_guard_failures()
}

@id("std.log.tests.structured-guard-failures")
fn structured_guard_failures() -> i64
{
    let mut failed = 0;
    failed = failed + if message_budget_boundary() { 0 } else { 67108864 };
    failed = failed + if structured_event_admission_is_attributable() { 0 } else { 134217728 };
    failed = failed + if structured_guard_refuses_each_secret_flag() { 0 } else { 268435456 };
    failed = failed + if structured_guard_refuses_the_remaining_flags() { 0 } else { 536870912 };
    failed = failed + if export_failure_never_masks_the_primary_status() { 0 } else { 1073741824 };
    failed
}

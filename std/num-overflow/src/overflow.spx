module std.num.overflow;

@id("std.num.overflow.add_overflows")
fn add_overflows(left: i64, right: i64) -> bool
{
    if right > 0 { left > 9223372036854775807 - right } else { left < -9223372036854775807 - 1 - right }
}

@id("std.num.overflow.sub_overflows")
fn sub_overflows(left: i64, right: i64) -> bool
{
    if right < 0 { left > 9223372036854775807 + right } else { left < -9223372036854775807 - 1 + right }
}

@id("std.num.overflow.neg_overflows")
fn neg_overflows(value: i64) -> bool
    ensures result == (value == -9223372036854775807 - 1)
{
    value == -9223372036854775807 - 1
}

@id("std.num.overflow.mul_overflows")
fn mul_overflows(left: i64, right: i64) -> bool
{
    if left == 0 || right == 0 || left == 1 || right == 1 { false } else { if left == -1 { right == -9223372036854775807 - 1 } else { if right == -1 { left == -9223372036854775807 - 1 } else { if left == -9223372036854775807 - 1 || right == -9223372036854775807 - 1 { true } else { let magnitude_left = if left < 0 { 0 - left } else { left }; let magnitude_right = if right < 0 { 0 - right } else { right }; let quotient = 9223372036854775807 / magnitude_right; let remainder = 9223372036854775807 % magnitude_right; if left < 0 == right < 0 { magnitude_left > quotient } else { magnitude_left > quotient + if remainder == magnitude_right - 1 { 1 } else { 0 } } } } } }
}

@id("std.num.overflow.wrapping_add")
fn wrapping_add(left: i64, right: i64) -> i64
{
    if right > 0 && left > 9223372036854775807 - right { left - (9223372036854775807 - right) - 1 + (-9223372036854775807 - 1) } else { if right < 0 && left < -9223372036854775807 - 1 - right { left - (-9223372036854775807 - 1 - right) + 1 + 9223372036854775807 } else { left + right } }
}

@id("std.num.overflow.wrapping_sub")
fn wrapping_sub(left: i64, right: i64) -> i64
{
    if right < 0 && left > 9223372036854775807 + right { left + (-9223372036854775807 - 1) - (right + 9223372036854775807) - 1 } else { if right > 0 && left < -9223372036854775807 - 1 + right { left + 9223372036854775807 - (right + (-9223372036854775807 - 1)) + 1 } else { left - right } }
}

@id("std.num.overflow.wrapping_neg")
fn wrapping_neg(value: i64) -> i64
{
    if value == -9223372036854775807 - 1 { value } else { 0 - value }
}

@id("std.num.overflow.saturating_add")
fn saturating_add(left: i64, right: i64) -> i64
{
    if right > 0 && left > 9223372036854775807 - right { 9223372036854775807 } else { if right < 0 && left < -9223372036854775807 - 1 - right { -9223372036854775807 - 1 } else { left + right } }
}

@id("std.num.overflow.saturating_sub")
fn saturating_sub(left: i64, right: i64) -> i64
{
    if right < 0 && left > 9223372036854775807 + right { 9223372036854775807 } else { if right > 0 && left < -9223372036854775807 - 1 + right { -9223372036854775807 - 1 } else { left - right } }
}

@id("std.num.overflow.saturating_neg")
fn saturating_neg(value: i64) -> i64
{
    if value == -9223372036854775807 - 1 { 9223372036854775807 } else { 0 - value }
}

@id("std.num.overflow.saturating_abs")
fn saturating_abs(value: i64) -> i64
    ensures result >= 0
{
    if value == -9223372036854775807 - 1 { 9223372036854775807 } else { if value < 0 { 0 - value } else { value } }
}

@id("std.num.overflow.saturating_mul")
fn saturating_mul(left: i64, right: i64) -> i64
{
    if mul_overflows(left, right) { if left < 0 == right < 0 { 9223372036854775807 } else { -9223372036854775807 - 1 } } else { left * right }
}

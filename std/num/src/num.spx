module std.num;

@id("std.num.i64_min")
fn i64_min() -> i64
    ensures result == -9223372036854775807 - 1
{
    -9223372036854775807 - 1
}

@id("std.num.i64_max")
fn i64_max() -> i64
    ensures result == 9223372036854775807
{
    9223372036854775807
}

@id("std.num.sign")
fn sign(value: i64) -> i64
    ensures result >= -1 && result <= 1
    ensures result == 0 || value != 0
{
    if value < 0 { -1 } else { if value > 0 { 1 } else { 0 } }
}

@id("std.num.abs")
fn abs(value: i64) -> i64
    requires value != -9223372036854775807 - 1
    ensures result >= 0
    ensures result == value || result == 0 - value
{
    if value < 0 { 0 - value } else { value }
}

@id("std.num.is_even")
fn is_even(value: i64) -> bool
    ensures result == (value % 2 == 0)
{
    value % 2 == 0
}

@id("std.num.is_odd")
fn is_odd(value: i64) -> bool
    ensures result == (value % 2 != 0)
{
    value % 2 != 0
}

@id("std.num.div_euclid")
fn div_euclid(dividend: i64, divisor: i64) -> i64
    requires divisor != 0
    requires dividend != -9223372036854775807 - 1 || divisor != -1
{
    let quotient = dividend / divisor;
    if dividend % divisor < 0 { if divisor > 0 { quotient - 1 } else { quotient + 1 } } else { quotient }
}

@id("std.num.rem_euclid")
fn rem_euclid(dividend: i64, divisor: i64) -> i64
    requires divisor != 0
    requires dividend != -9223372036854775807 - 1 || divisor != -1
    ensures result >= 0
{
    let remainder = dividend % divisor;
    if remainder < 0 { if divisor > 0 { remainder + divisor } else { remainder - divisor } } else { remainder }
}

@id("std.num.gcd")
fn gcd(left: i64, right: i64) -> i64
    requires left >= 0 && right >= 0
    ensures result >= 0
{
    let mut a = left;
    let mut b = right;
    while b != 0 {
        let next = a % b;
        a = b;
        b = next;
        b != 0
    }
    a
}

@id("std.num.pow")
fn pow(base: i64, exponent: i64) -> i64
    requires exponent >= 0
    ensures exponent > 0 || result == 1
{
    let mut remaining = exponent;
    let mut product = 1;
    while remaining > 0 {
        product = product * base;
        remaining = remaining - 1;
        remaining > 0
    }
    product
}

@id("std.num.isqrt")
fn isqrt(value: i64) -> i64
    requires value >= 0
    ensures result >= 0 && result <= 3037000499
    ensures result * result <= value
{
    let mut low = 0;
    let mut high = if value < 3037000499 { value } else { 3037000499 };
    while low < high {
        let middle = low + (high - low + 1) / 2;
        let fits = middle * middle <= value;
        low = if fits { middle } else { low };
        high = if fits { high } else { middle - 1 };
        low < high
    }
    low
}

@id("std.num.digit_count")
fn digit_count(value: i64) -> i64
    ensures result >= 1 && result <= 19
{
    let mut remaining = value / 10;
    let mut digits = 1;
    while remaining != 0 {
        remaining = remaining / 10;
        digits = digits + 1;
        remaining != 0
    }
    digits
}

@id("std.num.is_power_of_two")
fn is_power_of_two(value: i64) -> bool
    ensures !result || value > 0
{
    let mut remaining = value;
    while remaining > 1 && remaining % 2 == 0 {
        remaining = remaining / 2;
        remaining > 1 && remaining % 2 == 0
    }
    remaining == 1
}

@id("std.num.log2_floor")
fn log2_floor(value: i64) -> i64
    requires value > 0
    ensures result >= 0 && result <= 62
{
    let mut remaining = value / 2;
    let mut exponent = 0;
    while remaining > 0 {
        remaining = remaining / 2;
        exponent = exponent + 1;
        remaining > 0
    }
    exponent
}

@id("std.num.log10_floor")
fn log10_floor(value: i64) -> i64
    requires value > 0
    ensures result >= 0 && result <= 18
{
    let mut remaining = value / 10;
    let mut exponent = 0;
    while remaining > 0 {
        remaining = remaining / 10;
        exponent = exponent + 1;
        remaining > 0
    }
    exponent
}

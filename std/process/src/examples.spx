module std.process.examples;
use type @id("std.io.reader") from std.io as Reader;
use type @id("std.io.writer") from std.io as Writer;
use type @id("std.process.argv") from std.process as Argv;
use type @id("std.process.output") from std.process as Output;
use function @id("std.process.argv-new") from std.process as argv_new;
use function @id("std.process.argv-push") from std.process as argv_push;
use function @id("std.process.argv-count") from std.process as argv_count;
use function @id("std.process.run") from std.process as run;
use function @id("std.process.valid") from std.process as valid;
use function @id("std.process.termination-kind") from std.process as termination_kind;
use function @id("std.process.termination-code") from std.process as termination_code;
use function @id("std.process.stdout-len") from std.process as stdout_len;
use function @id("std.process.stderr-len") from std.process as stderr_len;
use function @id("std.process.stdout-into") from std.process as stdout_into;
use function @id("std.process.stderr-into") from std.process as stderr_into;

permit { process.execute }

@id("std.process.examples.inspect")
fn inspect() -> bool
    uses { process.execute }
{
    let raw = bytes_set(bytes_zeroed(1usize), 0usize, 255u8);
    let first = Reader { data: raw, position: 0usize };
    let args = argv_push(first, argv_new(bytes_zeroed(16usize)));
    let second = Reader { data: bytes_zeroed(0usize), position: 0usize };
    let complete = argv_push(second, args);
    let count = argv_count(complete);
    let stdin_data = bytes_set(bytes_set(bytes_zeroed(2usize), 0usize, 88u8), 1usize, 66u8);
    let stdin = Reader { data: stdin_data, position: 1usize };
    let output = run(7usize, complete, stdin, 100usize, 2usize, 2usize);
    let stdout = stdout_into(output, Writer { data: bytes_zeroed(1usize), position: 0usize });
    let stderr = stderr_into(output, Writer { data: bytes_zeroed(1usize), position: 0usize });
    let stdout_byte = match own stdout { Writer { data, position: _ } => match byte_get(bytes_as_slice(data), 0usize) { Option::Some { value } => value, Option::None {} => 0u8, }, };
    let stderr_byte = match own stderr { Writer { data, position: _ } => match byte_get(bytes_as_slice(data), 0usize) { Option::Some { value } => value, Option::None {} => 0u8, }, };
    valid(output) && count == 2usize && termination_kind(output) == 0usize && termination_code(output) == 4294967295usize && stdout_len(output) == 1usize && stderr_len(output) == 1usize && stdout_byte == 65u8 && stderr_byte == 33u8
}

@id("std.process.examples.main")
fn main() -> i64
{
    0
}

module partition_repeated;

@id("partition_repeated.main")
fn main() -> i64
{
    let first = {
        let whole = bytes_zeroed(8192usize);
        let children = bytes_partition(whole, 8192usize, 1usize);
        i64_from_usize(vec_len<Bytes>(children))
    };
    let whole = bytes_zeroed(1usize);
    let children = bytes_partition(whole, 1usize, 1usize);
    first + i64_from_usize(vec_len<Bytes>(children))
}

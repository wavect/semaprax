semaprax.prelude.v5
variant core.option Option<T>
0 core.option.none None
1 core.option.some Some core.option.some.value:value:T
variant core.result Result<T,E>
0 core.result.ok Ok core.result.ok.value:value:T
1 core.result.err Err core.result.err.error:error:E
record core.vec Vec<T>
record core.box Box<T>
elements i64,i32,u8,usize,char,f32,f64,bool
operation core.vec.with-capacity vec_with_capacity <T>(value:usize)->own:Vec<T>
operation core.vec.push vec_push <T>(own:Vec<T>,value:T)->own:Vec<T>
operation core.vec.len vec_len <T>(borrow:Vec<T>)->value:usize
operation core.vec.capacity vec_capacity <T>(borrow:Vec<T>)->value:usize
operation core.vec.get vec_get <T>(borrow:Vec<T>,value:usize)->value:T
limit max_capacity 8192
status semaprax.vec.v1 push_full:1 get_out_of_bounds:2 allocation_failure:3
operation core.vec.reserve-exact vec_reserve_exact <T>(own:Vec<T>,value:usize)->own:Vec<T>
operation core.vec.set vec_set <T>(own:Vec<T>,value:usize,value:T)->own:Vec<T>
operation core.vec.clear vec_clear <T>(own:Vec<T>)->own:Vec<T>
rule reserve_exact target_capacity=max(old_capacity,length+additional) overflow_or_above_max_or_allocation_failure=semaprax.vec.v1:3
rule set index_out_of_bounds=semaprax.vec.v1:2
rule clear length=0 capacity=old_capacity
rule successful_owner_mutation generation=next
operation core.box.new box_new <T>(value:T)->own:Box<T>
operation core.box.get box_get <T>(borrow:Box<T>)->value:T
operation core.box.into-inner box_into_inner <T>(own:Box<T>)->value:T
elements i64,i32,u8,usize,char,f32,f64,bool
limit max_live_allocations 4096
status semaprax.box.v1 allocation_failure:1
operation core.box.new box_new <Bytes>(own:Bytes)->own:Box<Bytes>
operation core.box.into-inner box_into_inner <Bytes>(own:Box<Bytes>)->own:Bytes
rule core.box.get <Bytes>=closed
wasm_imports spx_box_new_v2,spx_box_get_v2,spx_box_into_inner_v2,spx_box_drop_v2

profile core.vec.owned-bytes.v1 element:Bytes carrier_charge:16 max_capacity:8192
operation core.vec.with-capacity vec_with_capacity <Bytes>(value:usize)->own:Vec<Bytes>
operation core.vec.push vec_push <Bytes>(own:Vec<Bytes>,own:Bytes)->own:Vec<Bytes>

wasm_imports spx_vec_with_capacity_v2,spx_vec_push_v2,spx_vec_len_v2,spx_vec_capacity_v2,spx_vec_get_v2,spx_vec_drop_v2,spx_vec_reserve_exact_v2,spx_vec_set_v2,spx_vec_clear_v2
record core.iter Iter<T>
representation core.iter opaque logical:Vec<T>,cursor:usize
variant core.iter-step IterStep<T>
0 core.iter-step.done Done
1 core.iter-step.yield Yield core.iter-step.yield.item:item:T core.iter-step.yield.rest:rest:Iter<T>
operation core.vec.into-iter vec_into_iter <T>(own:Vec<T>)->own:Iter<T>
operation core.iter.next iter_next <T>(own:Iter<T>)->own:IterStep<T>
elements i64,i32,u8,usize,char,f32,f64,bool
rule iter_next consumes_iterator_and_yield_rest_owns_successor
rule iter_done_has_no_payload
cleanup_plan semaprax.cleanup-plan.v10
profile core.iter.owned-bytes.v2 element:Bytes
operation core.vec.into-iter vec_into_iter <Bytes>(own:Vec<Bytes>)->own:Iter<Bytes>
operation core.iter.next iter_next <Bytes>(own:Iter<Bytes>)->own:IterStep<Bytes>
rule owned_iter distinct_authority initialized_window:[cursor,length) detached_prefix:[0,cursor)
rule owned_iter_next validation_before_commit atomic_item_and_remainder_transfer
rule owned_iter_drop suffix_index_order_then_backing
rule owned_iter_yield owners:item,rest

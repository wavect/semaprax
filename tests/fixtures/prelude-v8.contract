operation core.vec.set vec_set <Bytes>(own:Vec<Bytes>,value:usize,own:Bytes)->own:Vec<Bytes>
operation core.vec.clear vec_clear <Bytes>(own:Vec<Bytes>)->own:Vec<Bytes>
rule core.vec.get <Bytes>=closed
rule owned_vec_push_set_reserve failure_before_owner_commit
rule owned_vec_set drops_replaced_payload_once

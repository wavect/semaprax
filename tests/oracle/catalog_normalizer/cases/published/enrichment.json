    {
      "name": "enrichment-disabled-by-default-ignores-fixture",
      "enrich": false,
      "expected_output": "{\"status\":\"ok\",\"count\":1,\"total_quantity\":1,\"records\":[{\"id\":\"blocked-vendor\",\"label\":\"l\",\"quantity\":1}]}\n",
      "input": "{\"id\": \"blocked-vendor\", \"label\": \"l\", \"quantity\": 1}\n"
    }
  ]

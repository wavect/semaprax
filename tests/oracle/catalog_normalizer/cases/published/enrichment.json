      "expected_output": "{\"status\":\"ok\",\"count\":1,\"total_quantity\":1,\"records\":[{\"id\":\"known-missing\",\"label\":\"l\",\"quantity\":1,\"category\":null}]}\n",
      "input": "{\"id\": \"known-missing\", \"label\": \"l\", \"quantity\": 1}\n"
    },
    {
      "name": "enrichment-absent-from-table-is-missing",
      "enrich": true,
      "expected_output": "{\"status\":\"ok\",\"count\":1,\"total_quantity\":1,\"records\":[{\"id\":\"not-in-table\",\"label\":\"l\",\"quantity\":1,\"category\":null}]}\n",
      "input": "{\"id\": \"not-in-table\", \"label\": \"l\", \"quantity\": 1}\n"
    },
    {
      "name": "enrichment-denied-rejects-batch",
